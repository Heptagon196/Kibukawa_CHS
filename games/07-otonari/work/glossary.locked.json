  "rules": {
    "public_policy": "同时读取series/glossary.json及series/glossary-rules.json；不继承第六作拼音实验覆盖。",
    "timeline": "本事发生在假面幻想事件前三个月；案结两个月后林居才被破格提拔为刑警。正文主时段他是26岁巡查。",
    "viewpoints": "原文提示林居和吉娃娃视角切换；保持各视角知识范围，不提前补出玩家尚未获知的信息。",
    "review_status": "全文四章及所有文字候选已译并双重审校；标签、点击与固定页面分段复核完成。图片内容译稿已备，图片及运行时布局未验收。",
    "title": "用户锁定作品副标题为林居刑警的搜查笔记。小小名侦探为开场正文及第三章标题，不能用冒号并入作品副标题。",
    "murder_timing": "今早约9时离开房间；约五分钟后根室回来取遗忘物品。死亡推定时间为60至90分钟前，即12时前后，不改成精确12时整。",
    "death_cause": "致死原因是背部刀刺造成的休克；此前后脑遭花瓶重击。头部打击不是最终死因。早期花瓶打击顺序为鉴定推测，保留おそらく/と思われます的推定。",
    "alibi_uncertainty": "鸟玩偶员工称只见中本排队，却不足以保证中本不在场证明牢固。根室自称去厕所、手伤自称在游乐园无意中受伤，均不译为客观查证事实。",
    "key_mechanism": "正确推理：根室先把自己的钥匙与伊崎备用钥匙的房号牌对调，把挂着伊崎房号牌的自己的钥匙交还前台；之后借钥匙，再在九楼走廊将牌换回。务必区分本体和牌，以及自己的/死者的/备用钥匙。错误选项仍照错译，不自动纠正。",
    "blood_reveal": "公园拾取的脏东西直到尾场看到后才确认为花瓶碎片，并提出比对根室手伤血迹。此时要求检验是否同一血液，不得先译成鉴定已匹配。",
    "confession": "凶手称死者首先持刀袭击她、自己并无杀意；保持当事人陈述，不补法律定性。换房号牌最初是想惊喜，并非预谋杀人的断言。",
    "dog_motive": "林居说恰皮大概不想让根室背负更多罪孽，保留たぶん推测，不改成全知旁白或确定犬类内心。",
    "police_track": "キャリア/ノンキャリア为警察职业晋升路线，建议精英组/非精英组或精英刑警，不译成职业/业余警察。警视总监不得简称为警察局长。",
    "plate_analogy": "换盘子而菜肴相同的类比按原文保留，不为了贴合钥匙解答擅自倒换菜与盘的关系。",
    "money": "餐具加菜肴赔偿39900日元含税，保留币种、金额和含税，不折算人民币。",
    "clue_names": "足りない破片→缺少的碎片；伊崎の忘れ物→伊崎遗忘的东西；向井の口論→向井的争吵；汚い何か→脏兮兮的东西；不確定なアリバイ→不确定的不在场证明；二つの皿→两只盘子。",
    "fixed_pages": "章节/地点卡及片尾角色/姓名/注音槽按原77换行隔离；中文姓名不附读音，注音槽用空串而非null保留指令。",
    "dynamic_joins": "scn3:7932/9469原77后的共用尾句2665/2738必须独立；分别2×2及4×4×4分支，不在静态顺序中串为一段。"
  }
}
