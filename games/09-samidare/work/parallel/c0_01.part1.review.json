{
  "script": "c0_01",
  "batch": "c0_01.part1.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 55,
      "kind": "line",
      "limit": 11,
      "source": "お便りの返事…ですか？",
      "target": "回复来信…吗？"
    },
    {
      "offset": 103,
      "kind": "line",
      "limit": 10,
      "source": "うん、そうそう。",
      "target": "嗯，对对。"
    },
    {
      "offset": 125,
      "kind": "line",
      "limit": 10,
      "source": "アプリで遊んだ人から",
      "target": "玩过这款应用的"
    },
    {
      "offset": 151,
      "kind": "line",
      "limit": 10,
      "source": "質問が来てるんで…",
      "target": "玩家寄来了问题…"
    },
    {
      "offset": 175,
      "kind": "line",
      "limit": 11,
      "source": "伊綱君に、その返答を",
      "target": "所以想请伊纲"
    },
    {
      "offset": 201,
      "kind": "line",
      "limit": 11,
      "source": "して欲しいってわけだ。",
      "target": "回答一下。"
    },
    {
      "offset": 229,
      "kind": "line",
      "limit": 11,
      "source": "まあ、サイトで公開する",
      "target": "差不多就是发布在"
    },
    {
      "offset": 257,
      "kind": "line",
      "limit": 11,
      "source": "インタビューみたいな",
      "target": "网站上的采访"
    },
    {
      "offset": 283,
      "kind": "line",
      "limit": 11,
      "source": "ものかな。",
      "target": "吧。"
    },
    {
      "offset": 299,
      "kind": "line",
      "limit": 8,
      "source": "いよっ、人気者！",
      "target": "哟，大红人！"
    },
    {
      "offset": 323,
      "kind": "line",
      "limit": 9,
      "source": "なんで私がそこまで",
      "target": "我为什么非得"
    },
    {
      "offset": 347,
      "kind": "line",
      "limit": 9,
      "source": "しないといけないん",
      "target": "做到这种地步"
    },
    {
      "offset": 371,
      "kind": "line",
      "limit": 9,
      "source": "ですか。",
      "target": "啊。"
    },
    {
      "offset": 396,
      "kind": "line",
      "limit": 11,
      "source": "生王さんが勝手に",
      "target": "明明是生王先生"
    },
    {
      "offset": 424,
      "kind": "line",
      "limit": 11,
      "source": "作ってるゲームなのに。",
      "target": "擅自做的游戏。"
    },
    {
      "offset": 461,
      "kind": "line",
      "limit": 11,
      "source": "まあまあ、これから",
      "target": "好啦，等会我念问题，"
    },
    {
      "offset": 485,
      "kind": "line",
      "limit": 11,
      "source": "読み上げるものに口頭で",
      "target": "你口头回答"
    },
    {
      "offset": 513,
      "kind": "line",
      "limit": 11,
      "source": "返答すればいいからさ。",
      "target": "就行了。"
    },
    {
      "offset": 541,
      "kind": "line",
      "limit": 8,
      "source": "録音だけ、させて",
      "target": "不过得让我"
    },
    {
      "offset": 563,
      "kind": "line",
      "limit": 8,
      "source": "もらうけど。",
      "target": "录下来。"
    },
    {
      "offset": 581,
      "kind": "line",
      "limit": 10,
      "source": "こういう地道な宣伝が",
      "target": "这种踏实的宣传"
    },
    {
      "offset": 607,
      "kind": "line",
      "limit": 10,
      "source": "探偵の商売繁盛にも",
      "target": "也能让侦探生意"
    },
    {
      "offset": 631,
      "kind": "line",
      "limit": 10,
      "source": "つながるわけだ。",
      "target": "兴隆起来。"
    },
    {
      "offset": 653,
      "kind": "line",
      "limit": 5,
      "source": "…たぶん。",
      "target": "…大概。"
    },
    {
      "offset": 671,
      "kind": "line",
      "limit": 5,
      "source": "んもう…。",
      "target": "真是的…"
    },
    {
      "offset": 689,
      "kind": "line",
      "limit": 10,
      "source": "さあ、それでは今週も",
      "target": "好了，本周也让我们"
    },
    {
      "offset": 715,
      "kind": "line",
      "limit": 10,
      "source": "いってみましょう！",
      "target": "开始吧！"
    },
    {
      "offset": 749,
      "kind": "line",
      "limit": 11,
      "source": "皆さんお待ちかね！",
      "target": "各位期待已久！"
    },
    {
      "offset": 773,
      "kind": "line",
      "limit": 11,
      "source": "直撃！伊綱さんに",
      "target": "直击！伊纲小姐的"
    },
    {
      "offset": 795,
      "kind": "line",
      "limit": 11,
      "source": "４つの質問コーナー!!",
      "target": "四问四答环节！！"
    },
    {
      "offset": 821,
      "kind": "line",
      "limit": 9,
      "source": "いよっ！　拍手!!",
      "target": "好！鼓掌！！"
    },
    {
      "offset": 845,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 871,
      "kind": "choice",
      "limit": 0,
      "source": "お便り読む",
      "target": "读来信"
    },
    {
      "offset": 885,
      "kind": "choice",
      "limit": 0,
      "source": "中断する",
      "target": "中断"
    },
    {
      "offset": 906,
      "kind": "line",
      "limit": 11,
      "source": "さて、どの質問から",
      "target": "先问哪个问题"
    },
    {
      "offset": 930,
      "kind": "line",
      "limit": 11,
      "source": "ぶつけてみようかな…。",
      "target": "好呢…"
    },
    {
      "offset": 976,
      "kind": "choice",
      "limit": 0,
      "source": "事務所の経営について",
      "target": "关于事务所的经营"
    },
    {
      "offset": 1009,
      "kind": "choice",
      "limit": 0,
      "source": "これまでの事件で…",
      "target": "迄今的案件…"
    },
    {
      "offset": 1040,
      "kind": "choice",
      "limit": 0,
      "source": "引越しはどうなった？",
      "target": "搬家怎么样了？"
    },
    {
      "offset": 1073,
      "kind": "choice",
      "limit": 0,
      "source": "伊綱ちゃんＬＯＶＥ！",
      "target": "伊纲妹妹ＬＯＶＥ！"
    },
    {
      "offset": 1102,
      "kind": "line",
      "limit": 10,
      "source": "こちらはリュウタさん",
      "target": "这是龙太先生的",
      "runs": [
        "这是",
        "龙太先生的"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "こちらは"
        },
        {
          "colour": 2,
          "text": "リュウタさん"
        }
      ]
    },
    {
      "offset": 1141,
      "kind": "line",
      "limit": 10,
      "source": "からのメールです！",
      "target": "邮件！"
    },
    {
      "offset": 1165,
      "kind": "line",
      "limit": 10,
      "source": "ええと…",
      "target": "嗯…"
    },
    {
      "offset": 1181,
      "kind": "line",
      "limit": 11,
      "source": "こんにちは、いつも",
      "target": "你好，我一直都在"
    },
    {
      "offset": 1205,
      "kind": "line",
      "limit": 11,
      "source": "楽しくアプリで遊ばせて",
      "target": "愉快地玩这款"
    },
    {
      "offset": 1233,
      "kind": "line",
      "limit": 11,
      "source": "もらっています。",
      "target": "应用。"
    },
    {
      "offset": 1256,
      "kind": "line",
      "limit": 11,
      "source": "いやあ、どうも",
      "target": "哎呀，真是"
    },
    {
      "offset": 1276,
      "kind": "line",
      "limit": 11,
      "source": "ありがとうございます！",
      "target": "非常感谢！"
    },
    {
      "offset": 1306,
      "kind": "line",
      "limit": 8,
      "source": "…なんかひとりで",
      "target": "…你一个人"
    },
    {
      "offset": 1328,
      "kind": "line",
      "limit": 8,
      "source": "楽しそうですね。",
      "target": "倒挺开心的。"
    },
    {
      "offset": 1354,
      "kind": "line",
      "limit": 10,
      "source": "ところで、伊綱さんに",
      "target": "我想问伊纲小姐"
    },
    {
      "offset": 1380,
      "kind": "line",
      "limit": 10,
      "source": "質問があります。",
      "target": "一个问题。"
    },
    {
      "offset": 1405,
      "kind": "line",
      "limit": 11,
      "source": "癸生川探偵事務所には",
      "target": "听说癸生川侦探"
    },
    {
      "offset": 1431,
      "kind": "line",
      "limit": 11,
      "source": "仕事があまり来ないそう",
      "target": "事务所没什么"
    },
    {
      "offset": 1459,
      "kind": "line",
      "limit": 11,
      "source": "ですけど、",
      "target": "委托，"
    },
    {
      "offset": 1478,
      "kind": "line",
      "limit": 9,
      "source": "伊綱さんたちは",
      "target": "伊纲小姐你们"
    },
    {
      "offset": 1498,
      "kind": "line",
      "limit": 9,
      "source": "どうやって生計を",
      "target": "究竟靠什么"
    },
    {
      "offset": 1520,
      "kind": "line",
      "limit": 9,
      "source": "立ててるんですか？",
      "target": "维持生计？"
    },
    {
      "offset": 1545,
      "kind": "line",
      "limit": 10,
      "source": "…ということですが？",
      "target": "…他这么问哦？"
    },
    {
      "offset": 1573,
      "kind": "line",
      "limit": 10,
      "source": "えっ？　なんですか",
      "target": "咦？为什么"
    },
    {
      "offset": 1597,
      "kind": "line",
      "limit": 10,
      "source": "私が答えるんですか？",
      "target": "要我回答？"
    },
    {
      "offset": 1625,
      "kind": "line",
      "limit": 9,
      "source": "あまり仕事は",
      "target": "听说你们"
    },
    {
      "offset": 1643,
      "kind": "line",
      "limit": 9,
      "source": "来ないそうですが。",
      "target": "没什么委托。"
    },
    {
      "offset": 1669,
      "kind": "line",
      "limit": 9,
      "source": "大きなお世話です。",
      "target": "要你多管。"
    },
    {
      "offset": 1695,
      "kind": "line",
      "limit": 11,
      "source": "確かあれですよね、この",
      "target": "我记得这家事务所"
    },
    {
      "offset": 1723,
      "kind": "line",
      "limit": 11,
      "source": "事務所にはオーナーが",
      "target": "有位老板",
      "runs": [
        "有位",
        "老板"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "事務所には"
        },
        {
          "colour": 2,
          "text": "オーナーが"
        }
      ]
    },
    {
      "offset": 1762,
      "kind": "line",
      "limit": 11,
      "source": "いるんですよね？",
      "target": "吧？"
    },
    {
      "offset": 1786,
      "kind": "line",
      "limit": 10,
      "source": "ええまあ、そうです。",
      "target": "嗯，是有。"
    },
    {
      "offset": 1822,
      "kind": "line",
      "limit": 10,
      "source": "私も会ったことないし",
      "target": "我也没见过本人，"
    },
    {
      "offset": 1848,
      "kind": "line",
      "limit": 10,
      "source": "詳しいことは知らない",
      "target": "不太清楚详情"
    },
    {
      "offset": 1874,
      "kind": "line",
      "limit": 10,
      "source": "んですが…",
      "target": "…"
    },
    {
      "offset": 1905,
      "kind": "line",
      "limit": 11,
      "source": "御堂丸将云っていう人が",
      "target": "一个叫御堂丸将云的人"
    },
    {
      "offset": 1959,
      "kind": "line",
      "limit": 11,
      "source": "この事務所のオーナー",
      "target": "似乎是这间事务所的"
    },
    {
      "offset": 1985,
      "kind": "line",
      "limit": 11,
      "source": "らしくて…",
      "target": "老板…"
    },
    {
      "offset": 2011,
      "kind": "line",
      "limit": 11,
      "source": "家賃や私たちの給料は、",
      "target": "无论有没有委托，"
    },
    {
      "offset": 2039,
      "kind": "line",
      "limit": 11,
      "source": "仕事の有無に関わらず",
      "target": "房租和我们的工资"
    },
    {
      "offset": 2065,
      "kind": "line",
      "limit": 11,
      "source": "払ってもらってます。",
      "target": "都由他支付。"
    },
    {
      "offset": 2091,
      "kind": "line",
      "limit": 11,
      "source": "先生と、何やら関わりが",
      "target": "他好像与老师"
    },
    {
      "offset": 2119,
      "kind": "line",
      "limit": 11,
      "source": "ある人らしいですが…。",
      "target": "有什么关系…"
    },
    {
      "offset": 2149,
      "kind": "line",
      "limit": 11,
      "source": "謎のオーナーですか。",
      "target": "神秘的老板吗。"
    },
    {
      "offset": 2175,
      "kind": "line",
      "limit": 11,
      "source": "これは気になりますね。",
      "target": "真令人在意。"
    },
    {
      "offset": 2205,
      "kind": "line",
      "limit": 10,
      "source": "わざとらしいですよ。",
      "target": "演得太假了。"
    },
    {
      "offset": 2233,
      "kind": "line",
      "limit": 10,
      "source": "ということは、仕事を",
      "target": "也就是说，就算"
    },
    {
      "offset": 2259,
      "kind": "line",
      "limit": 10,
      "source": "しなくても、食うには",
      "target": "不工作，也不用"
    },
    {
      "offset": 2285,
      "kind": "line",
      "limit": 10,
      "source": "困らない、と？",
      "target": "担心吃饭？"
    },
    {
      "offset": 2317,
      "kind": "line",
      "limit": 11,
      "source": "まあ、なので先生なんか",
      "target": "嗯，所以老师有时"
    },
    {
      "offset": 2345,
      "kind": "line",
      "limit": 11,
      "source": "ずっと寝てたりする日も",
      "target": "一整天都在"
    },
    {
      "offset": 2373,
      "kind": "line",
      "limit": 11,
      "source": "ありますけど…",
      "target": "睡觉…"
    },
    {
      "offset": 2393,
      "kind": "line",
      "limit": 11,
      "source": "私はできるだけ、仕事で",
      "target": "但我尽量只用"
    },
    {
      "offset": 2421,
      "kind": "line",
      "limit": 11,
      "source": "稼いだお金だけを",
      "target": "自己工作赚来的"
    },
    {
      "offset": 2443,
      "kind": "line",
      "limit": 11,
      "source": "使うようにしてます。",
      "target": "钱。"
    },
    {
      "offset": 2471,
      "kind": "line",
      "limit": 10,
      "source": "おお、立派ですねえ。",
      "target": "哦，真了不起。"
    },
    {
      "offset": 2509,
      "kind": "line",
      "limit": 10,
      "source": "でも、もらえると",
      "target": "不过，他给我们的"
    },
    {
      "offset": 2531,
      "kind": "line",
      "limit": 10,
      "source": "言っても最低限の賃金",
      "target": "只是最低工资，"
    },
    {
      "offset": 2557,
      "kind": "line",
      "limit": 10,
      "source": "しか出ないので…",
      "target": "所以…"
    },
    {
      "offset": 2579,
      "kind": "line",
      "limit": 11,
      "source": "備品や消耗品などは",
      "target": "办公用品和耗材"
    },
    {
      "offset": 2603,
      "kind": "line",
      "limit": 11,
      "source": "自分たちで調達しないと",
      "target": "都得由我们自己"
    },
    {
      "offset": 2631,
      "kind": "line",
      "limit": 11,
      "source": "いけないんですよ。",
      "target": "准备。"
    },
    {
      "offset": 2665,
      "kind": "line",
      "limit": 9,
      "source": "ほら、最近の悪事は",
      "target": "你看，现在的犯罪"
    },
    {
      "offset": 2689,
      "kind": "line",
      "limit": 9,
      "source": "手口が巧妙になって",
      "target": "手法越来越"
    },
    {
      "offset": 2713,
      "kind": "line",
      "limit": 9,
      "source": "きているので…",
      "target": "高明…"
    },
    {
      "offset": 2733,
      "kind": "line",
      "limit": 11,
      "source": "新しい道具や機材が",
      "target": "没有新工具和设备，"
    },
    {
      "offset": 2757,
      "kind": "line",
      "limit": 11,
      "source": "ないと、太刀打ち",
      "target": "有时根本无法"
    },
    {
      "offset": 2779,
      "kind": "line",
      "limit": 11,
      "source": "できないこともあって。",
      "target": "应付。"
    },
    {
      "offset": 2807,
      "kind": "line",
      "limit": 11,
      "source": "なので最新の機材を",
      "target": "所以我想备齐"
    },
    {
      "offset": 2831,
      "kind": "line",
      "limit": 11,
      "source": "揃えたいんですけど…。",
      "target": "最新设备…"
    },
    {
      "offset": 2861,
      "kind": "line",
      "limit": 10,
      "source": "ははあ、なるほど。",
      "target": "哦，原来如此。"
    },
    {
      "offset": 2885,
      "kind": "line",
      "limit": 10,
      "source": "ハイテク犯罪にも対応",
      "target": "也需要应对"
    },
    {
      "offset": 2911,
      "kind": "line",
      "limit": 10,
      "source": "する必要があると。",
      "target": "高科技犯罪啊。"
    },
    {
      "offset": 2937,
      "kind": "line",
      "limit": 11,
      "source": "そういうことです。",
      "target": "就是这样。"
    },
    {
      "offset": 2961,
      "kind": "line",
      "limit": 11,
      "source": "最新の探知機とかも",
      "target": "最新型的探测器"
    },
    {
      "offset": 2985,
      "kind": "line",
      "limit": 11,
      "source": "欲しいじゃないですか。",
      "target": "也很想要吧。"
    },
    {
      "offset": 3013,
      "kind": "line",
      "limit": 10,
      "source": "でも今の稼ぎじゃ、",
      "target": "可凭现在的收入，"
    },
    {
      "offset": 3037,
      "kind": "line",
      "limit": 10,
      "source": "とてもそこまでは手が",
      "target": "完全负担不起"
    },
    {
      "offset": 3063,
      "kind": "line",
      "limit": 10,
      "source": "回らないんですよ。",
      "target": "这些。"
    },
    {
      "offset": 3089,
      "kind": "line",
      "limit": 10,
      "source": "そういうものは、",
      "target": "这种东西毕竟"
    },
    {
      "offset": 3111,
      "kind": "line",
      "limit": 10,
      "source": "特殊な機材ですから",
      "target": "是特殊设备，"
    },
    {
      "offset": 3135,
      "kind": "line",
      "limit": 10,
      "source": "高いんですよねえ…。",
      "target": "很贵啊…"
    },
    {
      "offset": 3163,
      "kind": "line",
      "limit": 7,
