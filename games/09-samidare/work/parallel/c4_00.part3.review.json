{
  "script": "c4_00",
  "batch": "c4_00.part3.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 9922,
      "kind": "line",
      "limit": 11,
      "source": "調査をした探偵からの",
      "target": "替绫子调查的侦探"
    },
    {
      "offset": 9948,
      "kind": "line",
      "limit": 11,
      "source": "紹介で出会った、とある",
      "target": "介绍他认识的一位"
    },
    {
      "offset": 9976,
      "kind": "line",
      "limit": 11,
      "source": "資産家であった。",
      "target": "富豪。"
    },
    {
      "offset": 9998,
      "kind": "line",
      "limit": 11,
      "source": "その男は、忠雄が負って",
      "target": "那人把忠雄欠下的"
    },
    {
      "offset": 10026,
      "kind": "line",
      "limit": 11,
      "source": "いる借金と、その利子分",
      "target": "债务连同全部利息"
    },
    {
      "offset": 10054,
      "kind": "line",
      "limit": 11,
      "source": "すべてを、無利子で",
      "target": "一并无息"
    },
    {
      "offset": 10078,
      "kind": "line",
      "limit": 11,
      "source": "貸してくれたのである。",
      "target": "借给了他。"
    },
    {
      "offset": 10106,
      "kind": "line",
      "limit": 11,
      "source": "…いくら資産家と言え、",
      "target": "…虽说是富豪，"
    },
    {
      "offset": 10134,
      "kind": "line",
      "limit": 11,
      "source": "彼にとっても決して",
      "target": "这笔钱对他而言"
    },
    {
      "offset": 10158,
      "kind": "line",
      "limit": 11,
      "source": "軽くはない金額だった。",
      "target": "也绝非小数目。"
    },
    {
      "offset": 10189,
      "kind": "line",
      "limit": 11,
      "source": "その厚意にいたく感謝",
      "target": "忠雄对他的好意"
    },
    {
      "offset": 10215,
      "kind": "line",
      "limit": 11,
      "source": "した忠雄は、一生かけて",
      "target": "感激不已，发誓穷尽"
    },
    {
      "offset": 10243,
      "kind": "line",
      "limit": 11,
      "source": "でも、全額返済する",
      "target": "一生也要把钱"
    },
    {
      "offset": 10267,
      "kind": "line",
      "limit": 11,
      "source": "ことを誓ったのである。",
      "target": "全部还清。"
    },
    {
      "offset": 10298,
      "kind": "line",
      "limit": 11,
      "source": "…こうして、精神的な",
      "target": "…就这样，精神上的"
    },
    {
      "offset": 10324,
      "kind": "line",
      "limit": 11,
      "source": "負担が軽くなった忠雄は",
      "target": "负担减轻后，忠雄"
    },
    {
      "offset": 10352,
      "kind": "line",
      "limit": 11,
      "source": "それでも手は抜かずに",
      "target": "仍未有丝毫懈怠，"
    },
    {
      "offset": 10378,
      "kind": "line",
      "limit": 11,
      "source": "精力的に働き続け…",
      "target": "继续拼命工作…"
    },
    {
      "offset": 10402,
      "kind": "line",
      "limit": 11,
      "source": "それから２０年以上の間",
      "target": "之后的二十多年里，"
    },
    {
      "offset": 10430,
      "kind": "line",
      "limit": 11,
      "source": "家族に知られることなく",
      "target": "他一直瞒着家人"
    },
    {
      "offset": 10458,
      "kind": "line",
      "limit": 11,
      "source": "支払いを続けていたので",
      "target": "持续偿还着"
    },
    {
      "offset": 10486,
      "kind": "line",
      "limit": 11,
      "source": "ある。",
      "target": "这笔债务。"
    },
    {
      "offset": 10545,
      "kind": "line",
      "limit": 10,
      "source": "…なるほど、そういう",
      "target": "…原来如此，"
    },
    {
      "offset": 10571,
      "kind": "line",
      "limit": 10,
      "source": "ことだったんですか。",
      "target": "是这么回事啊。"
    },
    {
      "offset": 10597,
      "kind": "line",
      "limit": 11,
      "source": "そのおかげで綾子さんが",
      "target": "也正因如此，绫子女士"
    },
    {
      "offset": 10625,
      "kind": "line",
      "limit": 11,
      "source": "結婚詐欺師だったという",
      "target": "曾是婚姻诈骗犯的事"
    },
    {
      "offset": 10653,
      "kind": "line",
      "limit": 11,
      "source": "ことは…",
      "target": "才能…"
    },
    {
      "offset": 10667,
      "kind": "line",
      "limit": 10,
      "source": "ずっと隠し通せてきた",
      "target": "一直瞒到现在，"
    },
    {
      "offset": 10693,
      "kind": "line",
      "limit": 10,
      "source": "わけなんですね。",
      "target": "对吧？"
    },
    {
      "offset": 10717,
      "kind": "line",
      "limit": 5,
      "source": "…そうだ。",
      "target": "…是啊。"
    },
    {
      "offset": 10733,
      "kind": "line",
      "limit": 11,
      "source": "借金を完済したら、",
      "target": "等债务还清，"
    },
    {
      "offset": 10757,
      "kind": "line",
      "limit": 11,
      "source": "一緒に暮らそうと思って",
      "target": "我本想和她一起生活"
    },
    {
      "offset": 10785,
      "kind": "line",
      "limit": 11,
      "source": "いた…。",
      "target": "的…"
    },
    {
      "offset": 10801,
      "kind": "line",
      "limit": 6,
      "source": "なるほど…。",
      "target": "原来如此…"
    },
    {
      "offset": 10819,
      "kind": "line",
      "limit": 11,
      "source": "…返済額は、残りあと",
      "target": "…还剩下"
    },
    {
      "offset": 10845,
      "kind": "line",
      "limit": 11,
      "source": "どれくらいなんですか？",
      "target": "多少钱没还？"
    },
    {
      "offset": 10877,
      "kind": "line",
      "limit": 11,
      "source": "５００万円…なのだが。",
      "target": "五百万日元…"
    },
    {
      "offset": 10913,
      "kind": "line",
      "limit": 8,
      "source": "５００万円…!?",
      "target": "五百万…！？"
    },
    {
      "offset": 10935,
      "kind": "line",
      "limit": 11,
      "source": "実は先月、前倒しで",
      "target": "其实上个月，"
    },
    {
      "offset": 10959,
      "kind": "line",
      "limit": 11,
      "source": "返済をしないといけない",
      "target": "我忽然有了必须提前"
    },
    {
      "offset": 10987,
      "kind": "line",
      "limit": 11,
      "source": "事情ができてな…。",
      "target": "还款的理由…"
    },
    {
      "offset": 11013,
      "kind": "line",
      "limit": 5,
      "source": "事情が…？",
      "target": "理由…？"
    },
    {
      "offset": 11040,
      "kind": "line",
      "limit": 9,
      "source": "実は…その、借金を",
      "target": "其实…那位"
    },
    {
      "offset": 11064,
      "kind": "line",
      "limit": 9,
      "source": "肩代わりしてくれた",
      "target": "替我扛下债务的"
    },
    {
      "offset": 11088,
      "kind": "line",
      "limit": 9,
      "source": "資産家の方が…",
      "target": "富豪…"
    },
    {
      "offset": 11108,
      "kind": "line",
      "limit": 10,
      "source": "老衰で危篤状態だと",
      "target": "听说他因年老体衰"
    },
    {
      "offset": 11152,
      "kind": "line",
      "limit": 10,
      "source": "いう報せがきたのだ。",
      "target": "已经病危了。"
    },
    {
      "offset": 11207,
      "kind": "line",
      "limit": 7,
      "source": "危篤…ですか。",
      "target": "病危…是吗。"
    },
    {
      "offset": 11235,
      "kind": "line",
      "limit": 11,
      "source": "もちろん、もし亡くなる",
      "target": "当然，即便他真的"
    },
    {
      "offset": 11263,
      "kind": "line",
      "limit": 11,
      "source": "ことになっても借金は",
      "target": "去世，我也会继续"
    },
    {
      "offset": 11289,
      "kind": "line",
      "limit": 11,
      "source": "返済するつもりだが…",
      "target": "还清债务，可是…"
    },
    {
      "offset": 11326,
      "kind": "line",
      "limit": 11,
      "source": "大恩ある方なので、",
      "target": "他对我有大恩，"
    },
    {
      "offset": 11356,
      "kind": "line",
      "limit": 11,
      "source": "どうにか生存中に全額を",
      "target": "所以无论如何也想"
    },
    {
      "offset": 11384,
      "kind": "line",
      "limit": 11,
      "source": "支払いたかったんだ。",
      "target": "在他生前还清。"
    },
    {
      "offset": 11412,
      "kind": "line",
      "limit": 9,
      "source": "ああ、なるほど…。",
      "target": "啊，原来如此…"
    },
    {
      "offset": 11436,
      "kind": "line",
      "limit": 9,
      "source": "わかります。",
      "target": "我能理解。"
    },
    {
      "offset": 11456,
      "kind": "line",
      "limit": 10,
      "source": "実は数年前に、もう",
      "target": "其实几年前，"
    },
    {
      "offset": 11480,
      "kind": "line",
      "limit": 10,
      "source": "返済はいいと言われて",
      "target": "他已经说不用我"
    },
    {
      "offset": 11506,
      "kind": "line",
      "limit": 10,
      "source": "いたんだが…",
      "target": "继续偿还了…"
    },
    {
      "offset": 11524,
      "kind": "line",
      "limit": 8,
      "source": "こっちとしては、",
      "target": "可我这边，"
    },
    {
      "offset": 11546,
      "kind": "line",
      "limit": 8,
      "source": "そういうわけには",
      "target": "无论如何也"
    },
    {
      "offset": 11568,
      "kind": "line",
      "limit": 8,
      "source": "いかない。",
      "target": "不能接受。"
    },
    {
      "offset": 11584,
      "kind": "line",
      "limit": 11,
      "source": "これまで何十年もかけて",
      "target": "毕竟我已经花了几十年"
    },
    {
      "offset": 11612,
      "kind": "line",
      "limit": 11,
      "source": "払い続けたのだ。",
      "target": "不断偿还。"
    },
    {
      "offset": 11634,
      "kind": "line",
      "limit": 10,
      "source": "何としても、生きてる",
      "target": "无论如何，也得趁他"
    },
    {
      "offset": 11660,
      "kind": "line",
      "limit": 10,
      "source": "うちに…受け取って",
      "target": "还活着…让他收下"
    },
    {
      "offset": 11684,
      "kind": "line",
      "limit": 10,
      "source": "もらわないと、困る。",
      "target": "这笔钱才行。"
    },
    {
      "offset": 11710,
      "kind": "line",
      "limit": 11,
      "source": "…そうでないと、",
      "target": "…否则的话，"
    },
    {
      "offset": 11732,
      "kind": "line",
      "limit": 11,
      "source": "すべてが無意味になる。",
      "target": "一切就都没有意义了。"
    },
    {
      "offset": 11762,
      "kind": "line",
      "limit": 7,
      "source": "そうですよね。",
      "target": "是这样啊。"
    },
    {
      "offset": 11782,
      "kind": "line",
      "limit": 9,
      "source": "なるほど、それで…",
      "target": "原来是这样…"
    },
    {
      "offset": 11806,
      "kind": "line",
      "limit": 9,
      "source": "お金が必要だった",
      "target": "您才需要"
    },
    {
      "offset": 11828,
      "kind": "line",
      "limit": 9,
      "source": "わけですね。",
      "target": "这笔钱啊。"
    },
    {
      "offset": 11848,
      "kind": "line",
      "limit": 8,
      "source": "なにぶん、時間が",
      "target": "毕竟时间"
    },
    {
      "offset": 11870,
      "kind": "line",
      "limit": 8,
      "source": "なかったもので…",
      "target": "太紧了…"
    },
    {
      "offset": 11892,
      "kind": "line",
      "limit": 9,
      "source": "暁の貯金を使わせて",
      "target": "我本想借用晓的"
    },
    {
      "offset": 11916,
      "kind": "line",
      "limit": 9,
      "source": "もらおうと思って",
      "target": "存款，"
    },
    {
      "offset": 11938,
      "kind": "line",
      "limit": 9,
      "source": "いたんだ。",
      "target": "来解燃眉之急。"
    },
    {
      "offset": 11954,
      "kind": "line",
      "limit": 11,
      "source": "今さら事情も話せないが",
      "target": "事到如今也无法说明，"
    },
    {
      "offset": 11982,
      "kind": "line",
      "limit": 11,
      "source": "どうにか頼むつもりで",
      "target": "但我还是打算想办法"
    },
    {
      "offset": 12008,
      "kind": "line",
      "limit": 11,
      "source": "いた。",
      "target": "求他答应。"
    },
    {
      "offset": 12020,
      "kind": "line",
      "limit": 3,
      "source": "だが…",
      "target": "但…"
    },
    {
      "offset": 12034,
      "kind": "line",
      "limit": 11,
      "source": "義父の寅男さんが、先に",
      "target": "岳父寅男先生却先"
    },
    {
      "offset": 12062,
      "kind": "line",
      "limit": 11,
      "source": "通帳を盗んでいた…と。",
      "target": "偷走了存折…"
    },
    {
      "offset": 12092,
      "kind": "line",
      "limit": 6,
      "source": "…そうなる。",
      "target": "…就是这样。"
    },
    {
      "offset": 12110,
      "kind": "line",
      "limit": 11,
      "source": "それで、一刻も早く",
      "target": "我急着尽快"
    },
    {
      "offset": 12134,
      "kind": "line",
      "limit": 11,
      "source": "金が必要で、焦っていた",
      "target": "弄到这笔钱，慌乱之下"
    },
    {
      "offset": 12162,
      "kind": "line",
      "limit": 11,
      "source": "私は…",
      "target": "我…"
    },
    {
      "offset": 12174,
      "kind": "line",
      "limit": 11,
      "source": "ある誘いに乗り、犯罪に",
      "target": "受人引诱，参与犯罪",
      "runs": [
        "受人引诱，参与",
        "犯罪"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "ある誘いに乗り、"
        },
        {
          "colour": 2,
          "text": "犯罪に"
        }
      ]
    },
    {
      "offset": 12224,
      "kind": "line",
      "limit": 11,
      "source": "荷担してしまったのだ。",
      "target": "成了帮凶。"
    },
    {
      "offset": 12258,
      "kind": "line",
      "limit": 7,
      "source": "それが…先月の",
      "target": "那是…上个月",
      "runs": [
        "那是…",
        "上个月"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "それが…"
        },
        {
          "colour": 2,
          "text": "先月の"
        }
      ]
    },
    {
      "offset": 12291,
      "kind": "line",
      "limit": 7,
      "source": "ことだった。",
      "target": "的事。"
    },
    {
      "offset": 12311,
      "kind": "line",
      "limit": 8,
      "source": "えっ、犯罪…!?",
      "target": "什么，犯罪…！？"
    },
    {
      "offset": 12331,
      "kind": "line",
      "limit": 8,
      "source": "それは…どういう",
      "target": "那是…怎么"
    },
    {
      "offset": 12353,
      "kind": "line",
      "limit": 8,
      "source": "ことですか…？",
      "target": "一回事…？"
    },
    {
      "offset": 12382,
      "kind": "line",
      "limit": 6,
      "source": "よーうしッ！",
      "target": "好——嘞！"
    },
    {
      "offset": 12400,
      "kind": "line",
      "limit": 9,
      "source": "なるほど、これで",
      "target": "原来如此，这样"
    },
    {
      "offset": 12422,
      "kind": "line",
      "limit": 9,
      "source": "話はつながったぞ！",
      "target": "整件事就串起来了！"
    },
    {
      "offset": 12458,
      "kind": "line",
      "limit": 8,
      "source": "…ああ、癸生川。",
      "target": "…啊，癸生川。",
      "runs": [
        "…啊，",
        "癸生川。"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "…ああ、"
        },
        {
          "colour": 2,
          "text": "癸生川。"
        }
      ]
    },
    {
      "offset": 12505,
      "kind": "line",
      "limit": 8,
      "source": "…やっと来たか。",
      "target": "…你终于来了。"
    },
    {
      "offset": 12529,
      "kind": "line",
      "limit": 8,
      "source": "な、何事だ…!?",
      "target": "怎、怎么了…？"
    },
    {
      "offset": 12566,
      "kind": "line",
      "limit": 11,
      "source": "つまりそういうことだ！",
      "target": "也就是说，就是这样！"
    },
    {
      "offset": 12599,
      "kind": "line",
      "limit": 7,
      "source": "それが全ての",
      "target": "这就是一切的"
    },
    {
      "offset": 12634,
      "kind": "line",
      "limit": 7,
      "source": "元凶なのだよ！",
      "target": "罪魁祸首！"
    },
    {
      "offset": 12654,
      "kind": "line",
      "limit": 7,
      "source": "…さあ、暁君！",
      "target": "…来吧，晓！"
    },
    {
      "offset": 12694,
      "kind": "line",
      "limit": 7,
      "source": "出てきたまえ！",
      "target": "现身吧！"
    },
    {
      "offset": 12716,
      "kind": "line",
      "limit": 10,
      "source": "なにっ、暁だと…!?",
      "target": "什么，晓…！？"
    },
    {
      "offset": 12789,
      "kind": "name",
      "limit": 0,
      "source": "(暁)",
      "target": "(晓)"
    },
    {
      "offset": 12810,
      "kind": "name",
      "limit": 0,
      "source": "(忠雄)",
      "target": "(忠雄)"
    },
    {
      "offset": 12843,
      "kind": "line",
      "limit": 9,
      "source": "１９９６年６月某日",
      "target": "１９９６年６月某日"
    },
    {
      "offset": 12867,
      "kind": "line",
      "limit": 9,
      "source": "天気、雨",
      "target": "天气：雨"
    },
    {
      "offset": 12881,
      "kind": "line",
      "limit": 9,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 12889,
      "kind": "line",
      "limit": 9,
      "source": "クレフ製作所",
      "target": "克雷夫制作所"
    },
    {
      "offset": 12950,
      "kind": "line",
      "limit": 10,
      "source": "…ということらしい！",
      "target": "…事情就是这样！"
    },
    {
      "offset": 12976,
      "kind": "line",
      "limit": 8,
      "source": "…今の父親の話、",
      "target": "…你父亲刚才的话"
    },
    {
      "offset": 12998,
      "kind": "line",
      "limit": 8,
      "source": "聞こえたか？",
      "target": "听到了吗？"
    },
    {
      "offset": 13018,
      "kind": "line",
      "limit": 8,
      "source": "あ、ああああ…。",
      "target": "啊、啊啊啊…"
    },
    {
      "offset": 13040,
      "kind": "line",
      "limit": 8,
      "source": "…そ、そんな…。",
      "target": "…怎、怎么会…"
    },
    {
      "offset": 13062,
      "kind": "line",
      "limit": 10,
      "source": "まさか、父がそんな…",
      "target": "父亲竟然一直…"
    },
    {
      "offset": 13088,
      "kind": "line",
      "limit": 11,
      "source": "ずっと借金返済のために",
      "target": "为了偿还债务"
    },
    {
      "offset": 13116,
      "kind": "line",
      "limit": 11,
      "source": "働いていたなんて…。",
      "target": "拼命工作…"
    },
    {
      "offset": 13142,
      "kind": "line",
      "limit": 10,
      "source": "それに、母は元々",
      "target": "而且，母亲原本"
    },
    {
      "offset": 13164,
      "kind": "line",
      "limit": 10,
      "source": "結婚詐欺師だった…？",
      "target": "是婚姻诈骗犯…？"
    },
    {
      "offset": 13190,
      "kind": "line",
      "limit": 4,
      "source": "なのに…",
      "target": "可是…"
    },
    {
      "offset": 13204,
      "kind": "line",
      "limit": 9,
      "source": "あ、ああ…あああ…",
      "target": "啊、啊…啊啊…"
    },
    {
      "offset": 13233,
      "kind": "line",
      "limit": 11,
      "source": "父の話を聞いているうち",
      "target": "听着父亲的诉说，"
    },
    {
      "offset": 13261,
      "kind": "line",
      "limit": 11,
      "source": "自然と涙が出ていた。",
      "target": "泪水自然涌了出来。"
    },
    {
      "offset": 13287,
      "kind": "line",
      "limit": 10,
      "source": "どれだけの苦労の末に",
      "target": "我终于明白，父母历经"
    },
    {
      "offset": 13313,
      "kind": "line",
      "limit": 10,
      "source": "自分の命があるのかを",
      "target": "多少苦难，才换来"
    },
    {
      "offset": 13339,
      "kind": "line",
      "limit": 10,
      "source": "知り、そして…",
      "target": "我的生命，而且…"
    },
    {
      "offset": 13359,
      "kind": "line",
      "limit": 11,
      "source": "どれだけの深い愛情の",
      "target": "也明白自己承载了"
    },
    {
      "offset": 13385,
      "kind": "line",
      "limit": 11,
      "source": "末に、今自分がこうして",
      "target": "多么深厚的爱，"
    },
    {
      "offset": 13413,
      "kind": "line",
      "limit": 11,
      "source": "ここに生きているのか…",
      "target": "才得以活到今天…"
    },
    {
      "offset": 13441,
      "kind": "line",
      "limit": 9,
      "source": "それを知り、涙が",
      "target": "想到这里，泪水"
    },
    {
      "offset": 13463,
      "kind": "line",
      "limit": 9,
      "source": "止まらなかった…。",
      "target": "怎么也止不住…"
    },
    {
      "offset": 13487,
      "kind": "line",
      "limit": 9,
      "source": "誤解していたことを",
      "target": "我曾误解父亲，"
    },
    {
      "offset": 13511,
      "kind": "line",
      "limit": 9,
      "source": "心から恥じた。",
      "target": "对此羞愧不已。"
    },
    {
      "offset": 13533,
      "kind": "line",
      "limit": 8,
      "source": "…まあ、つまり",
      "target": "…总之，"
    },
    {
      "offset": 13553,
      "kind": "line",
      "limit": 8,
      "source": "そういうことだ。",
      "target": "就是这么回事。"
    },
    {
      "offset": 13575,
      "kind": "line",
      "limit": 11,
      "source": "説明の手間が省けたな。",
      "target": "倒省了说明的工夫。"
    },
    {
      "offset": 13605,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "…………"
    },
    {
      "offset": 13624,
      "kind": "line",
      "limit": 11,
      "source": "探偵に連れられてやって",
      "target": "我被侦探带到的地方，"
    },
    {
      "offset": 13652,
      "kind": "line",
      "limit": 11,
      "source": "来たのは、父が勤めて",
      "target": "正是父亲工作的"
    },
    {
      "offset": 13678,
      "kind": "line",
      "limit": 11,
      "source": "いたという工場だった。",
      "target": "那间工厂。"
    },
    {
      "offset": 13706,
      "kind": "line",
      "limit": 11,
      "source": "そこで偶然、父と白鷺洲",
      "target": "在那里，我们恰好碰见"
    },
    {
      "offset": 13751,
      "kind": "line",
      "limit": 11,
      "source": "さんが話している所に",
      "target": "父亲在和白鹭洲先生"
    },
    {
      "offset": 13777,
      "kind": "line",
      "limit": 11,
      "source": "遭遇し…",
      "target": "交谈…"
    },
    {
      "offset": 13791,
      "kind": "line",
      "limit": 11,
      "source": "私たちは、その話を",
      "target": "于是我们藏起来，"
    },
    {
      "offset": 13815,
      "kind": "line",
      "limit": 11,
      "source": "隠れて聞いていたのだ。",
      "target": "偷听了他们的对话。"
    },
    {
      "offset": 13846,
      "kind": "line",
      "limit": 10,
      "source": "そして一通りの話が",
      "target": "等他们谈完之后，"
    },
    {
      "offset": 13870,
      "kind": "line",
      "limit": 10,
      "source": "終わると、探偵は突然",
      "target": "侦探突然"
    },
    {
      "offset": 13896,
      "kind": "line",
      "limit": 10,
      "source": "大きな声を出した。",
      "target": "大声喊道。"
    },
    {
      "offset": 13922,
      "kind": "line",
      "limit": 6,
      "source": "よーうしッ！",
      "target": "好——嘞！"
    },
    {
      "offset": 13940,
      "kind": "line",
      "limit": 9,
      "source": "なるほど、これで",
      "target": "原来如此，这样"
    },
    {
      "offset": 13962,
      "kind": "line",
      "limit": 9,
      "source": "話はつながったぞ！",
      "target": "整件事就串起来了！"
    },
    {
      "offset": 14001,
      "kind": "line",
      "limit": 8,
      "source": "ああ、癸生川。",
      "target": "啊，癸生川。"
    },
    {
      "offset": 14043,
      "kind": "line",
      "limit": 8,
      "source": "…やっと来たか。",
      "target": "…你终于来了。"
    },
    {
      "offset": 14067,
      "kind": "line",
      "limit": 8,
      "source": "な、何事だ…!?",
      "target": "怎、怎么了…？"
    },
    {
      "offset": 14089,
      "kind": "line",
      "limit": 11,
      "source": "突然飛び出した探偵は、",
      "target": "侦探突然冲出来，"
    },
    {
      "offset": 14117,
      "kind": "line",
      "limit": 11,
      "source": "２人の元に向かう。",
      "target": "朝两人走去。"
    },
    {
      "offset": 14143,
      "kind": "line",
      "limit": 11,
      "source": "つまりそういうことだ！",
      "target": "也就是说，就是这样！"
    },
    {
      "offset": 14176,
      "kind": "line",
      "limit": 7,
      "source": "それが全ての",
      "target": "这就是一切的"
    },
    {
      "offset": 14211,
      "kind": "line",
      "limit": 7,
      "source": "元凶なのだよ！",
      "target": "罪魁祸首！"
    },
    {
      "offset": 14231,
      "kind": "line",
      "limit": 7,
      "source": "…さあ、暁君！",
      "target": "…来吧，晓！"
    },
    {
      "offset": 14271,
      "kind": "line",
      "limit": 7,
      "source": "出てきたまえ！",
      "target": "现身吧！"
    },
    {
      "offset": 14293,
      "kind": "line",
      "limit": 10,
      "source": "なにっ、暁だと…!?",
      "target": "什么，晓…！？"
    },
    {
      "offset": 14342,
      "kind": "line",
      "limit": 8,
      "source": "…呼ばれている。",
      "target": "…他在叫我。"
    },
    {
      "offset": 14364,
      "kind": "line",
      "limit": 11,
      "source": "私は涙をぬぐい、３人の",
      "target": "我擦干眼泪，"
    },
    {
      "offset": 14392,
      "kind": "line",
      "limit": 11,
      "source": "前に姿を現した。",
      "target": "走到了三人面前。"
    },
    {
      "offset": 14477,
      "kind": "line",
      "limit": 6,
      "source": "暁、お前…。",
      "target": "晓，你…"
    },
    {
      "offset": 14503,
      "kind": "line",
      "limit": 10,
      "source": "父さん、事情は",
      "target": "爸爸，事情"
    },
    {
      "offset": 14523,
      "kind": "line",
      "limit": 10,
      "source": "聞かせてもらったよ。",
      "target": "我都听到了。"
    },
    {
      "offset": 14551,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 14579,
      "kind": "line",
      "limit": 10,
      "source": "この際、全てハッキリ",
      "target": "趁这个机会，还是把"
    },
    {
      "offset": 14605,
      "kind": "line",
      "limit": 10,
      "source": "させた方がいい！",
      "target": "一切都说清楚吧！"
    },
    {
      "offset": 14627,
      "kind": "line",
      "limit": 11,
      "source": "…今の話を総合すれば",
      "target": "…综合刚才的事，"
    },
    {
      "offset": 14653,
      "kind": "line",
      "limit": 11,
      "source": "もう見えてくるだろう。",
      "target": "真相已经显而易见了。"
    },
    {
      "offset": 14694,
      "kind": "line",
      "limit": 4,
      "source": "………？",
      "target": "………？"
    },
    {
      "offset": 14710,
      "kind": "line",
      "limit": 9,
      "source": "…癸生川。",
      "target": "…癸生川。"
    },
    {
      "offset": 14748,
      "kind": "line",
      "limit": 9,
      "source": "もう少し補足説明が",
      "target": "是不是还需要"
    },
    {
      "offset": 14772,
      "kind": "line",
      "limit": 9,
      "source": "必要じゃないかい？",
      "target": "再补充说明一下？"
    },
    {
      "offset": 14808,
      "kind": "line",
      "limit": 11,
      "source": "じゃあ確認していこう。",
      "target": "那就逐一确认吧。"
    }
  ]
}
