{
  "script": "c0_01",
  "units": [
    {"offset": 55, "target": "回复来信…吗？"},
    {"offset": 103, "target": "嗯，对对。"},
    {"offset": 125, "target": "玩过这款应用的"},
    {"offset": 151, "target": "玩家寄来了问题…"},
    {"offset": 175, "target": "所以想请伊纲"},
    {"offset": 201, "target": "回答一下。"},
    {"offset": 229, "target": "差不多就是发布在"},
    {"offset": 257, "target": "网站上的采访"},
    {"offset": 283, "target": "吧。"},
    {"offset": 299, "target": "哟，大红人！"},
    {"offset": 323, "target": "我为什么非得"},
    {"offset": 347, "target": "做到这种地步"},
    {"offset": 371, "target": "啊。"},
    {"offset": 396, "target": "明明是生王先生"},
    {"offset": 424, "target": "擅自做的游戏。"},
    {"offset": 461, "target": "好啦，等会我念问题，"},
    {"offset": 485, "target": "你口头回答"},
    {"offset": 513, "target": "就行了。"},
    {"offset": 541, "target": "不过得让我"},
    {"offset": 563, "target": "录下来。"},
    {"offset": 581, "target": "这种踏实的宣传"},
    {"offset": 607, "target": "也能让侦探生意"},
    {"offset": 631, "target": "兴隆起来。"},
    {"offset": 653, "target": "…大概。"},
    {"offset": 671, "target": "真是的…"},
    {"offset": 689, "target": "好了，本周也让我们"},
    {"offset": 715, "target": "开始吧！"},
    {"offset": 749, "target": "各位期待已久！"},
    {"offset": 773, "target": "直击！伊纲小姐的"},
    {"offset": 795, "target": "四问四答环节！！"},
    {"offset": 821, "target": "好！鼓掌！！"},
    {"offset": 845, "target": "……"},
    {"offset": 871, "target": "读来信"},
    {"offset": 885, "target": "中断"},
    {"offset": 906, "target": "先问哪个问题"},
    {"offset": 930, "target": "好呢…"},
    {"offset": 976, "target": "关于事务所的经营"},
    {"offset": 1009, "target": "迄今的案件…"},
    {"offset": 1040, "target": "搬家怎么样了？"},
    {"offset": 1073, "target": "伊纲妹妹ＬＯＶＥ！"},
    {"offset": 1102, "target": "这是龙太先生的", "runs": ["这是", "龙太先生的"]},
    {"offset": 1141, "target": "邮件！"},
    {"offset": 1165, "target": "嗯…"},
    {"offset": 1181, "target": "你好，我一直都在"},
    {"offset": 1205, "target": "愉快地玩这款"},
    {"offset": 1233, "target": "应用。"},
    {"offset": 1256, "target": "哎呀，真是"},
    {"offset": 1276, "target": "非常感谢！"},
    {"offset": 1306, "target": "…你一个人"},
    {"offset": 1328, "target": "倒挺开心的。"},
    {"offset": 1354, "target": "我想问伊纲小姐"},
    {"offset": 1380, "target": "一个问题。"},
    {"offset": 1405, "target": "听说癸生川侦探"},
    {"offset": 1431, "target": "事务所没什么"},
    {"offset": 1459, "target": "委托，"},
    {"offset": 1478, "target": "伊纲小姐你们"},
    {"offset": 1498, "target": "究竟靠什么"},
    {"offset": 1520, "target": "维持生计？"},
    {"offset": 1545, "target": "…他这么问哦？"},
    {"offset": 1573, "target": "咦？为什么"},
    {"offset": 1597, "target": "要我回答？"},
    {"offset": 1625, "target": "听说你们"},
    {"offset": 1643, "target": "没什么委托。"},
    {"offset": 1669, "target": "要你多管。"},
    {"offset": 1695, "target": "我记得这家事务所"},
    {"offset": 1723, "target": "有位老板", "runs": ["有位", "老板"]},
    {"offset": 1762, "target": "吧？"},
    {"offset": 1786, "target": "嗯，是有。"},
    {"offset": 1822, "target": "我也没见过本人，"},
    {"offset": 1848, "target": "不太清楚详情"},
    {"offset": 1874, "target": "…"},
    {"offset": 1905, "target": "一个叫御堂丸将云的人"},
    {"offset": 1959, "target": "似乎是这间事务所的"},
    {"offset": 1985, "target": "老板…"},
    {"offset": 2011, "target": "无论有没有委托，"},
    {"offset": 2039, "target": "房租和我们的工资"},
    {"offset": 2065, "target": "都由他支付。"},
    {"offset": 2091, "target": "他好像与老师"},
    {"offset": 2119, "target": "有什么关系…"},
    {"offset": 2149, "target": "神秘的老板吗。"},
    {"offset": 2175, "target": "真令人在意。"},
    {"offset": 2205, "target": "演得太假了。"},
    {"offset": 2233, "target": "也就是说，就算"},
    {"offset": 2259, "target": "不工作，也不用"},
    {"offset": 2285, "target": "担心吃饭？"},
    {"offset": 2317, "target": "嗯，所以老师有时"},
    {"offset": 2345, "target": "一整天都在"},
    {"offset": 2373, "target": "睡觉…"},
    {"offset": 2393, "target": "但我尽量只用"},
    {"offset": 2421, "target": "自己工作赚来的"},
    {"offset": 2443, "target": "钱。"},
    {"offset": 2471, "target": "哦，真了不起。"},
    {"offset": 2509, "target": "不过，他给我们的"},
    {"offset": 2531, "target": "只是最低工资，"},
    {"offset": 2557, "target": "所以…"},
    {"offset": 2579, "target": "办公用品和耗材"},
    {"offset": 2603, "target": "都得由我们自己"},
    {"offset": 2631, "target": "准备。"},
    {"offset": 2665, "target": "你看，现在的犯罪"},
    {"offset": 2689, "target": "手法越来越"},
    {"offset": 2713, "target": "高明…"},
    {"offset": 2733, "target": "没有新工具和设备，"},
    {"offset": 2757, "target": "有时根本无法"},
    {"offset": 2779, "target": "应付。"},
    {"offset": 2807, "target": "所以我想备齐"},
    {"offset": 2831, "target": "最新设备…"},
    {"offset": 2861, "target": "哦，原来如此。"},
    {"offset": 2885, "target": "也需要应对"},
    {"offset": 2911, "target": "高科技犯罪啊。"},
    {"offset": 2937, "target": "就是这样。"},
    {"offset": 2961, "target": "最新型的探测器"},
    {"offset": 2985, "target": "也很想要吧。"},
    {"offset": 3013, "target": "可凭现在的收入，"},
    {"offset": 3037, "target": "完全负担不起"},
    {"offset": 3063, "target": "这些。"},
    {"offset": 3089, "target": "这种东西毕竟"},
    {"offset": 3111, "target": "是特殊设备，"},
    {"offset": 3135, "target": "很贵啊…"},
    {"offset": 3163, "target": "就是啊。"},
    {"offset": 3183, "target": "要备齐现在想要的"},
    {"offset": 3207, "target": "全部设备，大约需要"},
    {"offset": 3235, "target": "３００万日元。"},
    {"offset": 3263, "target": "哇啊！"},
    {"offset": 3279, "target": "那、那还真"},
    {"offset": 3299, "target": "不容易啊…"},
    {"offset": 3333, "target": "所以请给我们委托。"},
    {"offset": 3361, "target": "哈哈，结果还是"},
    {"offset": 3387, "target": "落到这里啊。"},
    {"offset": 3409, "target": "各位若有烦恼，"},
    {"offset": 3437, "target": "请来鞠滨台的"},
    {"offset": 3508, "target": "癸生川侦探事务所！"},
    {"offset": 3530, "target": "只咨询也可以！"},
    {"offset": 3558, "target": "欢迎随时光临！"},
    {"offset": 3584, "target": "好，非常感谢"},
    {"offset": 3612, "target": "你的回答。"},
    {"offset": 3646, "target": "嗯，这一封"},
    {"offset": 3668, "target": "来自匿名人士。"},
    {"offset": 3707, "target": "生王先生，你好。"},
    {"offset": 3742, "target": "…你好！"},
    {"offset": 3770, "target": "你就是想演"},
    {"offset": 3796, "target": "这一出吧？"},
    {"offset": 3818, "target": "难道说。"},
    {"offset": 3840, "target": "至今已有许多案件"},
    {"offset": 3866, "target": "被做成了应用…"},
    {"offset": 3897, "target": "尚未被做成应用的"},
    {"offset": 3925, "target": "案件还有多少"},
    {"offset": 3949, "target": "呢？"},
    {"offset": 3976, "target": "另外，最令你"},
    {"offset": 4002, "target": "印象深刻的是"},
    {"offset": 4028, "target": "哪起案件？"},
    {"offset": 4049, "target": "请务必问问"},
    {"offset": 4071, "target": "伊纲小姐。"},
    {"offset": 4098, "target": "…大概就是"},
    {"offset": 4122, "target": "这样的问题。"},
    {"offset": 4142, "target": "不，这种事情"},
    {"offset": 4164, "target": "怎么可能"},
    {"offset": 4190, "target": "说得出口。"},
    {"offset": 4208, "target": "被做成应用的案件"},
    {"offset": 4234, "target": "基本都只有我"},
    {"offset": 4260, "target": "参与的那些…"},
    {"offset": 4282, "target": "伊纲平时还做过"},
    {"offset": 4306, "target": "许多其他调查"},
    {"offset": 4332, "target": "吧？"},
    {"offset": 4356, "target": "当然做过。"},
    {"offset": 4397, "target": "林居先生也经常"},
    {"offset": 4427, "target": "来找我们商量"},
    {"offset": 4453, "target": "事情…"},
    {"offset": 4473, "target": "也有些案件不能"},
    {"offset": 4501, "target": "在这里说…"},
    {"offset": 4531, "target": "不能说的案件！"},
    {"offset": 4569, "target": "就是不能说。"},
    {"offset": 4593, "target": "啧…"},
    {"offset": 4607, "target": "那最令你"},
    {"offset": 4631, "target": "印象深刻的案件呢？"},
    {"offset": 4655, "target": "每一件都印象深刻。"},
    {"offset": 4683, "target": "没有哪起案件"},
    {"offset": 4705, "target": "是微不足道的。"},
    {"offset": 4733, "target": "不过，你看，"},
    {"offset": 4754, "target": "非要选的话。"},
    {"offset": 4794, "target": "唔…"},
    {"offset": 4810, "target": "那果然还是…"},
    {"offset": 4847, "target": "五年前让生王先生"},
    {"offset": 4884, "target": "吃尽苦头的"},
    {"offset": 4929, "target": "永劫会事件吧。"},
    {"offset": 4971, "target": "唔，那件事…"},
    {"offset": 5007, "target": "听说当时生王先生"},
    {"offset": 5053, "target": "遭遇了非常"},
    {"offset": 5079, "target": "不得了的事呢。"},
    {"offset": 5107, "target": "够了，不说这个！"},
    {"offset": 5133, "target": "结束结束，"},
    {"offset": 5153, "target": "这个话题到此结束！！"},
    {"offset": 5189, "target": "嗯…"},
    {"offset": 5205, "target": "这一封来自海獭先生", "runs": ["这一封来自", "海獭先生"]},
    {"offset": 5242, "target": "来信。"},
    {"offset": 5264, "target": "伊纲小姐说过"},
    {"offset": 5290, "target": "事务所采光和通风"},
    {"offset": 5318, "target": "都很差…"},
    {"offset": 5347, "target": "还不能搬去"},
    {"offset": 5373, "target": "漂亮的房间吗？"},
    {"offset": 5402, "target": "这算什么，"},
    {"offset": 5424, "target": "讽刺我吗？"},
    {"offset": 5444, "target": "就是讽刺你！"},
    {"offset": 5466, "target": "好啦好啦。"},
    {"offset": 5482, "target": "你以前不是说过"},
    {"offset": 5506, "target": "类似的话"},
    {"offset": 5530, "target": "吗？"},
    {"offset": 5550, "target": "不是不想搬，"},
    {"offset": 5578, "target": "是搬不了。"},
    {"offset": 5604, "target": "哦，出现新说法了！？"},
    {"offset": 5630, "target": "这是怎么一回"},
    {"offset": 5654, "target": "事呢？"}
  ]
}
