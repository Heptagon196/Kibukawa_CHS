{
  "script": "c4_00",
  "units": [
    {"offset": 14841, "target": "交谈"},
    {"offset": 14849, "target": "中断"},
    {"offset": 14864, "target": "案件概况"},
    {"offset": 14917, "target": "…首先！"},
    {"offset": 14931, "target": "克雷夫制作所社长"},
    {"offset": 14966, "target": "尼子启三的身份……"},
    {"offset": 15013, "target": "传说中的“极恶骗”"},
    {"offset": 15057, "target": "正是他本人！"},
    {"offset": 15081, "target": "……连我也没想到"},
    {"offset": 15107, "target": "社长竟然会是"},
    {"offset": 15131, "target": "那样的人物……"},
    {"offset": 15161, "target": "忠雄先生得知此事"},
    {"offset": 15189, "target": "是大约３个月前", "runs": ["是", "大约３个月前"]},
    {"offset": 15230, "target": "对吧。"},
    {"offset": 15252, "target": "……嗯。"},
    {"offset": 15266, "target": "这家工厂在秘密制枪", "runs": ["这家工厂在", "秘密制枪"]},
    {"offset": 15307, "target": "忠雄偶然"},
    {"offset": 15335, "target": "得知此事……"},
    {"offset": 15363, "target": "认为这是犯罪……"},
    {"offset": 15389, "target": "便将证据文件", "runs": ["便将", "证据文件"]},
    {"offset": 15428, "target": "偷了出来。"},
    {"offset": 15452, "target": "是想交给警方"},
    {"offset": 15476, "target": "对吧。"},
    {"offset": 15496, "target": "在忠雄先生家中"},
    {"offset": 15520, "target": "找到了那些文件。"},
    {"offset": 15548, "target": "……我只是出于"},
    {"offset": 15568, "target": "一点正义感。"},
    {"offset": 15598, "target": "不，那样做"},
    {"offset": 15620, "target": "是对的！"},
    {"offset": 15644, "target": "……但对手"},
    {"offset": 15664, "target": "惹错了对手。"},
    {"offset": 15690, "target": "……毕竟，他在地下世界"},
    {"offset": 15718, "target": "人脉广得惊人。"},
    {"offset": 15742, "target": "四处都布下人手，"},
    {"offset": 15770, "target": "忠雄先生逃脱不了，"},
    {"offset": 15798, "target": "渐渐被逼入绝境。"},
    {"offset": 15826, "target": "…………"},
    {"offset": 15844, "target": "于是他曾去过一次"},
    {"offset": 15874, "target": "家人居住的家。"},
    {"offset": 15906, "target": "……就是晓见过他那次。"},
    {"offset": 15956, "target": "啊，是那次……！"},
    {"offset": 15978, "target": "……可父亲既然"},
    {"offset": 16002, "target": "住在别处……"},
    {"offset": 16026, "target": "那个叫尼子的男人"},
    {"offset": 16072, "target": "怎么会知道"},
    {"offset": 16098, "target": "我们家的地址？"},
    {"offset": 16122, "target": "……难道他连这里"},
    {"offset": 16148, "target": "都调查过？"},
    {"offset": 16168, "target": "不，并非如此。"},
    {"offset": 16194, "target": "其实在那之前", "runs": ["其实", "在那之前"]},
    {"offset": 16247, "target": "尼子就已经知道了。"},
    {"offset": 16279, "target": "……纯属偶然。"},
    {"offset": 16301, "target": "咦，为什么……！？"},
    {"offset": 16327, "target": "…………"},
    {"offset": 16353, "target": "这件事现在先"},
    {"offset": 16381, "target": "放到一边！"},
    {"offset": 16403, "target": "后来，忠雄先生"},
    {"offset": 16431, "target": "认为再也逃不掉"},
    {"offset": 16459, "target": "的时候……"},
    {"offset": 16473, "target": "发生了"},
    {"offset": 16493, "target": "一起事件。"},
    {"offset": 16515, "target": "对，那正是……"},
    {"offset": 16539, "target": "……尼子启三被暗杀。", "runs": ["……尼子启三被", "暗杀。"]},
    {"offset": 16617, "target": "啊……！"},
    {"offset": 16631, "target": "被某个人灭口……"},
    {"offset": 16655, "target": "是那件事？"},
    {"offset": 16685, "target": "是的。"},
    {"offset": 16699, "target": "这让忠雄先生"},
    {"offset": 16727, "target": "侥幸逃过一劫。"},
    {"offset": 16751, "target": "……顺带一提，"},
    {"offset": 16775, "target": "交给警方的证据不足，"},
    {"offset": 16803, "target": "最后不予受理。"},
    {"offset": 16831, "target": "……正是如此。"},
    {"offset": 16855, "target": "为、为什么……？"},
    {"offset": 16889, "target": "工厂制造的"},
    {"offset": 16917, "target": "只是零件，并非枪", "runs": ["只是零件，", "并非枪"]},
    {"offset": 16964, "target": "而已！"},
    {"offset": 16984, "target": "…咦？"},
    {"offset": 16998, "target": "这些零件只有"},
    {"offset": 17022, "target": "组装成完整枪械后"},
    {"offset": 17048, "target": "才能称为枪。"},
    {"offset": 17068, "target": "其实……每件零件"},
    {"offset": 17092, "target": "若是分散的状态……"},
    {"offset": 17120, "target": "就只是普通的金属件，", "runs": ["就只是普通的", "金属件，"]},
    {"offset": 17159, "target": "因此进出口也"},
    {"offset": 17187, "target": "十分容易。"},
    {"offset": 17215, "target": "啊……"},
    {"offset": 17241, "target": "假设需要１００个"},
    {"offset": 17267, "target": "枪械零件……"},
    {"offset": 17285, "target": "就让１００家工厂"},
    {"offset": 17307, "target": "分别制造不同零件"},
    {"offset": 17333, "target": "就是这么回事。"},
    {"offset": 17355, "target": "只查封一家工厂……"},
    {"offset": 17381, "target": "证据依然不足。"},
    {"offset": 17411, "target": "怎么会……"},
    {"offset": 17427, "target": "那父亲的努力……！？"},
    {"offset": 17467, "target": "很遗憾，这只让他"},
    {"offset": 17515, "target": "成了尼子的敌人。"},
    {"offset": 17541, "target": "就是这么回事。"},
    {"offset": 17569, "target": "…………"},
    {"offset": 17597, "target": "而正因为在这里"},
    {"offset": 17621, "target": "与尼子为敌……"},
    {"offset": 17649, "target": "后来，一场大祸", "runs": ["后来，一场", "大祸"]},
    {"offset": 17701, "target": "便降临了。"},
    {"offset": 17731, "target": "…！？"},
    {"offset": 17759, "target": "那场大祸是……？"},
    {"offset": 17811, "target": "其实……尼子有"},
    {"offset": 17853, "target": "两个女儿。", "runs": ["两个", "女儿。"]},
    {"offset": 17890, "target": "并非亲生。"},
    {"offset": 17917, "target": "都是他收养的"},
    {"offset": 17947, "target": "弃婴。"},
    {"offset": 17969, "target": "……他把弃婴"},
    {"offset": 17993, "target": "养大了吗？"},
    {"offset": 18015, "target": "这么说听起来"},
    {"offset": 18041, "target": "像件好事……"},
    {"offset": 18071, "target": "可他培养女儿，"},
    {"offset": 18099, "target": "是为了在各种犯罪中"},
    {"offset": 18125, "target": "利用她们。"},
    {"offset": 18147, "target": "太过分了……"},
    {"offset": 18167, "target": "两个女儿各用不同姓名", "runs": ["两个女儿各用", "不同姓名"]},
    {"offset": 18210, "target": "过着不同生活，"},
    {"offset": 18242, "target": "环境也不同。"},
    {"offset": 18270, "target": "……也就是说，尼子"},
    {"offset": 18335, "target": "一直以别人的女儿", "runs": ["一直以", "别人的女儿"]},
    {"offset": 18374, "target": "身份养育她们。"},
    {"offset": 18412, "target": "……他使用着"},
    {"offset": 18438, "target": "许多不同姓名。"},
    {"offset": 18460, "target": "做到这点很容易。"},
    {"offset": 18500, "target": "过着双重、三重生活。"},
    {"offset": 18528, "target": "有时是骗子，"},
    {"offset": 18554, "target": "有时是小工厂的社长。"},
    {"offset": 18582, "target": "而且……"},
    {"offset": 18596, "target": "有时又是个父亲，"},
    {"offset": 18622, "target": "浪迹全国的漂泊者", "runs": ["浪迹全国的", "漂泊者"]},
    {"offset": 18657, "target": "……"},
    {"offset": 18681, "target": "漂泊者…？"},
    {"offset": 18699, "target": "因为他不能待在家。"},
    {"offset": 18725, "target": "这样说"},
    {"offset": 18749, "target": "对他更方便。"},
    {"offset": 18779, "target": "那、那个…"},
    {"offset": 18802, "target": "这、这样的人……"},
    {"offset": 18828, "target": "我倒是想到"},
    {"offset": 18852, "target": "一个……"},
    {"offset": 18878, "target": "…答对了。"},
    {"offset": 18896, "target": "难、难道……"},
    {"offset": 18916, "target": "怎么会……"},
    {"offset": 18932, "target": "……父亲！"},
    {"offset": 18950, "target": "…………"},
    {"offset": 18968, "target": "这样一来，"},
    {"offset": 18986, "target": "一切都连起来了。"},
    {"offset": 19019, "target": "尼子启三使用的"},
    {"offset": 19064, "target": "另一个姓名就是……"},
    {"offset": 19090, "target": "水岛寅男。"},
    {"offset": 19150, "target": "…………"},
    {"offset": 19166, "target": "祖、祖父……！？"},
    {"offset": 19186, "target": "那、那么……母亲……", "runs": ["那、那么……", "母亲……"]},
    {"offset": 19227, "target": "母亲是骗子一事"},
    {"offset": 19255, "target": "难道也是……"},
    {"offset": 19286, "target": "尼子的“教诲”"},
    {"offset": 19343, "target": "恐怕仍留在她身上。"},
    {"offset": 19367, "target": "怎么会，可是……"},
    {"offset": 19393, "target": "看来，"},
    {"offset": 19421, "target": "的确是这样。"},
    {"offset": 19443, "target": "我当成父亲"},
    {"offset": 19469, "target": "一直追寻的人……"},
    {"offset": 19487, "target": "居然就是我曾工作过"},
    {"offset": 19515, "target": "的工厂社长。"},
    {"offset": 19539, "target": "即便他变了装，"},
    {"offset": 19567, "target": "完全没能察觉的自己"},
    {"offset": 19595, "target": "真让我懊悔。"},
    {"offset": 19627, "target": "他可是传说中的骗子！"},
    {"offset": 19651, "target": "怎么可能轻易"},
    {"offset": 19679, "target": "被人识破！"},
    {"offset": 19713, "target": "……你不必"},
    {"offset": 19733, "target": "为此羞愧。"},
    {"offset": 19753, "target": "这样啊……"},
    {"offset": 19771, "target": "母亲知道这件事……？"},
    {"offset": 19799, "target": "恐怕她只是"},
    {"offset": 19845, "target": "被迫遵照尼子"},
    {"offset": 19873, "target": "的命令行事……"},
    {"offset": 19901, "target": "……父亲是那样有名的"},
    {"offset": 19927, "target": "骗子，她恐怕也没"}
  ]
}
