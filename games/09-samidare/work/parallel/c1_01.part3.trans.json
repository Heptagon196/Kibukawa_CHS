{
  "script": "c1_01",
  "units": [
    {"offset": 11260, "target": "能再详细告诉我一些"},
    {"offset": 11288, "target": "吗？"},
    {"offset": 11312, "target": "……？"},
    {"offset": 11324, "target": "…啊，好的。"},
    {"offset": 11348, "target": "没问题…"},
    {"offset": 11389, "target": "我打算拿这笔钱"},
    {"offset": 11417, "target": "帮助她的家。"},
    {"offset": 11473, "target": "我很尊敬"},
    {"offset": 11495, "target": "我的母亲。"},
    {"offset": 11528, "target": "她几乎独自一人"},
    {"offset": 11554, "target": "将我养大，还供我"},
    {"offset": 11578, "target": "读完了高中。"},
    {"offset": 11604, "target": "不，母亲还得供养那个"},
    {"offset": 11632, "target": "伸手要钱的父亲…"},
    {"offset": 11658, "target": "反而只有我们母子"},
    {"offset": 11684, "target": "相依为命还会"},
    {"offset": 11710, "target": "好过一些。"},
    {"offset": 11734, "target": "但从几年前起，"},
    {"offset": 11756, "target": "她的身体逐渐虚弱…"},
    {"offset": 11780, "target": "现在已经不再外出"},
    {"offset": 11804, "target": "工作，只在家料理"},
    {"offset": 11830, "target": "家务。"},
    {"offset": 11852, "target": "生活费只能靠"},
    {"offset": 11870, "target": "我的收入勉强维持…"},
    {"offset": 11900, "target": "…原来如此。"},
    {"offset": 11918, "target": "你们的生活原来"},
    {"offset": 11942, "target": "如此艰难…"},
    {"offset": 11966, "target": "可即便如此，她也"},
    {"offset": 11992, "target": "从不说您父亲的"},
    {"offset": 12016, "target": "坏话…"},
    {"offset": 12040, "target": "您母亲真是一位"},
    {"offset": 12060, "target": "了不起的人。"},
    {"offset": 12080, "target": "是。"},
    {"offset": 12092, "target": "我也这么认为。"},
    {"offset": 12116, "target": "要不是有她，我恐怕"},
    {"offset": 12144, "target": "早已恨透父亲，不知会"},
    {"offset": 12170, "target": "做出什么事。"},
    {"offset": 12198, "target": "不论发生什么，母亲都"},
    {"offset": 12226, "target": "相信父亲，而且"},
    {"offset": 12250, "target": "直到现在依然如此。"},
    {"offset": 12300, "target": "唔。"},
    {"offset": 12314, "target": "可在我看来…"},
    {"offset": 12338, "target": "她为什么会和那种"},
    {"offset": 12362, "target": "父亲结婚，我实在"},
    {"offset": 12388, "target": "无法理解。"},
    {"offset": 12415, "target": "父亲对这个家所做的"},
    {"offset": 12441, "target": "一切，就是如此"},
    {"offset": 12467, "target": "过分。"},
    {"offset": 12483, "target": "这样啊…"},
    {"offset": 12520, "target": "关于这次的事，"},
    {"offset": 12542, "target": "您母亲说过"},
    {"offset": 12562, "target": "什么吗？"},
    {"offset": 12586, "target": "母亲…"},
    {"offset": 12600, "target": "那个人一定有不得不"},
    {"offset": 12628, "target": "这样做的理由，"},
    {"offset": 12652, "target": "所以…"},
    {"offset": 12686, "target": "所以要放过他？"},
    {"offset": 12712, "target": "是。"},
    {"offset": 12726, "target": "现在先别声张，"},
    {"offset": 12750, "target": "相信他，等下去…"},
    {"offset": 12782, "target": "唔…"},
    {"offset": 12798, "target": "可这番话从好几年前"},
    {"offset": 12822, "target": "开始，她就一直"},
    {"offset": 12846, "target": "在对我说…"},
    {"offset": 12870, "target": "所以我也开始觉得"},
    {"offset": 12912, "target": "无法接受。"},
    {"offset": 12952, "target": "也是啊，这么多年来"},
    {"offset": 12980, "target": "始终如此…"},
    {"offset": 13008, "target": "以前有一次，我曾"},
    {"offset": 13036, "target": "就这件事追问过"},
    {"offset": 13062, "target": "母亲。"},
    {"offset": 13080, "target": "为什么还能相信"},
    {"offset": 13104, "target": "那种父亲，一直"},
    {"offset": 13130, "target": "等着他…"},
    {"offset": 13167, "target": "她怎么回答？"},
    {"offset": 13191, "target": "母亲只说，自己选定了他", "runs": ["母亲只说，", "自己选定了他"]},
    {"offset": 13226, "target": "既然是选定的人，"},
    {"offset": 13254, "target": "便只管相信他…"},
    {"offset": 13290, "target": "因为是自己认定的"},
    {"offset": 13314, "target": "人…吗。"},
    {"offset": 13330, "target": "…是。"},
    {"offset": 13346, "target": "如果不相信自己"},
    {"offset": 13370, "target": "选定的人…"},
    {"offset": 13393, "target": "就等于不相信"},
    {"offset": 13421, "target": "自己。"},
    {"offset": 13451, "target": "世上到处都是这种"},
    {"offset": 13479, "target": "无法信任的事物…"},
    {"offset": 13519, "target": "所以晓也要相信"},
    {"offset": 13549, "target": "自己和自己选定的"},
    {"offset": 13577, "target": "人，坚信不移地活下去…"},
    {"offset": 13631, "target": "她就是这样"},
    {"offset": 13649, "target": "教导我的。"},
    {"offset": 13671, "target": "原来如此…"},
    {"offset": 13689, "target": "说得真好。"},
    {"offset": 13719, "target": "是，听起来像是"},
    {"offset": 13743, "target": "被她教训了。"},
    {"offset": 13761, "target": "…所以母亲好像对"},
    {"offset": 13787, "target": "父亲的事真的"},
    {"offset": 13815, "target": "一无所知…"},
    {"offset": 13833, "target": "她又相信父亲，"},
    {"offset": 13861, "target": "所以似乎从不细问"},
    {"offset": 13885, "target": "他的事。"},
    {"offset": 13914, "target": "她是一位内心坚强的人。"},
    {"offset": 13950, "target": "可是…"},
    {"offset": 13966, "target": "过去我一直尊重"},
    {"offset": 13990, "target": "母亲的意思，可我"},
    {"offset": 14012, "target": "已经忍无可忍。"},
    {"offset": 14034, "target": "唯独这一次，"},
    {"offset": 14054, "target": "我不能原谅父亲。"},
    {"offset": 14076, "target": "或许我也该相信母亲，"},
    {"offset": 14104, "target": "耐心等下去…"},
    {"offset": 14130, "target": "可是那笔钱，我现在"},
    {"offset": 14158, "target": "无论如何都需要。"},
    {"offset": 14186, "target": "…所以我才来到"},
    {"offset": 14210, "target": "这里咨询。"},
    {"offset": 14236, "target": "原来如此。"},
    {"offset": 14252, "target": "我都明白了。"},
    {"offset": 14293, "target": "或许我也该相信母亲，"},
    {"offset": 14321, "target": "耐心等下去…"},
    {"offset": 14347, "target": "可是那笔钱，我现在"},
    {"offset": 14375, "target": "无论如何都需要。"},
    {"offset": 14417, "target": "对了，那个…"},
    {"offset": 14439, "target": "刚才那个女孩"},
    {"offset": 14461, "target": "和这里有关吗？"},
    {"offset": 14489, "target": "您很在意她？"},
    {"offset": 14513, "target": "不，我不是那个"},
    {"offset": 14541, "target": "意思…"},
    {"offset": 14563, "target": "只是觉得她看起来"},
    {"offset": 14587, "target": "非常年轻。"},
    {"offset": 14623, "target": "别看她那样，好像"},
    {"offset": 14649, "target": "比我还年长。"},
    {"offset": 14675, "target": "咦，"},
    {"offset": 14689, "target": "真的吗！？"},
    {"offset": 14723, "target": "她似乎有着很复杂的"},
    {"offset": 14749, "target": "隐情。"},
    {"offset": 14775, "target": "啊…？"},
    {"offset": 14789, "target": "最好别把视线"},
    {"offset": 14811, "target": "从她身上移开。"},
    {"offset": 14839, "target": "哦…"},
    {"offset": 14874, "target": "那个女孩的事"},
    {"offset": 14894, "target": "先放一边吧。"},
    {"offset": 14914, "target": "能继续说说您的"},
    {"offset": 14938, "target": "委托吗？"},
    {"offset": 14982, "target": "您知道父亲工作的"},
    {"offset": 15008, "target": "那家工厂在什么"},
    {"offset": 15034, "target": "地方吗？"},
    {"offset": 15056, "target": "呃…记得是间小型"},
    {"offset": 15093, "target": "小工厂，名字是…"},
    {"offset": 15123, "target": "…对了，是有限公司", "runs": ["…对了，是", "有限公司"]},
    {"offset": 15154, "target": "克雷夫制作所"},
    {"offset": 15184, "target": "这家公司。"},
    {"offset": 15210, "target": "克雷夫制作所…对吧。"},
    {"offset": 15238, "target": "我知道了。"},
    {"offset": 15260, "target": "不过，我甚至有些怀疑"},
    {"offset": 15284, "target": "是否真有这么一家"},
    {"offset": 15306, "target": "工厂…"},
    {"offset": 15346, "target": "连这件事一起，"},
    {"offset": 15370, "target": "我们先调查"},
    {"offset": 15392, "target": "看看吧。"},
    {"offset": 15410, "target": "这样啊。"},
    {"offset": 15428, "target": "…拜托您了。"},
    {"offset": 15471, "target": "父亲工作过的"},
    {"offset": 15510, "target": "小工厂名叫克雷夫制作所", "runs": ["小工厂名叫", "克雷夫制作所"]},
    {"offset": 15557, "target": "就是这家厂。"},
    {"offset": 15602, "target": "交往对象是森慧美，", "runs": ["交往对象是", "森慧美，"]},
    {"offset": 15666, "target": "我们三个月前"},
    {"offset": 15690, "target": "相识。"},
    {"offset": 15712, "target": "她美丽又体贴，"},
    {"offset": 15738, "target": "是位非常出色的"},
    {"offset": 15760, "target": "女性。"},
    {"offset": 15780, "target": "…对了，这是她的"},
    {"offset": 15804, "target": "照片。"},
    {"offset": 15832, "target": "…哦，她确实是位"},
    {"offset": 15867, "target": "美女。"},
    {"offset": 15897, "target": "哈哈，被您这么说，"},
    {"offset": 15925, "target": "我都有些不好意思了。"},
    {"offset": 15953, "target": "是啊，她可是"},
    {"offset": 15971, "target": "我引以为豪的恋人。"},
    {"offset": 16007, "target": "相识才三个月，"},
    {"offset": 16033, "target": "就已经谈到"},
    {"offset": 16059, "target": "结婚了啊。"},
    {"offset": 16079, "target": "是，正是如此。"},
    {"offset": 16105, "target": "我本来就在这样的"},
    {"offset": 16133, "target": "家庭中长大，所以想"},
    {"offset": 16161, "target": "尽快拥有自己的家。"},
    {"offset": 16189, "target": "可以说是对父亲的"},
    {"offset": 16213, "target": "反抗…或者说是"},
    {"offset": 16239, "target": "一种赌气吧…"},
    {"offset": 16265, "target": "原来如此，你想"},
    {"offset": 16287, "target": "建立一个健全的"},
    {"offset": 16318, "target": "家庭。"},
    {"offset": 16348, "target": "是，差不多就是这样。"},
    {"offset": 16376, "target": "她也很想结婚，"},
    {"offset": 16404, "target": "所以我们很早就"},
    {"offset": 16428, "target": "谈过这件事。"},
    {"offset": 16455, "target": "正当我们准备开始"},
    {"offset": 16481, "target": "讨论具体安排"},
    {"offset": 16507, "target": "的时候…"},
    {"offset": 16531, "target": "其实最近，她的父母"},
    {"offset": 16559, "target": "经营的服装店"},
    {"offset": 16592, "target": "似乎倒闭了…"},
    {"offset": 16628, "target": "只留下了一大笔"},
    {"offset": 16662, "target": "债务。"},
    {"offset": 16692, "target": "啊…这可真是"},
    {"offset": 16716, "target": "太不幸了…"},
    {"offset": 16742, "target": "家里变成这种状况，"},
    {"offset": 16770, "target": "自然顾不上女儿结婚"}
  ]
}
