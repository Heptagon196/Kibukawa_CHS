{
  "script": "c3_01",
  "batch": "c3_01.part2.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 4927,
      "kind": "line",
      "limit": 11,
      "source": "結婚して子供もいるのに",
      "target": "有人明明已经结婚"
    },
    {
      "offset": 4955,
      "kind": "line",
      "limit": 11,
      "source": "別の人と別の家で同棲を",
      "target": "生子，却还和别人"
    },
    {
      "offset": 5005,
      "kind": "line",
      "limit": 11,
      "source": "続けていた、などで…",
      "target": "在另一个家同居…"
    },
    {
      "offset": 5031,
      "kind": "line",
      "limit": 11,
      "source": "一見まじめで誠実そうな",
      "target": "有些人看起来认真"
    },
    {
      "offset": 5059,
      "kind": "line",
      "limit": 11,
      "source": "人でも、実は裏でそんな",
      "target": "诚实，背地里却会"
    },
    {
      "offset": 5087,
      "kind": "line",
      "limit": 11,
      "source": "ことをしていたりする。",
      "target": "做这种事。"
    },
    {
      "offset": 5115,
      "kind": "line",
      "limit": 10,
      "source": "ひどいものになると、",
      "target": "更过分的，甚至会"
    },
    {
      "offset": 5152,
      "kind": "line",
      "limit": 10,
      "source": "偽名を使って…",
      "target": "使用假名…"
    },
    {
      "offset": 5179,
      "kind": "line",
      "limit": 11,
      "source": "完全に別人になりすまし",
      "target": "彻底冒充另一个人，"
    },
    {
      "offset": 5207,
      "kind": "line",
      "limit": 11,
      "source": "そのまま何年も過ごして",
      "target": "就这样生活"
    },
    {
      "offset": 5235,
      "kind": "line",
      "limit": 11,
      "source": "いたという例もあった。",
      "target": "好几年。"
    },
    {
      "offset": 5268,
      "kind": "line",
      "limit": 9,
      "source": "しかし、まさか…。",
      "target": "可是，不会吧…"
    },
    {
      "offset": 5294,
      "kind": "line",
      "limit": 10,
      "source": "彼を信じて待つ、妻の",
      "target": "我想起了他的妻子"
    },
    {
      "offset": 5320,
      "kind": "line",
      "limit": 10,
      "source": "綾子さんの姿を思い",
      "target": "绫子女士相信着他，"
    },
    {
      "offset": 5344,
      "kind": "line",
      "limit": 10,
      "source": "出した。",
      "target": "一直苦等的模样。"
    },
    {
      "offset": 5358,
      "kind": "line",
      "limit": 10,
      "source": "…とりあえず、この",
      "target": "…总之先记住"
    },
    {
      "offset": 5382,
      "kind": "line",
      "limit": 10,
      "source": "住所は覚えといて、",
      "target": "这个地址，"
    },
    {
      "offset": 5406,
      "kind": "line",
      "limit": 10,
      "source": "後で行ってみよう…。",
      "target": "之后去看看吧…"
    },
    {
      "offset": 5454,
      "kind": "line",
      "limit": 8,
      "source": "…いや、待てよ。",
      "target": "…不，等等。"
    },
    {
      "offset": 5485,
      "kind": "line",
      "limit": 11,
      "source": "尼子は忠雄さんを訪ね",
      "target": "尼子去找忠雄先生时"
    },
    {
      "offset": 5526,
      "kind": "line",
      "limit": 11,
      "source": "暁さんの自宅を訪問した",
      "target": "造访的是晓先生的"
    },
    {
      "offset": 5560,
      "kind": "line",
      "limit": 11,
      "source": "とのことだったが…",
      "target": "家…"
    },
    {
      "offset": 5584,
      "kind": "line",
      "limit": 10,
      "source": "社員名簿の住所は違う",
      "target": "可员工名册上写的是"
    },
    {
      "offset": 5610,
      "kind": "line",
      "limit": 10,
      "source": "場所なのに、どうして",
      "target": "另一个地址，他怎么"
    },
    {
      "offset": 5638,
      "kind": "line",
      "limit": 10,
      "source": "本当の住所を…？",
      "target": "会知道真住址…？"
    },
    {
      "offset": 5675,
      "kind": "line",
      "limit": 11,
      "source": "尼子が身元を詳しく調査",
      "target": "难道尼子详细调查过"
    },
    {
      "offset": 5709,
      "kind": "line",
      "limit": 11,
      "source": "したのだろうか…？",
      "target": "他的身份…？"
    },
    {
      "offset": 5733,
      "kind": "line",
      "limit": 11,
      "source": "それとも、元から事情を",
      "target": "还是他本来就知道"
    },
    {
      "offset": 5761,
      "kind": "line",
      "limit": 11,
      "source": "知っていたとか…？",
      "target": "内情…？"
    },
    {
      "offset": 5785,
      "kind": "line",
      "limit": 10,
      "source": "だとすると、尼子と",
      "target": "这样一来，尼子和"
    },
    {
      "offset": 5829,
      "kind": "line",
      "limit": 10,
      "source": "忠雄さんの関係は",
      "target": "忠雄先生究竟是"
    },
    {
      "offset": 5851,
      "kind": "line",
      "limit": 10,
      "source": "何だったんだろう…？",
      "target": "什么关系…？"
    },
    {
      "offset": 5877,
      "kind": "line",
      "limit": 6,
      "source": "…ふむぅ…。",
      "target": "…唔…"
    },
    {
      "offset": 5910,
      "kind": "line",
      "limit": 10,
      "source": "その他、特に気になる",
      "target": "除此之外，没有"
    },
    {
      "offset": 5936,
      "kind": "line",
      "limit": 10,
      "source": "情報はなかった。",
      "target": "值得注意的信息。"
    },
    {
      "offset": 5970,
      "kind": "line",
      "limit": 11,
      "source": "大きさ２センチほどの、",
      "target": "这是一块约两厘米大"
    },
    {
      "offset": 5998,
      "kind": "line",
      "limit": 11,
      "source": "特殊加工された金属だ。",
      "target": "经过特殊加工的金属。"
    },
    {
      "offset": 6026,
      "kind": "line",
      "limit": 11,
      "source": "ホコリを払ってみると、",
      "target": "掸去灰尘后，"
    },
    {
      "offset": 6054,
      "kind": "line",
      "limit": 11,
      "source": "やけに複雑な形状をして",
      "target": "可以看出形状极其"
    },
    {
      "offset": 6082,
      "kind": "line",
      "limit": 11,
      "source": "いるのがわかった。",
      "target": "复杂。"
    },
    {
      "offset": 6108,
      "kind": "line",
      "limit": 4,
      "source": "…あれ？",
      "target": "…咦？"
    },
    {
      "offset": 6122,
      "kind": "line",
      "limit": 11,
      "source": "このパーツ、どこかで",
      "target": "这个零件，我好像"
    },
    {
      "offset": 6148,
      "kind": "line",
      "limit": 11,
      "source": "見たことあるような…。",
      "target": "在哪里见过…"
    },
    {
      "offset": 6178,
      "kind": "line",
      "limit": 11,
      "source": "…何か引っかかるものを",
      "target": "…心中掠过一丝异样，"
    },
    {
      "offset": 6206,
      "kind": "line",
      "limit": 11,
      "source": "感じ、僕は記憶の",
      "target": "我开始翻找"
    },
    {
      "offset": 6228,
      "kind": "line",
      "limit": 11,
      "source": "引き出しを探る。",
      "target": "记忆。"
    },
    {
      "offset": 6250,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 6269,
      "kind": "line",
      "limit": 4,
      "source": "あっ…。",
      "target": "啊…"
    },
    {
      "offset": 6285,
      "kind": "line",
      "limit": 7,
      "source": "…思い出した。",
      "target": "…想起来了。"
    },
    {
      "offset": 6305,
      "kind": "line",
      "limit": 11,
      "source": "これ、拳銃に使われて",
      "target": "这不是手枪用的",
      "runs": [
        "这不是",
        "手枪用的"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "これ、"
        },
        {
          "colour": 2,
          "text": "拳銃に使われて"
        }
      ]
    },
    {
      "offset": 6344,
      "kind": "line",
      "limit": 11,
      "source": "いるパーツじゃないか。",
      "target": "零件吗。"
    },
    {
      "offset": 6372,
      "kind": "line",
      "limit": 11,
      "source": "昔、専門家の人に、分解",
      "target": "以前有位专家让我看"
    },
    {
      "offset": 6400,
      "kind": "line",
      "limit": 11,
      "source": "しているところを見せて",
      "target": "过拆卸手枪的"
    },
    {
      "offset": 6428,
      "kind": "line",
      "limit": 11,
      "source": "もらったことがあるが…",
      "target": "过程…"
    },
    {
      "offset": 6456,
      "kind": "line",
      "limit": 9,
      "source": "その時、これと同じ",
      "target": "那时就见过和这"
    },
    {
      "offset": 6480,
      "kind": "line",
      "limit": 9,
      "source": "パーツを見たのだ。",
      "target": "一模一样的零件。"
    },
    {
      "offset": 6504,
      "kind": "line",
      "limit": 7,
      "source": "…しかしこれ、",
      "target": "…可是，"
    },
    {
      "offset": 6529,
      "kind": "line",
      "limit": 7,
      "source": "本物なのか？",
      "target": "这是真的吗？"
    },
    {
      "offset": 6564,
      "kind": "line",
      "limit": 11,
      "source": "…おもちゃ用にしては、",
      "target": "…如果只是玩具，"
    },
    {
      "offset": 6592,
      "kind": "line",
      "limit": 11,
      "source": "使っている金属の材質が",
      "target": "所用的金属材质似乎"
    },
    {
      "offset": 6620,
      "kind": "line",
      "limit": 11,
      "source": "良すぎる気はする。",
      "target": "好得过头了。"
    },
    {
      "offset": 6644,
      "kind": "line",
      "limit": 6,
      "source": "まさか…!?",
      "target": "难道说…！？"
    },
    {
      "offset": 6669,
      "kind": "line",
      "limit": 9,
      "source": "拳銃のパーツらしき",
      "target": "像是手枪零件的"
    },
    {
      "offset": 6693,
      "kind": "line",
      "limit": 9,
      "source": "金属片だ。",
      "target": "金属碎片。"
    },
    {
      "offset": 6709,
      "kind": "line",
      "limit": 11,
      "source": "…これを、この工場で",
      "target": "…这东西是这间工厂"
    },
    {
      "offset": 6735,
      "kind": "line",
      "limit": 11,
      "source": "作っていたのだろうか。",
      "target": "制造的吗？"
    },
    {
      "offset": 6763,
      "kind": "line",
      "limit": 7,
      "source": "だとすると…。",
      "target": "如果是这样…"
    },
    {
      "offset": 6813,
      "kind": "line",
      "limit": 10,
      "source": "僕は物陰に隠れ、",
      "target": "我躲到暗处，"
    },
    {
      "offset": 6835,
      "kind": "line",
      "limit": 10,
      "source": "こっそり様子を伺う。",
      "target": "悄悄观察情况。"
    },
    {
      "offset": 6861,
      "kind": "line",
      "limit": 11,
      "source": "…人が入ってきて、",
      "target": "…有人走进来，"
    },
    {
      "offset": 6885,
      "kind": "line",
      "limit": 11,
      "source": "ゆっくり近付いてくる。",
      "target": "慢慢向这里靠近。"
    },
    {
      "offset": 6913,
      "kind": "line",
      "limit": 9,
      "source": "隙間から、少しだけ",
      "target": "我从缝隙中看到了"
    },
    {
      "offset": 6937,
      "kind": "line",
      "limit": 9,
      "source": "姿が見えた。",
      "target": "一点身影。"
    },
    {
      "offset": 6955,
      "kind": "line",
      "limit": 5,
      "source": "あれは…。",
      "target": "那是…"
    },
    {
      "offset": 6988,
      "kind": "line",
      "limit": 7,
      "source": "川瀬莉沙…!?",
      "target": "川濑莉沙…！？"
    },
    {
      "offset": 7042,
      "kind": "line",
      "limit": 10,
      "source": "間違いない、彼女だ。",
      "target": "不会错，就是她。"
    },
    {
      "offset": 7068,
      "kind": "line",
      "limit": 10,
      "source": "どうしてここに…？",
      "target": "她为什么在这里…？"
    },
    {
      "offset": 7092,
      "kind": "line",
      "limit": 9,
      "source": "しばらくして、",
      "target": "过了一会儿，"
    },
    {
      "offset": 7112,
      "kind": "line",
      "limit": 9,
      "source": "もうひとり工場内に",
      "target": "又有一个人走进"
    },
    {
      "offset": 7136,
      "kind": "line",
      "limit": 9,
      "source": "やってきた。",
      "target": "工厂。"
    },
    {
      "offset": 7154,
      "kind": "line",
      "limit": 11,
      "source": "どうやら、待ち合わせを",
      "target": "看来他们约好在这里"
    },
    {
      "offset": 7182,
      "kind": "line",
      "limit": 11,
      "source": "していたようだ。",
      "target": "碰面。"
    },
    {
      "offset": 7204,
      "kind": "line",
      "limit": 10,
      "source": "…話し声が聞こえる。",
      "target": "…能听见说话声。"
    },
    {
      "offset": 7230,
      "kind": "line",
      "limit": 10,
      "source": "男性の声だ。",
      "target": "是男人的声音。"
    },
    {
      "offset": 7248,
      "kind": "line",
      "limit": 11,
      "source": "小声で話しているので、",
      "target": "他们说得很小声，"
    },
    {
      "offset": 7276,
      "kind": "line",
      "limit": 11,
      "source": "何を言っているのか",
      "target": "具体内容完全"
    },
    {
      "offset": 7300,
      "kind": "line",
      "limit": 11,
      "source": "までは聞き取れない。",
      "target": "听不清。"
    },
    {
      "offset": 7326,
      "kind": "line",
      "limit": 8,
      "source": "相手の男性の姿は",
      "target": "虽然看不清对方"
    },
    {
      "offset": 7348,
      "kind": "line",
      "limit": 8,
      "source": "よく見えないが…",
      "target": "男人的样子…"
    },
    {
      "offset": 7370,
      "kind": "line",
      "limit": 11,
      "source": "どうやら何かを受け渡し",
      "target": "但他们似乎正在"
    },
    {
      "offset": 7398,
      "kind": "line",
      "limit": 11,
      "source": "しているような感じだ。",
      "target": "交接什么东西。"
    },
    {
      "offset": 7428,
      "kind": "line",
      "limit": 11,
      "source": "…ちゃんと、約束通り",
      "target": "…我可是按约定"
    },
    {
      "offset": 7454,
      "kind": "line",
      "limit": 11,
      "source": "やっておきましたよー。",
      "target": "全都办妥了哦。"
    },
    {
      "offset": 7482,
      "kind": "line",
      "limit": 10,
      "source": "…ほら、見ての通り。",
      "target": "…看，正如您所见。"
    },
    {
      "offset": 7508,
      "kind": "line",
      "limit": 10,
      "source": "ここにはもう、",
      "target": "这里已经"
    },
    {
      "offset": 7528,
      "kind": "line",
      "limit": 10,
      "source": "誰もいませんよ。",
      "target": "没有人了。"
    },
    {
      "offset": 7552,
      "kind": "line",
      "limit": 11,
      "source": "高くてよく通る、彼女の",
      "target": "只有她尖亮的声音"
    },
    {
      "offset": 7580,
      "kind": "line",
      "limit": 11,
      "source": "声だけ少し聞き取れた。",
      "target": "勉强能听清一些。"
    },
    {
      "offset": 7618,
      "kind": "line",
      "limit": 9,
      "source": "…そうして、",
      "target": "…之后，"
    },
    {
      "offset": 7636,
      "kind": "line",
      "limit": 9,
      "source": "２人は出て行った。",
      "target": "两人便离开了。"
    },
    {
      "offset": 7660,
      "kind": "line",
      "limit": 9,
      "source": "去り際に、僕は少し",
      "target": "他们离开时，我稍微"
    },
    {
      "offset": 7684,
      "kind": "line",
      "limit": 9,
      "source": "顔を出して、２人の",
      "target": "探出头，看清了两人"
    },
    {
      "offset": 7708,
      "kind": "line",
      "limit": 9,
      "source": "後ろ姿を確認する。",
      "target": "的背影。"
    },
    {
      "offset": 7732,
      "kind": "line",
      "limit": 11,
      "source": "相手は、中肉中背の",
      "target": "对方似乎是身材中等"
    },
    {
      "offset": 7758,
      "kind": "line",
      "limit": 11,
      "source": "中年男性のようだった。",
      "target": "的中年男人。"
    },
    {
      "offset": 7792,
      "kind": "line",
      "limit": 8,
      "source": "…見覚えはない。",
      "target": "…我没见过他。"
    },
    {
      "offset": 7824,
      "kind": "line",
      "limit": 11,
      "source": "２人が完全に出て行った",
      "target": "确认两人已经彻底"
    },
    {
      "offset": 7852,
      "kind": "line",
      "limit": 11,
      "source": "のを確認し、僕は機材の",
      "target": "离开后，我从设备"
    },
    {
      "offset": 7880,
      "kind": "line",
      "limit": 11,
      "source": "陰から出た。",
      "target": "后面走了出来。"
    },
    {
      "offset": 7913,
      "kind": "line",
      "limit": 11,
      "source": "…ここに誰もいないのを",
      "target": "…他们知道这里没人，"
    },
    {
      "offset": 7941,
      "kind": "line",
      "limit": 11,
      "source": "知って、秘密の会合に",
      "target": "所以才把此处用来"
    },
    {
      "offset": 7967,
      "kind": "line",
      "limit": 11,
      "source": "使っているのだろうか。",
      "target": "秘密会面吗？"
    },
    {
      "offset": 7995,
      "kind": "line",
      "limit": 5,
      "source": "…しかし。",
      "target": "…不过。"
    },
    {
      "offset": 8011,
      "kind": "line",
      "limit": 5,
      "source": "うーん…。",
      "target": "嗯…"
    },
    {
      "offset": 8027,
      "kind": "line",
      "limit": 10,
      "source": "…なにかと、気になる",
      "target": "…让人在意的事"
    },
    {
      "offset": 8053,
      "kind": "line",
      "limit": 10,
      "source": "ことが多いな…。",
      "target": "还真多…"
    },
    {
      "offset": 8086,
      "kind": "line",
      "limit": 11,
      "source": "癸生川に連絡を取って、",
      "target": "我得联系癸生川，"
    },
    {
      "offset": 8120,
      "kind": "line",
      "limit": 11,
