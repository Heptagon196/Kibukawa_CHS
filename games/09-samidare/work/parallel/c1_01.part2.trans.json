{
  "script": "c1_01",
  "units": [
    {"offset": 5693, "target": "然后马上又"},
    {"offset": 5715, "target": "出门，一连好几天"},
    {"offset": 5739, "target": "不回家。"},
    {"offset": 5765, "target": "一直如此…"},
    {"offset": 5781, "target": "从那时直到现在，"},
    {"offset": 5809, "target": "始终是这副德行。"},
    {"offset": 5835, "target": "那确实…"},
    {"offset": 5855, "target": "很糟糕。"},
    {"offset": 5881, "target": "是。"},
    {"offset": 5893, "target": "但最痛苦的应该是"},
    {"offset": 5921, "target": "我母亲。"},
    {"offset": 5943, "target": "父亲一直那样，家里的"},
    {"offset": 5971, "target": "生计全靠母亲独自"},
    {"offset": 5997, "target": "支撑。"},
    {"offset": 6031, "target": "您父亲没有"},
    {"offset": 6053, "target": "工作吗？"},
    {"offset": 6083, "target": "听母亲说他在工厂工作", "runs": ["听母亲说他", "在工厂工作"]},
    {"offset": 6119, "target": "这是很久以前"},
    {"offset": 6143, "target": "听她提过的。"},
    {"offset": 6165, "target": "可工作不可能忙到"},
    {"offset": 6191, "target": "连家都回不来"},
    {"offset": 6215, "target": "吧。"},
    {"offset": 6239, "target": "何况，如果父亲真的"},
    {"offset": 6267, "target": "在认真工作…"},
    {"offset": 6291, "target": "母亲就不会"},
    {"offset": 6313, "target": "被迫吃那么多"},
    {"offset": 6357, "target": "苦了。"},
    {"offset": 6383, "target": "原来如此…"},
    {"offset": 6403, "target": "即便如此，母亲也从没"},
    {"offset": 6431, "target": "在我面前说过父亲的"},
    {"offset": 6453, "target": "坏话…"},
    {"offset": 6488, "target": "可唯独这一次，"},
    {"offset": 6512, "target": "我实在忍无可忍。"},
    {"offset": 6536, "target": "唔…"},
    {"offset": 6577, "target": "即使在我这个儿子看来"},
    {"offset": 6603, "target": "他也有太多让人"},
    {"offset": 6629, "target": "摸不透的地方…"},
    {"offset": 6645, "target": "在我眼里，"},
    {"offset": 6665, "target": "他是最差劲的父亲…"},
    {"offset": 6698, "target": "如果不是为了母亲，"},
    {"offset": 6722, "target": "我早就抛下这个家"},
    {"offset": 6750, "target": "离开了。"},
    {"offset": 6776, "target": "这样啊…"},
    {"offset": 6816, "target": "您知道父亲可能"},
    {"offset": 6840, "target": "会去什么地方"},
    {"offset": 6862, "target": "吗？"},
    {"offset": 6882, "target": "既然他几乎不回家，"},
    {"offset": 6908, "target": "过着这样的生活，"},
    {"offset": 6934, "target": "应该有某个平时"},
    {"offset": 6960, "target": "落脚过夜的"},
    {"offset": 6982, "target": "地方吧。"},
    {"offset": 7004, "target": "说起这个，"},
    {"offset": 7026, "target": "他偶尔待在家时"},
    {"offset": 7050, "target": "也几乎不说话…"},
    {"offset": 7092, "target": "我从小就没怎么"},
    {"offset": 7116, "target": "和他交谈过。"},
    {"offset": 7138, "target": "一次也没有。"},
    {"offset": 7156, "target": "他总沉默寡言，"},
    {"offset": 7184, "target": "我不记得他陪我"},
    {"offset": 7208, "target": "玩过。"},
    {"offset": 7226, "target": "说真的，父亲的事"},
    {"offset": 7254, "target": "我连想去了解的念头"},
    {"offset": 7278, "target": "都从未有过。"},
    {"offset": 7306, "target": "那您母亲知道"},
    {"offset": 7332, "target": "些什么吗？"},
    {"offset": 7360, "target": "其实母亲也不了解父亲", "runs": ["其实母亲也", "不了解父亲"]},
    {"offset": 7393, "target": "的详情…"},
    {"offset": 7423, "target": "她是这么说的。"},
    {"offset": 7455, "target": "是这样吗…？"},
    {"offset": 7481, "target": "我当时也没有继续"},
    {"offset": 7509, "target": "追问，所以并不"},
    {"offset": 7535, "target": "清楚…"},
    {"offset": 7561, "target": "但似乎就是"},
    {"offset": 7585, "target": "这样。"},
    {"offset": 7603, "target": "唔…总觉得有些"},
    {"offset": 7629, "target": "蹊跷。"},
    {"offset": 7666, "target": "还有没有可能和您父亲"},
    {"offset": 7694, "target": "有关的其他线索"},
    {"offset": 7720, "target": "呢？"},
    {"offset": 7740, "target": "比如他的熟人，"},
    {"offset": 7766, "target": "什么都可以。"},
    {"offset": 7794, "target": "嗯…"},
    {"offset": 7810, "target": "听您这么一说，"},
    {"offset": 7832, "target": "好像是有过"},
    {"offset": 7854, "target": "什么…"},
    {"offset": 7874, "target": "对不起，我一时"},
    {"offset": 7900, "target": "想不起来。"},
    {"offset": 7924, "target": "我对记忆力还挺"},
    {"offset": 7950, "target": "有自信的…"},
    {"offset": 7974, "target": "这样啊…"},
    {"offset": 8002, "target": "实在抱歉…"},
    {"offset": 8028, "target": "等我想起来，"},
    {"offset": 8052, "target": "会再告诉您的。"},
    {"offset": 8088, "target": "…啊，对了！"},
    {"offset": 8110, "target": "我想起父亲的一位"},
    {"offset": 8134, "target": "熟人了！"},
    {"offset": 8158, "target": "哦，是谁？"},
    {"offset": 8182, "target": "大约是两三个月"},
    {"offset": 8210, "target": "前…"},
    {"offset": 8226, "target": "有一次，来找父亲的", "runs": ["有一次，", "来找父亲的"]},
    {"offset": 8259, "target": "人来到家里。"},
    {"offset": 8293, "target": "来找您父亲…？"},
    {"offset": 8313, "target": "那个人是"},
    {"offset": 8333, "target": "谁呢？"},
    {"offset": 8353, "target": "是个衣服脏旧的男人，"},
    {"offset": 8381, "target": "年龄大概有六七十"},
    {"offset": 8407, "target": "岁…"},
    {"offset": 8433, "target": "记得他叫…尼子启三", "runs": ["记得他叫…", "尼子启三"]},
    {"offset": 8496, "target": "…是这样自称的。"},
    {"offset": 8526, "target": "年长男子，"},
    {"offset": 8553, "target": "尼子启三…"},
    {"offset": 8594, "target": "那个人说了"},
    {"offset": 8620, "target": "什么？"},
    {"offset": 8636, "target": "他报上名字，"},
    {"offset": 8660, "target": "问我父亲是否"},
    {"offset": 8684, "target": "在家。"},
    {"offset": 8704, "target": "我当然不知道，"},
    {"offset": 8730, "target": "就这样回答了。"},
    {"offset": 8754, "target": "之后他便离开了…"},
    {"offset": 8780, "target": "所以我完全不知道"},
    {"offset": 8804, "target": "他是什么人…"},
    {"offset": 8830, "target": "或来自哪里…"},
    {"offset": 8858, "target": "原来如此…"},
    {"offset": 8876, "target": "看来他是少数认识"},
    {"offset": 8902, "target": "您父亲的人。"},
    {"offset": 8936, "target": "谢谢您，光是这点"},
    {"offset": 8964, "target": "就已经是很有用的"},
    {"offset": 8988, "target": "线索了。"},
    {"offset": 9016, "target": "是吗？"},
    {"offset": 9034, "target": "那太好了。"},
    {"offset": 9067, "target": "其他的…我实在"},
    {"offset": 9093, "target": "想不到了。"},
    {"offset": 9117, "target": "对不起。"},
    {"offset": 9167, "target": "那笔钱，"},
    {"offset": 9193, "target": "是我作为结婚资金", "runs": ["是我", "作为结婚资金"]},
    {"offset": 9230, "target": "一点点攒下来的…"},
    {"offset": 9258, "target": "因为现在急用，"},
    {"offset": 9282, "target": "我刚才去银行准备"},
    {"offset": 9310, "target": "取钱…"},
    {"offset": 9330, "target": "可本应足够的余额"},
    {"offset": 9358, "target": "却不够了，"},
    {"offset": 9382, "target": "钱没能取出来。"},
    {"offset": 9412, "target": "唔…"},
    {"offset": 9428, "target": "于是我请银行查询"},
    {"offset": 9454, "target": "交易记录…"},
    {"offset": 9476, "target": "才发现不知是谁"},
    {"offset": 9504, "target": "昨天，全部被人取走", "runs": ["昨天，", "全部被人取走"]},
    {"offset": 9535, "target": "了。"},
    {"offset": 9577, "target": "这可真是…"},
    {"offset": 9599, "target": "我赶紧回家确认，"},
    {"offset": 9627, "target": "发现账户的存折和印章", "runs": ["发现账户的", "存折和印章"]},
    {"offset": 9662, "target": "也都不见了。"},
    {"offset": 9696, "target": "这肯定是父亲"},
    {"offset": 9744, "target": "干的！"},
    {"offset": 9768, "target": "而且父亲好像知道"},
    {"offset": 9792, "target": "存折和印章藏在"},
    {"offset": 9818, "target": "哪里…"},
    {"offset": 9852, "target": "金额大约有"},
    {"offset": 9874, "target": "多少？"},
    {"offset": 9898, "target": "全部存款约有５００万", "runs": ["全部存款约有", "５００万"]},
    {"offset": 9934, "target": "日元。"},
    {"offset": 9958, "target": "５００万日元！？"},
    {"offset": 9982, "target": "真不少啊…"},
    {"offset": 10006, "target": "那是我工作多年，从不"},
    {"offset": 10034, "target": "奢侈，一点点攒下的"},
    {"offset": 10062, "target": "宝贵积蓄。"},
    {"offset": 10096, "target": "原来如此…"},
    {"offset": 10135, "target": "我现在的工资也"},
    {"offset": 10159, "target": "绝不算高…"},
    {"offset": 10185, "target": "可我一边补贴家用，"},
    {"offset": 10209, "target": "一边踏实攒下这点"},
    {"offset": 10237, "target": "仅有的积蓄。"},
    {"offset": 10267, "target": "为了攒下这些钱，"},
    {"offset": 10291, "target": "我不知吃了多少"},
    {"offset": 10313, "target": "苦…"},
    {"offset": 10378, "target": "…啊，对了。"},
    {"offset": 10404, "target": "嗯。"},
    {"offset": 10428, "target": "蝼川内先生现在急需"},
    {"offset": 10480, "target": "动用攒下的结婚资金，"},
    {"offset": 10508, "target": "也就是说…"},
    {"offset": 10534, "target": "您最近就要"},
    {"offset": 10560, "target": "结婚了吧。"},
    {"offset": 10584, "target": "啊，这件事啊。"},
    {"offset": 10608, "target": "不，那个…其实我们"},
    {"offset": 10636, "target": "还没有马上结婚的"},
    {"offset": 10662, "target": "打算…"},
    {"offset": 10680, "target": "不过…钱的用途"},
    {"offset": 10706, "target": "确实差不多是这样。"},
    {"offset": 10753, "target": "…？"},
    {"offset": 10763, "target": "如果方便，可以说给"},
    {"offset": 10789, "target": "我听听吗？"},
    {"offset": 10819, "target": "啊，好、好的…"},
    {"offset": 10843, "target": "其实我正在和一位"},
    {"offset": 10869, "target": "以结婚为前提的女友", "runs": ["以结婚为前提的", "女友"]},
    {"offset": 10906, "target": "交往…"},
    {"offset": 10930, "target": "嗯。"},
    {"offset": 10944, "target": "她因为家里的事，"},
    {"offset": 10968, "target": "无论如何都需要钱", "runs": ["无论如何都", "需要钱"]},
    {"offset": 11002, "target": "她是这样说的…"},
    {"offset": 11022, "target": "所以我想拿攒下的"},
    {"offset": 11050, "target": "结婚资金帮她"},
    {"offset": 11080, "target": "渡过难关。"},
    {"offset": 11116, "target": "因为家里的事，"},
    {"offset": 11140, "target": "急需用钱…？"},
    {"offset": 11158, "target": "是。"},
    {"offset": 11172, "target": "…蝼川内先生。"},
    {"offset": 11232, "target": "关于您的交往对象，"}
  ]
}
