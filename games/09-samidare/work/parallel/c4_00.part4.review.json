    },
    {
      "offset": 16247,
      "kind": "line",
      "limit": 10,
      "source": "から知っていたのだ。",
      "target": "尼子就已经知道了。"
    },
    {
      "offset": 16279,
      "kind": "line",
      "limit": 7,
      "source": "…実に偶然に。",
