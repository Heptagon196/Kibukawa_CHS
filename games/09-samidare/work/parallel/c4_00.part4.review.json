    {
      "offset": 16148,
      "kind": "line",
      "limit": 10,
      "source": "ことですか？",
      "target": "都调查过？"
    },
    {
      "offset": 16168,
      "kind": "line",
      "limit": 10,
      "source": "いや、そうじゃない。",
      "target": "不，并非如此。"
    },
    {
      "offset": 16194,
      "kind": "line",
      "limit": 10,
      "source": "実は尼子は、それ以前",
