    },
    {
      "offset": 15107,
      "kind": "line",
      "limit": 11,
      "source": "そんな人物だとは、",
      "target": "社长竟然会是"
    },
    {
      "offset": 15131,
      "kind": "line",
      "limit": 11,
      "source": "思ってもいなかった…。",
      "target": "那样的人物……"
    },
    {
      "offset": 15161,
      "kind": "line",
      "limit": 11,
      "source": "忠雄さんがそれを知った",
