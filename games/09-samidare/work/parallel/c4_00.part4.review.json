      "emphasis": [
        {
          "colour": null,
          "text": "のは、"
        },
        {
          "colour": 2,
          "text": "３ヶ月くらい前の"
        }
      ]
    },
    {
      "offset": 15230,
      "kind": "line",
      "limit": 11,
      "source": "ことですよね。",
      "target": "对吧。"
    },
    {
      "offset": 15252,
      "kind": "line",
      "limit": 4,
      "source": "…ああ。",
      "target": "……嗯。"
    },
    {
      "offset": 15266,
      "kind": "line",
      "limit": 11,
      "source": "この工場で、銃器密造を",
