        "秘密制枪"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "この工場で、"
        },
        {
          "colour": 2,
          "text": "銃器密造を"
        }
      ]
    },
    {
      "offset": 15307,
      "kind": "line",
      "limit": 11,
      "source": "してることを、ふとした",
      "target": "忠雄偶然"
    },
    {
      "offset": 15335,
      "kind": "line",
      "limit": 11,
      "source": "ことから知ってしまい…",
      "target": "得知此事……"
    },
    {
      "offset": 15363,
      "kind": "line",
      "limit": 10,
      "source": "これは悪いことだと…",
      "target": "认为这是犯罪……"
    },
    {
      "offset": 15389,
      "kind": "line",
      "limit": 10,
      "source": "その証拠となる書類を",
      "target": "便将证据文件",
      "runs": [
        "便将",
        "证据文件"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "その"
        },
        {
          "colour": 2,
          "text": "証拠となる書類を"
        }
      ]
    },
    {
      "offset": 15428,
      "kind": "line",
      "limit": 10,
      "source": "盗んでしまった。",
      "target": "偷了出来。"
    },
    {
      "offset": 15452,
      "kind": "line",
      "limit": 9,
      "source": "警察に届け出ようと",
      "target": "是想交给警方"
    },
    {
      "offset": 15476,
      "kind": "line",
      "limit": 9,
      "source": "したのですね。",
      "target": "对吧。"
    },
    {
      "offset": 15496,
      "kind": "line",
      "limit": 10,
      "source": "忠雄さんの自宅で、",
      "target": "在忠雄先生家中"
    },
    {
      "offset": 15520,
      "kind": "line",
      "limit": 10,
      "source": "それを発見しました。",
      "target": "找到了那些文件。"
    },
    {
      "offset": 15548,
      "kind": "line",
      "limit": 11,
      "source": "…ちょっとした",
      "target": "……我只是出于"
    },
    {
      "offset": 15568,
      "kind": "line",
      "limit": 11,
      "source": "正義感のつもりだった。",
      "target": "一点正义感。"
    },
    {
      "offset": 15598,
      "kind": "line",
      "limit": 8,
      "source": "いや、その行動は",
      "target": "不，那样做"
    },
    {
      "offset": 15620,
      "kind": "line",
      "limit": 8,
      "source": "正しい！",
      "target": "是对的！"
    },
    {
      "offset": 15644,
      "kind": "line",
      "limit": 9,
      "source": "…だが、相手が",
      "target": "……但对手"
    },
    {
      "offset": 15664,
      "kind": "line",
      "limit": 9,
      "source": "ちょっと悪かった。",
      "target": "惹错了对手。"
    },
    {
      "offset": 15690,
      "kind": "line",
      "limit": 11,
      "source": "…なにせ、裏社会の顔は",
      "target": "……毕竟，他在地下世界"
    },
    {
      "offset": 15718,
      "kind": "line",
      "limit": 11,
      "source": "とてつもなく広い。",
      "target": "人脉广得惊人。"
    },
    {
      "offset": 15742,
      "kind": "line",
      "limit": 11,
      "source": "四方八方から手を回され",
      "target": "四处都布下人手，"
    },
    {
      "offset": 15770,
      "kind": "line",
      "limit": 11,
      "source": "忠雄さんは逃げ切れず、",
      "target": "忠雄先生逃脱不了，"
    },
    {
      "offset": 15798,
      "kind": "line",
      "limit": 11,
      "source": "追い込まれていった。",
      "target": "渐渐被逼入绝境。"
    },
    {
      "offset": 15826,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 15844,
      "kind": "line",
      "limit": 11,
      "source": "それで一度、家族の住む",
      "target": "于是他曾去过一次"
    },
    {
      "offset": 15874,
      "kind": "line",
      "limit": 11,
      "source": "自宅にも訪れている。",
      "target": "家人居住的家。"
    },
    {
      "offset": 15906,
      "kind": "line",
      "limit": 11,
      "source": "…暁君が会ったときだ。",
      "target": "……就是晓见过他那次。"
    },
    {
      "offset": 15956,
      "kind": "line",
      "limit": 8,
      "source": "あっ、あの時…！",
      "target": "啊，是那次……！"
    },
    {
      "offset": 15978,
      "kind": "line",
      "limit": 9,
      "source": "…でも、父が別宅に",
      "target": "……可父亲既然"
    },
    {
      "offset": 16002,
      "kind": "line",
      "limit": 9,
      "source": "住んでいたのなら…",
      "target": "住在别处……"
    },
    {
      "offset": 16026,
      "kind": "line",
      "limit": 10,
      "source": "その尼子という男は、",
      "target": "那个叫尼子的男人"
