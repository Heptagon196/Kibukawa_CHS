{
  "script": "c3_00",
  "units": [
    {"offset": 10747, "target": "这个名字…"},
    {"offset": 10771, "target": "呃，好像是…"},
    {"offset": 10802, "target": "…对了。"},
    {"offset": 10822, "target": "是克雷夫制作所。"},
    {"offset": 10857, "target": "先回事务所，"},
    {"offset": 10879, "target": "从电话簿上"},
    {"offset": 10901, "target": "找找吧…"},
    {"offset": 10956, "target": "１９９６年５月某日"},
    {"offset": 10980, "target": "天气：阴｜晴"},
    {"offset": 10998, "target": "　"},
    {"offset": 11006, "target": "森家中的对话"},
    {"offset": 11051, "target": "…亲爱的，怎么样了？"},
    {"offset": 11081, "target": "嗯，总算凑了５００万", "runs": ["嗯，总算凑了", "５００万"]},
    {"offset": 11117, "target": "日元。"},
    {"offset": 11139, "target": "真的吗！！"},
    {"offset": 11159, "target": "太好了…"},
    {"offset": 11185, "target": "这样就能熬过"},
    {"offset": 11211, "target": "下个月的还款期限…"},
    {"offset": 11233, "target": "全家也不用一起"},
    {"offset": 11255, "target": "上吊了。"},
    {"offset": 11285, "target": "亲爱的，别说这么"},
    {"offset": 11313, "target": "不吉利的话…"},
    {"offset": 11335, "target": "不过，也让慧美"},
    {"offset": 11381, "target": "担心了…"},
    {"offset": 11407, "target": "是啊…"},
    {"offset": 11427, "target": "那孩子也一直"},
    {"offset": 11453, "target": "为此烦恼。"},
    {"offset": 11481, "target": "我还担心她钻牛角尖，"},
    {"offset": 11509, "target": "做出什么坏事"},
    {"offset": 11535, "target": "来…"},
    {"offset": 11561, "target": "不，唯独那孩子"},
    {"offset": 11587, "target": "不可能那么做…"},
    {"offset": 11653, "target": "１９９６年６月某日"},
    {"offset": 11677, "target": "天气：雨"},
    {"offset": 11691, "target": "　"},
    {"offset": 11710, "target": "癸生川侦探事务所前"},
    {"offset": 11790, "target": "呼…"},
    {"offset": 11806, "target": "…为了取消委托，"},
    {"offset": 11834, "target": "我姑且又回来"},
    {"offset": 11858, "target": "了一趟…"},
    {"offset": 11884, "target": "可委托过后再来拒绝，"},
    {"offset": 11912, "target": "总觉得有些"},
    {"offset": 11938, "target": "过意不去…"},
    {"offset": 11960, "target": "况且，如果他们真的"},
    {"offset": 11988, "target": "已经展开调查…"},
    {"offset": 12014, "target": "那就继续交给他们"},
    {"offset": 12040, "target": "也好…"},
    {"offset": 12066, "target": "…唉。"},
    {"offset": 12078, "target": "我就这样再次"},
    {"offset": 12102, "target": "在事务所门前徘徊"},
    {"offset": 12130, "target": "起来。"},
    {"offset": 12161, "target": "……"},
    {"offset": 12173, "target": "…不，可是。"},
    {"offset": 12193, "target": "现在，那位侦探"},
    {"offset": 12234, "target": "白鹭洲先生一定"},
    {"offset": 12260, "target": "出门调查了。"},
    {"offset": 12288, "target": "…对。"},
    {"offset": 12304, "target": "既然不在，没法取消"},
    {"offset": 12330, "target": "也是没办法的事。"},
    {"offset": 12356, "target": "…好，就这样。"},
    {"offset": 12397, "target": "我用这种怪道理"},
    {"offset": 12417, "target": "说服自己…"},
    {"offset": 12439, "target": "心里想着千万别有人"},
    {"offset": 12465, "target": "回应，同时按下了"},
    {"offset": 12491, "target": "事务所门铃。"},
    {"offset": 12531, "target": "…………"},
    {"offset": 12559, "target": "…………………"},
    {"offset": 12595, "target": "…好，没人…"},
    {"offset": 12623, "target": "…就在我这么想时。"},
    {"offset": 12656, "target": "…哎，请进。"},
    {"offset": 12680, "target": "里面传来一句"},
    {"offset": 12706, "target": "有气无力的回应。"},
    {"offset": 12732, "target": "糟了，"},
    {"offset": 12754, "target": "原来有人…"},
    {"offset": 12776, "target": "…刚才白鹭洲先生的"},
    {"offset": 12826, "target": "声音好像不太一样…"},
    {"offset": 12854, "target": "可既然有人回应，"},
    {"offset": 12878, "target": "那就没办法了。"},
    {"offset": 12904, "target": "我打开门，"},
    {"offset": 12928, "target": "走进房间。"},
    {"offset": 12965, "target": "…打扰了…"},
    {"offset": 12989, "target": "我环顾着与刚才"},
    {"offset": 13011, "target": "一样脏乱的房间…"},
    {"offset": 13037, "target": "一个仿佛与这房间"},
    {"offset": 13061, "target": "融为一体，"},
    {"offset": 13089, "target": "邋里邋遢的…"},
    {"offset": 13131, "target": "高得出奇的男人"},
    {"offset": 13153, "target": "从里面缓缓现身。"},
    {"offset": 13192, "target": "…你是谁。"},
    {"offset": 13210, "target": "难道是委托人！？"},
    {"offset": 13238, "target": "咦…！？"},
    {"offset": 13252, "target": "不，那个…硬要说"},
    {"offset": 13280, "target": "的话，正相反…", "runs": ["的话，", "正相反…"]},
    {"offset": 13321, "target": "…这样啊。"},
    {"offset": 13337, "target": "你委托了调查，"},
    {"offset": 13357, "target": "但来取消了吧。"},
    {"offset": 13387, "target": "啊…对，对。"},
    {"offset": 13411, "target": "就、就是这样。"},
    {"offset": 13433, "target": "…真让人吃惊。"},
    {"offset": 13455, "target": "我自己都觉得刚才"},
    {"offset": 13483, "target": "那样说传达不了意思…"},
    {"offset": 13511, "target": "他却领会得"},
    {"offset": 13533, "target": "如此之快。"},
    {"offset": 13555, "target": "大概是…"},
    {"offset": 13571, "target": "这种来历不明的"},
    {"offset": 13617, "target": "侦探事务所，委托它"},
    {"offset": 13643, "target": "真的不要紧吗…"},
    {"offset": 13669, "target": "…有人这么说吧。"},
    {"offset": 13748, "target": "呃…"},
    {"offset": 13764, "target": "这、这个男人怎么回事…"},
    {"offset": 13792, "target": "难道他会读心"},
    {"offset": 13818, "target": "不成…"},
    {"offset": 13844, "target": "短短两三句话，"},
    {"offset": 13868, "target": "我便彻底被带进"},
    {"offset": 13894, "target": "了他的节奏。"},
    {"offset": 13954, "target": "交谈"},
    {"offset": 13962, "target": "调查"},
    {"offset": 13972, "target": "中断"},
    {"offset": 13995, "target": "请问，您是…？"},
    {"offset": 14031, "target": "我才不叫渡边！"},
    {"offset": 14059, "target": "啊…？"},
    {"offset": 14086, "target": "既不叫佐保山，"},
    {"offset": 14127, "target": "也不叫月下部！"},
    {"offset": 14155, "target": "更不是什么"},
    {"offset": 14201, "target": "瓜生津！"},
    {"offset": 14225, "target": "对，绝对不是！"},
    {"offset": 14253, "target": "………"},
    {"offset": 14282, "target": "我姓癸生川！"},
    {"offset": 14320, "target": "癸生川凌介！"},
    {"offset": 14363, "target": "是一名侦探！"},
    {"offset": 14381, "target": "啊，那么您就是…"},
    {"offset": 14409, "target": "招牌上写的"},
    {"offset": 14444, "target": "癸生川先生…？"},
    {"offset": 14493, "target": "癸生川侦探事务所"},
    {"offset": 14523, "target": "的侦探若姓佐野川谷"},
    {"offset": 14575, "target": "岂不是很奇怪！"},
    {"offset": 14601, "target": "可是…刚才有位"},
    {"offset": 14651, "target": "白鹭洲先生…"},
    {"offset": 14683, "target": "那不重要！"},
    {"offset": 14703, "target": "………"},
    {"offset": 14738, "target": "先不说这个，"},
    {"offset": 14777, "target": "受理委托的白鹭洲君"},
    {"offset": 14809, "target": "很遗憾出门调查了。"},
    {"offset": 14831, "target": "总之，你可以先说说"},
    {"offset": 14859, "target": "委托的内容"},
    {"offset": 14887, "target": "吗？"},
    {"offset": 14907, "target": "之后再谈。"},
    {"offset": 14933, "target": "啊、好…其实…"},
    {"offset": 14961, "target": "…于是，我再一次"},
    {"offset": 14985, "target": "说明了整件事。"},
    {"offset": 15013, "target": "这个领会力异常出众"},
    {"offset": 15041, "target": "的男人，总能瞬间"},
    {"offset": 15067, "target": "理解我的话，巧妙引导…"},
    {"offset": 15133, "target": "回过神来，我连家里的事"},
    {"offset": 15170, "target": "和慧美小姐的情况"},
    {"offset": 15204, "target": "也全说了。"},
    {"offset": 15256, "target": "…原来如此，"},
    {"offset": 15278, "target": "我明白了。"},
    {"offset": 15300, "target": "不过，那个，调查"},
    {"offset": 15324, "target": "已经不用继续了…"},
    {"offset": 15362, "target": "这样好吗！？"},
    {"offset": 15380, "target": "咦…？"},
    {"offset": 15396, "target": "来找你父亲的"},
    {"offset": 15424, "target": "那个男人，"},
    {"offset": 15450, "target": "自称什么？"},
    {"offset": 15470, "target": "咦、咦…？"},
    {"offset": 15490, "target": "对了，尼子启三！"},
    {"offset": 15553, "target": "啊，是、是的…"},
    {"offset": 15577, "target": "…您知道"},
    {"offset": 15601, "target": "那个人吗？"},
    {"offset": 15637, "target": "先别管那个。"},
    {"offset": 15661, "target": "你对灵崎朱这位女性", "runs": ["你对", "灵崎朱这位女性"]},
    {"offset": 15727, "target": "有印象吗？"},
    {"offset": 15753, "target": "灵崎朱…？"},
    {"offset": 15777, "target": "不，我想不到"},
    {"offset": 15797, "target": "这样的人…"},
    {"offset": 15827, "target": "这样啊。"},
    {"offset": 15841, "target": "那么…"},
    {"offset": 15872, "target": "你认识一个名叫"},
    {"offset": 15918, "target": "水岛绫子的人吗？"},
    {"offset": 15964, "target": "咦…！？"},
    {"offset": 15990, "target": "你果然认识！"},
    {"offset": 16016, "target": "不，这哪只是"},
    {"offset": 16038, "target": "认识…"},
    {"offset": 16064, "target": "她是我的恋人。"},
    {"offset": 16082, "target": "她是我的母亲。"},
    {"offset": 16107, "target": "她是我的祖母。"},
    {"offset": 16127, "target": "…恋人？"},
    {"offset": 16141, "target": "不不，你的恋人"},
    {"offset": 16172, "target": "是慧美。"},
    {"offset": 16196, "target": "我问的不是这个…"},
    {"offset": 16229, "target": "…祖母？"},
    {"offset": 16243, "target": "说起来，我似乎"},
    {"offset": 16271, "target": "连祖母叫什么"},
    {"offset": 16297, "target": "都没听说过…"},
    {"offset": 16319, "target": "不，总之"},
    {"offset": 16341, "target": "不是这个…"},
    {"offset": 16374, "target": "…水岛绫子，"},
    {"offset": 16394, "target": "是我母亲的名字。", "runs": ["是我", "母亲的名字。"]},
    {"offset": 16431, "target": "她现在姓蝼川内，"}
  ]
}
