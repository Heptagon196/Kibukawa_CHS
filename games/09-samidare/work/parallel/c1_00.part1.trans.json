{
  "script": "c1_00",
  "units": [
    {"offset": 35, "target": "随后，男人缓缓讲起"},
    {"offset": 63, "target": "八年前发生的"},
    {"offset": 89, "target": "事情。"},
    {"offset": 130, "target": "…此后的内容，"},
    {"offset": 154, "target": "是我生王依据"},
    {"offset": 191, "target": "他的讲述与后日谈"},
    {"offset": 221, "target": "重新编排而成。"},
    {"offset": 273, "target": "据说那天也和今天"},
    {"offset": 301, "target": "一样，下着创纪录的"},
    {"offset": 329, "target": "暴雨…"},
    {"offset": 343, "target": "天空被染成"},
    {"offset": 376, "target": "一片铅灰…"},
    {"offset": 422, "target": "１９９６年６月某日"},
    {"offset": 446, "target": "天气：雨"},
    {"offset": 460, "target": "　"},
    {"offset": 479, "target": "鞠滨市鞠滨台"},
    {"offset": 571, "target": "癸生川侦探事务所"},
    {"offset": 658, "target": "…我回来了。"},
    {"offset": 676, "target": "喂，癸生川。"},
    {"offset": 720, "target": "…不在吗？"},
    {"offset": 742, "target": "………"},
    {"offset": 756, "target": "…真是的。"},
    {"offset": 774, "target": "才几天就"},
    {"offset": 792, "target": "乱成这样。"},
    {"offset": 812, "target": "那家伙真是…"},
    {"offset": 843, "target": "我叫白鹭洲凉二。", "runs": ["我叫", "白鹭洲凉二。"]},
    {"offset": 913, "target": "在这间癸生川"},
    {"offset": 941, "target": "侦探事务所担任助手。"},
    {"offset": 965, "target": "一项历时数日的"},
    {"offset": 989, "target": "调查结束后，我久违地"},
    {"offset": 1013, "target": "回到事务所…"},
    {"offset": 1041, "target": "可短短几天就"},
    {"offset": 1063, "target": "乱成这样，"},
    {"offset": 1085, "target": "实在让人无语。"},
    {"offset": 1111, "target": "连日暴雨带来湿气，"},
    {"offset": 1139, "target": "让屋内的状况"},
    {"offset": 1167, "target": "难受到了极点。"},
    {"offset": 1197, "target": "…咳、咳！"},
    {"offset": 1223, "target": "空气也不流通。"},
    {"offset": 1267, "target": "先开窗通风吧…"},
    {"offset": 1309, "target": "第１节"},
    {"offset": 1321, "target": "　"},
    {"offset": 1329, "target": "“因为我认定了他”"},
    {"offset": 1405, "target": "环视四周"},
    {"offset": 1419, "target": "调查"},
    {"offset": 1429, "target": "呼叫"},
    {"offset": 1437, "target": "中断"},
    {"offset": 1458, "target": "书籍、文件和衣物"},
    {"offset": 1486, "target": "多得夸张，"},
    {"offset": 1512, "target": "散落得到处都是。"},
    {"offset": 1534, "target": "原本就通风不良，"},
    {"offset": 1562, "target": "屋里甚至隐约"},
    {"offset": 1597, "target": "带着霉味。"},
    {"offset": 1621, "target": "会客区乱成这样，"},
    {"offset": 1647, "target": "就算委托人来了"},
    {"offset": 1671, "target": "也没法请进来…"},
    {"offset": 1708, "target": "虽然已经惨不忍睹，"},
    {"offset": 1734, "target": "但比起隔壁他的"},
    {"offset": 1760, "target": "房间还算好。"},
    {"offset": 1788, "target": "地板"},
    {"offset": 1794, "target": "会客区"},
    {"offset": 1802, "target": "书桌"},
    {"offset": 1808, "target": "书架"},
    {"offset": 1825, "target": "真是连落脚的地方"},
    {"offset": 1853, "target": "都没有。"},
    {"offset": 1888, "target": "癸生川基本从不会"},
    {"offset": 1918, "target": "把拿出来的东西"},
    {"offset": 1944, "target": "收回去。"},
    {"offset": 1970, "target": "…不如说，"},
    {"offset": 1990, "target": "东西一旦没用了，"},
    {"offset": 2018, "target": "他只会当场"},
    {"offset": 2093, "target": "松手。"},
    {"offset": 2111, "target": "他又会四处走动，"},
    {"offset": 2137, "target": "于是地板自然而然"},
    {"offset": 2161, "target": "就成了这样。"},
    {"offset": 2187, "target": "…真是的。"},
    {"offset": 2214, "target": "能看见地板的面积"},
    {"offset": 2240, "target": "少得可怜。"},
    {"offset": 2286, "target": "这是我跑遍二手"},
    {"offset": 2314, "target": "古董店才找到的"},
    {"offset": 2342, "target": "会客桌椅。"},
    {"offset": 2362, "target": "其实它的品质"},
    {"offset": 2384, "target": "高级得与价格"},
    {"offset": 2408, "target": "完全不相称…"},
    {"offset": 2434, "target": "可看到这副惨状，"},
    {"offset": 2482, "target": "实在让人想至少"},
    {"offset": 2506, "target": "让谁坐一坐。"},
    {"offset": 2536, "target": "…高级家具都哭了。"},
    {"offset": 2564, "target": "对不起啊。"},
    {"offset": 2589, "target": "靠外的长沙发，"},
    {"offset": 2628, "target": "经常被癸生川"},
    {"offset": 2662, "target": "当作床。"},
    {"offset": 2674, "target": "…亏他睡得着，"},
    {"offset": 2702, "target": "真是的。"},
    {"offset": 2745, "target": "这是癸生川专用的桌子。"},
    {"offset": 2779, "target": "对于别人"},
    {"offset": 2805, "target": "碰这张桌子一事，"},
    {"offset": 2833, "target": "他极度厌恶。"},
    {"offset": 2845, "target": "所以要是擅自"},
    {"offset": 2869, "target": "在上面放东西，"},
    {"offset": 2895, "target": "或帮他收拾…"},
    {"offset": 2917, "target": "他就会整张脸扭曲，"},
    {"offset": 2963, "target": "一直明摆着露出"},
    {"offset": 2989, "target": "厌恶的表情。"},
    {"offset": 3015, "target": "无论发生什么，"},
    {"offset": 3043, "target": "都得一直看着那张脸，"},
    {"offset": 3071, "target": "实在受不了。"},
    {"offset": 3097, "target": "…话虽如此，他似乎"},
    {"offset": 3125, "target": "也没把桌子当成"},
    {"offset": 3151, "target": "宝贝。"},
    {"offset": 3177, "target": "他到底在坚持"},
    {"offset": 3205, "target": "什么…果然还是"},
    {"offset": 3233, "target": "搞不懂。"},
    {"offset": 3264, "target": "从那次以后，"},
    {"offset": 3290, "target": "我尽量不去碰"},
    {"offset": 3314, "target": "这张桌子。"},
    {"offset": 3354, "target": "这是为整理资料"},
    {"offset": 3378, "target": "准备的书架…"},
    {"offset": 3413, "target": "可到了癸生川手里，"},
    {"offset": 3445, "target": "这种东西仿佛"},
    {"offset": 3471, "target": "根本不需要。"},
    {"offset": 3495, "target": "即便这里"},
    {"offset": 3523, "target": "已经乱成这样…"},
    {"offset": 3545, "target": "甚至在更加"},
    {"offset": 3565, "target": "杂乱的私人房间"},
    {"offset": 3591, "target": "里…"},
    {"offset": 3615, "target": "他也能轻而易举"},
    {"offset": 3639, "target": "找到想要的东西，"},
    {"offset": 3665, "target": "从不失手。"},
    {"offset": 3681, "target": "仿佛这里本来就是"},
    {"offset": 3709, "target": "整理得井井有条的"},
    {"offset": 3735, "target": "状态。"},
    {"offset": 3753, "target": "大概是因为"},
    {"offset": 3771, "target": "他那非凡的推理能力…"},
    {"offset": 3797, "target": "能瞬间从这些"},
    {"offset": 3825, "target": "杂乱之中发现"},
    {"offset": 3853, "target": "某种规律吧。"},
    {"offset": 3879, "target": "所以即使这里"},
    {"offset": 3905, "target": "乱成这副样子，"},
    {"offset": 3929, "target": "他也丝毫不犯难。"},
    {"offset": 3953, "target": "既然不为难，"},
    {"offset": 3973, "target": "也就不必收拾。"},
    {"offset": 3999, "target": "…所以书架也"},
    {"offset": 4021, "target": "不需要。"},
    {"offset": 4054, "target": "它只有在我帮忙"},
    {"offset": 4078, "target": "收拾房间时"},
    {"offset": 4104, "target": "才有用。"},
    {"offset": 4130, "target": "癸生川"},
    {"offset": 4151, "target": "喂，癸生川。"},
    {"offset": 4195, "target": "…你在房里吗？"},
    {"offset": 4219, "target": "……"},
    {"offset": 4233, "target": "…喊了也"},
    {"offset": 4253, "target": "没人回应。"},
    {"offset": 4271, "target": "是在睡觉，还是…"},
    {"offset": 4299, "target": "不想被我逼着"},
    {"offset": 4327, "target": "收拾房间，逃走了…"},
    {"offset": 4355, "target": "吧。"},
    {"offset": 4376, "target": "等他出来，得先让他"},
    {"offset": 4402, "target": "把房间收拾好。"},
    {"offset": 4428, "target": "…真是的。"},
    {"offset": 4547, "target": "…咦？"},
    {"offset": 4561, "target": "有人来了？"},
    {"offset": 4583, "target": "这种时候若是委托人"},
    {"offset": 4611, "target": "就有点难办了…"},
    {"offset": 4637, "target": "…来了。"},
    {"offset": 4662, "target": "你好！"},
    {"offset": 4697, "target": "我是川濑莉沙！"},
    {"offset": 4739, "target": "…啊，是你。"},
    {"offset": 4759, "target": "身体没事了吗？"},
    {"offset": 4787, "target": "啊，凉二先生！"},
    {"offset": 4809, "target": "您还记得我"},
    {"offset": 4833, "target": "啊！"},
    {"offset": 4847, "target": "谢谢，我好高兴！"},
    {"offset": 4873, "target": "那、那个…我能"},
    {"offset": 4899, "target": "进去吗？"},
    {"offset": 4917, "target": "外面雨好大…"},
    {"offset": 4943, "target": "…里面有点"},
    {"offset": 4965, "target": "乱…"},
    {"offset": 4989, "target": "你不介意就好。"},
    {"offset": 5013, "target": "哈哈，没关系。"},
    {"offset": 5039, "target": "打扰了。"},
    {"offset": 5102, "target": "哎呀，真的"},
    {"offset": 5124, "target": "很乱呢。"},
    {"offset": 5152, "target": "这个嘛…"},
    {"offset": 5168, "target": "我说过了吧？"},
    {"offset": 5202, "target": "呵呵，我不会"},
    {"offset": 5224, "target": "在意这些，"},
    {"offset": 5246, "target": "没关系的。"},
    {"offset": 5278, "target": "不然的话，"},
    {"offset": 5302, "target": "我来收拾好吗？"}
  ]
}
