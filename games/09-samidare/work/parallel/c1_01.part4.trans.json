{
  "script": "c1_01",
  "units": [
    {"offset": 16798, "target": "了吧。"},
    {"offset": 16820, "target": "不只如此，"},
    {"offset": 16840, "target": "这样下去，他们可能"},
    {"offset": 16864, "target": "会负债连夜逃走…"},
    {"offset": 16888, "target": "最坏的情况，甚至可能"},
    {"offset": 16914, "target": "全家一起自杀。"},
    {"offset": 16942, "target": "听说已经如此严重！"},
    {"offset": 16970, "target": "……"},
    {"offset": 16984, "target": "不过，只要先偿还"},
    {"offset": 17006, "target": "大约５００万日元"},
    {"offset": 17036, "target": "的债务…"},
    {"offset": 17062, "target": "局面暂时就能"},
    {"offset": 17090, "target": "缓过来。"},
    {"offset": 17120, "target": "５００万日元吗。"},
    {"offset": 17144, "target": "原来如此，所以…"},
    {"offset": 17172, "target": "对，我想用自己的存款"},
    {"offset": 17200, "target": "来填补。"},
    {"offset": 17222, "target": "婚期虽然会因此推迟，"},
    {"offset": 17250, "target": "但她的家庭正面临"},
    {"offset": 17278, "target": "崩溃的危机。"},
    {"offset": 17306, "target": "如果能帮助他们"},
    {"offset": 17330, "target": "渡过难关，"},
    {"offset": 17354, "target": "这代价并不算大。"},
    {"offset": 17382, "target": "这样啊…原来还有"},
    {"offset": 17406, "target": "这样的隐情。"},
    {"offset": 17436, "target": "所以我现在一刻也不能"},
    {"offset": 17464, "target": "耽误，必须找回那笔钱。"},
    {"offset": 17492, "target": "……"},
    {"offset": 17504, "target": "…晓先生，您见过"},
    {"offset": 17546, "target": "对方的父母"},
    {"offset": 17572, "target": "吗？"},
    {"offset": 17592, "target": "…咦？慧美小姐的"},
    {"offset": 17638, "target": "父母吗？"},
    {"offset": 17658, "target": "…不，其实我还没"},
    {"offset": 17686, "target": "见过他们。"},
    {"offset": 17710, "target": "我本想去拜访，"},
    {"offset": 17734, "target": "可她总说现在"},
    {"offset": 17758, "target": "还不行…"},
    {"offset": 17782, "target": "现在想来，是因为店铺"},
    {"offset": 17808, "target": "当时就面临经营"},
    {"offset": 17834, "target": "问题吧。"},
    {"offset": 17864, "target": "唔…"},
    {"offset": 17895, "target": "她也哭着说，能依靠的"},
    {"offset": 17921, "target": "人只剩下我"},
    {"offset": 17945, "target": "了…"},
    {"offset": 17971, "target": "我想尽快看到慧美小姐"},
    {"offset": 18017, "target": "恢复开朗的笑容。"},
    {"offset": 18070, "target": "…对了，"},
    {"offset": 18103, "target": "白鹭洲先生。"},
    {"offset": 18129, "target": "什么？"},
    {"offset": 18143, "target": "那个…接下来或许"},
    {"offset": 18169, "target": "和委托没什么"},
    {"offset": 18195, "target": "关系…"},
    {"offset": 18217, "target": "没事，请说。"},
    {"offset": 18241, "target": "什么事？"},
    {"offset": 18272, "target": "白鹭洲先生有正在"},
    {"offset": 18304, "target": "交往的对象"},
    {"offset": 18330, "target": "吗？"},
    {"offset": 18346, "target": "咦？"},
    {"offset": 18358, "target": "问我…吗？"},
    {"offset": 18380, "target": "不，那个…只是觉得"},
    {"offset": 18406, "target": "您好像很了解"},
    {"offset": 18432, "target": "女性的心思…"},
    {"offset": 18458, "target": "是这样吗？"},
    {"offset": 18480, "target": "如果真是如此，大概是"},
    {"offset": 18516, "target": "因为过去调查时，"},
    {"offset": 18540, "target": "我接触过形形色色的"},
    {"offset": 18586, "target": "爱恨纠葛。"},
    {"offset": 18612, "target": "人心肮脏、扭曲的"},
    {"offset": 18647, "target": "一面，我也看过"},
    {"offset": 18679, "target": "许多次…"},
    {"offset": 18707, "target": "啊，原来如此…"},
    {"offset": 18731, "target": "…可是亲眼见过"},
    {"offset": 18757, "target": "那样的场面，"},
    {"offset": 18781, "target": "看清人的本性后…"},
    {"offset": 18805, "target": "…还是能够"},
    {"offset": 18827, "target": "喜欢上别人"},
    {"offset": 18849, "target": "吗？"},
    {"offset": 18884, "target": "………"},
    {"offset": 18901, "target": "原来如此。"},
    {"offset": 18927, "target": "…蝼川内先生，"},
    {"offset": 18973, "target": "您很不安吧？"},
    {"offset": 19003, "target": "咦…？"},
    {"offset": 19019, "target": "您母亲不论遇到什么，"},
    {"offset": 19047, "target": "都会相信自己选定的"},
    {"offset": 19075, "target": "人，一直坚持下去…"},
    {"offset": 19113, "target": "而您不确定自己"},
    {"offset": 19139, "target": "无论发生什么，"},
    {"offset": 19163, "target": "能否始终相信恋人。"},
    {"offset": 19189, "target": "您缺少这份自信，"},
    {"offset": 19215, "target": "所以感到不安…"},
    {"offset": 19237, "target": "…是啊。"},
    {"offset": 19266, "target": "唔…其、其实"},
    {"offset": 19290, "target": "正是这样。"},
    {"offset": 19314, "target": "为了她，就算失去"},
    {"offset": 19342, "target": "辛苦攒下的５００万"},
    {"offset": 19370, "target": "日元…"},
    {"offset": 19392, "target": "连我自己都很惊讶，"},
    {"offset": 19418, "target": "我竟然完全没有"},
    {"offset": 19442, "target": "一丝犹豫。"},
    {"offset": 19460, "target": "我虽然优柔寡断，"},
    {"offset": 19486, "target": "但唯独这份心意"},
    {"offset": 19514, "target": "绝不会有错。"},
    {"offset": 19538, "target": "可是…"},
    {"offset": 19556, "target": "不会有事的。"},
    {"offset": 19586, "target": "…咦？"},
    {"offset": 19615, "target": "蝼川内先生真实的"},
    {"offset": 19645, "target": "心意里，没有任何"},
    {"offset": 19675, "target": "不安或迷茫。"},
    {"offset": 19705, "target": "咦…！？"},
    {"offset": 19719, "target": "为…为什么您会"},
    {"offset": 19745, "target": "知道？"},
    {"offset": 19785, "target": "我想无论发生什么，"},
    {"offset": 19813, "target": "您都能始终相信"},
    {"offset": 19839, "target": "她。"},
    {"offset": 19863, "target": "您之所以感到不安，"},
    {"offset": 19889, "target": "一定只是想要别人"},
    {"offset": 19917, "target": "推您一把…"},
    {"offset": 19941, "target": "您心里其实早已"},
    {"offset": 19967, "target": "做好了觉悟。"},
    {"offset": 19995, "target": "…不会有事的。"},
    {"offset": 20017, "target": "……啊…"},
    {"offset": 20033, "target": "…谢谢您，真的"},
    {"offset": 20057, "target": "非常感谢。"},
    {"offset": 20093, "target": "听白鹭洲先生这么说，"},
    {"offset": 20127, "target": "我顿时觉得心里"},
    {"offset": 20155, "target": "舒畅多了。"},
    {"offset": 20181, "target": "那就好。"},
    {"offset": 20211, "target": "侦探果然连委托人的"},
    {"offset": 20239, "target": "心理也会帮忙"},
    {"offset": 20265, "target": "照顾啊。"},
    {"offset": 20289, "target": "至少我一直要求自己"},
    {"offset": 20317, "target": "做到这一点。"},
    {"offset": 20339, "target": "而且…"},
    {"offset": 20355, "target": "而且？"},
    {"offset": 20371, "target": "我也有自己"},
    {"offset": 20393, "target": "喜欢的人。"},
    {"offset": 20423, "target": "…！"},
    {"offset": 20433, "target": "…啊，听您这样说"},
    {"offset": 20459, "target": "我就放心些了。"},
    {"offset": 20485, "target": "呵呵。"},
    {"offset": 20507, "target": "那么，我们回到"},
    {"offset": 20533, "target": "委托的话题吧。"},
    {"offset": 20561, "target": "啊，好的。"},
    {"offset": 20579, "target": "抱歉，刚才说远了。"},
    {"offset": 20609, "target": "白鹭洲凉二"},
    {"offset": 20632, "target": "虽说是侦探助手，"},
    {"offset": 20656, "target": "但这个青年非常年轻。"},
    {"offset": 20691, "target": "大约２０岁吧。"},
    {"offset": 20725, "target": "他年纪虽轻，却很沉稳，"},
    {"offset": 20753, "target": "和他相处时，"},
    {"offset": 20775, "target": "会感到莫名安心。"},
    {"offset": 20799, "target": "…但换个角度看，"},
    {"offset": 20825, "target": "他又像能看透一切的"},
    {"offset": 20851, "target": "圣人，带着几分威严…"},
    {"offset": 20899, "target": "实在是个拥有"},
    {"offset": 20921, "target": "奇妙气质的青年。"},
    {"offset": 20958, "target": "他身形纤细，皮肤白皙"},
    {"offset": 20987, "target": "仿佛轻轻一碰"},
    {"offset": 21019, "target": "就会碎裂般脆弱…"},
    {"offset": 21065, "target": "这份脆弱更衬出"},
    {"offset": 21109, "target": "他身上的圣洁。"},
    {"offset": 21142, "target": "他明明应该比我"},
    {"offset": 21170, "target": "年轻得多…"},
    {"offset": 21190, "target": "我却被他的气质压倒，"},
    {"offset": 21232, "target": "不由得拘谨起来，"},
    {"offset": 21284, "target": "一直对他用敬语…"},
    {"offset": 21342, "target": "那么…接下来要进行的"},
    {"offset": 21370, "target": "调查，"},
    {"offset": 21405, "target": "蝼川内先生的母亲和", "runs": ["蝼川内先生的", "母亲和"]},
    {"offset": 21454, "target": "森慧美小姐，我想和她们"},
    {"offset": 21508, "target": "见面谈谈…"},
    {"offset": 21542, "target": "可以吗？"},
    {"offset": 21562, "target": "咦…！？"},
    {"offset": 21576, "target": "母亲那边我明白，"},
    {"offset": 21609, "target": "但连慧美也要…？"},
    {"offset": 21645, "target": "是的，请帮忙安排。"},
    {"offset": 21673, "target": "可是…慧美和父亲的"},
    {"offset": 21717, "target": "事情有什么"},
    {"offset": 21741, "target": "关系吗？"},
    {"offset": 21763, "target": "也许没有关系，"},
    {"offset": 21791, "target": "但我有些在意…"},
    {"offset": 21821, "target": "哦…"},
    {"offset": 21835, "target": "那我…会先试着"},
    {"offset": 21863, "target": "和她说一说…"},
    {"offset": 21887, "target": "不过因为这次的事，"},
    {"offset": 21913, "target": "她现在变得非常"},
    {"offset": 21961, "target": "敏感…"},
    {"offset": 21991, "target": "当然，等她本人"},
    {"offset": 22017, "target": "同意之后再安排"},
    {"offset": 22041, "target": "就可以。"},
    {"offset": 22072, "target": "…我、我知道了。"},
    {"offset": 22136, "target": "另外…"},
    {"offset": 22152, "target": "因为我本来和慧美"},
    {"offset": 22192, "target": "约好了见面，"},
    {"offset": 22231, "target": "于是这样告诉白鹭洲，"},
    {"offset": 22265, "target": "离开了事务所。"},
    {"offset": 22287, "target": "听说他决定先去我家，"},
    {"offset": 22315, "target": "和我的母亲"},
    {"offset": 22341, "target": "见面。"},
    {"offset": 22366, "target": "我联系了正在家中的"},
    {"offset": 22412, "target": "母亲，然后便"},
    {"offset": 22460, "target": "前往她等候的咖啡馆。", "runs": ["前往她等候的", "咖啡馆。"]},
    {"offset": 22533, "target": "保存"},
    {"offset": 22547, "target": "返回游戏"},
    {"offset": 22576, "target": "保存成功。"},
    {"offset": 22612, "target": "保存失败。", "runs": ["保存", "失败", "。"]}
  ]
}
