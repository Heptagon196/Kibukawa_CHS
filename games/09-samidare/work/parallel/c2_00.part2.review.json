{
  "script": "c2_00",
  "batch": "c2_00.part2.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 6118,
      "kind": "line",
      "limit": 11,
      "source": "家庭を築いてもらいたい",
      "target": "他能建立一个普通而"
    },
    {
      "offset": 6146,
      "kind": "line",
      "limit": 11,
      "source": "と、母として願います。",
      "target": "幸福的家庭。"
    },
    {
      "offset": 6176,
      "kind": "line",
      "limit": 6,
      "source": "それなのに…",
      "target": "可没想到……"
    },
    {
      "offset": 6194,
      "kind": "line",
      "limit": 11,
      "source": "なんだかすでに、波乱が",
      "target": "如今事情似乎已经"
    },
    {
      "offset": 6222,
      "kind": "line",
      "limit": 11,
      "source": "感じられる展開になって",
      "target": "朝着波折不断的方向"
    },
    {
      "offset": 6250,
      "kind": "line",
      "limit": 11,
      "source": "しまいましたね…。",
      "target": "发展了……"
    },
    {
      "offset": 6276,
      "kind": "line",
      "limit": 9,
      "source": "それは…。",
      "target": "您是说……"
    },
    {
      "offset": 6301,
      "kind": "line",
      "limit": 9,
      "source": "慧美さんの家の、",
      "target": "慧美小姐家里的"
    },
    {
      "offset": 6329,
      "kind": "line",
      "limit": 9,
      "source": "借金のことですね。",
      "target": "债务吧。"
    },
    {
      "offset": 6355,
      "kind": "line",
      "limit": 9,
      "source": "ええ、そうです。",
      "target": "是的，正是。"
    },
    {
      "offset": 6377,
      "kind": "line",
      "limit": 9,
      "source": "ご存知なんですね。",
      "target": "您已经知道了。"
    },
    {
      "offset": 6412,
      "kind": "line",
      "limit": 8,
      "source": "暁がそんなことを",
      "target": "晓跟我提过"
    },
    {
      "offset": 6440,
      "kind": "line",
      "limit": 8,
      "source": "言っていました。",
      "target": "这件事。"
    },
    {
      "offset": 6469,
      "kind": "line",
      "limit": 11,
      "source": "ですが…私、あの子には",
      "target": "可是……我从很早"
    },
    {
      "offset": 6497,
      "kind": "line",
      "limit": 11,
      "source": "昔からずっと、こう",
      "target": "以前就一直这样"
    },
    {
      "offset": 6521,
      "kind": "line",
      "limit": 11,
      "source": "教えてきました。",
      "target": "教导他。"
    },
    {
      "offset": 6545,
      "kind": "line",
      "limit": 8,
      "source": "…何でしょうか。",
      "target": "……怎么说？"
    },
    {
      "offset": 6580,
      "kind": "line",
      "limit": 11,
      "source": "お金のない苦しい生活を",
      "target": "正因为我们一直过着"
    },
    {
      "offset": 6608,
      "kind": "line",
      "limit": 11,
      "source": "続けてきたからこそ…",
      "target": "缺钱的艰苦生活……"
    },
    {
      "offset": 6636,
      "kind": "line",
      "limit": 11,
      "source": "お金に執着した生き方は",
      "target": "才更不能过上"
    },
    {
      "offset": 6690,
      "kind": "line",
      "limit": 11,
      "source": "するんじゃないよ…と。",
      "target": "执着于金钱的人生。"
    },
    {
      "offset": 6726,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 6740,
      "kind": "line",
      "limit": 10,
      "source": "お金とは、人が生み、",
      "target": "钱应该由人创造，"
    },
    {
      "offset": 6766,
      "kind": "line",
      "limit": 10,
      "source": "人が支配するもので",
      "target": "也必须由人来"
    },
    {
      "offset": 6790,
      "kind": "line",
      "limit": 10,
      "source": "なきゃいけない。",
      "target": "支配。"
    },
    {
      "offset": 6812,
      "kind": "line",
      "limit": 11,
      "source": "お金に支配され、振り",
      "target": "要是反被金钱支配，"
    },
    {
      "offset": 6838,
      "kind": "line",
      "limit": 11,
      "source": "回される生き方をして…",
      "target": "过着任它摆布的人生……"
    },
    {
      "offset": 6866,
      "kind": "line",
      "limit": 11,
      "source": "それで良いことなんて、",
      "target": "那绝不会带来"
    },
    {
      "offset": 6894,
      "kind": "line",
      "limit": 11,
      "source": "何ひとつありはしないん",
      "target": "任何好事。"
    },
    {
      "offset": 6922,
      "kind": "line",
      "limit": 11,
      "source": "だよ…って。",
      "target": "我是这样说的。"
    },
    {
      "offset": 6942,
      "kind": "line",
      "limit": 11,
      "source": "なるほど…。",
      "target": "原来如此……"
    },
    {
      "offset": 6960,
      "kind": "line",
      "limit": 11,
      "source": "重みのある言葉ですね。",
      "target": "真是一番有分量的话。"
    },
    {
      "offset": 6990,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 7004,
      "kind": "line",
      "limit": 10,
      "source": "それで、お金に執着が",
      "target": "也许正因为他对"
    },
    {
      "offset": 7056,
      "kind": "line",
      "limit": 10,
      "source": "なかったからこそ…",
      "target": "金钱并不执着……"
    },
    {
      "offset": 7080,
      "kind": "line",
      "limit": 10,
      "source": "そこまでの貯金をする",
      "target": "所以才能够"
    },
    {
      "offset": 7106,
      "kind": "line",
      "limit": 10,
      "source": "ことができたのかも",
      "target": "存下那么多"
    },
    {
      "offset": 7130,
      "kind": "line",
      "limit": 10,
      "source": "しれないですね。",
      "target": "钱吧。"
    },
    {
      "offset": 7154,
      "kind": "line",
      "limit": 7,
      "source": "…そうですね。",
      "target": "……是啊。"
    },
    {
      "offset": 7174,
      "kind": "line",
      "limit": 7,
      "source": "しかも…",
      "target": "而且……"
    },
    {
      "offset": 7188,
      "kind": "line",
      "limit": 11,
      "source": "その貯金にも固執せず",
      "target": "他不执着于那笔存款，"
    },
    {
      "offset": 7234,
      "kind": "line",
      "limit": 11,
      "source": "相手のために投げ打とう",
      "target": "甚至愿意为了对方"
    },
    {
      "offset": 7262,
      "kind": "line",
      "limit": 11,
      "source": "としてることが…",
      "target": "将钱全部拿出来……"
    },
    {
      "offset": 7284,
      "kind": "line",
      "limit": 9,
      "source": "実は、私は少し",
      "target": "其实，这让我"
    },
    {
      "offset": 7304,
      "kind": "line",
      "limit": 9,
      "source": "嬉しかったのです。",
      "target": "有些高兴。"
    },
    {
      "offset": 7328,
      "kind": "line",
      "limit": 11,
      "source": "それに、それだけの覚悟",
      "target": "况且，他要和一个"
    },
    {
      "offset": 7356,
      "kind": "line",
      "limit": 11,
      "source": "ができる相手と結婚",
      "target": "能让自己下定如此"
    },
    {
      "offset": 7380,
      "kind": "line",
      "limit": 11,
      "source": "しようというのです。",
      "target": "决心的人结婚。"
    },
    {
      "offset": 7406,
      "kind": "line",
      "limit": 9,
      "source": "私が横からとやかく",
      "target": "无需我从旁说三"
    },
    {
      "offset": 7430,
      "kind": "line",
      "limit": 9,
      "source": "口を出さなくても…",
      "target": "道四……"
    },
    {
      "offset": 7454,
      "kind": "line",
      "limit": 11,
      "source": "もうあの子の責任で、",
      "target": "我相信他能为自己"
    },
    {
      "offset": 7480,
      "kind": "line",
      "limit": 11,
      "source": "立派にやっていけると",
      "target": "负责，过好今后的"
    },
    {
      "offset": 7506,
      "kind": "line",
      "limit": 11,
      "source": "信じ、見守っています。",
      "target": "生活，所以静静守望。"
    },
    {
      "offset": 7545,
      "kind": "line",
      "limit": 10,
      "source": "決めた相手だから…と",
      "target": "因为那是他认定的人"
    },
    {
      "offset": 7577,
      "kind": "line",
      "limit": 10,
      "source": "いうことですね。",
      "target": "……对吧。"
    },
    {
      "offset": 7601,
      "kind": "line",
      "limit": 5,
      "source": "そうです。",
      "target": "正是。"
    },
    {
      "offset": 7619,
      "kind": "line",
      "limit": 6,
      "source": "わかります。",
      "target": "我能理解。"
    },
    {
      "offset": 7637,
      "kind": "line",
      "limit": 11,
      "source": "…だからこそ僕も、",
      "target": "……正因如此，我也"
    },
    {
      "offset": 7661,
      "kind": "line",
      "limit": 11,
      "source": "こうして無償で手伝いを",
      "target": "决定像这样无偿"
    },
    {
      "offset": 7711,
      "kind": "line",
      "limit": 11,
      "source": "しようと決めたんです。",
      "target": "帮忙。"
    },
    {
      "offset": 7741,
      "kind": "line",
      "limit": 8,
      "source": "えっ、無償で…？",
      "target": "咦，无偿……？"
    },
    {
      "offset": 7787,
      "kind": "line",
      "limit": 9,
      "source": "はい。お金には執着",
      "target": "是啊。我也不执着"
    },
    {
      "offset": 7832,
      "kind": "line",
      "limit": 9,
      "source": "してませんから。",
      "target": "于金钱。"
    },
    {
      "offset": 7856,
      "kind": "line",
      "limit": 8,
      "source": "ふふふ、面白い",
      "target": "呵呵呵，真是一位"
    },
    {
      "offset": 7876,
      "kind": "line",
      "limit": 8,
      "source": "探偵さんですね。",
      "target": "有趣的侦探。"
    },
    {
      "offset": 7900,
      "kind": "line",
      "limit": 11,
      "source": "ありがとうございます。",
      "target": "谢谢夸奖。"
    },
    {
      "offset": 7949,
      "kind": "line",
      "limit": 10,
      "source": "それで…暁さんの交際",
      "target": "那么……关于晓先生"
    },
    {
      "offset": 7995,
      "kind": "line",
      "limit": 10,
      "source": "相手の、慧美さんの",
      "target": "交往的对象慧美"
    },
    {
      "offset": 8039,
      "kind": "line",
      "limit": 10,
      "source": "ことなんですが…。",
      "target": "小姐……"
    },
    {
      "offset": 8063,
      "kind": "line",
      "limit": 11,
      "source": "なにか…気になることは",
      "target": "您有没有什么地方"
    },
    {
      "offset": 8091,
      "kind": "line",
      "limit": 11,
      "source": "ありませんか？",
      "target": "觉得不对劲？"
    },
    {
      "offset": 8113,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "……"
    },
    {
      "offset": 8127,
      "kind": "line",
      "limit": 6,
      "source": "…探偵さん。",
      "target": "……侦探先生"
    },
    {
      "offset": 8145,
      "kind": "line",
      "limit": 10,
      "source": "やぶから棒にそれを",
      "target": "您突然问起这个，"
    },
    {
      "offset": 8176,
      "kind": "line",
      "limit": 10,
      "source": "尋ねるということは…",
      "target": "是不是说明……"
    },
    {
      "offset": 8208,
      "kind": "line",
      "limit": 10,
      "source": "もう、何か思い当たる",
      "target": "您已经想到"
    },
    {
      "offset": 8234,
      "kind": "line",
      "limit": 10,
      "source": "ことがあるんじゃない",
      "target": "什么了"
    },
    {
      "offset": 8260,
      "kind": "line",
      "limit": 10,
      "source": "のですか？",
      "target": "呢？"
    },
    {
      "offset": 8278,
      "kind": "line",
      "limit": 10,
      "source": "…さすがですね。",
      "target": "……您真敏锐。"
    },
    {
      "offset": 8300,
      "kind": "line",
      "limit": 10,
      "source": "実は、そうなんです。",
      "target": "其实，的确如此。"
    },
    {
      "offset": 8333,
      "kind": "line",
      "limit": 11,
      "source": "さすがに暁さん本人には",
      "target": "我实在没法对晓先生"
    },
    {
      "offset": 8381,
      "kind": "line",
      "limit": 11,
      "source": "言えなかったのですが…",
      "target": "本人说出口……"
    },
    {
      "offset": 8409,
      "kind": "line",
      "limit": 11,
      "source": "気になることがひとつ、",
      "target": "但有件事一直令我"
    },
    {
      "offset": 8437,
      "kind": "line",
      "limit": 11,
      "source": "あるんです。",
      "target": "在意。"
    },
    {
      "offset": 8457,
      "kind": "line",
      "limit": 8,
      "source": "何でしょうか…。",
      "target": "是什么……"
    },
    {
      "offset": 8492,
      "kind": "line",
      "limit": 3,
      "source": "まず…",
      "target": "首先，"
    },
    {
      "offset": 8504,
      "kind": "line",
      "limit": 9,
      "source": "２人が出会ってから",
      "target": "两人相识至今"
    },
    {
      "offset": 8528,
      "kind": "line",
      "limit": 9,
      "source": "まだ３ヶ月と、日が",
      "target": "才三个月，时间很短",
      "runs": [
        "才三个月，",
        "时间很短"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "まだ３ヶ月と、"
        },
        {
          "colour": 2,
          "text": "日が"
        }
      ]
    },
    {
      "offset": 8559,
      "kind": "line",
      "limit": 9,
      "source": "浅いということ。",
      "target": "这一点。"
    },
    {
      "offset": 8587,
      "kind": "line",
      "limit": 11,
      "source": "そして、結婚をかさに",
      "target": "其次，对方打着结婚"
    },
    {
      "offset": 8613,
      "kind": "line",
      "limit": 11,
      "source": "家庭の事情などで高額の",
      "target": "的旗号，以家庭状况"
    },
    {
      "offset": 8643,
      "kind": "line",
      "limit": 11,
      "source": "現金を要求しています。",
      "target": "为由索要巨款。"
    },
    {
      "offset": 8677,
      "kind": "line",
      "limit": 11,
      "source": "しかも、親に会うこと、",
      "target": "而且，她拒绝拜见"
    },
    {
      "offset": 8705,
      "kind": "line",
      "limit": 11,
      "source": "そして会わせることは",
      "target": "晓先生的母亲，也"
    },
    {
      "offset": 8733,
      "kind": "line",
      "limit": 11,
      "source": "拒否していた。",
      "target": "不让他见自己父母。"
    },
    {
      "offset": 8759,
      "kind": "line",
      "limit": 11,
      "source": "これは、もしかすると…",
      "target": "这会不会是……"
    },
    {
      "offset": 8789,
      "kind": "line",
      "limit": 8,
      "source": "…あっ、まさか…",
      "target": "……啊，难道……"
    },
    {
      "offset": 8813,
      "kind": "line",
      "limit": 9,
      "source": "結婚詐欺では…!?",
      "target": "是婚姻诈骗……！？"
    },
    {
      "offset": 8880,
      "kind": "line",
      "limit": 10,
      "source": "…そうです。",
      "target": "……没错。"
    },
    {
      "offset": 8898,
      "kind": "line",
      "limit": 10,
      "source": "よくわかりましたね。",
      "target": "您一下就明白了。"
    },
    {
      "offset": 8936,
      "kind": "line",
      "limit": 10,
      "source": "言われてみれば、",
      "target": "听您这么一说，"
    },
    {
      "offset": 8960,
      "kind": "line",
      "limit": 10,
      "source": "典型的な手口です…。",
      "target": "确实是典型手法……"
    },
    {
      "offset": 8994,
      "kind": "line",
      "limit": 11,
      "source": "…なので、慧美さんにも",
      "target": "……所以我也请求"
    },
    {
      "offset": 9042,
      "kind": "line",
      "limit": 11,
      "source": "話を聞かせて欲しい、と",
      "target": "慧美小姐，让我和她"
    },
    {
      "offset": 9070,
      "kind": "line",
      "limit": 11,
      "source": "お願いしたのです。",
      "target": "谈一谈。"
    },
    {
      "offset": 9094,
      "kind": "line",
      "limit": 10,
      "source": "本当にお金が必要で、",
      "target": "如果她确实急需钱，"
    },
    {
      "offset": 9120,
      "kind": "line",
      "limit": 10,
      "source": "貯金を探して欲しいと",
      "target": "真心希望我们找回"
    },
    {
      "offset": 9146,
      "kind": "line",
      "limit": 10,
      "source": "思っているのなら…",
      "target": "那笔存款……"
    },
    {
      "offset": 9170,
      "kind": "line",
      "limit": 10,
      "source": "そのくらいの協力は、",
      "target": "这种程度的配合，"
    },
    {
      "offset": 9196,
      "kind": "line",
      "limit": 10,
      "source": "してくれると思うん",
      "target": "她应该会答应"
    },
    {
      "offset": 9220,
      "kind": "line",
      "limit": 10,
      "source": "です。",
      "target": "才对。"
    },
    {
      "offset": 9232,
      "kind": "line",
      "limit": 4,
      "source": "しかし…",
      "target": "可是……"
    },
    {
      "offset": 9258,
      "kind": "line",
      "limit": 10,
      "source": "もし、詐欺だったら…",
      "target": "如果那真是诈骗……"
    },
    {
      "offset": 9302,
      "kind": "line",
      "limit": 11,
      "source": "…絶対に、探偵と会おう",
      "target": "……她绝不会愿意"
    },
    {
      "offset": 9330,
      "kind": "line",
      "limit": 11,
      "source": "とはしないでしょうね。",
      "target": "见侦探吧。"
    },
    {
      "offset": 9360,
      "kind": "line",
      "limit": 10,
      "source": "…そういうことです。",
      "target": "……正是如此。"
    },
    {
      "offset": 9386,
      "kind": "line",
      "limit": 11,
      "source": "僕は、暁さんの貯金の",
      "target": "我不仅在意晓先生"
    },
    {
      "offset": 9441,
      "kind": "line",
      "limit": 11,
      "source": "在処だけでなく、",
      "target": "存款的下落，"
    },
    {
      "offset": 9469,
      "kind": "line",
      "limit": 11,
      "source": "そこも気になるんです。",
      "target": "也很在意这件事。"
    },
    {
      "offset": 9499,
      "kind": "line",
      "limit": 11,
      "source": "普段は優柔不断なのに、",
