  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 12306,
      "kind": "line",
      "limit": 11,
      "source": "していました。",
      "target": "听取他的意见。"
    },
    {
      "offset": 12328,
      "kind": "line",
      "limit": 11,
      "source": "忠雄さんのことも",
      "target": "忠雄先生的事"
    },
    {
      "offset": 12350,
      "kind": "line",
      "limit": 11,
      "source": "相談していたんですか？",
      "target": "也和他商量过吗？"
    },
    {
      "offset": 12380,
      "kind": "line",
      "limit": 11,
      "source": "いえ。",
      "target": "没有。"
    },
    {
      "offset": 12392,
      "kind": "line",
      "limit": 11,
      "source": "あの人についての話は",
      "target": "关于那个人，"
    },
    {
      "offset": 12418,
      "kind": "line",
      "limit": 11,
      "source": "ほとんどしていません。",
      "target": "我几乎什么都没说。"
    },
    {
      "offset": 12456,
      "kind": "line",
      "limit": 11,
      "source": "…夫のことを話すと、",
      "target": "……我觉得谈起丈夫"
    },
    {
      "offset": 12482,
      "kind": "line",
      "limit": 11,
      "source": "よけいな心配をさせる",
      "target": "只会让父亲平添"
    },
    {
      "offset": 12508,
      "kind": "line",
      "limit": 11,
      "source": "だけだと思ったので…。",
      "target": "担心……"
    },
    {
      "offset": 12538,
      "kind": "line",
      "limit": 10,
      "source": "ああ、そうですよね。",
      "target": "啊，也对。"
    },
    {
      "offset": 12564,
      "kind": "line",
      "limit": 10,
      "source": "別に不満に思っていた",
      "target": "毕竟您似乎也并未"
    },
    {
      "offset": 12590,
      "kind": "line",
      "limit": 10,
      "source": "わけではなかったよう",
      "target": "对此心怀不满。"
    },
    {
      "offset": 12616,
      "kind": "line",
      "limit": 10,
      "source": "ですし。",
      "target": "是吧。"
    },
    {
      "offset": 12642,
      "kind": "line",
      "limit": 10,
      "source": "ええ、そうです。",
      "target": "是的，没错。"
    },
    {
      "offset": 12664,
      "kind": "line",
      "limit": 10,
      "source": "私たちのことは",
      "target": "我们的事"
    },
    {
      "offset": 12684,
      "kind": "line",
      "limit": 10,
      "source": "私たちの問題なので…",
      "target": "是我们自己的问题……"
    },
    {
      "offset": 12710,
      "kind": "line",
      "limit": 9,
      "source": "放っておいて",
      "target": "我希望别人"
    },
    {
      "offset": 12728,
      "kind": "line",
      "limit": 9,
      "source": "欲しかったんです。",
      "target": "不要干涉。"
    },
    {
      "offset": 12754,
      "kind": "line",
      "limit": 11,
      "source": "では…お父様は暁さんの",
      "target": "那么……您父亲知道"
    },
    {
      "offset": 12802,
      "kind": "line",
      "limit": 11,
      "source": "貯金のことは、ご存知",
      "target": "晓先生在存钱的"
    },
    {
      "offset": 12828,
      "kind": "line",
      "limit": 11,
      "source": "だったんでしょうか。",
      "target": "事吗？"
    },
    {
      "offset": 12866,
      "kind": "line",
      "limit": 7,
      "source": "…知ってます。",
      "target": "……他知道。"
    },
    {
      "offset": 12886,
      "kind": "line",
      "limit": 10,
      "source": "頑張って結婚資金を",
      "target": "我和他说过晓正"
    },
    {
      "offset": 12910,
      "kind": "line",
      "limit": 10,
      "source": "貯めてるという話は、",
      "target": "努力攒结婚资金，"
    },
    {
      "offset": 12936,
      "kind": "line",
      "limit": 10,
      "source": "何度かしましたので。",
      "target": "而且说过几次。"
    },
    {
      "offset": 12964,
      "kind": "line",
      "limit": 8,
      "source": "通帳の場所は…？",
      "target": "存折在哪里……？"
    },
    {
      "offset": 12988,
      "kind": "line",
      "limit": 4,
      "source": "それは…",
      "target": "这个……"
    },
    {
      "offset": 13002,
      "kind": "line",
      "limit": 10,
      "source": "見ての通り、物の",
      "target": "您也看见了，"
    },
    {
      "offset": 13024,
      "kind": "line",
      "limit": 10,
      "source": "少ない家ですから…。",
      "target": "家里的东西很少……"
    },
    {
      "offset": 13052,
      "kind": "line",
      "limit": 9,
      "source": "…ああ、なるほど。",
      "target": "……啊，我明白了。"
    },
    {
      "offset": 13076,
      "kind": "line",
      "limit": 9,
      "source": "大事なものをどこに",
      "target": "重要的东西会放"
    },
    {
      "offset": 13100,
      "kind": "line",
      "limit": 9,
      "source": "しまうかは…",
      "target": "在哪里……"
    },
    {
      "offset": 13118,
      "kind": "line",
      "limit": 10,
      "source": "何度か足を運べば",
      "target": "只要来过几次，"
    },
    {
      "offset": 13140,
      "kind": "line",
      "limit": 10,
      "source": "だいたい見当がつく、",
      "target": "大概就能猜到，"
    },
    {
      "offset": 13166,
      "kind": "line",
      "limit": 10,
      "source": "ということですね。",
      "target": "是这个意思吧。"
    },
    {
      "offset": 13192,
      "kind": "line",
      "limit": 10,
      "source": "でも、まさか父が…。",
      "target": "可是，父亲怎么会……"
    },
    {
      "offset": 13255,
      "kind": "line",
      "limit": 10,
      "source": "通帳を盗んだのが",
      "target": "如果偷走存折的"
    },
    {
      "offset": 13277,
      "kind": "line",
      "limit": 10,
      "source": "忠雄さんでないなら…",
      "target": "人不是忠雄先生……"
    },
    {
      "offset": 13303,
      "kind": "line",
      "limit": 11,
      "source": "お父様がもっとも",
      "target": "那您父亲恐怕"
    },
    {
      "offset": 13325,
      "kind": "line",
      "limit": 11,
      "source": "可能性が高い人物という",
      "target": "就是嫌疑最大"
    },
    {
      "offset": 13353,
      "kind": "line",
      "limit": 11,
      "source": "ことになりますが…。",
      "target": "的人了……"
    },
    {
      "offset": 13391,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "……"
    },
    {
      "offset": 13444,
      "kind": "line",
      "limit": 10,
      "source": "そのお父様のことを、",
      "target": "关于您父亲，"
    },
    {
      "offset": 13470,
      "kind": "line",
      "limit": 10,
      "source": "もう少し詳しく",
      "target": "能再详细告诉我"
    },
    {
      "offset": 13490,
      "kind": "line",
      "limit": 10,
      "source": "教えてもらえますか。",
      "target": "一些吗？"
    },
    {
      "offset": 13516,
      "kind": "line",
      "limit": 11,
      "source": "今は、どこで何をしてる",
      "target": "他现在在哪里，"
    },
    {
      "offset": 13544,
      "kind": "line",
      "limit": 11,
      "source": "のでしょうか。",
      "target": "又在做什么？"
    },
    {
      "offset": 13566,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 13578,
      "kind": "line",
      "limit": 11,
      "source": "父の名前は、水島寅男と",
      "target": "我父亲名叫水岛寅男。",
      "runs": [
        "我父亲名叫",
        "水岛寅男。"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "父の名前は、"
        },
        {
          "colour": 2,
          "text": "水島寅男と"
        }
      ]
    },
    {
      "offset": 13646,
      "kind": "line",
      "limit": 11,
      "source": "いいます。",
      "target": "就是这个名字。"
    },
    {
      "offset": 13662,
      "kind": "line",
      "limit": 11,
      "source": "私の旧姓の、水島です。",
      "target": "水岛是我的旧姓。"
    },
    {
      "offset": 13700,
      "kind": "line",
      "limit": 8,
      "source": "今、どこで何を",
      "target": "他现在在哪里，"
    },
    {
      "offset": 13720,
      "kind": "line",
      "limit": 8,
      "source": "しているのかは…",
      "target": "又在做什么……"
    },
    {
      "offset": 13742,
      "kind": "line",
      "limit": 11,
      "source": "恥ずかしながら、私も",
      "target": "说来惭愧，我也"
    },
    {
      "offset": 13768,
      "kind": "line",
      "limit": 11,
      "source": "よくわからないのです。",
      "target": "不太清楚。"
    },
    {
      "offset": 13798,
      "kind": "line",
      "limit": 4,
      "source": "えっ…？",
      "target": "咦……？"
    },
    {
      "offset": 13824,
      "kind": "line",
      "limit": 11,
      "source": "父は、私が幼い頃から",
      "target": "从我年幼时起，父亲"
    },
    {
      "offset": 13865,
      "kind": "line",
      "limit": 11,
      "source": "飄々と世の中を渡り歩く",
      "target": "就一直游戏人间，"
    },
    {
      "offset": 13914,
      "kind": "line",
      "limit": 11,
      "source": "風来人のような人で…",
      "target": "像个四处漂泊的浪子……"
    },
    {
      "offset": 13946,
      "kind": "line",
      "limit": 11,
      "source": "定職にも就かずに",
      "target": "他没有固定工作，"
    },
    {
      "offset": 13984,
      "kind": "line",
      "limit": 11,
      "source": "全国を旅して回っている",
      "target": "终年在全国四处旅行，"
    },
    {
      "offset": 14012,
      "kind": "line",
      "limit": 11,
      "source": "変わった人でした。",
      "target": "是个怪人。"
    },
    {
      "offset": 14036,
      "kind": "line",
      "limit": 11,
      "source": "なので、ほとんど家には",
      "target": "所以，他几乎从来"
    },
    {
      "offset": 14064,
      "kind": "line",
      "limit": 11,
      "source": "帰って来ませんでした",
      "target": "不回家……"
    },
    {
      "offset": 14090,
      "kind": "line",
      "limit": 11,
      "source": "が…。",
      "target": "就是了……"
    },
    {
      "offset": 14104,
      "kind": "line",
      "limit": 10,
      "source": "へえ…。",
      "target": "这样啊……"
    },
    {
      "offset": 14118,
      "kind": "line",
      "limit": 10,
      "source": "なんだかすごい",
      "target": "您父亲还真是位"
    },
    {
      "offset": 14138,
      "kind": "line",
      "limit": 10,
      "source": "お父様なんですね…。",
      "target": "不得了的人……"
    },
    {
      "offset": 14164,
      "kind": "line",
      "limit": 11,
      "source": "失礼ですが、生活費は",
      "target": "恕我冒昧，那生活费"
    },
    {
      "offset": 14190,
      "kind": "line",
      "limit": 11,
      "source": "どうされてたんですか？",
      "target": "又是怎么解决的？"
    },
    {
      "offset": 14220,
      "kind": "line",
      "limit": 9,
      "source": "毎月必ず、仕送りが",
      "target": "每个月都会准时"
    },
    {
      "offset": 14244,
      "kind": "line",
      "limit": 9,
      "source": "送られてきました。",
      "target": "寄来生活费。"
    },
    {
      "offset": 14268,
      "kind": "line",
      "limit": 10,
      "source": "どういう仕事をして",
      "target": "至于他到底做"
    },
    {
      "offset": 14292,
      "kind": "line",
      "limit": 10,
      "source": "いたのかは、わかりま",
      "target": "什么工作，我并不"
    },
    {
      "offset": 14318,
      "kind": "line",
      "limit": 10,
      "source": "せんが…。",
      "target": "清楚……"
    },
    {
      "offset": 14336,
      "kind": "line",
      "limit": 6,
      "source": "なるほど…。",
      "target": "原来如此……"
    },
    {
      "offset": 14356,
      "kind": "line",
      "limit": 11,
      "source": "しかも、今でも変わらず",
      "target": "而且，他现在仍旧"
    },
    {
      "offset": 14384,
      "kind": "line",
      "limit": 11,
      "source": "そういう暮らしをして",
      "target": "过着那样的生活，"
    },
    {
      "offset": 14410,
      "kind": "line",
      "limit": 11,
      "source": "いるんです。",
      "target": "一点没变。"
    },
    {
      "offset": 14428,
      "kind": "line",
      "limit": 11,
      "source": "もう年は７０を軽く",
      "target": "明明已经年过"
    },
    {
      "offset": 14452,
      "kind": "line",
      "limit": 11,
      "source": "越えているのですが…。",
      "target": "七十了……"
    },
    {
      "offset": 14482,
      "kind": "line",
      "limit": 8,
      "source": "えっ、今でも…？",
      "target": "咦，至今还……？"
    },
    {
      "offset": 14504,
      "kind": "line",
      "limit": 10,
      "source": "…すると、こちらから",
      "target": "……那么，您这边"
    },
    {
      "offset": 14530,
      "kind": "line",
      "limit": 10,
      "source": "連絡を取ることは…？",
      "target": "能联系到他吗？"
    },
    {
      "offset": 14558,
      "kind": "line",
      "limit": 9,
      "source": "はい、できません。",
      "target": "是的，联系不到。",
      "runs": [
        "是的，",
        "联系不到。"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "はい、"
        },
        {
          "colour": 2,
          "text": "できません。"
        }
      ]
    },
    {
      "offset": 14595,
      "kind": "line",
      "limit": 10,
      "source": "会うときはいつも",
      "target": "每次见面，都是"
    },
    {
      "offset": 14617,
      "kind": "line",
      "limit": 10,
      "source": "父から連絡が来ます。",
      "target": "父亲主动联系我。"
    },
    {
      "offset": 14643,
      "kind": "line",
      "limit": 10,
      "source": "…時々、連絡せず突然",
      "target": "……他偶尔也会"
    },
    {
      "offset": 14669,
      "kind": "line",
      "limit": 10,
      "source": "このアパートに来る",
      "target": "不打招呼，突然来"
    },
    {
      "offset": 14693,
      "kind": "line",
      "limit": 10,
      "source": "こともありますが。",
      "target": "这间公寓。"
    },
    {
      "offset": 14719,
      "kind": "line",
      "limit": 4,
      "source": "ふむ…。",
      "target": "唔……"
    },
    {
      "offset": 14733,
      "kind": "line",
      "limit": 11,
      "source": "では、最後に会ったのは",
      "target": "那么，您最后一次"
    },
    {
      "offset": 14761,
      "kind": "line",
      "limit": 11,
      "source": "いつですか？",
      "target": "见他是什么时候？"
    },
    {
      "offset": 14793,
      "kind": "line",
      "limit": 8,
      "source": "２ヶ月ほど前に",
      "target": "大概是两个月"
    },
    {
      "offset": 14819,
      "kind": "line",
      "limit": 8,
      "source": "なるでしょうか。",
      "target": "以前。"
    },
    {
      "offset": 14843,
      "kind": "line",
      "limit": 11,
      "source": "…すると、その時は",
      "target": "……那么，当时他"
    },
    {
      "offset": 14867,
      "kind": "line",
      "limit": 11,
      "source": "鞠浜にいたわけですね。",
      "target": "还在鞠滨。"
    },
    {
      "offset": 14897,
      "kind": "line",
      "limit": 3,
      "source": "はい。",
      "target": "是的。"
    },
    {
      "offset": 14909,
      "kind": "line",
      "limit": 11,
      "source": "ですが今はもう、どこに",
      "target": "但他如今究竟在哪，"
    },
    {
      "offset": 14937,
      "kind": "line",
      "limit": 11,
      "source": "いるのかさっぱり…。",
      "target": "我完全不清楚……"
    },
    {
      "offset": 14965,
      "kind": "line",
      "limit": 4,
      "source": "ふむ…。",
      "target": "唔……"
    },
    {
      "offset": 14979,
      "kind": "line",
      "limit": 10,
      "source": "そうなると、会って",
      "target": "这样一来，想见他"
    },
    {
      "offset": 15003,
      "kind": "line",
      "limit": 10,
      "source": "話を聞くのは難しそう",
      "target": "并询问情况似乎很"
    },
    {
      "offset": 15029,
      "kind": "line",
      "limit": 10,
      "source": "ですね…。",
      "target": "困难……"
    },
    {
      "offset": 15047,
      "kind": "line",
      "limit": 6,
      "source": "そうですね。",
      "target": "是啊。"
    },
    {
      "offset": 15065,
      "kind": "line",
      "limit": 11,
      "source": "私はもう、父はそういう",
      "target": "我早已认为父亲就是"
    },
    {
      "offset": 15093,
      "kind": "line",
      "limit": 11,
      "source": "ものだと思って、慣れて",
      "target": "那样的人，也已经"
    },
    {
      "offset": 15121,
      "kind": "line",
      "limit": 11,
      "source": "いますから…。",
      "target": "习惯了……"
    },
    {
      "offset": 15143,
      "kind": "line",
      "limit": 6,
      "source": "なるほど…。",
      "target": "原来如此……"
    },
    {
      "offset": 15161,
      "kind": "line",
      "limit": 10,
      "source": "…その時、寅男さんに",
      "target": "……当时，寅男先生"
    },
    {
      "offset": 15207,
      "kind": "line",
      "limit": 10,
      "source": "何か変わった様子は",
      "target": "有没有什么反常"
    },
    {
      "offset": 15231,
      "kind": "line",
      "limit": 10,
      "source": "ありましたか？",
      "target": "的表现？"
    },
    {
      "offset": 15263,
      "kind": "line",
      "limit": 11,
      "source": "そうですね、特には…。",
      "target": "这个嘛，没什么……"
    },
    {
      "offset": 15301,
      "kind": "line",
      "limit": 11,
      "source": "強いて言えば、珍しく",
      "target": "非要说的话，他难得"
    },
    {
      "offset": 15327,
      "kind": "line",
      "limit": 11,
      "source": "夫の居場所を聞いてきた",
      "target": "问起了我丈夫的"
    },
    {
      "offset": 15355,
      "kind": "line",
      "limit": 11,
      "source": "…くらいでしょうか。",
      "target": "下落……就这件事吧。"
    },
    {
      "offset": 15383,
      "kind": "line",
      "limit": 10,
      "source": "忠雄さんの居場所を？",
      "target": "他问忠雄先生在哪？"
    },
    {
      "offset": 15411,
