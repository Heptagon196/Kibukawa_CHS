{
  "script": "c4_01",
  "batch": "c4_01.part2.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 4705,
      "kind": "line",
      "limit": 9,
      "source": "本来なら、喜ぶべき",
      "target": "本来应该是件"
    },
    {
      "offset": 4729,
      "kind": "line",
      "limit": 9,
      "source": "ことなんだけど…。",
      "target": "值得高兴的事…"
    },
    {
      "offset": 4755,
      "kind": "line",
      "limit": 5,
      "source": "…でしょ？",
      "target": "…对吧？"
    },
    {
      "offset": 4773,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 4789,
      "kind": "line",
      "limit": 10,
      "source": "２人でも暮らしていく",
      "target": "我们连两个人"
    },
    {
      "offset": 4815,
      "kind": "line",
      "limit": 10,
      "source": "お金もないのに…",
      "target": "生活的钱都没有…"
    },
    {
      "offset": 4837,
      "kind": "line",
      "limit": 9,
      "source": "子供なんて、とても",
      "target": "更别说养育"
    },
    {
      "offset": 4861,
      "kind": "line",
      "limit": 9,
      "source": "育てられないよ。",
      "target": "孩子了。"
    },
    {
      "offset": 4885,
      "kind": "line",
      "limit": 7,
      "source": "そう…だよね。",
      "target": "是…啊。"
    },
    {
      "offset": 4907,
      "kind": "line",
      "limit": 8,
      "source": "もう、無理なの。",
      "target": "已经没办法了。"
    },
    {
      "offset": 4931,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 4947,
      "kind": "line",
      "limit": 9,
      "source": "暁さんの物分かりが",
      "target": "晓能理解这些，"
    },
    {
      "offset": 4971,
      "kind": "line",
      "limit": 9,
      "source": "良くて、嬉しいよ。",
      "target": "我很高兴。"
    },
    {
      "offset": 4995,
      "kind": "line",
      "limit": 10,
      "source": "…わたしのことを",
      "target": "…如果你真的"
    },
    {
      "offset": 5017,
      "kind": "line",
      "limit": 10,
      "source": "想ってくれてるなら、",
      "target": "为我着想，"
    },
    {
      "offset": 5043,
      "kind": "line",
      "limit": 10,
      "source": "もう何も言わないで。",
      "target": "就什么都别说了。"
    },
    {
      "offset": 5069,
      "kind": "line",
      "limit": 3,
      "source": "…ね？",
      "target": "…吧？"
    },
    {
      "offset": 5083,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 5097,
      "kind": "line",
      "limit": 6,
      "source": "…わかった。",
      "target": "…我明白了。"
    },
    {
      "offset": 5117,
      "kind": "line",
      "limit": 6,
      "source": "…ありがと。",
      "target": "…谢谢。"
    },
    {
      "offset": 5150,
      "kind": "line",
      "limit": 7,
      "source": "そうか…",
      "target": "这样啊…"
    },
    {
      "offset": 5164,
      "kind": "line",
      "limit": 7,
      "source": "…わかったよ。",
      "target": "…我明白了。"
    },
    {
      "offset": 5184,
      "kind": "line",
      "limit": 11,
      "source": "やっぱり…そういうこと",
      "target": "果然…就是这么"
    },
    {
      "offset": 5278,
      "kind": "line",
      "limit": 11,
      "source": "だったんだね…。",
      "target": "回事啊…"
    },
    {
      "offset": 5302,
      "kind": "line",
      "limit": 6,
      "source": "…ごめんね。",
      "target": "…对不起。"
    },
    {
      "offset": 5320,
      "kind": "line",
      "limit": 11,
      "source": "今まで、ありがとう…。",
      "target": "一直以来，谢谢你…"
    },
    {
      "offset": 5350,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 5372,
      "kind": "line",
      "limit": 9,
      "source": "…じゃあね。",
      "target": "…再见。"
    },
    {
      "offset": 5390,
      "kind": "line",
      "limit": 9,
      "source": "わたし、行くね…。",
      "target": "我走了…"
    },
    {
      "offset": 5414,
      "kind": "line",
      "limit": 6,
      "source": "…さよなら。",
      "target": "…永别了。"
    },
    {
      "offset": 5434,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 5460,
      "kind": "line",
      "limit": 5,
      "source": "そして…。",
      "target": "然后…"
    },
    {
      "offset": 5476,
      "kind": "line",
      "limit": 11,
      "source": "彼女は後ろを振り向き、",
      "target": "她背过身去，"
    },
    {
      "offset": 5504,
      "kind": "line",
      "limit": 11,
      "source": "ゆっくりと去っていく。",
      "target": "缓缓离开了。"
    },
    {
      "offset": 5534,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 5551,
      "kind": "choice",
      "limit": 0,
      "source": "見ている",
      "target": "默默看着"
    },
    {
      "offset": 5563,
      "kind": "choice",
      "limit": 0,
      "source": "呼び止める",
      "target": "叫住她"
    },
    {
      "offset": 5579,
      "kind": "line",
      "limit": 11,
      "source": "私は、去っていく",
      "target": "我只是默默凝望"
    },
    {
      "offset": 5610,
      "kind": "line",
      "limit": 11,
      "source": "慧美さんの背中を、",
      "target": "着慧美渐渐远去的"
    },
    {
      "offset": 5640,
      "kind": "line",
      "limit": 11,
      "source": "ただじっと見ていた…。",
      "target": "背影…"
    },
    {
      "offset": 5690,
      "kind": "line",
      "limit": 11,
      "source": "…これでよかったんだ。",
      "target": "…这样就好。"
    },
    {
      "offset": 5718,
      "kind": "line",
      "limit": 9,
      "source": "彼女がこれを望んだ",
      "target": "因为这正是她"
    },
    {
      "offset": 5742,
      "kind": "line",
      "limit": 9,
      "source": "のだから…。",
      "target": "所希望的…"
    },
    {
      "offset": 5760,
      "kind": "line",
      "limit": 5,
      "source": "いいんだ。",
      "target": "这样就好。"
    },
    {
      "offset": 5776,
      "kind": "line",
      "limit": 4,
      "source": "もう…。",
      "target": "已经…"
    },
    {
      "offset": 5790,
      "kind": "line",
      "limit": 7,
      "source": "…これで、",
      "target": "…到这里，"
    },
    {
      "offset": 5806,
      "kind": "line",
      "limit": 7,
      "source": "おわりなんだ。",
      "target": "一切都结束了。"
    },
    {
      "offset": 5831,
      "kind": "line",
      "limit": 8,
      "source": "…さ、慧美さん！",
      "target": "…慧美！"
    },
    {
      "offset": 5875,
      "kind": "line",
      "limit": 11,
      "source": "私は、いつの間にか",
      "target": "我不知不觉间"
    },
    {
      "offset": 5899,
      "kind": "line",
      "limit": 11,
      "source": "彼女を呼び止めていた。",
      "target": "叫住了她。"
    },
    {
      "offset": 5927,
      "kind": "line",
      "limit": 10,
      "source": "…何を言おうとしたの",
      "target": "…我甚至不知道"
    },
    {
      "offset": 5953,
      "kind": "line",
      "limit": 10,
      "source": "かも、わからない。",
      "target": "想说些什么。"
    },
    {
      "offset": 5977,
      "kind": "line",
      "limit": 11,
      "source": "ただ、ここで呼ばないと",
      "target": "只是觉得此刻"
    },
    {
      "offset": 6005,
      "kind": "line",
      "limit": 11,
      "source": "いけないような気が",
      "target": "非叫住她"
    },
    {
      "offset": 6029,
      "kind": "line",
      "limit": 11,
      "source": "したのだ。",
      "target": "不可。"
    },
    {
      "offset": 6067,
      "kind": "line",
      "limit": 5,
      "source": "…しかし。",
      "target": "…可是。"
    },
    {
      "offset": 6083,
      "kind": "line",
      "limit": 11,
      "source": "しかし、慧美さんは",
      "target": "慧美停下脚步，"
    },
    {
      "offset": 6127,
      "kind": "line",
      "limit": 11,
      "source": "立ち止まって、少しだけ",
      "target": "微微回过头来…"
    },
    {
      "offset": 6155,
      "kind": "line",
      "limit": 11,
      "source": "振り返ると…",
      "target": "她只在嘴角"
    },
    {
      "offset": 6173,
      "kind": "line",
      "limit": 10,
      "source": "口元だけの、わずかな",
      "target": "浮现一丝"
    },
    {
      "offset": 6199,
      "kind": "line",
      "limit": 10,
      "source": "笑顔を浮かべて…",
      "target": "淡淡的笑意…"
    },
    {
      "offset": 6221,
      "kind": "line",
      "limit": 11,
      "source": "目を伏せながら、小さく",
      "target": "垂下眼眸，轻轻"
    },
    {
      "offset": 6249,
      "kind": "line",
      "limit": 11,
      "source": "２回、首を振った…。",
      "target": "摇了两次头…"
    },
    {
      "offset": 6280,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 6299,
      "kind": "line",
      "limit": 7,
      "source": "そして、また…",
      "target": "然后，她再次…"
    },
    {
      "offset": 6319,
      "kind": "line",
      "limit": 10,
      "source": "前を向き、ゆっくりと",
      "target": "转过身，缓缓"
    },
    {
      "offset": 6345,
      "kind": "line",
      "limit": 10,
      "source": "去っていった…。",
      "target": "离开了…"
    },
    {
      "offset": 6386,
      "kind": "line",
      "limit": 5,
      "source": "…これで。",
      "target": "…这样。"
    },
    {
      "offset": 6402,
      "kind": "line",
      "limit": 9,
      "source": "これで、いいんだ。",
      "target": "这样就好。"
    },
    {
      "offset": 6426,
      "kind": "line",
      "limit": 10,
      "source": "これが…彼女が望んだ",
      "target": "因为这…就是她"
    },
    {
      "offset": 6452,
      "kind": "line",
      "limit": 10,
      "source": "ことなのだから…。",
      "target": "所希望的…"
    },
    {
      "offset": 6502,
      "kind": "line",
      "limit": 9,
      "source": "それから数日後の朝",
      "target": "几天后的早晨"
    },
    {
      "offset": 6526,
      "kind": "line",
      "limit": 9,
      "source": "天気、雨",
      "target": "天气：雨"
    },
    {
      "offset": 6540,
      "kind": "line",
      "limit": 9,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 6559,
      "kind": "line",
      "limit": 9,
      "source": "鞠浜市中央町",
      "target": "鞠滨市中央町"
    },
    {
      "offset": 6596,
      "kind": "line",
      "limit": 9,
      "source": "螻川内家",
      "target": "蝼川内家"
    },
    {
      "offset": 6638,
      "kind": "name",
      "limit": 0,
      "source": "(暁)",
      "target": "(晓)"
    },
    {
      "offset": 6673,
      "kind": "line",
      "limit": 4,
      "source": "…おや？",
      "target": "…咦？"
    },
    {
      "offset": 6689,
      "kind": "line",
      "limit": 10,
      "source": "今、電話が鳴っていた",
      "target": "刚才电话是不是"
    },
    {
      "offset": 6715,
      "kind": "line",
      "limit": 10,
      "source": "ような…。",
      "target": "响了…"
    },
    {
      "offset": 6748,
      "kind": "line",
      "limit": 10,
      "source": "…あれから数日。私は",
      "target": "…那之后过了几天。"
    },
    {
      "offset": 6774,
      "kind": "line",
      "limit": 10,
      "source": "何も考えられず、ただ",
      "target": "我什么也无法思考，"
    },
    {
      "offset": 6800,
      "kind": "line",
      "limit": 10,
      "source": "呆然と暮らしている。",
      "target": "只是茫然度日。"
    },
    {
      "offset": 6829,
      "kind": "line",
      "limit": 10,
      "source": "…今日は休日だった。",
      "target": "…今天是休息日。"
    },
    {
      "offset": 6855,
      "kind": "line",
      "limit": 11,
      "source": "電話の音で、目が覚めた",
      "target": "我好像被电话铃声"
    },
    {
      "offset": 6883,
      "kind": "line",
      "limit": 11,
      "source": "ような気がしたが…",
      "target": "吵醒了，可…"
    },
    {
      "offset": 6907,
      "kind": "line",
      "limit": 10,
      "source": "気が付いたときには、",
      "target": "回过神时，"
    },
    {
      "offset": 6933,
      "kind": "line",
      "limit": 10,
      "source": "もうベルの音は止んで",
      "target": "铃声已经停"
    },
    {
      "offset": 6959,
      "kind": "line",
      "limit": 10,
      "source": "いた。",
      "target": "了。"
    },
    {
      "offset": 6971,
      "kind": "line",
      "limit": 8,
      "source": "…時計を見ると、",
      "target": "…我看了看钟，"
    },
    {
      "offset": 6993,
      "kind": "line",
      "limit": 8,
      "source": "早朝５時だった。",
      "target": "才清晨５点。"
    },
    {
      "offset": 7017,
      "kind": "line",
      "limit": 10,
      "source": "…こんな時間に電話を",
      "target": "…谁会在这种时间"
    },
    {
      "offset": 7043,
      "kind": "line",
      "limit": 10,
      "source": "かけてくるなんて…",
      "target": "打电话来…"
    },
    {
      "offset": 7067,
      "kind": "line",
      "limit": 10,
      "source": "誰だ、まったく…。",
      "target": "真是的，谁啊…"
    },
    {
      "offset": 7096,
      "kind": "line",
      "limit": 11,
      "source": "…なんだか妙な胸騒ぎを",
      "target": "…一种不祥的预感"
    },
    {
      "offset": 7124,
      "kind": "line",
      "limit": 11,
      "source": "感じ、私はいつもより",
      "target": "涌上心头，我比"
    },
    {
      "offset": 7150,
      "kind": "line",
      "limit": 11,
      "source": "早く起きた。",
      "target": "平时更早起了床。"
    },
    {
      "offset": 7168,
      "kind": "line",
      "limit": 9,
      "source": "…どうも、さっきの",
      "target": "…刚才那通电话"
    },
    {
      "offset": 7192,
      "kind": "line",
      "limit": 9,
      "source": "電話が気になる。",
      "target": "实在令我在意。"
    },
    {
      "offset": 7214,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 7235,
      "kind": "line",
      "limit": 10,
      "source": "…ひとりで考えても、",
      "target": "…独自苦想也"
    },
    {
      "offset": 7261,
      "kind": "line",
      "limit": 10,
      "source": "はじまらないか…。",
      "target": "无济于事吧…"
    },
    {
      "offset": 7285,
      "kind": "line",
      "limit": 4,
      "source": "…よし。",
      "target": "…好。"
    },
    {
      "offset": 7301,
      "kind": "line",
      "limit": 11,
      "source": "…私は迷惑を承知で、",
      "target": "…我明知会打扰他，"
    },
    {
      "offset": 7327,
      "kind": "line",
      "limit": 11,
      "source": "思い切って白鷺洲さんに",
      "target": "仍下定决心打电话"
    },
    {
      "offset": 7377,
      "kind": "line",
      "limit": 11,
      "source": "相談の電話をしてみた。",
      "target": "找白鹭洲商量。"
    },
    {
      "offset": 7419,
      "kind": "line",
      "limit": 11,
      "source": "…白鷺洲さんは、早朝の",
      "target": "…白鹭洲虽然一大早"
    },
    {
      "offset": 7469,
      "kind": "line",
      "limit": 11,
      "source": "突然の電話にも関わらず",
      "target": "接到突如其来的电话，"
    },
    {
      "offset": 7497,
      "kind": "line",
      "limit": 11,
      "source": "親身に聞いてくれた。",
      "target": "仍认真听我说完。"
    },
    {
      "offset": 7523,
      "kind": "line",
      "limit": 4,
      "source": "そして…",
      "target": "然后…"
    },
    {
      "offset": 7542,
      "kind": "line",
      "limit": 10,
      "source": "…その電話は、確かに",
      "target": "…那通电话确实"
    },
    {
      "offset": 7568,
      "kind": "line",
      "limit": 10,
      "source": "僕も気になりますね。",
      "target": "也令我很在意。"
    },
    {
      "offset": 7594,
      "kind": "line",
      "limit": 10,
      "source": "…やはり、慧美さん",
      "target": "…我认为打电话的"
    },
    {
      "offset": 7638,
      "kind": "line",
      "limit": 10,
      "source": "である可能性が高いと",
      "target": "很可能就是慧美"
    },
    {
      "offset": 7664,
      "kind": "line",
      "limit": 10,
      "source": "思います。",
      "target": "本人。"
    },
    {
      "offset": 7682,
      "kind": "line",
      "limit": 8,
      "source": "や、やっぱりそう",
      "target": "果、果然您也"
    },
    {
      "offset": 7704,
      "kind": "line",
      "limit": 8,
      "source": "思いますか…？",
      "target": "这么想吗…？"
    },
    {
      "offset": 7726,
      "kind": "line",
      "limit": 10,
      "source": "…しかも、だとしたら",
      "target": "…而且若真是她，"
    },
    {
      "offset": 7752,
      "kind": "line",
      "limit": 10,
      "source": "何かを思い詰めている",
      "target": "她或许正钻着"
    },
    {
      "offset": 7838,
      "kind": "line",
      "limit": 10,
      "source": "かもしれません。",
      "target": "牛角尖。"
    },
    {
      "offset": 7873,
      "kind": "line",
      "limit": 8,
      "source": "…そ、そんな!!",
      "target": "…怎、怎么会！！"
    },
    {
      "offset": 7895,
      "kind": "line",
      "limit": 11,
      "source": "…今すぐ、慧美さんの",
      "target": "…我们立刻去"
    },
    {
      "offset": 7941,
      "kind": "line",
      "limit": 11,
      "source": "家に行ってみましょう！",
      "target": "慧美家看看！"
    },
    {
      "offset": 7993,
