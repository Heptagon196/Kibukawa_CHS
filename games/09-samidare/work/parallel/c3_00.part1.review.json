    },
    {
      "offset": 4828,
      "kind": "line",
      "limit": 10,
      "source": "はじめて、心の底から",
      "target": "得知此事时…我才"
    },
    {
      "offset": 4854,
      "kind": "line",
      "limit": 10,
      "source": "生きたいと思うように",
      "target": "第一次从心底"
    },
    {
      "offset": 4880,
      "kind": "line",
      "limit": 10,
      "source": "なったんです。",
      "target": "想要活下去。"
    },
    {
      "offset": 4902,
      "kind": "line",
      "limit": 9,
      "source": "ああ、それで",
