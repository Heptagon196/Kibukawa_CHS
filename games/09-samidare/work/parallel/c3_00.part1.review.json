    },
    {
      "offset": 3460,
      "kind": "line",
      "limit": 9,
      "source": "怖さはまったく感じ",
      "target": "我完全没有感到"
    },
    {
      "offset": 3484,
      "kind": "line",
      "limit": 9,
      "source": "ませんでした。",
      "target": "害怕。"
    },
    {
      "offset": 3504,
      "kind": "line",
      "limit": 10,
      "source": "自然と、理解した…と",
      "target": "该说是自然就明白了"
    },
    {
      "offset": 3530,
      "kind": "line",
      "limit": 10,
      "source": "言うんでしょうか。",
      "target": "吧。"
    },
    {
      "offset": 3556,
      "kind": "line",
      "limit": 10,
      "source": "死を、理解…ですか。",
      "target": "明白死亡…吗？"
    },
    {
      "offset": 3584,
      "kind": "line",
      "limit": 7,
      "source": "…そうですね。",
      "target": "…是啊。"
    },
    {
      "offset": 3604,
      "kind": "line",
      "limit": 10,
      "source": "身体はちゃんと、",
      "target": "身体会清楚地"
    },
    {
      "offset": 3626,
      "kind": "line",
      "limit": 10,
      "source": "死期がわかっていて…",
      "target": "知道死期…"
    },
    {
      "offset": 3652,
      "kind": "line",
      "limit": 11,
      "source": "その時がきたら、自然と",
      "target": "等那一刻来临，"
    },
    {
      "offset": 3680,
      "kind": "line",
      "limit": 11,
      "source": "受け容れるように",
      "target": "人就会自然地"
    },
    {
      "offset": 3718,
      "kind": "line",
      "limit": 11,
      "source": "なってるみたいです。",
      "target": "接受死亡。"
    },
    {
      "offset": 3746,
      "kind": "line",
      "limit": 9,
      "source": "はあ、なるほど…。",
      "target": "哦，原来如此…"
    },
    {
      "offset": 3770,
      "kind": "line",
      "limit": 10,
      "source": "でも…実際はこうして",
      "target": "可是…您最后还是"
    },
    {
      "offset": 3796,
      "kind": "line",
      "limit": 10,
      "source": "助かったんですよね。",
      "target": "像这样活下来了。"
    },
    {
      "offset": 3822,
      "kind": "line",
      "limit": 10,
      "source": "母子共に。",
      "target": "母子都平安。"
    },
    {
      "offset": 3840,
      "kind": "line",
      "limit": 8,
      "source": "それなんですが…",
      "target": "问题就在这里…"
    },
    {
      "offset": 3862,
      "kind": "line",
      "limit": 10,
      "source": "それからのくわしい",
