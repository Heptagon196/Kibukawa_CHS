    },
    {
      "offset": 5238,
      "kind": "line",
      "limit": 11,
      "source": "そうだったんですか…。",
      "target": "原来是这样…"
    },
    {
      "offset": 5268,
      "kind": "line",
      "limit": 11,
      "source": "その後は順調に回復し、",
      "target": "之后我顺利康复，"
    },
    {
      "offset": 5296,
      "kind": "line",
      "limit": 11,
      "source": "リハビリを重ねたおかげ",
      "target": "也多亏不断进行"
    },
    {
      "offset": 5324,
      "kind": "line",
      "limit": 11,
      "source": "もあって…",
      "target": "复健…"
    },
    {
      "offset": 5340,
      "kind": "line",
      "limit": 10,
      "source": "大きな後遺症もなく、",
      "target": "没有留下严重后遗症，"
    },
    {
      "offset": 5375,
      "kind": "line",
      "limit": 10,
      "source": "子供と一緒に退院する",
