    },
    {
      "offset": 3897,
      "kind": "line",
      "limit": 10,
      "source": "経緯は、私には",
      "target": "经过，我也"
    },
    {
      "offset": 3923,
      "kind": "line",
      "limit": 10,
      "source": "わからないんですが…",
      "target": "不太清楚…"
    },
    {
      "offset": 3949,
      "kind": "line",
      "limit": 11,
      "source": "気が付けば、すごい",
      "target": "回过神来，我已经"
    },
    {
      "offset": 3973,
      "kind": "line",
      "limit": 11,
      "source": "設備の病院に転院されて",
      "target": "被转进设备极其先进"
    },
    {
      "offset": 4001,
      "kind": "line",
      "limit": 11,
      "source": "いたり…",
      "target": "的医院…"
    },
    {
      "offset": 4015,
      "kind": "line",
      "limit": 10,
      "source": "集中治療室という所に",
      "target": "还被送进了"
    },
    {
      "offset": 4041,
      "kind": "line",
      "limit": 10,
      "source": "入れられたりして",
      "target": "所谓的重症监护室"
    },
    {
      "offset": 4063,
      "kind": "line",
      "limit": 10,
      "source": "いたようなんです。",
      "target": "接受治疗。"
    },
    {
      "offset": 4117,
      "kind": "line",
      "limit": 11,
      "source": "その頃も、まだ意識は",
      "target": "那时您仍然"
    },
    {
      "offset": 4143,
      "kind": "line",
      "limit": 11,
      "source": "うつろだったんですか？",
      "target": "意识模糊吗？"
    },
    {
      "offset": 4173,
      "kind": "line",
      "limit": 10,
      "source": "意識はだいぶハッキリ",
      "target": "意识已经清醒了"
    },
    {
      "offset": 4199,
      "kind": "line",
      "limit": 10,
      "source": "していたんですが…",
