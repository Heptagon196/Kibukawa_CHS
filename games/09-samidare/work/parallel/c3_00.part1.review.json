    },
    {
      "offset": 5442,
      "kind": "line",
      "limit": 10,
      "source": "それは、よかった…。",
      "target": "那真是太好了…"
    },
    {
      "offset": 5470,
      "kind": "line",
      "limit": 8,
      "source": "なのでそれ以降…",
      "target": "所以从那以后…"
    },
    {
      "offset": 5492,
      "kind": "line",
      "limit": 11,
      "source": "瀕死だった私たち母子の",
      "target": "为了濒死的我们母子"
    },
    {
      "offset": 5520,
      "kind": "line",
      "limit": 11,
      "source": "ために力を尽くして",
      "target": "而竭尽全力的"
    }
  ]
}
