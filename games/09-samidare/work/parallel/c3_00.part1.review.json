    },
    {
      "offset": 4223,
      "kind": "line",
      "limit": 11,
      "source": "生きよう、という気力が",
      "target": "似乎还是缺少"
    },
    {
      "offset": 4258,
      "kind": "line",
      "limit": 11,
      "source": "乏しかったような感じ",
      "target": "活下去的意志。"
    },
    {
      "offset": 4290,
      "kind": "line",
      "limit": 11,
      "source": "だった気がします。",
      "target": "我记得是这样。"
    },
    {
      "offset": 4316,
      "kind": "line",
      "limit": 5,
      "source": "なるほど。",
      "target": "原来如此。"
    },
    {
      "offset": 4332,
      "kind": "line",
      "limit": 10,
      "source": "なすがままに、治療を",
      "target": "您只是任由医生"
    },
    {
      "offset": 4358,
      "kind": "line",
      "limit": 10,
      "source": "受けていただけなん",
      "target": "为您治疗而已"
    },
    {
      "offset": 4382,
      "kind": "line",
      "limit": 10,
      "source": "ですね。",
      "target": "吧。"
    },
    {
      "offset": 4398,
      "kind": "line",
      "limit": 4,
      "source": "…はい。",
      "target": "…是的。"
    },
    {
      "offset": 4412,
      "kind": "line",
      "limit": 11,
      "source": "なのでその頃は、自分が",
      "target": "所以当时，我自己"
    },
    {
      "offset": 4440,
      "kind": "line",
      "limit": 11,
      "source": "そんな有様なので…",
      "target": "都成了那副样子…"
    },
    {
      "offset": 4464,
      "kind": "line",
      "limit": 10,
      "source": "お腹の子供は、もう",
      "target": "便以为腹中的孩子"
    },
    {
      "offset": 4488,
      "kind": "line",
      "limit": 10,
      "source": "とっくに死んでいると",
      "target": "早就已经"
    },
    {
      "offset": 4514,
      "kind": "line",
      "limit": 10,
      "source": "思っていました。",
      "target": "死了。"
    },
    {
      "offset": 4536,
      "kind": "line",
      "limit": 7,
      "source": "…と言うより、",
