    },
    {
      "offset": 4556,
      "kind": "line",
      "limit": 10,
      "source": "妊娠をしていたという",
      "target": "就连自己曾经怀孕"
    },
    {
      "offset": 4582,
      "kind": "line",
      "limit": 10,
      "source": "ことすら、頭の中から",
      "target": "这件事，也从脑海中"
    },
    {
      "offset": 4608,
      "kind": "line",
      "limit": 10,
      "source": "完全に消えてました。",
      "target": "彻底消失了。"
    },
    {
      "offset": 4634,
      "kind": "line",
      "limit": 4,
      "source": "なので…",
      "target": "所以…"
    },
    {
      "offset": 4650,
      "kind": "line",
      "limit": 5,
      "source": "…なので？",
      "target": "…所以？"
    },
    {
      "offset": 4686,
      "kind": "line",
      "limit": 11,
      "source": "実は私のお腹の子供が、",
      "target": "其实，我腹中的孩子"
    },
    {
      "offset": 4714,
      "kind": "line",
      "limit": 11,
      "source": "帝王切開で取り出されて",
