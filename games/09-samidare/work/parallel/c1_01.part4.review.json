    },
    {
      "offset": 20155,
      "kind": "line",
      "limit": 11,
      "source": "スッキリしました。",
      "target": "舒畅多了。"
    },
    {
      "offset": 20181,
      "kind": "line",
      "limit": 11,
      "source": "それは良かったですね。",
      "target": "那就好。"
    },
    {
      "offset": 20211,
      "kind": "line",
      "limit": 11,
      "source": "さすが、探偵というのは",
      "target": "侦探果然连委托人的"
    },
    {
      "offset": 20239,
      "kind": "line",
      "limit": 11,
      "source": "心のケアもしてくれる",
      "target": "心理也会帮忙"
    },
    {
      "offset": 20265,
      "kind": "line",
      "limit": 11,
      "source": "ものなんですね。",
      "target": "照顾啊。"
    },
    {
      "offset": 20289,
      "kind": "line",
      "limit": 11,
      "source": "少なくとも、僕はそれを",
      "target": "至少我一直要求自己"
    },
    {
      "offset": 20317,
      "kind": "line",
      "limit": 11,
