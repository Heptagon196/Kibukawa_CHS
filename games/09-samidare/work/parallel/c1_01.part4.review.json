    },
    {
      "offset": 20033,
      "kind": "line",
      "limit": 9,
      "source": "…ああ、ありがとう",
      "target": "…谢谢您，真的"
    },
    {
      "offset": 20057,
      "kind": "line",
      "limit": 9,
      "source": "ございます。",
      "target": "非常感谢。"
    },
    {
      "offset": 20093,
      "kind": "line",
      "limit": 11,
      "source": "白鷺洲さんにそう言われ",
      "target": "听白鹭洲先生这么说，"
    },
    {
      "offset": 20127,
      "kind": "line",
      "limit": 11,
      "source": "たら、なんだか気持ちが",
