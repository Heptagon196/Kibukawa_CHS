{
  "script": "c1_01",
  "batch": "c1_01.part4.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 16798,
      "kind": "line",
      "limit": 11,
      "source": "じゃないですか。",
      "target": "了吧。"
    },
    {
      "offset": 16820,
      "kind": "line",
      "limit": 9,
      "source": "それどころか、",
      "target": "不只如此，"
    },
    {
      "offset": 16840,
      "kind": "line",
      "limit": 9,
      "source": "このままでは借金を",
      "target": "这样下去，他们可能"
    },
    {
      "offset": 16864,
      "kind": "line",
      "limit": 9,
      "source": "抱えて夜逃げとか…",
      "target": "会负债连夜逃走…"
    },
    {
      "offset": 16888,
      "kind": "line",
      "limit": 11,
      "source": "最悪、一家心中なんて",
      "target": "最坏的情况，甚至可能"
    },
    {
      "offset": 16914,
      "kind": "line",
      "limit": 11,
      "source": "ことになるかもしれない",
      "target": "全家一起自杀。"
    },
    {
      "offset": 16942,
      "kind": "line",
      "limit": 11,
      "source": "一大事らしいんです！",
      "target": "听说已经如此严重！"
    },
    {
      "offset": 16970,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 16984,
      "kind": "line",
      "limit": 10,
      "source": "でも、ひとまず",
      "target": "不过，只要先偿还"
    },
    {
      "offset": 17006,
      "kind": "line",
      "limit": 10,
      "source": "５００万円ほど返済",
      "target": "大约５００万日元"
    },
    {
      "offset": 17036,
      "kind": "line",
      "limit": 10,
      "source": "することができれば…",
      "target": "的债务…"
    },
    {
      "offset": 17062,
      "kind": "line",
      "limit": 11,
      "source": "とりあえずは、持ち直す",
      "target": "局面暂时就能"
    },
    {
      "offset": 17090,
      "kind": "line",
      "limit": 11,
      "source": "ことができるそうです。",
      "target": "缓过来。"
    },
    {
      "offset": 17120,
      "kind": "line",
      "limit": 10,
      "source": "５００万円ですか。",
      "target": "５００万日元吗。"
    },
    {
      "offset": 17144,
      "kind": "line",
      "limit": 10,
      "source": "なるほど、それで…。",
      "target": "原来如此，所以…"
    },
    {
      "offset": 17172,
      "kind": "line",
      "limit": 11,
      "source": "はい、それを私の貯金で",
      "target": "对，我想用自己的存款"
    },
    {
      "offset": 17200,
      "kind": "line",
      "limit": 11,
      "source": "まかなおうかと。",
      "target": "来填补。"
    },
    {
      "offset": 17222,
      "kind": "line",
      "limit": 11,
      "source": "結婚は遅れてしまいます",
      "target": "婚期虽然会因此推迟，"
    },
    {
      "offset": 17250,
      "kind": "line",
      "limit": 11,
      "source": "けれども、彼女の家庭の",
      "target": "但她的家庭正面临"
    },
    {
      "offset": 17278,
      "kind": "line",
      "limit": 11,
      "source": "崩壊の危機ですからね。",
      "target": "崩溃的危机。"
    },
    {
      "offset": 17306,
      "kind": "line",
      "limit": 10,
      "source": "それを助けることが",
      "target": "如果能帮助他们"
    },
    {
      "offset": 17330,
      "kind": "line",
      "limit": 10,
      "source": "できるのであれば、",
      "target": "渡过难关，"
    },
    {
      "offset": 17354,
      "kind": "line",
      "limit": 10,
      "source": "まあ、安いものです。",
      "target": "这代价并不算大。"
    },
    {
      "offset": 17382,
      "kind": "line",
      "limit": 11,
      "source": "そうですか…そんな",
      "target": "这样啊…原来还有"
    },
    {
      "offset": 17406,
      "kind": "line",
      "limit": 11,
      "source": "事情があったんですね。",
      "target": "这样的隐情。"
    },
    {
      "offset": 17436,
      "kind": "line",
      "limit": 11,
      "source": "なので一刻も早く、あの",
      "target": "所以我现在一刻也不能"
    },
    {
      "offset": 17464,
      "kind": "line",
      "limit": 11,
      "source": "お金が必要なんです。",
      "target": "耽误，必须找回那笔钱。"
    },
    {
      "offset": 17492,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 17504,
      "kind": "line",
      "limit": 10,
      "source": "…暁さん、相手の",
      "target": "…晓先生，您见过"
    },
    {
      "offset": 17546,
      "kind": "line",
      "limit": 10,
      "source": "ご両親と会ったことは",
      "target": "对方的父母"
    },
    {
      "offset": 17572,
      "kind": "line",
      "limit": 10,
      "source": "ありますか？",
      "target": "吗？"
    },
    {
      "offset": 17592,
      "kind": "line",
      "limit": 10,
      "source": "…えっ？　慧美さんの",
      "target": "…咦？慧美小姐的"
    },
    {
      "offset": 17638,
      "kind": "line",
      "limit": 10,
      "source": "両親にですか？",
      "target": "父母吗？"
    },
    {
      "offset": 17658,
      "kind": "line",
      "limit": 11,
      "source": "…いや、実はまだ会った",
      "target": "…不，其实我还没"
    },
    {
      "offset": 17686,
      "kind": "line",
      "limit": 11,
      "source": "ことはないんです。",
      "target": "见过他们。"
    },
    {
      "offset": 17710,
      "kind": "line",
      "limit": 9,
      "source": "あいさつに行こうと",
      "target": "我本想去拜访，"
    },
    {
      "offset": 17734,
      "kind": "line",
      "limit": 9,
      "source": "しても、彼女が今は",
      "target": "可她总说现在"
    },
    {
      "offset": 17758,
      "kind": "line",
      "limit": 9,
      "source": "ダメだと言って…。",
      "target": "还不行…"
    },
    {
      "offset": 17782,
      "kind": "line",
      "limit": 11,
      "source": "今思えば、店の経営で",
      "target": "现在想来，是因为店铺"
    },
    {
      "offset": 17808,
      "kind": "line",
      "limit": 11,
      "source": "問題を抱えている最中",
      "target": "当时就面临经营"
    },
    {
      "offset": 17834,
      "kind": "line",
      "limit": 11,
      "source": "だったからなんですね。",
      "target": "问题吧。"
    },
    {
      "offset": 17864,
      "kind": "line",
      "limit": 4,
      "source": "ふむ…。",
      "target": "唔…"
    },
    {
      "offset": 17895,
      "kind": "line",
      "limit": 10,
      "source": "彼女も、私しかアテに",
      "target": "她也哭着说，能依靠的"
    },
    {
      "offset": 17921,
      "kind": "line",
      "limit": 10,
      "source": "できる人がいないと",
      "target": "人只剩下我"
    },
    {
      "offset": 17945,
      "kind": "line",
      "limit": 10,
      "source": "泣きついているので…",
      "target": "了…"
    },
    {
      "offset": 17971,
      "kind": "line",
      "limit": 10,
      "source": "早く慧美さんの元気な",
      "target": "我想尽快看到慧美小姐"
    },
    {
      "offset": 18017,
      "kind": "line",
      "limit": 10,
      "source": "笑顔を見たいんです。",
      "target": "恢复开朗的笑容。"
    },
    {
      "offset": 18070,
      "kind": "line",
      "limit": 8,
      "source": "…あ、そういえば",
      "target": "…对了，"
    },
    {
      "offset": 18103,
      "kind": "line",
      "limit": 8,
      "source": "白鷺洲さん。",
      "target": "白鹭洲先生。"
    },
    {
      "offset": 18129,
      "kind": "line",
      "limit": 3,
      "source": "はい？",
      "target": "什么？"
    },
    {
      "offset": 18143,
      "kind": "line",
      "limit": 10,
      "source": "あの…少し関係のない",
      "target": "那个…接下来或许"
    },
    {
      "offset": 18169,
      "kind": "line",
      "limit": 10,
      "source": "話になってしまうかも",
      "target": "和委托没什么"
    },
    {
      "offset": 18195,
      "kind": "line",
      "limit": 10,
      "source": "しれませんが…",
      "target": "关系…"
    },
    {
      "offset": 18217,
      "kind": "line",
      "limit": 9,
      "source": "ええ、いいですよ。",
      "target": "没事，请说。"
    },
    {
      "offset": 18241,
      "kind": "line",
      "limit": 9,
      "source": "なんですか？",
      "target": "什么事？"
    },
    {
      "offset": 18272,
      "kind": "line",
      "limit": 10,
      "source": "白鷺洲さんには…交際",
      "target": "白鹭洲先生有正在"
    },
    {
      "offset": 18304,
      "kind": "line",
      "limit": 10,
      "source": "している相手はいるん",
      "target": "交往的对象"
    },
    {
      "offset": 18330,
      "kind": "line",
      "limit": 10,
      "source": "ですか？",
      "target": "吗？"
    },
    {
      "offset": 18346,
      "kind": "line",
      "limit": 7,
      "source": "えっ？",
      "target": "咦？"
    },
    {
      "offset": 18358,
      "kind": "line",
      "limit": 7,
      "source": "僕に…ですか？",
      "target": "问我…吗？"
    },
    {
      "offset": 18380,
      "kind": "line",
      "limit": 10,
      "source": "いや、あの…なんだか",
      "target": "不，那个…只是觉得"
    },
    {
      "offset": 18406,
      "kind": "line",
      "limit": 10,
      "source": "女性の気持ちについて",
      "target": "您好像很了解"
    },
    {
      "offset": 18432,
      "kind": "line",
      "limit": 10,
      "source": "詳しそうなので…。",
      "target": "女性的心思…"
    },
    {
      "offset": 18458,
      "kind": "line",
      "limit": 10,
      "source": "あ、そうですか？",
      "target": "是这样吗？"
    },
    {
      "offset": 18480,
      "kind": "line",
      "limit": 10,
      "source": "だとしたら、恐らく…",
      "target": "如果真是如此，大概是"
    },
    {
      "offset": 18516,
      "kind": "line",
      "limit": 10,
      "source": "これまでの調査で、",
      "target": "因为过去调查时，"
    },
    {
      "offset": 18540,
      "kind": "line",
      "limit": 10,
      "source": "様々な愛憎の現場に",
      "target": "我接触过形形色色的"
    },
    {
      "offset": 18586,
      "kind": "line",
      "limit": 10,
      "source": "触れたからでしょう。",
      "target": "爱恨纠葛。"
    },
    {
      "offset": 18612,
      "kind": "line",
      "limit": 11,
      "source": "人の心の、汚れた部分や",
      "target": "人心肮脏、扭曲的"
    },
    {
      "offset": 18647,
      "kind": "line",
      "limit": 11,
      "source": "歪んだ部分を、何件も",
      "target": "一面，我也看过"
    },
    {
      "offset": 18679,
      "kind": "line",
      "limit": 11,
      "source": "見てきましたから…。",
      "target": "许多次…"
    },
    {
      "offset": 18707,
      "kind": "line",
      "limit": 9,
      "source": "ああ、なるほど…。",
      "target": "啊，原来如此…"
    },
    {
      "offset": 18731,
      "kind": "line",
      "limit": 10,
      "source": "…でも、そんな現場を",
      "target": "…可是亲眼见过"
    },
    {
      "offset": 18757,
      "kind": "line",
      "limit": 10,
      "source": "目の当たりにして、",
      "target": "那样的场面，"
    },
    {
      "offset": 18781,
      "kind": "line",
      "limit": 10,
      "source": "人の本性を見ても…",
      "target": "看清人的本性后…"
    },
    {
      "offset": 18805,
      "kind": "line",
      "limit": 8,
      "source": "…それでも、人を",
      "target": "…还是能够"
    },
    {
      "offset": 18827,
      "kind": "line",
      "limit": 8,
      "source": "好きになれるもの",
      "target": "喜欢上别人"
    },
    {
      "offset": 18849,
      "kind": "line",
      "limit": 8,
      "source": "なんでしょうか？",
      "target": "吗？"
    },
    {
      "offset": 18884,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 18901,
      "kind": "line",
      "limit": 5,
      "source": "なるほど。",
      "target": "原来如此。"
    },
    {
      "offset": 18927,
      "kind": "line",
      "limit": 8,
      "source": "…螻川内さん、",
      "target": "…蝼川内先生，"
    },
    {
      "offset": 18973,
      "kind": "line",
      "limit": 8,
      "source": "不安なんですね？",
      "target": "您很不安吧？"
    },
    {
      "offset": 19003,
      "kind": "line",
      "limit": 4,
      "source": "えっ…？",
      "target": "咦…？"
    },
    {
      "offset": 19019,
      "kind": "line",
      "limit": 11,
      "source": "どんな状況でも、自分の",
      "target": "您母亲不论遇到什么，"
    },
    {
      "offset": 19047,
      "kind": "line",
      "limit": 11,
      "source": "決めた相手を信じ抜く、",
      "target": "都会相信自己选定的"
    },
    {
      "offset": 19075,
      "kind": "line",
      "limit": 11,
      "source": "あなたの母親のように…",
      "target": "人，一直坚持下去…"
    },
    {
      "offset": 19113,
      "kind": "line",
      "limit": 10,
      "source": "自分は果たして、何が",
      "target": "而您不确定自己"
    },
    {
      "offset": 19139,
      "kind": "line",
      "limit": 10,
      "source": "あっても今の相手を",
      "target": "无论发生什么，"
    },
    {
      "offset": 19163,
      "kind": "line",
      "limit": 10,
      "source": "信じ抜けるかどうか。",
      "target": "能否始终相信恋人。"
    },
    {
      "offset": 19189,
      "kind": "line",
      "limit": 10,
      "source": "その自信がいまひとつ",
      "target": "您缺少这份自信，"
    },
    {
      "offset": 19215,
      "kind": "line",
      "limit": 10,
      "source": "持てず、不安…。",
      "target": "所以感到不安…"
    },
    {
      "offset": 19237,
      "kind": "line",
      "limit": 7,
      "source": "…そうですね。",
      "target": "…是啊。"
    },
    {
      "offset": 19266,
      "kind": "line",
      "limit": 9,
      "source": "ううっ…。じ、実は",
      "target": "唔…其、其实"
    },
    {
      "offset": 19290,
      "kind": "line",
      "limit": 9,
      "source": "その通りなんです。",
      "target": "正是这样。"
    },
    {
      "offset": 19314,
      "kind": "line",
      "limit": 11,
      "source": "彼女のために、苦労して",
      "target": "为了她，就算失去"
    },
    {
      "offset": 19342,
      "kind": "line",
      "limit": 11,
      "source": "貯めた５００万円を失う",
      "target": "辛苦攒下的５００万"
    },
    {
      "offset": 19370,
      "kind": "line",
      "limit": 11,
      "source": "ことに対しては…",
      "target": "日元…"
    },
    {
      "offset": 19392,
      "kind": "line",
      "limit": 10,
      "source": "自分でも驚くくらい、",
      "target": "连我自己都很惊讶，"
    },
    {
      "offset": 19418,
      "kind": "line",
      "limit": 10,
      "source": "まったくためらいが",
      "target": "我竟然完全没有"
    },
    {
      "offset": 19442,
      "kind": "line",
      "limit": 10,
      "source": "ないんです。",
      "target": "一丝犹豫。"
    },
    {
      "offset": 19460,
      "kind": "line",
      "limit": 11,
      "source": "優柔不断な私ですが、",
      "target": "我虽然优柔寡断，"
    },
    {
      "offset": 19486,
      "kind": "line",
      "limit": 11,
      "source": "その気持ちだけは本当に",
      "target": "但唯独这份心意"
    },
    {
      "offset": 19514,
      "kind": "line",
      "limit": 11,
      "source": "間違いありません。",
      "target": "绝不会有错。"
    },
    {
      "offset": 19538,
      "kind": "line",
      "limit": 5,
      "source": "ですが…。",
      "target": "可是…"
    },
    {
      "offset": 19556,
      "kind": "line",
      "limit": 7,
      "source": "大丈夫ですよ。",
      "target": "不会有事的。"
    },
    {
      "offset": 19586,
      "kind": "line",
      "limit": 4,
      "source": "…えっ？",
      "target": "…咦？"
    },
    {
      "offset": 19615,
      "kind": "line",
      "limit": 11,
      "source": "螻川内さんの本当の",
      "target": "蝼川内先生真实的"
    },
    {
      "offset": 19645,
      "kind": "line",
      "limit": 11,
      "source": "気持ちに、不安や迷いは",
      "target": "心意里，没有任何"
    },
    {
      "offset": 19675,
      "kind": "line",
      "limit": 11,
      "source": "ありませんから。",
      "target": "不安或迷茫。"
    },
    {
      "offset": 19705,
      "kind": "line",
      "limit": 11,
      "source": "えっ…!?",
      "target": "咦…！？"
    },
    {
      "offset": 19719,
      "kind": "line",
      "limit": 11,
      "source": "ど…どうして、そんな",
      "target": "为…为什么您会"
    },
    {
      "offset": 19745,
      "kind": "line",
      "limit": 11,
      "source": "ことがわかるんですか？",
      "target": "知道？"
    },
    {
      "offset": 19785,
      "kind": "line",
      "limit": 11,
      "source": "あなたなら何があっても",
      "target": "我想无论发生什么，"
    },
    {
      "offset": 19813,
      "kind": "line",
      "limit": 11,
      "source": "彼女を信じ抜くことが",
      "target": "您都能始终相信"
    },
    {
      "offset": 19839,
      "kind": "line",
      "limit": 11,
      "source": "できると思います。",
      "target": "她。"
    },
    {
      "offset": 19863,
      "kind": "line",
      "limit": 11,
      "source": "不安に思っていたのは",
      "target": "您之所以感到不安，"
    },
    {
      "offset": 19889,
      "kind": "line",
      "limit": 11,
      "source": "きっと、誰かの後押しが",
      "target": "一定只是想要别人"
    },
    {
      "offset": 19917,
      "kind": "line",
      "limit": 11,
      "source": "欲しかっただけで…",
      "target": "推您一把…"
    },
    {
      "offset": 19941,
      "kind": "line",
      "limit": 11,
      "source": "心の中では、ちゃんと",
      "target": "您心里其实早已"
    },
    {
      "offset": 19967,
      "kind": "line",
      "limit": 11,
      "source": "覚悟できていますから。",
      "target": "做好了觉悟。"
    },
    {
      "offset": 19995,
      "kind": "line",
      "limit": 7,
