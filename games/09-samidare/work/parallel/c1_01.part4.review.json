    {
      "offset": 20423,
      "kind": "line",
      "limit": 2,
      "source": "…！",
      "target": "…！"
    },
    {
      "offset": 20433,
      "kind": "line",
      "limit": 10,
      "source": "…ああ、それを聞いて",
      "target": "…啊，听您这样说"
    },
    {
      "offset": 20459,
      "kind": "line",
      "limit": 10,
      "source": "少し安心しました。",
