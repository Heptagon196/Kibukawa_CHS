{
  "script": "c1_00",
  "units": [
    {"offset": 10289, "target": "看穿…？"},
    {"offset": 10307, "target": "只要稍微接触，"},
    {"offset": 10331, "target": "对方内心真实的感情", "runs": ["对方", "内心真实的感情"]},
    {"offset": 10368, "target": "他都能看穿！"},
    {"offset": 10382, "target": "听好了。"},
    {"offset": 10396, "target": "人真正的感情，"},
    {"offset": 10422, "target": "无论藏得多深…"},
    {"offset": 10450, "target": "都一定会在表情"},
    {"offset": 10476, "target": "或话语的某处露出"},
    {"offset": 10524, "target": "细微的痕迹！"},
    {"offset": 10546, "target": "而他有一项本领，"},
    {"offset": 10570, "target": "能敏锐地捕捉到"},
    {"offset": 10596, "target": "那些痕迹。"},
    {"offset": 10620, "target": "比如其实在生气，"},
    {"offset": 10646, "target": "或是心里很高兴，"},
    {"offset": 10672, "target": "他一眼就能看穿！"},
    {"offset": 10707, "target": "只要观察就行！"},
    {"offset": 10741, "target": "简直易如反掌！"},
    {"offset": 10765, "target": "怎么会有这种事…"},
    {"offset": 10803, "target": "凉二先生，这件事"},
    {"offset": 10827, "target": "是真的吗…？"},
    {"offset": 10853, "target": "…我一直以为，"},
    {"offset": 10879, "target": "这种事谁都能"},
    {"offset": 10905, "target": "做到。"},
    {"offset": 10921, "target": "看来，就连本人", "runs": ["看来，", "就连本人"]},
    {"offset": 10950, "target": "尚未察觉的感情，"},
    {"offset": 10984, "target": "我也会感觉到。"},
    {"offset": 11024, "target": "……………"},
    {"offset": 11044, "target": "怎么了！难道有什么"},
    {"offset": 11072, "target": "不妙吗！？"},
    {"offset": 11105, "target": "…凉二先生。"},
    {"offset": 11123, "target": "我还是回去了。"},
    {"offset": 11151, "target": "虽然和那件事无关，"},
    {"offset": 11179, "target": "但受了这种对待，"},
    {"offset": 11205, "target": "我没法再待下去。"},
    {"offset": 11231, "target": "…这样啊。"},
    {"offset": 11247, "target": "那你回去时，"},
    {"offset": 11265, "target": "路上小心。"},
    {"offset": 11303, "target": "好的。"},
    {"offset": 11317, "target": "我还会再来的！"},
    {"offset": 11380, "target": "…真是的。"},
    {"offset": 11415, "target": "交谈"},
    {"offset": 11423, "target": "中断"},
    {"offset": 11438, "target": "关于癸生川"},
    {"offset": 11452, "target": "关于莉沙"},
    {"offset": 11464, "target": "关于事务所"},
    {"offset": 11498, "target": "…先不说这个，白鹭洲，"},
    {"offset": 11548, "target": "你什么时候回来的？"},
    {"offset": 11576, "target": "嗯，刚刚才回来。"},
    {"offset": 11604, "target": "我回来了。"},
    {"offset": 11622, "target": "我可没听说你要"},
    {"offset": 11650, "target": "离开这么多天！"},
    {"offset": 11680, "target": "只是你没听我说"},
    {"offset": 11708, "target": "而已吧。"},
    {"offset": 11732, "target": "看来调查了"},
    {"offset": 11754, "target": "很久，"},
    {"offset": 11776, "target": "可别逞强。"},
    {"offset": 11798, "target": "千万别逞强。"},
    {"offset": 11820, "target": "我没事。"},
    {"offset": 11840, "target": "你的精神和身体"},
    {"offset": 11902, "target": "都经不起太多"},
    {"offset": 11944, "target": "折腾。"},
    {"offset": 11966, "target": "我自己的情况，"},
    {"offset": 11988, "target": "我当然很清楚。"},
    {"offset": 12016, "target": "你要是不在了，"},
    {"offset": 12040, "target": "我会很困扰。"},
    {"offset": 12052, "target": "真发生那种事，"},
    {"offset": 12074, "target": "这间事务所就"},
    {"offset": 12096, "target": "经营不下去了。"},
    {"offset": 12120, "target": "嗯，多谢你担心。"},
    {"offset": 12148, "target": "…你还是老样子，"},
    {"offset": 12170, "target": "唯独在这件事上"},
    {"offset": 12190, "target": "格外爱操心。"},
    {"offset": 12212, "target": "平时无论发生什么"},
    {"offset": 12236, "target": "都漠不关心的你。"},
    {"offset": 12258, "target": "…我总有种"},
    {"offset": 12280, "target": "不祥的预感。"},
    {"offset": 12304, "target": "未来两三年内，"},
    {"offset": 12328, "target": "你恐怕会遇到…"},
    {"offset": 12356, "target": "你又开始说这种"},
    {"offset": 12378, "target": "不吉利的话了。"},
    {"offset": 12402, "target": "你什么时候也开始"},
    {"offset": 12426, "target": "做起占卜师那一套"},
    {"offset": 12452, "target": "了？"},
    {"offset": 12472, "target": "我是侦探。"},
    {"offset": 12490, "target": "我只谈基于事实的"},
    {"offset": 12518, "target": "推理。"},
    {"offset": 12536, "target": "…还是说，"},
    {"offset": 12562, "target": "这是你那位占卜师"},
    {"offset": 12588, "target": "祖母的神谕"},
    {"offset": 12647, "target": "吗？"},
    {"offset": 12661, "target": "和她无关。"},
    {"offset": 12685, "target": "…真是的。"},
    {"offset": 12703, "target": "没事的。"},
    {"offset": 12721, "target": "今后我也会一直"},
    {"offset": 12747, "target": "留在这里协助"},
    {"offset": 12771, "target": "你的。"},
    {"offset": 12793, "target": "拜托了。"},
    {"offset": 12807, "target": "…没有人能够"},
    {"offset": 12831, "target": "取代你。"},
    {"offset": 12866, "target": "对了，癸生川。"},
    {"offset": 12910, "target": "现在有什么"},
    {"offset": 12930, "target": "工作吗？"},
    {"offset": 12950, "target": "没有。"},
    {"offset": 12964, "target": "老板交代的委托呢？"},
    {"offset": 12994, "target": "就是找那个身份"},
    {"offset": 13038, "target": "不明的骗子吧。"},
    {"offset": 13060, "target": "那件事已经办完了。"},
    {"offset": 13088, "target": "暂时不用操心。"},
    {"offset": 13110, "target": "不过话说回来…"},
    {"offset": 13151, "target": "明明听说他病危，"},
    {"offset": 13183, "target": "结果却痊愈得活蹦"},
    {"offset": 13209, "target": "乱跳！"},
    {"offset": 13229, "target": "…真是个会给人"},
    {"offset": 13257, "target": "添麻烦的老头。"},
    {"offset": 13277, "target": "原来如此…所以你"},
    {"offset": 13297, "target": "才在睡觉啊…"},
    {"offset": 13340, "target": "反正下着大雨。"},
    {"offset": 13362, "target": "今天我会待在房里。"},
    {"offset": 13388, "target": "知道了。"},
    {"offset": 13426, "target": "刚才那女孩没事吧？"},
    {"offset": 13456, "target": "她肯定没事。"},
    {"offset": 13491, "target": "你观察过？"},
    {"offset": 13530, "target": "没有，我没那么认真"},
    {"offset": 13563, "target": "地观察她…"},
    {"offset": 13608, "target": "不过，"},
    {"offset": 13620, "target": "…她看起来很开心。"},
    {"offset": 13646, "target": "她似乎连我们的"},
    {"offset": 13670, "target": "反应也一并享受。"},
    {"offset": 13700, "target": "很危险。"},
    {"offset": 13724, "target": "即使这样也没事。"},
    {"offset": 13752, "target": "…就算发生什么，"},
    {"offset": 13780, "target": "还有你在嘛。"},
    {"offset": 13804, "target": "我感觉到一种"},
    {"offset": 13824, "target": "不妙的气息。"},
    {"offset": 13846, "target": "…你要小心。"},
    {"offset": 13868, "target": "好，我知道了。"},
    {"offset": 13890, "target": "我会小心的。"},
    {"offset": 13930, "target": "话说回来，才过了"},
    {"offset": 13956, "target": "几天，这房间怎么"},
    {"offset": 13984, "target": "就成了这副样子？"},
    {"offset": 14012, "target": "不把这里收拾好，"},
    {"offset": 14038, "target": "等委托人来了，"},
    {"offset": 14062, "target": "我们会很困扰吧。"},
    {"offset": 14086, "target": "这样才最让我"},
    {"offset": 14106, "target": "安心。"},
    {"offset": 14130, "target": "能在这种房间安心"},
    {"offset": 14156, "target": "的人，恐怕也只有"},
    {"offset": 14184, "target": "你了。"},
    {"offset": 14206, "target": "记得好好收拾"},
    {"offset": 14232, "target": "干净。"},
    {"offset": 14246, "target": "我可不会再"},
    {"offset": 14262, "target": "帮忙了。"},
    {"offset": 14288, "target": "那就难办了。"},
    {"offset": 14308, "target": "…真是的。"},
    {"offset": 14378, "target": "…总之，我再"},
    {"offset": 14400, "target": "睡上一觉。"},
    {"offset": 14426, "target": "…好好好。"},
    {"offset": 14444, "target": "醒来以后记得"},
    {"offset": 14466, "target": "把房间收拾好。"},
    {"offset": 14506, "target": "告辞！"},
    {"offset": 14532, "target": "真是的…"},
    {"offset": 14634, "target": "…咦，又有客人。"},
    {"offset": 14660, "target": "今天真热闹…"},
    {"offset": 14684, "target": "来了。"},
    {"offset": 14703, "target": "…咦，莉沙小姐。"},
    {"offset": 14745, "target": "你又来了？"},
    {"offset": 14784, "target": "啊，凉二先生！委托人", "runs": ["啊，凉二先生！", "委托人"]},
    {"offset": 14820, "target": "我给您带来了！"},
    {"offset": 14855, "target": "咦，委托人…？"},
    {"offset": 14889, "target": "是！"},
    {"offset": 14935, "target": "保存"},
    {"offset": 14949, "target": "返回游戏"},
    {"offset": 14978, "target": "保存成功。"},
    {"offset": 15014, "target": "保存失败。", "runs": ["保存", "失败", "。"]}
  ]
}
