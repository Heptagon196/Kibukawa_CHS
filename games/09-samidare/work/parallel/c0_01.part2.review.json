{
  "script": "c0_01",
  "batch": "c0_01.part2.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 5688,
      "kind": "line",
      "limit": 10,
      "source": "なんでも、ここに居を",
      "target": "听说这里必须"
    },
    {
      "offset": 5739,
      "kind": "line",
      "limit": 10,
      "source": "構えてないといけない",
      "target": "作为事务所，"
    },
    {
      "offset": 5773,
      "kind": "line",
      "limit": 10,
      "source": "理由があるとか…。",
      "target": "是有什么理由…"
    },
    {
      "offset": 5805,
      "kind": "line",
      "limit": 9,
      "source": "それは、癸生川が？",
      "target": "癸生川说的？"
    },
    {
      "offset": 5853,
      "kind": "line",
      "limit": 11,
      "source": "そうです、先生が以前に",
      "target": "对，老师以前"
    },
    {
      "offset": 5881,
      "kind": "line",
      "limit": 11,
      "source": "言ってたんですよ。",
      "target": "说过。"
    },
    {
      "offset": 5905,
      "kind": "line",
      "limit": 11,
      "source": "何でしょうね？",
      "target": "是什么呢？"
    },
    {
      "offset": 5925,
      "kind": "line",
      "limit": 11,
      "source": "ここで何かを待ってる、",
      "target": "他在这里等待着"
    },
    {
      "offset": 5953,
      "kind": "line",
      "limit": 11,
      "source": "とかでしょうか…？",
      "target": "什么吗…？"
    },
    {
      "offset": 5979,
      "kind": "line",
      "limit": 9,
      "source": "気になりますねえ。",
      "target": "真令人在意。"
    },
    {
      "offset": 6015,
      "kind": "line",
      "limit": 11,
      "source": "まあ、さすがに４年半も",
      "target": "不过住了四年半，"
    },
    {
      "offset": 6043,
      "kind": "line",
      "limit": 11,
      "source": "いると、愛着も湧いて",
      "target": "我对这里也有"
    },
    {
      "offset": 6085,
      "kind": "line",
      "limit": 11,
      "source": "きますけどね。",
      "target": "感情了。"
    },
    {
      "offset": 6107,
      "kind": "line",
      "limit": 9,
      "source": "ああ、もう４年半に",
      "target": "啊，已经四年半"
    },
    {
      "offset": 6131,
      "kind": "line",
      "limit": 9,
      "source": "なるんですね。",
      "target": "了啊。"
    },
    {
      "offset": 6164,
      "kind": "line",
      "limit": 11,
      "source": "生王さんと出会ったのも",
      "target": "遇见生王先生也是"
    },
    {
      "offset": 6198,
      "kind": "line",
      "limit": 11,
      "source": "その頃ですよね。",
      "target": "那时候吧。"
    },
    {
      "offset": 6222,
      "kind": "line",
      "limit": 4,
      "source": "うっ…。",
      "target": "唔…"
    },
    {
      "offset": 6238,
      "kind": "line",
      "limit": 10,
      "source": "あの時、生王さんは…",
      "target": "那时候，生王先生…"
    },
    {
      "offset": 6288,
      "kind": "line",
      "limit": 7,
      "source": "だああああっ！",
      "target": "啊啊啊啊！"
    },
    {
      "offset": 6308,
      "kind": "line",
      "limit": 7,
      "source": "わああああっ！",
      "target": "哇啊啊啊！"
    },
    {
      "offset": 6328,
      "kind": "line",
      "limit": 7,
      "source": "言うなっ!!",
      "target": "不许说！！"
    },
    {
      "offset": 6346,
      "kind": "line",
      "limit": 4,
      "source": "くふふ。",
      "target": "呵呵呵。"
    },
    {
      "offset": 6374,
      "kind": "line",
      "limit": 11,
      "source": "ええと、これは高校生の",
      "target": "嗯，这封好像来自"
    },
    {
      "offset": 6402,
      "kind": "line",
      "limit": 11,
      "source": "女の子からみたいです。",
      "target": "一位高中女生。"
    },
    {
      "offset": 6432,
      "kind": "line",
      "limit": 10,
      "source": "伊綱ちゃんカワイイ！",
      "target": "伊纲妹妹好可爱！"
    },
    {
      "offset": 6458,
      "kind": "line",
      "limit": 10,
      "source": "もうサイコー☆",
      "target": "简直最棒☆"
    },
    {
      "offset": 6478,
      "kind": "line",
      "limit": 10,
      "source": "ＬＯＶＥ!!",
      "target": "ＬＯＶＥ！！"
    },
    {
      "offset": 6497,
      "kind": "line",
      "limit": 5,
      "source": "うるせえ。",
      "target": "吵死了。"
    },
    {
      "offset": 6515,
      "kind": "line",
      "limit": 8,
      "source": "そしてもう１通。",
      "target": "还有一封。"
    },
    {
      "offset": 6539,
      "kind": "line",
      "limit": 11,
      "source": "伊綱ちゃんキュートで",
      "target": "伊纲妹妹又可爱"
    },
    {
      "offset": 6565,
      "kind": "line",
      "limit": 11,
      "source": "ステキです！憧れです！",
      "target": "又迷人！我好崇拜！"
    },
    {
      "offset": 6593,
      "kind": "line",
      "limit": 11,
      "source": "もう大好きです！",
      "target": "我最喜欢你了！"
    },
    {
      "offset": 6618,
      "kind": "line",
      "limit": 8,
      "source": "だあああっ!!",
      "target": "啊啊啊！！"
    },
    {
      "offset": 6636,
      "kind": "line",
      "limit": 8,
      "source": "うるさい黙れっ！",
      "target": "吵死了，闭嘴！"
    },
    {
      "offset": 6658,
      "kind": "line",
      "limit": 4,
      "source": "ばかっ！",
      "target": "笨蛋！"
    },
    {
      "offset": 6674,
      "kind": "line",
      "limit": 11,
      "source": "いけませんよ伊綱さん。",
      "target": "这样不行啊，伊纲小姐。"
    },
    {
      "offset": 6702,
      "kind": "line",
      "limit": 11,
      "source": "せっかくファンの人が",
      "target": "难得粉丝特地"
    },
    {
      "offset": 6728,
      "kind": "line",
      "limit": 11,
      "source": "送ってくれたのに…",
      "target": "寄来这些话…"
    },
    {
      "offset": 6752,
      "kind": "line",
      "limit": 11,
      "source": "そんな冷たい返事は",
      "target": "你怎么能如此"
    },
    {
      "offset": 6776,
      "kind": "line",
      "limit": 11,
      "source": "ないんじゃないですか？",
      "target": "冷淡地回应？"
    },
    {
      "offset": 6816,
      "kind": "line",
      "limit": 11,
      "source": "もっと、カッコいいとか",
      "target": "我更希望听到帅气、"
    },
    {
      "offset": 6844,
      "kind": "line",
      "limit": 11,
      "source": "頼もしいとか、そういう",
      "target": "可靠之类的"
    },
    {
      "offset": 6872,
      "kind": "line",
      "limit": 11,
      "source": "のがいいんですけど。",
      "target": "评价。"
    },
    {
      "offset": 6900,
      "kind": "line",
      "limit": 10,
      "source": "いやあ、そういうのは",
      "target": "哎呀，这种评价"
    },
    {
      "offset": 6926,
      "kind": "line",
      "limit": 10,
      "source": "来てないですねえ。",
      "target": "倒是没收到。"
    },
    {
      "offset": 6962,
      "kind": "line",
      "limit": 4,
      "source": "ゲフー。",
      "target": "噗哇。"
    },
    {
      "offset": 6978,
      "kind": "line",
      "limit": 8,
      "source": "あっ、衝撃発言！",
      "target": "啊，震撼发言！"
    },
    {
      "offset": 7002,
      "kind": "line",
      "limit": 9,
      "source": "しまった、つい…。",
      "target": "糟了，一不留神…"
    },
    {
      "offset": 7026,
      "kind": "line",
      "limit": 9,
      "source": "んもう、生王さんが",
      "target": "真是的，还不都怪"
    },
    {
      "offset": 7072,
      "kind": "line",
      "limit": 9,
      "source": "いつも言うから!!",
      "target": "生王先生总说！！"
    },
    {
      "offset": 7096,
      "kind": "line",
      "limit": 4,
      "source": "くふふ。",
      "target": "呵呵呵。"
    },
    {
      "offset": 7148,
      "kind": "line",
      "limit": 11,
      "source": "はい！…というわけで。",
      "target": "好！…总而言之，"
    },
    {
      "offset": 7176,
      "kind": "line",
      "limit": 8,
      "source": "今回のゲストは、",
      "target": "本期嘉宾是"
    },
    {
      "offset": 7198,
      "kind": "line",
      "limit": 8,
      "source": "探偵助手の白鷺洲",
      "target": "侦探助手白鹭洲"
    },
    {
      "offset": 7237,
      "kind": "line",
      "limit": 8,
      "source": "伊綱さんです！",
      "target": "伊纲小姐！"
    },
    {
      "offset": 7257,
      "kind": "line",
      "limit": 11,
      "source": "どうもどうも、ひとつ",
      "target": "大家好，请多"
    },
    {
      "offset": 7283,
      "kind": "line",
      "limit": 11,
      "source": "よろしくお願いします。",
      "target": "关照。"
    },
    {
      "offset": 7313,
      "kind": "line",
      "limit": 11,
      "source": "…なんですかそれ。",
      "target": "…这又是哪一出。"
    },
    {
      "offset": 7337,
      "kind": "line",
      "limit": 11,
      "source": "ラジオのパーソナリティ",
      "target": "装成电台主持人"
    },
    {
      "offset": 7365,
      "kind": "line",
      "limit": 11,
      "source": "気取りですか？",
      "target": "吗？"
    },
    {
      "offset": 7387,
      "kind": "line",
      "limit": 11,
      "source": "まあいいからいいから。",
      "target": "别管了，别管了。"
    },
    {
      "offset": 7415,
      "kind": "line",
      "limit": 11,
      "source": "こういうのは気分が",
      "target": "做这种事讲究的"
    },
    {
      "offset": 7439,
      "kind": "line",
      "limit": 11,
      "source": "大事ってことで。",
      "target": "就是气氛。"
    },
    {
      "offset": 7461,
      "kind": "line",
      "limit": 10,
      "source": "それではまず最初の",
      "target": "那么第一封"
    },
    {
      "offset": 7485,
      "kind": "line",
      "limit": 10,
      "source": "お便りはこちらっ!!",
      "target": "来信就是这个！！"
    },
    {
      "offset": 7518,
      "kind": "line",
      "limit": 11,
      "source": "さあ、次いきましょう。",
      "target": "好，来看下一封。"
    },
    {
      "offset": 7546,
      "kind": "line",
      "limit": 11,
      "source": "２通目のお便りは",
      "target": "第二封来信"
    },
    {
      "offset": 7568,
      "kind": "line",
      "limit": 11,
      "source": "こちらですっ！",
      "target": "在这里！"
    },
    {
      "offset": 7590,
      "kind": "line",
      "limit": 10,
      "source": "ノリノリですねえ…。",
      "target": "你很来劲啊…"
    },
    {
      "offset": 7625,
      "kind": "line",
      "limit": 10,
      "source": "それでは３通目。",
      "target": "接下来是第三封。"
    },
    {
      "offset": 7647,
      "kind": "line",
      "limit": 10,
      "source": "こんなメールも",
      "target": "还有这样的邮件"
    },
    {
      "offset": 7667,
      "kind": "line",
      "limit": 10,
      "source": "寄せられていますよ！",
      "target": "寄来！"
    },
    {
      "offset": 7695,
      "kind": "line",
      "limit": 9,
      "source": "まだあるんですか？",
      "target": "还有吗？"
    },
    {
      "offset": 7728,
      "kind": "line",
      "limit": 11,
      "source": "さあ、残念ながら最後の",
      "target": "遗憾的是，这已经是"
    },
    {
      "offset": 7756,
      "kind": "line",
      "limit": 11,
      "source": "メールになってしまい",
      "target": "最后一封邮件"
    },
    {
      "offset": 7782,
      "kind": "line",
      "limit": 11,
      "source": "ました！",
      "target": "了！"
    },
    {
      "offset": 7798,
      "kind": "line",
      "limit": 10,
      "source": "残念じゃないですよ。",
      "target": "一点也不遗憾。"
    },
    {
      "offset": 7824,
      "kind": "line",
      "limit": 10,
      "source": "いいから早くして",
      "target": "行了，快点"
    },
    {
      "offset": 7846,
      "kind": "line",
      "limit": 10,
      "source": "ください。",
      "target": "念吧。"
    },
    {
      "offset": 7884,
      "kind": "line",
      "limit": 9,
      "source": "…っと、今回の",
      "target": "…好了，本期"
    },
    {
      "offset": 7904,
      "kind": "line",
      "limit": 9,
      "source": "お便りは以上です。",
      "target": "来信到此结束。"
    },
    {
      "offset": 7928,
      "kind": "line",
      "limit": 10,
      "source": "伊綱さん、ありがとう",
      "target": "伊纲小姐，非常感谢"
    },
    {
      "offset": 7954,
      "kind": "line",
      "limit": 10,
      "source": "ございました。",
      "target": "你的回答。"
    },
    {
      "offset": 7976,
      "kind": "line",
      "limit": 9,
      "source": "これで満足ですか？",
      "target": "这下满意了？"
    },
    {
      "offset": 8002,
      "kind": "line",
      "limit": 11,
      "source": "いやあ、いいコメントが",
      "target": "哎呀，录到了"
    },
    {
      "offset": 8030,
      "kind": "line",
      "limit": 11,
      "source": "録れたなあ。",
      "target": "很不错的回答。"
    },
    {
      "offset": 8048,
      "kind": "line",
      "limit": 10,
      "source": "面白かったのでサイト",
      "target": "太有趣了，不放网站，"
    },
    {
      "offset": 8074,
      "kind": "line",
      "limit": 10,
      "source": "じゃなくて、アプリに",
      "target": "干脆收进应用"
    },
    {
      "offset": 8100,
      "kind": "line",
      "limit": 10,
      "source": "入れちゃおうかな…。",
      "target": "里吧…"
    },
    {
      "offset": 8128,
      "kind": "line",
      "limit": 9,
      "source": "…ああもう、勝手に",
      "target": "…真是的，随你"
    },
    {
      "offset": 8152,
      "kind": "line",
      "limit": 9,
      "source": "してください。",
      "target": "高兴吧。"
    },
    {
      "offset": 8279,
      "kind": "line",
      "limit": 9,
      "source": "あれ、お客さんだ。",
      "target": "咦，有客人。"
    },
    {
      "offset": 8303,
      "kind": "line",
      "limit": 5,
      "source": "…はーい！",
      "target": "…来啦！"
    },
    {
      "offset": 8331,
      "kind": "line",
      "limit": 10,
      "source": "おや、わざわざ",
      "target": "哎呀，居然特地"
    },
    {
      "offset": 8351,
      "kind": "line",
      "limit": 10,
      "source": "こんな大雨の日に…？",
      "target": "冒着这么大的雨…？"
    },
    {
      "offset": 8394,
      "kind": "line",
      "limit": 11,
      "source": "困ったことが起こるのに",
      "target": "遇上麻烦这种事，"
    },
    {
      "offset": 8422,
      "kind": "line",
      "limit": 11,
      "source": "雨も晴れも関係ありま",
      "target": "和天晴还是下雨"
    },
    {
      "offset": 8448,
      "kind": "line",
      "limit": 11,
      "source": "せんよ。",
      "target": "无关。"
    },
    {
      "offset": 8464,
      "kind": "line",
      "limit": 11,
      "source": "いいから早く出なって！",
      "target": "行了，快去开门！"
    },
    {
      "offset": 8504,
      "kind": "line",
      "limit": 6,
      "source": "はいはーい！",
      "target": "来了！"
    },
    {
      "offset": 8531,
      "kind": "line",
      "limit": 11,
      "source": "…あ、どうぞこちらへ。",
      "target": "…请进这边。"
    },
    {
      "offset": 8587,
      "kind": "name",
      "limit": 0,
      "source": "(男性)",
      "target": "（男性）"
    },
    {
      "offset": 8612,
      "kind": "line",
      "limit": 11,
      "source": "…あの、失礼します…。",
      "target": "…打扰了…"
    },
    {
      "offset": 8640,
      "kind": "line",
      "limit": 9,
      "source": "こちら、癸生川探偵",
      "target": "这里是癸生川侦探"
    },
    {
      "offset": 8686,
      "kind": "line",
      "limit": 9,
      "source": "事務所ですよね？",
      "target": "事务所吧？"
    },
    {
      "offset": 8710,
      "kind": "line",
      "limit": 9,
      "source": "はい、そうですよ。",
      "target": "对，就是这里。"
    },
    {
      "offset": 8736,
      "kind": "line",
      "limit": 4,
      "source": "はぁ…。",
      "target": "唉…"
    },
    {
      "offset": 8750,
      "kind": "line",
      "limit": 11,
      "source": "…あの、こちらに白鷺洲",
      "target": "…请问这里是不是有位"
    },
    {
      "offset": 8795,
      "kind": "line",
      "limit": 11,
      "source": "さんっていう探偵助手が",
      "target": "姓白鹭洲的"
    },
    {
      "offset": 8823,
      "kind": "line",
      "limit": 11,
      "source": "いたと思うんですが…。",
      "target": "侦探助手…"
    },
    {
      "offset": 8853,
      "kind": "line",
      "limit": 6,
      "source": "あ、はい。",
      "target": "啊，是的。"
    },
    {
      "offset": 8869,
      "kind": "line",
      "limit": 6,
      "source": "私ですが…？",
      "target": "就是我…？"
    },
    {
      "offset": 8889,
      "kind": "line",
      "limit": 5,
      "source": "…えっ!?",
      "target": "…什么！？"
    },
    {
      "offset": 8903,
      "kind": "line",
      "limit": 10,
      "source": "…あはは、いやいや、",
      "target": "…哈哈，不是，"
    },
    {
      "offset": 8929,
      "kind": "line",
      "limit": 10,
      "source": "あなたのような娘さん",
      "target": "不是你这样的"
    },
    {
      "offset": 8955,
      "kind": "line",
      "limit": 10,
      "source": "じゃなくて…。",
      "target": "年轻姑娘…"
    },
    {
      "offset": 8977,
      "kind": "line",
      "limit": 2,
      "source": "…？",
      "target": "…？"
    },
    {
      "offset": 8989,
      "kind": "line",
      "limit": 10,
      "source": "ここにいましたよね？",
      "target": "他以前在这里吧？"
    },
    {
      "offset": 9015,
      "kind": "line",
      "limit": 10,
      "source": "あの…",
      "target": "那个…"
    },
    {
      "offset": 9040,
      "kind": "line",
      "limit": 9,
      "source": "白鷺洲っていう、",
      "target": "就是一个姓"
    },
    {
      "offset": 9068,
      "kind": "line",
      "limit": 9,
      "source": "メガネの青年が…。",
      "target": "戴眼镜的青年…"
    },
    {
      "offset": 9107,
      "kind": "line",
      "limit": 5,
      "source": "…えっ!?",
      "target": "…什么！？"
    },
    {
      "offset": 9123,
      "kind": "line",
      "limit": 2,
      "source": "…？",
      "target": "…？"
    },
    {
      "offset": 9138,
      "kind": "line",
      "limit": 11,
      "source": "…その瞬間から、しばし",
      "target": "…从那一刻起，"
    },
    {
      "offset": 9179,
      "kind": "line",
      "limit": 11,
      "source": "静寂が続いた。",
      "target": "沉默持续了片刻。"
    },
    {
      "offset": 9205,
      "kind": "line",
      "limit": 11,
      "source": "さっきまで耳障りだった",
      "target": "方才还刺耳的"
    },
    {
      "offset": 9255,
      "kind": "line",
      "limit": 11,
      "source": "ほどの雨の音が、途端に",
      "target": "雨声，突然间"
    },
    {
      "offset": 9283,
      "kind": "line",
      "limit": 11,
      "source": "聞こえなくなった。",
      "target": "消失了。"
    },
    {
      "offset": 9307,
      "kind": "line",
      "limit": 11,
      "source": "私の隣にいた伊綱君は",
      "target": "站在我身边的伊纲"
    },
    {
      "offset": 9333,
      "kind": "line",
      "limit": 11,
      "source": "呼吸が止まるほど驚き…",
      "target": "惊讶得屏住呼吸…"
    },
    {
      "offset": 9361,
      "kind": "line",
      "limit": 11,
      "source": "その高鳴る心臓の鼓動が",
      "target": "她剧烈的心跳声"
    },
    {
      "offset": 9389,
      "kind": "line",
      "limit": 11,
      "source": "ここまで聞こえてくる",
      "target": "仿佛连我都能"
    },
    {
      "offset": 9415,
      "kind": "line",
      "limit": 11,
      "source": "ようだった。",
      "target": "听见。"
    },
    {
      "offset": 9444,
      "kind": "line",
      "limit": 10,
      "source": "…しかし、それも",
      "target": "…不过，那也"
    },
    {
      "offset": 9466,
      "kind": "line",
      "limit": 10,
      "source": "ほんの一瞬のことで。",
      "target": "只是一瞬。"
    },
    {
      "offset": 9492,
      "kind": "line",
      "limit": 11,
      "source": "彼女はすぐに動揺を隠し",
      "target": "她立刻掩饰住动摇，"
    },
    {
      "offset": 9520,
      "kind": "line",
      "limit": 11,
      "source": "平然と、その人はいない",
      "target": "若无其事地告诉他，"
    },
    {
      "offset": 9548,
      "kind": "line",
      "limit": 11,
      "source": "…という旨を伝える。",
      "target": "那人不在这里。"
    },
    {
      "offset": 9608,
      "kind": "line",
      "limit": 10,
      "source": "…ああ、そうですか。",
      "target": "…啊，是吗。"
    },
    {
      "offset": 9634,
      "kind": "line",
      "limit": 10,
      "source": "今はもう、ここには",
      "target": "他现在已经"
    },
    {
      "offset": 9658,
      "kind": "line",
      "limit": 10,
      "source": "いないんですか…。",
      "target": "不在这里了啊…"
    },
    {
      "offset": 9687,
      "kind": "line",
      "limit": 11,
      "source": "来訪した男性は、",
      "target": "来访的男人得知"
    },
    {
      "offset": 9709,
      "kind": "line",
      "limit": 11,
      "source": "その青年がいないと知り",
      "target": "那名青年不在，"
    },
    {
      "offset": 9737,
      "kind": "line",
      "limit": 11,
      "source": "残念そうに頷くと…",
      "target": "遗憾地点了点头…"
    },
    {
      "offset": 9781,
      "kind": "line",
      "limit": 11,
      "source": "そこでようやく、名前は",
      "target": "这时才终于自称"
    },
    {
      "offset": 9824,
      "kind": "line",
      "limit": 11,
      "source": "螻川内だと名乗った。",
      "target": "姓蝼川内。"
    },
    {
      "offset": 9860,
      "kind": "line",
