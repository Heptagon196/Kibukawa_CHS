      "target": "蝼川内先生说，"
    },
    {
      "offset": 9926,
      "kind": "line",
      "limit": 11,
      "source": "８年前の約束を果たしに",
      "target": "他是来兑现"
    },
    {
      "offset": 9960,
      "kind": "line",
      "limit": 11,
      "source": "来たのだと告げた。",
