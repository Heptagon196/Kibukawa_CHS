    {
      "offset": 10014,
      "kind": "line",
      "limit": 7,
      "source": "約束…ですか？",
      "target": "约定…吗？"
    },
    {
      "offset": 10036,
      "kind": "line",
      "limit": 7,
      "source": "そうなんです。",
      "target": "是的。"
    },
    {
      "offset": 10061,
      "kind": "line",
      "limit": 11,
      "source": "この男性の話によれば…",
