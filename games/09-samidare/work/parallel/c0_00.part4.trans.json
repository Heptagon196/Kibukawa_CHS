{
  "script": "c0_00",
  "units": [
    {"offset": 16515, "target": "也就是说…"},
    {"offset": 16553, "target": "我们不能随便插手"},
    {"offset": 16581, "target": "别人家的问题，"},
    {"offset": 16609, "target": "可是…"},
    {"offset": 16643, "target": "必须设法找到"},
    {"offset": 16671, "target": "查明他身份的"},
    {"offset": 16697, "target": "线索。"},
    {"offset": 16728, "target": "总之先别管内情，"},
    {"offset": 16754, "target": "我们也不能放着"},
    {"offset": 16778, "target": "他不管啊…"},
    {"offset": 16815, "target": "既然都来了，"},
    {"offset": 16850, "target": "生王先生也来"},
    {"offset": 16880, "target": "帮忙吧。"},
    {"offset": 16900, "target": "唔唔唔，"},
    {"offset": 16916, "target": "果然会变成这样…"},
    {"offset": 17001, "target": "糟糕，他彻底"},
    {"offset": 17027, "target": "不说话了…"},
    {"offset": 17051, "target": "叫伊纲过来"},
    {"offset": 17077, "target": "商量一下吧。"},
    {"offset": 17102, "target": "呃…到底该怎么问"},
    {"offset": 17130, "target": "他才肯开口"},
    {"offset": 17150, "target": "呢？"},
    {"offset": 17171, "target": "唔…我先自己"},
    {"offset": 17199, "target": "推理一下吧。"},
    {"offset": 17221, "target": "如果他没有迷路，"},
    {"offset": 17247, "target": "那他待在公寓楼"},
    {"offset": 17275, "target": "前是因为…"},
    {"offset": 17298, "target": "只是出来玩"},
    {"offset": 17318, "target": "离家出走"},
    {"offset": 17334, "target": "被父母抛弃"},
    {"offset": 17352, "target": "他会不会只是"},
    {"offset": 17378, "target": "一个人出来玩，"},
    {"offset": 17406, "target": "才来到这里？"},
    {"offset": 17432, "target": "毕竟他也没说过"},
    {"offset": 17460, "target": "自己迷路了…"},
    {"offset": 17497, "target": "他似乎有什么"},
    {"offset": 17523, "target": "难言之隐，该不会"},
    {"offset": 17551, "target": "是离家出走！？"},
    {"offset": 17592, "target": "他说父母不担心"},
    {"offset": 17618, "target": "他，所以…"},
    {"offset": 17638, "target": "难道他被抛弃了", "runs": ["难道他", "被抛弃了"]},
    {"offset": 17670, "target": "不会真有这种"},
    {"offset": 17694, "target": "可能吧…？"},
    {"offset": 17721, "target": "好。"},
    {"offset": 17733, "target": "把刚才的推理"},
    {"offset": 17759, "target": "告诉伊纲确认一下。"},
    {"offset": 17790, "target": "这孩子的线索啊…"},
    {"offset": 17818, "target": "还是再仔细观察", "runs": ["还是再仔细", "观察"]},
    {"offset": 17859, "target": "一下吧…"},
    {"offset": 17883, "target": "少年"},
    {"offset": 17891, "target": "伊纲"},
    {"offset": 17938, "target": "…嗯？"},
    {"offset": 18000, "target": "嗯，什么事？"},
    {"offset": 18035, "target": "…啊，她已经"},
    {"offset": 18055, "target": "联系上对方了。"},
    {"offset": 18087, "target": "…对，是的。"},
    {"offset": 18111, "target": "孩子现在在我们这里。"},
    {"offset": 18139, "target": "…啊，是您孙子吗？"},
    {"offset": 18167, "target": "…是。"},
    {"offset": 18181, "target": "好的，麻烦您了。"},
    {"offset": 18207, "target": "地址是鞠滨台的…"},
    {"offset": 18287, "target": "…打完电话了。"},
    {"offset": 18309, "target": "他爷爷现在会来"},
    {"offset": 18373, "target": "接他。"},
    {"offset": 18399, "target": "他们一直在找"},
    {"offset": 18425, "target": "这孩子，"},
    {"offset": 18449, "target": "知道他没事就放心了。"},
    {"offset": 18475, "target": "这样啊。"},
    {"offset": 18489, "target": "那太好了。"},
    {"offset": 18513, "target": "………"},
    {"offset": 18529, "target": "少年似乎认命了，"},
    {"offset": 18557, "target": "虽然噘着嘴，"},
    {"offset": 18583, "target": "还是默默坐着。"},
    {"offset": 18609, "target": "…爷爷会"},
    {"offset": 18649, "target": "来接我啊…"},
    {"offset": 18673, "target": "小朋友，你爸爸呢？"},
    {"offset": 18699, "target": "……哼。"},
    {"offset": 18727, "target": "…他和爸爸之间"},
    {"offset": 18751, "target": "发生了什么吗？"},
    {"offset": 18781, "target": "真没办法…"},
    {"offset": 18854, "target": "大约３０分钟后…"},
    {"offset": 18944, "target": "…泉！", "runs": ["…", "泉！"]},
    {"offset": 18983, "target": "你原来在这种"},
    {"offset": 19009, "target": "地方。"},
    {"offset": 19055, "target": "……切。"},
    {"offset": 19088, "target": "…哎呀，没先道谢"},
    {"offset": 19110, "target": "真是失礼了。"},
    {"offset": 19130, "target": "谢谢你们保护"},
    {"offset": 19154, "target": "我的孙子。"},
    {"offset": 19184, "target": "哪里哪里，能把他"},
    {"offset": 19208, "target": "平安交还给您，"},
    {"offset": 19232, "target": "我们也很高兴。"},
    {"offset": 19254, "target": "其实今天全家"},
    {"offset": 19287, "target": "开车来鞠滨"},
    {"offset": 19315, "target": "游玩…"},
    {"offset": 19335, "target": "稍没留神，"},
    {"offset": 19361, "target": "这孩子就不见了，"},
    {"offset": 19389, "target": "全家都急坏了。"},
    {"offset": 19413, "target": "儿媳还怪我"},
    {"offset": 19441, "target": "没看好他…"},
    {"offset": 19471, "target": "哈哈，原来"},
    {"offset": 19495, "target": "是这么回事。"},
    {"offset": 19517, "target": "我们还担心"},
    {"offset": 19541, "target": "他是不是离家"},
    {"offset": 19563, "target": "出走了。"},
    {"offset": 19591, "target": "真的给你们"},
    {"offset": 19611, "target": "添麻烦了。"},
    {"offset": 19638, "target": "那个…"},
    {"offset": 19656, "target": "嗯？"},
    {"offset": 19670, "target": "这孩子…名字叫泉", "runs": ["这孩子…名字", "叫泉"]},
    {"offset": 19715, "target": "对吗？"},
    {"offset": 19737, "target": "啊，他确实"},
    {"offset": 19761, "target": "叫这个名字。"},
    {"offset": 19777, "target": "因为像女孩的名字，"},
    {"offset": 19803, "target": "他自己似乎"},
    {"offset": 19829, "target": "不太喜欢…"},
    {"offset": 19849, "target": "原来如此，所以"},
    {"offset": 19871, "target": "他才不肯说名字吗。"},
    {"offset": 19901, "target": "………"},
    {"offset": 19917, "target": "我儿子也真是，"},
    {"offset": 19941, "target": "怎么会给他起了"},
    {"offset": 19967, "target": "这种名字…"},
    {"offset": 19983, "target": "…是啊。"},
    {"offset": 19997, "target": "我先走了。"},
    {"offset": 20035, "target": "啊，泉！"},
    {"offset": 20055, "target": "等等！"},
    {"offset": 20073, "target": "啊，那个…"},
    {"offset": 20093, "target": "没关系，快追上去，"},
    {"offset": 20119, "target": "这次别再跟丢"},
    {"offset": 20145, "target": "他了。"},
    {"offset": 20175, "target": "好，真抱歉。"},
    {"offset": 20199, "target": "那我们告辞了。"},
    {"offset": 20223, "target": "今天真的非常感谢"},
    {"offset": 20251, "target": "你们。"},
    {"offset": 20271, "target": "改日一定登门致谢…"},
    {"offset": 20301, "target": "不用不用，"},
    {"offset": 20317, "target": "别放在心上。"},
    {"offset": 20361, "target": "…真是的。"},
    {"offset": 20396, "target": "不管怎样，这件事"},
    {"offset": 20422, "target": "总算解决了。"},
    {"offset": 20444, "target": "辛苦了。"},
    {"offset": 20470, "target": "可是这种时候，"},
    {"offset": 20494, "target": "他爸爸也没来"},
    {"offset": 20516, "target": "接他啊。"},
    {"offset": 20540, "target": "泉是不是也因此"},
    {"offset": 20566, "target": "觉得不高兴呢…？"},
    {"offset": 20606, "target": "会不会只是因为"},
    {"offset": 20632, "target": "不喜欢这个像女孩的"},
    {"offset": 20656, "target": "名字？"},
    {"offset": 20690, "target": "可能有些家庭"},
    {"offset": 20714, "target": "内情吧。"},
    {"offset": 20742, "target": "不过我实在"},
    {"offset": 20764, "target": "不擅长应付孩子…"},
    {"offset": 20790, "target": "这种时候，癸生川"},
    {"offset": 20840, "target": "要是在就好了…"},
    {"offset": 20870, "target": "是啊。"},
    {"offset": 20904, "target": "说起来，不知为何"},
    {"offset": 20932, "target": "老师总能很快"},
    {"offset": 20958, "target": "和孩子亲近起来…"},
    {"offset": 20982, "target": "因为心理年龄"},
    {"offset": 21006, "target": "相近吧。"},
    {"offset": 21030, "target": "也许是某种波长"},
    {"offset": 21058, "target": "很合得来吧…"},
    {"offset": 21092, "target": "…对了，"},
    {"offset": 21123, "target": "生王先生。"},
    {"offset": 21147, "target": "…嗯？"},
    {"offset": 21161, "target": "你今天到底来"},
    {"offset": 21189, "target": "做什么？"},
    {"offset": 21211, "target": "…啊！"},
    {"offset": 21227, "target": "糟糕，我忘了！！"},
    {"offset": 21253, "target": "伊纲，我有件事"},
    {"offset": 21281, "target": "想拜托你…"},
    {"offset": 21305, "target": "不要。"},
    {"offset": 21321, "target": "真干脆！"},
    {"offset": 21335, "target": "至少先听我说完"},
    {"offset": 21363, "target": "也好啊！"},
    {"offset": 21387, "target": "反正又是叫我写"},
    {"offset": 21413, "target": "电子报之类的"},
    {"offset": 21441, "target": "麻烦事吧？"},
    {"offset": 21471, "target": "不是，今天不是"},
    {"offset": 21499, "target": "那种事。"},
    {"offset": 21521, "target": "唉…"},
    {"offset": 21541, "target": "其实…"},
    {"offset": 21565, "target": "保存"},
    {"offset": 21579, "target": "返回游戏"},
    {"offset": 21608, "target": "已保存。"},
    {"offset": 21644, "target": "保存失败了。", "runs": ["保存", "失败", "了。"]}
  ]
}
