    },
    {
      "offset": 18699,
      "kind": "line",
      "limit": 5,
      "source": "……ふん。",
      "target": "……哼。"
    },
    {
      "offset": 18727,
      "kind": "line",
      "limit": 11,
      "source": "…お父さんと、何か",
      "target": "…他和爸爸之间"
    },
    {
      "offset": 18751,
      "kind": "line",
      "limit": 11,
      "source": "あったんでしょうかね。",
      "target": "发生了什么吗？"
    },
    {
      "offset": 18781,
      "kind": "line",
      "limit": 6,
      "source": "やれやれ…。",
