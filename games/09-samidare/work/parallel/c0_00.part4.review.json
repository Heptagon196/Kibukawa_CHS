    },
    {
      "offset": 20840,
      "kind": "line",
      "limit": 11,
      "source": "いてくれればいいのに…",
      "target": "要是在就好了…"
    },
    {
      "offset": 20870,
      "kind": "line",
      "limit": 9,
      "source": "ああ、そうですね。",
      "target": "是啊。"
    },
    {
      "offset": 20904,
      "kind": "line",
      "limit": 11,
      "source": "そう言えば先生、なぜか",
      "target": "说起来，不知为何"
