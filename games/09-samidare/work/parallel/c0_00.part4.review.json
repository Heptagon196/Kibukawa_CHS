      "target": "不太喜欢…"
    },
    {
      "offset": 19849,
      "kind": "line",
      "limit": 11,
      "source": "なるほど、それで",
      "target": "原来如此，所以"
    },
    {
      "offset": 19871,
      "kind": "line",
      "limit": 11,
      "source": "名乗らなかったのかな。",
      "target": "他才不肯说名字吗。"
    },
    {
      "offset": 19901,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 19917,
      "kind": "line",
      "limit": 10,
      "source": "息子も、なんだって",
      "target": "我儿子也真是，"
    },
    {
      "offset": 19941,
      "kind": "line",
      "limit": 10,
      "source": "こんな名前を付けたの",
      "target": "怎么会给他起了"
    },
    {
      "offset": 19967,
      "kind": "line",
      "limit": 10,
      "source": "やら…。",
      "target": "这种名字…"
    },
    {
      "offset": 19983,
      "kind": "line",
      "limit": 10,
      "source": "…ねー。",
      "target": "…是啊。"
    },
    {
      "offset": 19997,
      "kind": "line",
      "limit": 10,
      "source": "ボクもう先に行くよ。",
      "target": "我先走了。"
    },
    {
      "offset": 20035,
      "kind": "line",
      "limit": 7,
      "source": "あっ、こら泉。",
      "target": "啊，泉！"
    },
    {
      "offset": 20055,
      "kind": "line",
      "limit": 7,
      "source": "待ちなさい！",
      "target": "等等！"
    },
    {
      "offset": 20073,
      "kind": "line",
      "limit": 6,
      "source": "あ、ええと…",
      "target": "啊，那个…"
    },
    {
      "offset": 20093,
      "kind": "line",
      "limit": 11,
      "source": "大丈夫ですよ。今度は",
      "target": "没关系，快追上去，"
    },
    {
      "offset": 20119,
      "kind": "line",
      "limit": 11,
      "source": "見失わないよう、早く",
      "target": "这次别再跟丢"
    },
    {
      "offset": 20145,
      "kind": "line",
      "limit": 11,
      "source": "行ってあげてください。",
      "target": "他了。"
    },
    {
      "offset": 20175,
      "kind": "line",
      "limit": 9,
      "source": "ああ、すみません。",
      "target": "好，真抱歉。"
    },
    {
      "offset": 20199,
      "kind": "line",
      "limit": 9,
      "source": "ではこれで失礼を。",
      "target": "那我们告辞了。"
    },
    {
      "offset": 20223,
      "kind": "line",
      "limit": 11,
      "source": "今日は本当にありがとう",
      "target": "今天真的非常感谢"
    },
    {
      "offset": 20251,
      "kind": "line",
      "limit": 11,
      "source": "ございました。",
      "target": "你们。"
    },
    {
      "offset": 20271,
      "kind": "line",
      "limit": 11,
      "source": "このお礼は、改めて…。",
      "target": "改日一定登门致谢…"
    },
    {
      "offset": 20301,
      "kind": "line",
      "limit": 8,
      "source": "いえいえ、",
      "target": "不用不用，"
    },
    {
      "offset": 20317,
      "kind": "line",
      "limit": 8,
      "source": "お気になさらず。",
      "target": "别放在心上。"
    },
    {
      "offset": 20361,
      "kind": "line",
      "limit": 6,
      "source": "…やれやれ。",
      "target": "…真是的。"
    },
    {
      "offset": 20396,
      "kind": "line",
      "limit": 10,
      "source": "まあ、ともあれこれで",
      "target": "不管怎样，这件事"
    },
    {
      "offset": 20422,
      "kind": "line",
      "limit": 10,
      "source": "一件落着ですね。",
      "target": "总算解决了。"
    },
    {
      "offset": 20444,
      "kind": "line",
      "limit": 10,
      "source": "お疲れさまでした。",
      "target": "辛苦了。"
    },
    {
      "offset": 20470,
      "kind": "line",
      "limit": 9,
      "source": "でも、こんな時でも",
      "target": "可是这种时候，"
    },
    {
      "offset": 20494,
      "kind": "line",
      "limit": 9,
      "source": "お父さんは迎えに",
      "target": "他爸爸也没来"
