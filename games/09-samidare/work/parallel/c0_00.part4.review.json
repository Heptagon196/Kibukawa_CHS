  "units": [
    {
      "offset": 16515,
      "kind": "line",
      "limit": 11,
      "source": "つまり…",
      "target": "也就是说…"
    },
    {
      "offset": 16553,
      "kind": "line",
      "limit": 11,
      "source": "家庭の問題に、私たちが",
      "target": "我们不能随便插手"
    },
    {
      "offset": 16581,
      "kind": "line",
      "limit": 11,
      "source": "勝手に踏み込むわけには",
      "target": "别人家的问题，"
    },
    {
      "offset": 16609,
      "kind": "line",
      "limit": 11,
      "source": "いきませんけど…",
      "target": "可是…"
    },
    {
      "offset": 16643,
      "kind": "line",
      "limit": 11,
      "source": "どうにかして彼の素性の",
      "target": "必须设法找到"
    },
    {
      "offset": 16671,
      "kind": "line",
      "limit": 11,
      "source": "手掛かりを探さないと",
      "target": "查明他身份的"
    },
    {
      "offset": 16697,
      "kind": "line",
      "limit": 11,
      "source": "いけませんね。",
      "target": "线索。"
    },
    {
      "offset": 16728,
      "kind": "line",
      "limit": 10,
      "source": "まあ、事情はともかく",
      "target": "总之先别管内情，"
    },
    {
      "offset": 16754,
      "kind": "line",
      "limit": 10,
      "source": "放っておくわけにも",
      "target": "我们也不能放着"
    },
    {
      "offset": 16778,
      "kind": "line",
      "limit": 10,
      "source": "いかないからなあ…。",
      "target": "他不管啊…"
    },
    {
      "offset": 16815,
      "kind": "line",
      "limit": 9,
      "source": "せっかくですから、",
      "target": "既然都来了，"
    },
    {
      "offset": 16850,
      "kind": "line",
      "limit": 9,
      "source": "生王さんも手伝って",
      "target": "生王先生也来"
    },
    {
      "offset": 16880,
      "kind": "line",
      "limit": 9,
      "source": "くださいね。",
      "target": "帮忙吧。"
    },
    {
      "offset": 16900,
      "kind": "line",
      "limit": 11,
      "source": "うぬぬぬ、",
      "target": "唔唔唔，"
    },
    {
      "offset": 16916,
      "kind": "line",
      "limit": 11,
      "source": "やっぱそうなるのか…。",
      "target": "果然会变成这样…"
    },
    {
      "offset": 17001,
      "kind": "line",
      "limit": 10,
      "source": "まずいなあ、徹底的に",
      "target": "糟糕，他彻底"
    },
    {
      "offset": 17027,
      "kind": "line",
      "limit": 10,
      "source": "黙っちゃったよ…。",
      "target": "不说话了…"
    },
    {
      "offset": 17051,
      "kind": "line",
      "limit": 10,
      "source": "伊綱君を呼んで、少し",
      "target": "叫伊纲过来"
    },
    {
      "offset": 17077,
      "kind": "line",
      "limit": 10,
      "source": "相談してみるか。",
      "target": "商量一下吧。"
    },
    {
      "offset": 17102,
      "kind": "line",
      "limit": 11,
      "source": "ええと…何をどう聞けば",
      "target": "呃…到底该怎么问"
    },
    {
      "offset": 17130,
      "kind": "line",
      "limit": 11,
      "source": "話してくれるん",
      "target": "他才肯开口"
    },
    {
      "offset": 17150,
      "kind": "line",
      "limit": 11,
      "source": "だろうか。",
      "target": "呢？"
    },
    {
      "offset": 17171,
      "kind": "line",
      "limit": 11,
      "source": "ええと…少し自分なりに",
      "target": "唔…我先自己"
    },
    {
      "offset": 17199,
      "kind": "line",
      "limit": 11,
      "source": "推理してみるか。",
      "target": "推理一下吧。"
    },
    {
      "offset": 17221,
      "kind": "line",
      "limit": 11,
      "source": "もしこの子が迷子じゃ",
      "target": "如果他没有迷路，"
    },
    {
      "offset": 17247,
      "kind": "line",
      "limit": 11,
      "source": "ないなら、マンションの",
      "target": "那他待在公寓楼"
    },
    {
      "offset": 17275,
      "kind": "line",
      "limit": 11,
      "source": "前にいたのは…",
      "target": "前是因为…"
    },
    {
      "offset": 17298,
      "kind": "choice",
      "limit": 0,
      "source": "ただ遊んでただけ",
      "target": "只是出来玩"
    },
    {
      "offset": 17318,
      "kind": "choice",
      "limit": 0,
      "source": "家出してきた",
      "target": "离家出走"
    },
    {
      "offset": 17334,
      "kind": "choice",
      "limit": 0,
      "source": "親に捨てられた",
      "target": "被父母抛弃"
    },
    {
      "offset": 17352,
      "kind": "line",
      "limit": 10,
      "source": "実はただ、ひとりで",
      "target": "他会不会只是"
    },
    {
      "offset": 17378,
      "kind": "line",
      "limit": 10,
      "source": "遊びに来てただけ",
      "target": "一个人出来玩，"
    },
    {
      "offset": 17406,
      "kind": "line",
      "limit": 10,
      "source": "だったりしないかな。",
      "target": "才来到这里？"
    },
    {
      "offset": 17432,
      "kind": "line",
      "limit": 11,
      "source": "実際、迷子になったとは",
      "target": "毕竟他也没说过"
    },
    {
      "offset": 17460,
      "kind": "line",
      "limit": 11,
      "source": "言ってないわけだし…。",
      "target": "自己迷路了…"
    },
    {
      "offset": 17497,
      "kind": "line",
      "limit": 11,
      "source": "なにか言いにくそうな",
      "target": "他似乎有什么"
    },
    {
      "offset": 17523,
      "kind": "line",
      "limit": 11,
      "source": "感じがするし、もしや",
      "target": "难言之隐，该不会"
    },
    {
      "offset": 17551,
      "kind": "line",
      "limit": 11,
      "source": "家出をしてきたとか!?",
      "target": "是离家出走！？"
    },
    {
      "offset": 17592,
      "kind": "line",
      "limit": 10,
      "source": "親が心配してないって",
      "target": "他说父母不担心"
    },
    {
      "offset": 17618,
      "kind": "line",
      "limit": 10,
      "source": "言ってたから…",
      "target": "他，所以…"
    },
    {
      "offset": 17638,
      "kind": "line",
      "limit": 9,
      "source": "もしや、捨てられた",
      "target": "难道他被抛弃了",
      "runs": [
        "难道他",
        "被抛弃了"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "もしや、"
        },
        {
          "colour": 2,
          "text": "捨てられた"
        }
      ]
    },
    {
      "offset": 17670,
      "kind": "line",
      "limit": 9,
      "source": "なんてことは、ない",
      "target": "不会真有这种"
    },
    {
      "offset": 17694,
      "kind": "line",
      "limit": 9,
      "source": "だろうか…？",
      "target": "可能吧…？"
    },
    {
      "offset": 17721,
      "kind": "line",
      "limit": 11,
      "source": "よし。",
      "target": "好。"
    },
    {
      "offset": 17733,
      "kind": "line",
      "limit": 11,
      "source": "今の推理を、伊綱君に",
      "target": "把刚才的推理"
    },
    {
      "offset": 17759,
      "kind": "line",
      "limit": 11,
      "source": "話して確認してみよう。",
      "target": "告诉伊纲确认一下。"
    },
    {
      "offset": 17790,
      "kind": "line",
      "limit": 11,
      "source": "この子の手掛かりか…。",
      "target": "这孩子的线索啊…"
    },
    {
      "offset": 17818,
      "kind": "line",
      "limit": 11,
      "source": "もう少し、よく観察して",
      "target": "还是再仔细观察",
      "runs": [
        "还是再仔细",
        "观察"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "もう少し、よく"
        },
        {
          "colour": 2,
          "text": "観察して"
        }
      ]
    },
    {
      "offset": 17859,
      "kind": "line",
      "limit": 11,
      "source": "みるかな…。",
      "target": "一下吧…"
    },
    {
      "offset": 17883,
      "kind": "choice",
      "limit": 0,
      "source": "少年",
      "target": "少年"
    },
    {
      "offset": 17891,
      "kind": "choice",
      "limit": 0,
      "source": "伊綱",
      "target": "伊纲"
    },
    {
      "offset": 17938,
      "kind": "line",
      "limit": 4,
      "source": "…んー？",
      "target": "…嗯？"
    },
    {
      "offset": 18000,
      "kind": "line",
      "limit": 9,
      "source": "はい、なんですか？",
      "target": "嗯，什么事？"
    },
    {
      "offset": 18035,
      "kind": "line",
      "limit": 9,
      "source": "…っと、すでに",
      "target": "…啊，她已经"
    },
    {
      "offset": 18055,
      "kind": "line",
      "limit": 9,
      "source": "話を聞ける状態か。",
      "target": "联系上对方了。"
    },
    {
      "offset": 18087,
      "kind": "line",
      "limit": 11,
      "source": "…はい、そうです。",
      "target": "…对，是的。"
    },
    {
      "offset": 18111,
      "kind": "line",
      "limit": 11,
      "source": "お子さんが今、うちに。",
      "target": "孩子现在在我们这里。"
    },
    {
      "offset": 18139,
      "kind": "line",
      "limit": 11,
      "source": "…あ、お孫さんですか？",
      "target": "…啊，是您孙子吗？"
    },
    {
      "offset": 18167,
      "kind": "line",
      "limit": 11,
      "source": "…はい。",
      "target": "…是。"
    },
    {
      "offset": 18181,
      "kind": "line",
      "limit": 10,
      "source": "はい、お願いします。",
      "target": "好的，麻烦您了。"
    },
    {
      "offset": 18207,
      "kind": "line",
      "limit": 10,
      "source": "住所は、鞠浜台の…",
      "target": "地址是鞠滨台的…"
    },
    {
      "offset": 18287,
      "kind": "line",
      "limit": 11,
      "source": "…電話しました。",
      "target": "…打完电话了。"
    },
    {
      "offset": 18309,
      "kind": "line",
      "limit": 11,
      "source": "今、お祖父さんが迎えに",
      "target": "他爷爷现在会来"
    },
    {
      "offset": 18373,
      "kind": "line",
      "limit": 11,
      "source": "来てくれるそうです。",
      "target": "接他。"
    },
    {
      "offset": 18399,
      "kind": "line",
      "limit": 10,
      "source": "今までずっとこの子を",
      "target": "他们一直在找"
    },
    {
      "offset": 18425,
      "kind": "line",
      "limit": 10,
      "source": "捜してたらしくて、",
      "target": "这孩子，"
    },
    {
      "offset": 18449,
      "kind": "line",
      "limit": 10,
      "source": "安心してましたよ。",
      "target": "知道他没事就放心了。"
    },
    {
      "offset": 18475,
      "kind": "line",
      "limit": 8,
      "source": "そっか。",
      "target": "这样啊。"
    },
    {
      "offset": 18489,
      "kind": "line",
      "limit": 8,
      "source": "それは良かった。",
      "target": "那太好了。"
    },
    {
      "offset": 18513,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 18529,
      "kind": "line",
      "limit": 11,
      "source": "少年は観念したらしく、",
      "target": "少年似乎认命了，"
    },
    {
      "offset": 18557,
      "kind": "line",
      "limit": 11,
      "source": "口をとがらせながらも",
      "target": "虽然噘着嘴，"
    },
    {
      "offset": 18583,
      "kind": "line",
      "limit": 11,
      "source": "黙って座っている。",
      "target": "还是默默坐着。"
    },
    {
      "offset": 18609,
      "kind": "line",
      "limit": 9,
      "source": "…お祖父さんが、",
      "target": "…爷爷会"
    },
    {
      "offset": 18649,
      "kind": "line",
      "limit": 9,
      "source": "来てくれるんだ…。",
      "target": "来接我啊…"
    },
    {
      "offset": 18673,
      "kind": "line",
      "limit": 9,
      "source": "坊や、お父さんは？",
