    {
      "offset": 20516,
      "kind": "line",
      "limit": 9,
      "source": "来てくれないのか。",
      "target": "接他啊。"
    },
    {
      "offset": 20540,
      "kind": "line",
      "limit": 11,
      "source": "泉君も、そのあたりが",
      "target": "泉是不是也因此"
    },
    {
      "offset": 20566,
      "kind": "line",
      "limit": 11,
      "source": "気に入らないのかな…？",
