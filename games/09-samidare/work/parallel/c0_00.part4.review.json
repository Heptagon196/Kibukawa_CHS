    },
    {
      "offset": 19611,
      "kind": "line",
      "limit": 8,
      "source": "おかけしました。",
      "target": "添麻烦了。"
    },
    {
      "offset": 19638,
      "kind": "line",
      "limit": 5,
      "source": "あのぅ…。",
      "target": "那个…"
    },
    {
      "offset": 19656,
      "kind": "line",
      "limit": 3,
      "source": "はい？",
      "target": "嗯？"
    },
    {
      "offset": 19670,
      "kind": "line",
