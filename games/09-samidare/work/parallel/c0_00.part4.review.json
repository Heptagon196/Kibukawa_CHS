    },
    {
      "offset": 20656,
      "kind": "line",
      "limit": 10,
      "source": "とかでしょうかね？",
      "target": "名字？"
    },
    {
      "offset": 20690,
      "kind": "line",
      "limit": 10,
      "source": "まあ、家庭の事情が",
