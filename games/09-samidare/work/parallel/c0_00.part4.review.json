        {
          "colour": 2,
          "text": "泉！"
        }
      ]
    },
    {
      "offset": 18983,
      "kind": "line",
      "limit": 10,
      "source": "お前、こんなところに",
      "target": "你原来在这种"
    },
    {
      "offset": 19009,
      "kind": "line",
      "limit": 10,
      "source": "いたのか。",
      "target": "地方。"
    },
    {
      "offset": 19055,
      "kind": "line",
      "limit": 5,
      "source": "……ちぇ。",
      "target": "……切。"
    },
    {
      "offset": 19088,
      "kind": "line",
      "limit": 8,
      "source": "…おっと、お礼も",
      "target": "…哎呀，没先道谢"
    },
    {
      "offset": 19110,
      "kind": "line",
      "limit": 8,
      "source": "言わず失礼を。",
      "target": "真是失礼了。"
    },
    {
      "offset": 19130,
      "kind": "line",
      "limit": 11,
      "source": "孫を保護してくれて",
      "target": "谢谢你们保护"
    },
    {
      "offset": 19154,
      "kind": "line",
      "limit": 11,
      "source": "ありがとうございます。",
      "target": "我的孙子。"
    },
    {
      "offset": 19184,
      "kind": "line",
      "limit": 9,
      "source": "いえいえ。こっちも",
      "target": "哪里哪里，能把他"
    },
    {
      "offset": 19208,
      "kind": "line",
      "limit": 9,
      "source": "無事にお返しできて",
      "target": "平安交还给您，"
    },
    {
      "offset": 19232,
      "kind": "line",
      "limit": 9,
      "source": "良かったです。",
      "target": "我们也很高兴。"
    },
    {
      "offset": 19254,
      "kind": "line",
      "limit": 8,
      "source": "実は今日、家族で",
      "target": "其实今天全家"
    },
    {
      "offset": 19287,
      "kind": "line",
      "limit": 8,
      "source": "鞠浜にドライブに",
      "target": "开车来鞠滨"
    },
    {
      "offset": 19315,
      "kind": "line",
      "limit": 8,
      "source": "来てたんだが…",
      "target": "游玩…"
    },
    {
      "offset": 19335,
      "kind": "line",
      "limit": 11,
      "source": "ちょっと目を離したら",
      "target": "稍没留神，"
    },
    {
      "offset": 19361,
      "kind": "line",
      "limit": 11,
      "source": "この子がいなくなったと",
      "target": "这孩子就不见了，"
    },
    {
      "offset": 19389,
      "kind": "line",
      "limit": 11,
      "source": "騒ぎになっててな。",
      "target": "全家都急坏了。"
    },
    {
      "offset": 19413,
      "kind": "line",
      "limit": 11,
      "source": "わしがよそ見してたから",
      "target": "儿媳还怪我"
    },
    {
      "offset": 19441,
      "kind": "line",
      "limit": 11,
      "source": "と嫁には怒られるし…。",
      "target": "没看好他…"
    },
    {
      "offset": 19471,
      "kind": "line",
      "limit": 9,
      "source": "あは、そういうこと",
      "target": "哈哈，原来"
    },
    {
      "offset": 19495,
      "kind": "line",
      "limit": 9,
      "source": "だったんですか。",
      "target": "是这么回事。"
    },
    {
      "offset": 19517,
      "kind": "line",
      "limit": 10,
