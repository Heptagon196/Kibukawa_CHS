    {
      "offset": 20932,
      "kind": "line",
      "limit": 11,
      "source": "子供とはすぐに仲良く",
      "target": "老师总能很快"
    },
    {
      "offset": 20958,
      "kind": "line",
      "limit": 11,
      "source": "なりますよね…。",
