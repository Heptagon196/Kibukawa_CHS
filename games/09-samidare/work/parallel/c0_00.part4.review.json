    {
      "offset": 20606,
      "kind": "line",
      "limit": 10,
      "source": "女の子みたいな名前が",
      "target": "会不会只是因为"
    },
    {
      "offset": 20632,
      "kind": "line",
      "limit": 10,
      "source": "気に入らないから…",
