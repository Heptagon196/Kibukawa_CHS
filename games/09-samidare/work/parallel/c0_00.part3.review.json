    },
    {
      "offset": 12718,
      "kind": "line",
      "limit": 11,
      "source": "さすがに気になって、",
      "target": "可实在放心不下，"
    },
    {
      "offset": 12744,
      "kind": "line",
      "limit": 11,
      "source": "話しかけてみたんです。",
      "target": "就上前问了问。"
    },
    {
      "offset": 12774,
      "kind": "line",
      "limit": 4,
      "source": "ふむ…。",
      "target": "唔…"
    },
    {
      "offset": 12836,
      "kind": "line",
      "limit": 7,
      "source": "…こんにちは。",
      "target": "…你好。"
    },
    {
      "offset": 12858,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 12872,
      "kind": "line",
      "limit": 10,
      "source": "こんな雨の中、",
      "target": "这么大的雨，"
    },
    {
      "offset": 12892,
      "kind": "line",
      "limit": 10,
      "source": "ひとりでどうしたの？",
      "target": "你一个人在做什么？"
    },
    {
      "offset": 12918,
      "kind": "line",
      "limit": 10,
      "source": "誰か待ってるの？",
