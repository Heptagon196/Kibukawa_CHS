    },
    {
      "offset": 12942,
      "kind": "line",
      "limit": 5,
      "source": "…違うよ。",
      "target": "…不是。"
    },
    {
      "offset": 12960,
      "kind": "line",
      "limit": 7,
      "source": "あ、違うんだ。",
      "target": "啊，不是啊。"
    },
    {
      "offset": 12980,
      "kind": "line",
      "limit": 7,
      "source": "どうかしたの？",
      "target": "出什么事了吗？"
    },
    {
      "offset": 13002,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 13016,
      "kind": "line",
      "limit": 11,
      "source": "お父さんかお母さんは？",
      "target": "你爸爸或妈妈呢？"
    },
    {
      "offset": 13046,
      "kind": "line",
      "limit": 6,
      "source": "…いないよ。",
      "target": "…不在。"
    },
    {
      "offset": 13066,
      "kind": "line",
      "limit": 9,
      "source": "えっ、いないの？",
      "target": "咦，不在吗？"
    },
    {
      "offset": 13088,
      "kind": "line",
      "limit": 9,
      "source": "はぐれちゃったの？",
      "target": "和他们走散了？"
    },
    {
      "offset": 13114,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 13128,
      "kind": "line",
      "limit": 11,
      "source": "うーん…。",
      "target": "唔…"
    },
    {
      "offset": 13144,
      "kind": "line",
      "limit": 11,
      "source": "困ったな、この大雨の中",
      "target": "难办了，这么大的雨"
