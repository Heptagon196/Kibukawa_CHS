    },
    {
      "offset": 12595,
      "kind": "line",
      "limit": 3,
      "source": "はい。",
      "target": "嗯。"
    },
    {
      "offset": 12609,
      "kind": "line",
      "limit": 5,
      "source": "ひとりで？",
