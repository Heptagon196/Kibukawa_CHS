    {
      "offset": 13575,
      "kind": "line",
      "limit": 9,
      "source": "いいんですけど…。",
      "target": "着凉…"
    },
    {
      "offset": 13601,
      "kind": "line",
      "limit": 3,
      "source": "……。",
