    },
    {
      "offset": 12637,
      "kind": "line",
      "limit": 7,
      "source": "ひとりでした。",
      "target": "是一个人。"
    },
    {
      "offset": 12657,
      "kind": "line",
      "limit": 11,
      "source": "最初は誰かを待ってるの",
