    {
      "offset": 13172,
      "kind": "line",
      "limit": 11,
      "source": "放ってもおけないし…。",
      "target": "也不能丢下他不管…"
    },
    {
      "offset": 13245,
      "kind": "line",
      "limit": 11,
      "source": "…ってわけで、ひとまず",
      "target": "…所以我先把他带来"
    },
    {
      "offset": 13273,
      "kind": "line",
      "limit": 11,
      "source": "事務所で雨宿りをして",
      "target": "事务所避雨，"
    },
    {
      "offset": 13299,
      "kind": "line",
      "limit": 11,
      "source": "もらってるんですけど。",
      "target": "就是这么回事。"
    },
    {
      "offset": 13329,
      "kind": "line",
      "limit": 8,
      "source": "なるほどねえ…。",
