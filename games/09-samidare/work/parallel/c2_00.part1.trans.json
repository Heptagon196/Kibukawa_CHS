{
  "script": "c2_00",
  "units": [
    {"offset": 13, "target": "１９９６年６月某日"},
    {"offset": 37, "target": "天气：雨"},
    {"offset": 51, "target": "　"},
    {"offset": 70, "target": "鞠滨市中央町"},
    {"offset": 107, "target": "蝼川内家　客厅"},
    {"offset": 196, "target": "来到蝼川内家后，"},
    {"offset": 228, "target": "他的母亲绫子女士", "runs": ["他的母亲", "绫子女士"]},
    {"offset": 273, "target": "出来迎接了我。"},
    {"offset": 312, "target": "听说您是侦探。"},
    {"offset": 340, "target": "看来我儿子给您"},
    {"offset": 366, "target": "添麻烦了……"},
    {"offset": 392, "target": "我明明告诉过他，"},
    {"offset": 438, "target": "忠雄的事不要再"},
    {"offset": 462, "target": "管了……"},
    {"offset": 495, "target": "看来晓先生还是"},
    {"offset": 523, "target": "不太信任自己的"},
    {"offset": 547, "target": "父亲。"},
    {"offset": 585, "target": "明明还不能断定"},
    {"offset": 611, "target": "存折就是那个人"},
    {"offset": 635, "target": "偷走的……"},
    {"offset": 661, "target": "我一直教导他，"},
    {"offset": 709, "target": "不能活在对他人的"},
    {"offset": 735, "target": "怀疑之中。"},
    {"offset": 757, "target": "如果方便的话，"},
    {"offset": 777, "target": "还请连这些事情"},
    {"offset": 801, "target": "也一并告诉我。"},
    {"offset": 837, "target": "至少，存款不见"},
    {"offset": 861, "target": "这件事本身"},
    {"offset": 883, "target": "确实是个问题。"},
    {"offset": 912, "target": "只要是我知道的，"},
    {"offset": 938, "target": "我都会告诉您。"},
    {"offset": 960, "target": "非常感谢。"},
    {"offset": 1004, "target": "第２节"},
    {"offset": 1016, "target": "　"},
    {"offset": 1024, "target": "“一定会吵起来”"},
    {"offset": 1110, "target": "环视四周"},
    {"offset": 1124, "target": "交谈"},
    {"offset": 1132, "target": "调查"},
    {"offset": 1142, "target": "观察"},
    {"offset": 1150, "target": "中断"},
    {"offset": 1182, "target": "这里位于鞠滨市"},
    {"offset": 1212, "target": "中央町，是公寓二楼"},
    {"offset": 1240, "target": "一间两居室……"},
    {"offset": 1277, "target": "蝼川内母子"},
    {"offset": 1316, "target": "就住在这里。"},
    {"offset": 1334, "target": "看得出他们的生活"},
    {"offset": 1362, "target": "并不宽裕，这种感觉"},
    {"offset": 1390, "target": "遍布房间各处。"},
    {"offset": 1418, "target": "旧榻榻米的霉味"},
    {"offset": 1462, "target": "混着连日阴雨的湿气"},
    {"offset": 1490, "target": "弥漫在整个房间。"},
    {"offset": 1542, "target": "关于忠雄"},
    {"offset": 1554, "target": "关于晓"},
    {"offset": 1573, "target": "关于父亲"},
    {"offset": 1585, "target": "关于存折"},
    {"offset": 1632, "target": "关于忠雄先生的去向，"},
    {"offset": 1676, "target": "您真的没有任何"},
    {"offset": 1704, "target": "线索吗？"},
    {"offset": 1720, "target": "我儿子也问过我，"},
    {"offset": 1748, "target": "可我确实不知道。"},
    {"offset": 1776, "target": "那个……恕我冒昧，"},
    {"offset": 1800, "target": "事情怎么会变成"},
    {"offset": 1826, "target": "这样？"},
    {"offset": 1846, "target": "连身为妻子的您"},
    {"offset": 1870, "target": "也什么都不知道，"},
    {"offset": 1896, "target": "实在是……"},
    {"offset": 1926, "target": "他从大约二十五年前", "runs": ["他从", "大约二十五年前"]},
    {"offset": 1959, "target": "开始，就像变了"},
    {"offset": 1991, "target": "个人。"},
    {"offset": 2005, "target": "他几乎不再回家，"},
    {"offset": 2031, "target": "偶尔回来，也只是"},
    {"offset": 2055, "target": "向我伸手要钱……"},
    {"offset": 2093, "target": "但既然嫁给了他，"},
    {"offset": 2119, "target": "我也早有觉悟……"},
    {"offset": 2147, "target": "所以……"},
    {"offset": 2159, "target": "我从没追问理由，"},
    {"offset": 2185, "target": "只是默默听从他。"},
    {"offset": 2235, "target": "原来如此……于是"},
    {"offset": 2259, "target": "就一直到了现在。"},
    {"offset": 2287, "target": "是的。"},
    {"offset": 2299, "target": "……回想起来，"},
    {"offset": 2319, "target": "已经过去"},
    {"offset": 2339, "target": "二十五年了。"},
    {"offset": 2363, "target": "即便如此，我仍相信"},
    {"offset": 2391, "target": "他做的事情"},
    {"offset": 2415, "target": "不会有错……"},
    {"offset": 2454, "target": "关于忠雄先生的"},
    {"offset": 2478, "target": "工作单位，您知道"},
    {"offset": 2504, "target": "些什么吗？"},
    {"offset": 2533, "target": "我听晓先生"},
    {"offset": 2561, "target": "说过……"},
    {"offset": 2579, "target": "他好像在一家叫"},
    {"offset": 2603, "target": "克雷夫制作所的小型"},
    {"offset": 2629, "target": "工厂工作。"},
    {"offset": 2663, "target": "……对不起。"},
    {"offset": 2683, "target": "我也只听过"},
    {"offset": 2707, "target": "这个名字……"},
    {"offset": 2737, "target": "连地址也"},
    {"offset": 2759, "target": "不知道吗？"},
    {"offset": 2781, "target": "对不起……"},
    {"offset": 2801, "target": "我真的一直没有"},
    {"offset": 2823, "target": "干涉他的事……"},
    {"offset": 2853, "target": "而且，那个……"},
    {"offset": 2877, "target": "请说。"},
    {"offset": 2891, "target": "在能够确定是他"},
    {"offset": 2917, "target": "偷走存折和存款"},
    {"offset": 2941, "target": "之前……"},
    {"offset": 2961, "target": "希望您也不要"},
    {"offset": 2981, "target": "干涉他的事……"},
    {"offset": 3007, "target": "嗯，说得也是……"},
    {"offset": 3033, "target": "……我明白了。"},
    {"offset": 3057, "target": "……拜托您了。"},
    {"offset": 3081, "target": "……"},
    {"offset": 3093, "target": "……虽说没办法，"},
    {"offset": 3115, "target": "之后还是查查电话簿"},
    {"offset": 3141, "target": "再去调查吧……"},
    {"offset": 3176, "target": "……啊，对了。"},
    {"offset": 3209, "target": "您认识一位叫"},
    {"offset": 3259, "target": "尼子启三的男性吗？"},
    {"offset": 3285, "target": "尼子……吗？"},
    {"offset": 3307, "target": "……好像在哪里"},
    {"offset": 3335, "target": "听过这个名字，"},
    {"offset": 3363, "target": "可是……"},
    {"offset": 3383, "target": "究竟是在哪里听过，"},
    {"offset": 3411, "target": "我有些想不起来"},
    {"offset": 3437, "target": "了。"},
    {"offset": 3449, "target": "……那个人怎么了？"},
    {"offset": 3477, "target": "晓先生告诉我，"},
    {"offset": 3503, "target": "他曾来找过忠雄"},
    {"offset": 3549, "target": "先生。"},
    {"offset": 3569, "target": "啊，这么说来，"},
    {"offset": 3591, "target": "他好像提过"},
    {"offset": 3613, "target": "这件事。"},
    {"offset": 3631, "target": "也许我只是在那时"},
    {"offset": 3659, "target": "听过这个名字……"},
    {"offset": 3687, "target": "可能仅此而已。"},
    {"offset": 3715, "target": "原来如此。"},
    {"offset": 3731, "target": "也就是说，您没有"},
    {"offset": 3757, "target": "特别的线索。"},
    {"offset": 3779, "target": "我对丈夫的人际关系"},
    {"offset": 3805, "target": "也不太了解。"},
    {"offset": 3835, "target": "我明白了。"},
    {"offset": 3855, "target": "谢谢您。"},
    {"offset": 3894, "target": "从前的丈夫认真"},
    {"offset": 3918, "target": "而且非常单纯。"},
    {"offset": 3946, "target": "……我觉得儿子晓"},
    {"offset": 3994, "target": "在这一点上很像他。"},
    {"offset": 4066, "target": "即便生在这种家庭，"},
    {"offset": 4100, "target": "儿子也没有走上"},
    {"offset": 4126, "target": "歧途……"},
    {"offset": 4138, "target": "他从不任性，"},
    {"offset": 4164, "target": "健康地长大成人，"},
    {"offset": 4190, "target": "我很欣慰。"},
    {"offset": 4206, "target": "我自己吃苦没关系，"},
    {"offset": 4234, "target": "可是……"},
    {"offset": 4258, "target": "我不想让一无所知的"},
    {"offset": 4282, "target": "儿子遭受痛苦，"},
    {"offset": 4310, "target": "一直都很留意。"},
    {"offset": 4336, "target": "直接要他原谅那样的"},
    {"offset": 4364, "target": "父亲，恐怕他也"},
    {"offset": 4392, "target": "不会听进去……"},
    {"offset": 4416, "target": "所以我先努力让他"},
    {"offset": 4444, "target": "信任身为母亲的我，"},
    {"offset": 4472, "target": "为此努力至今。"},
    {"offset": 4507, "target": "晓先生似乎也"},
    {"offset": 4537, "target": "明白这一点。"},
    {"offset": 4565, "target": "他说自己能不憎恨"},
    {"offset": 4593, "target": "父亲，也是因为"},
    {"offset": 4621, "target": "有您这位母亲。"},
    {"offset": 4649, "target": "这样啊。"},
    {"offset": 4669, "target": "这次，他也只是想"},
    {"offset": 4693, "target": "把钱找回来，"},
    {"offset": 4719, "target": "仅此而已。"},
    {"offset": 4743, "target": "只不过，他最先"},
    {"offset": 4771, "target": "怀疑的人恰好是"},
    {"offset": 4799, "target": "自己的父亲……"},
    {"offset": 4833, "target": "那也是……没有"},
    {"offset": 4859, "target": "办法的事。"},
    {"offset": 4875, "target": "那孩子为了存下钱"},
    {"offset": 4903, "target": "吃了多少苦，"},
    {"offset": 4929, "target": "我很清楚。"},
    {"offset": 4965, "target": "只是，我原以为他"},
    {"offset": 4991, "target": "能再冷静一些，"},
    {"offset": 5017, "target": "没想到……"},
    {"offset": 5039, "target": "如果此刻怀疑父亲……"},
    {"offset": 5067, "target": "过去一直相信的东西"},
    {"offset": 5095, "target": "就会全部化为"},
    {"offset": 5121, "target": "乌有。"},
    {"offset": 5141, "target": "偏偏他现在急需"},
    {"offset": 5165, "target": "用钱，或许才会"},
    {"offset": 5191, "target": "变成这样。"},
    {"offset": 5217, "target": "否则……他应该"},
    {"offset": 5243, "target": "可以更冷静地"},
    {"offset": 5267, "target": "看待这件事。"},
    {"offset": 5303, "target": "说得……也是。"},
    {"offset": 5341, "target": "我相信他不是那种"},
    {"offset": 5365, "target": "会轻易失去自我的"},
    {"offset": 5389, "target": "孩子……"},
    {"offset": 5465, "target": "啊，对了。"},
    {"offset": 5491, "target": "……嗯？"},
    {"offset": 5507, "target": "那个……和晓先生交往", "runs": ["那个……和晓先生", "交往"]},
    {"offset": 5562, "target": "的那位女性，您知道"},
    {"offset": 5592, "target": "吗？"},
    {"offset": 5618, "target": "啊，是慧美小姐。", "runs": ["啊，是", "慧美小姐。"]},
    {"offset": 5663, "target": "说的是她吧。"},
    {"offset": 5681, "target": "我只听说过她。"},
    {"offset": 5719, "target": "您没见过"},
    {"offset": 5743, "target": "本人吗？"},
    {"offset": 5765, "target": "那孩子似乎很想"},
    {"offset": 5793, "target": "介绍她给我……"},
    {"offset": 5817, "target": "可她本人好像"},
    {"offset": 5845, "target": "不太愿意。"},
    {"offset": 5873, "target": "哦，是这样啊。"},
    {"offset": 5901, "target": "我也理解她的心情，"},
    {"offset": 5929, "target": "所以没有催促，"},
    {"offset": 5957, "target": "只是默默看着。"},
    {"offset": 5998, "target": "……生在这样的家庭，"},
    {"offset": 6026, "target": "那孩子也吃了"},
    {"offset": 6054, "target": "不少苦……"},
    {"offset": 6090, "target": "身为母亲，我至少希望"}
  ]
}
