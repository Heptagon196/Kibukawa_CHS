{
  "script": "c0_00",
  "batch": "c0_00.part2.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 6294,
      "kind": "line",
      "limit": 11,
      "source": "風通しの悪い部屋って、",
      "target": "通风不好的房间，"
    },
    {
      "offset": 6322,
      "kind": "line",
      "limit": 11,
      "source": "こういう季節はホントに",
      "target": "一到这种季节"
    },
    {
      "offset": 6350,
      "kind": "line",
      "limit": 11,
      "source": "大変だよなあ…。",
      "target": "真是难熬啊…"
    },
    {
      "offset": 6381,
      "kind": "line",
      "limit": 11,
      "source": "こうして黙っていると、",
      "target": "这样沉默下来，"
    },
    {
      "offset": 6409,
      "kind": "line",
      "limit": 11,
      "source": "建物に当たる雨の音が",
      "target": "便能听见雨点"
    },
    {
      "offset": 6435,
      "kind": "line",
      "limit": 11,
      "source": "聞こえてくる。",
      "target": "敲打建筑的声音。"
    },
    {
      "offset": 6455,
      "kind": "line",
      "limit": 10,
      "source": "ザァザァという、",
      "target": "哗哗作响，"
    },
    {
      "offset": 6477,
      "kind": "line",
      "limit": 10,
      "source": "ノイズのような雨音が",
      "target": "如同噪声的雨声"
    },
    {
      "offset": 6525,
      "kind": "line",
      "limit": 10,
      "source": "室内に遠く響く。",
      "target": "远远回荡在室内。"
    },
    {
      "offset": 6556,
      "kind": "line",
      "limit": 10,
      "source": "部屋は、湿気で重たく",
      "target": "房间里尽是"
    },
    {
      "offset": 6582,
      "kind": "line",
      "limit": 10,
      "source": "なった不快な空気が",
      "target": "受潮后沉重"
    },
    {
      "offset": 6611,
      "kind": "line",
      "limit": 10,
      "source": "充ちている。",
      "target": "而难受的空气。"
    },
    {
      "offset": 6641,
      "kind": "choice",
      "limit": 0,
      "source": "少年",
      "target": "少年"
    },
    {
      "offset": 6658,
      "kind": "choice",
      "limit": 0,
      "source": "伊綱",
      "target": "伊纲"
    },
    {
      "offset": 6666,
      "kind": "choice",
      "limit": 0,
      "source": "窓",
      "target": "窗户"
    },
    {
      "offset": 6672,
      "kind": "choice",
      "limit": 0,
      "source": "天井",
      "target": "天花板"
    },
    {
      "offset": 6698,
      "kind": "line",
      "limit": 9,
      "source": "小学校の、低学年…",
      "target": "小学低年级…"
    },
    {
      "offset": 6724,
      "kind": "line",
      "limit": 9,
      "source": "６～７歳といった",
      "target": "大约六七岁"
    },
    {
      "offset": 6752,
      "kind": "line",
      "limit": 9,
      "source": "くらいの男の子だ。",
      "target": "的小男孩。"
    },
    {
      "offset": 6776,
      "kind": "line",
      "limit": 11,
      "source": "態度は図々しいけれど、",
      "target": "态度虽然有点放肆，"
    },
    {
      "offset": 6804,
      "kind": "line",
      "limit": 11,
      "source": "なんだか戸惑っている",
      "target": "却似乎也有些"
    },
    {
      "offset": 6830,
      "kind": "line",
      "limit": 11,
      "source": "ような感じもする。",
      "target": "不知所措。"
    },
    {
      "offset": 6863,
      "kind": "line",
      "limit": 10,
      "source": "よく見ると、服や髪が",
      "target": "仔细一看，他的衣服"
    },
    {
      "offset": 6889,
      "kind": "line",
      "limit": 10,
      "source": "しっとり濡れている。",
      "target": "和头发都湿漉漉的。"
    },
    {
      "offset": 6931,
      "kind": "line",
      "limit": 10,
      "source": "…風邪引いたりしない",
      "target": "…不会着凉吧"
    },
    {
      "offset": 6957,
      "kind": "line",
      "limit": 10,
      "source": "のかな…。",
      "target": "…"
    },
    {
      "offset": 6994,
      "kind": "line",
      "limit": 11,
      "source": "少年の外見に、何か",
      "target": "他身上会不会有"
    },
    {
      "offset": 7018,
      "kind": "line",
      "limit": 11,
      "source": "手掛かりはないかな…。",
      "target": "什么线索…"
    },
    {
      "offset": 7055,
      "kind": "line",
      "limit": 11,
      "source": "かぶってる帽子は、",
      "target": "他头上那顶帽子，"
    },
    {
      "offset": 7079,
      "kind": "line",
      "limit": 11,
      "source": "地元のプロ野球チームの",
      "target": "似乎是本地"
    },
    {
      "offset": 7107,
      "kind": "line",
      "limit": 11,
      "source": "もののようだ。",
      "target": "职业棒球队的。"
    },
    {
      "offset": 7127,
      "kind": "line",
      "limit": 11,
      "source": "…つまり、鞠浜市から",
      "target": "…也就是说，他很可能"
    },
    {
      "offset": 7175,
      "kind": "line",
      "limit": 11,
      "source": "そう離れてないところに",
      "target": "住在离鞠滨市"
    },
    {
      "offset": 7203,
      "kind": "line",
      "limit": 11,
      "source": "住んでる可能性が高い。",
      "target": "不太远的地方。"
    },
    {
      "offset": 7231,
      "kind": "line",
      "limit": 11,
      "source": "部屋を見渡しても、彼が",
      "target": "环顾房间，也看不出"
    },
    {
      "offset": 7259,
      "kind": "line",
      "limit": 11,
      "source": "カバンなどを持っていた",
      "target": "他带了书包之类"
    },
    {
      "offset": 7287,
      "kind": "line",
      "limit": 11,
      "source": "様子はない…か。",
      "target": "的东西…"
    },
    {
      "offset": 7309,
      "kind": "line",
      "limit": 11,
      "source": "ということは、手ぶらで",
      "target": "这么说，他是空着手"
    },
    {
      "offset": 7337,
      "kind": "line",
      "limit": 11,
      "source": "ここまで来たことに",
      "target": "一路来到这里"
    },
    {
      "offset": 7361,
      "kind": "line",
      "limit": 11,
      "source": "なるのかな…？",
      "target": "的吗…？"
    },
    {
      "offset": 7381,
      "kind": "line",
      "limit": 11,
      "source": "靴は、はきつぶした",
      "target": "鞋子是一双"
    },
    {
      "offset": 7405,
      "kind": "line",
      "limit": 11,
      "source": "感じの運動靴で、特に",
      "target": "穿旧了的运动鞋，"
    },
    {
      "offset": 7431,
      "kind": "line",
      "limit": 11,
      "source": "気になるところはない。",
      "target": "没什么特别之处。"
    },
    {
      "offset": 7459,
      "kind": "line",
      "limit": 11,
      "source": "うーん…特に手掛かりは",
      "target": "唔…好像没有"
    },
    {
      "offset": 7487,
      "kind": "line",
      "limit": 11,
      "source": "なさそうだけど…。",
      "target": "别的线索了…"
    },
    {
      "offset": 7529,
      "kind": "line",
      "limit": 4,
      "source": "…おや？",
      "target": "…咦？"
    },
    {
      "offset": 7543,
      "kind": "line",
      "limit": 11,
      "source": "よく見ると、お尻の",
      "target": "仔细看，他屁股上的"
    },
    {
      "offset": 7569,
      "kind": "line",
      "limit": 11,
      "source": "ポケットがふくらんでる",
      "target": "口袋好像鼓鼓的。"
    },
    {
      "offset": 7598,
      "kind": "line",
      "limit": 11,
      "source": "ようだ。",
      "target": "起来。"
    },
    {
      "offset": 7612,
      "kind": "line",
      "limit": 11,
      "source": "…何か入ってるのかな。",
      "target": "…里面装了什么吗？"
    },
    {
      "offset": 7640,
      "kind": "line",
      "limit": 11,
      "source": "でも…まともに聞いても",
      "target": "可是…直接问他"
    },
    {
      "offset": 7668,
      "kind": "line",
      "limit": 11,
      "source": "教えてもらえなそう",
      "target": "恐怕也不会"
    },
    {
      "offset": 7692,
      "kind": "line",
      "limit": 11,
      "source": "だなあ…。",
      "target": "告诉我…"
    },
    {
      "offset": 7717,
      "kind": "line",
      "limit": 9,
      "source": "…うむむ、もっと",
      "target": "…唔，还得让他"
    },
    {
      "offset": 7739,
      "kind": "line",
      "limit": 9,
      "source": "近くに呼ばないと、",
      "target": "再靠近些，"
    },
    {
      "offset": 7763,
      "kind": "line",
      "limit": 9,
      "source": "よく見えないか…。",
      "target": "才能看清…"
    },
    {
      "offset": 7799,
      "kind": "line",
      "limit": 10,
      "source": "窓ガラスは外側から、",
      "target": "雨点从外侧"
    },
    {
      "offset": 7825,
      "kind": "line",
      "limit": 10,
      "source": "雨粒がびちびちと",
      "target": "噼里啪啦地"
    },
    {
      "offset": 7854,
      "kind": "line",
      "limit": 10,
      "source": "叩き付けられていた。",
      "target": "砸在玻璃窗上。"
    },
    {
      "offset": 7893,
      "kind": "line",
      "limit": 11,
      "source": "震えるガラスの表面を、",
      "target": "水珠沿着震颤的"
    },
    {
      "offset": 7936,
      "kind": "line",
      "limit": 11,
      "source": "雫が静かに伝っている。",
      "target": "玻璃表面静静滑落。"
    },
    {
      "offset": 7997,
      "kind": "line",
      "limit": 11,
      "source": "よく見ると天井には",
      "target": "仔细一看，天花板上"
    },
    {
      "offset": 8021,
      "kind": "line",
      "limit": 11,
      "source": "湿気のためか、いくつか",
      "target": "大概是受潮，"
    },
    {
      "offset": 8054,
      "kind": "line",
      "limit": 11,
      "source": "染みができている。",
      "target": "留下了几处水渍。"
    },
    {
      "offset": 8084,
      "kind": "line",
      "limit": 9,
      "source": "最上階ではないので",
      "target": "这里并非顶层，"
    },
    {
      "offset": 8108,
      "kind": "line",
      "limit": 9,
      "source": "雨漏りの心配はない",
      "target": "应该不用担心"
    },
    {
      "offset": 8148,
      "kind": "line",
      "limit": 9,
      "source": "だろうけど…。",
      "target": "漏雨吧…"
    },
    {
      "offset": 8180,
      "kind": "line",
      "limit": 10,
      "source": "彼女がここの事務所の",
      "target": "她就是在这间"
    },
    {
      "offset": 8206,
      "kind": "line",
      "limit": 10,
      "source": "助手を務めている、",
      "target": "事务所担任助手的"
    },
    {
      "offset": 8243,
      "kind": "line",
      "limit": 10,
      "source": "白鷺洲伊綱だ。",
      "target": "白鹭洲伊纲。"
    },
    {
      "offset": 8285,
      "kind": "line",
      "limit": 11,
      "source": "いつもとぼけた様子だが",
      "target": "她平时总爱装傻，"
    },
    {
      "offset": 8313,
      "kind": "line",
      "limit": 11,
      "source": "少しでも甘いところを",
      "target": "可我只要稍微"
    },
    {
      "offset": 8339,
      "kind": "line",
      "limit": 11,
      "source": "見せようものなら…",
      "target": "示弱…"
    },
    {
      "offset": 8363,
      "kind": "line",
      "limit": 11,
      "source": "たちどころに楽しそうに",
      "target": "她立刻就会兴冲冲地"
    },
    {
      "offset": 8391,
      "kind": "line",
      "limit": 11,
      "source": "突っ込んでくるから",
      "target": "吐槽起来，"
    },
    {
      "offset": 8415,
      "kind": "line",
      "limit": 11,
      "source": "始末に負えない。",
      "target": "让人招架不住。"
    },
    {
      "offset": 8437,
      "kind": "line",
      "limit": 9,
      "source": "つまり、イジメだ。",
      "target": "也就是欺负人。"
    },
    {
      "offset": 8461,
      "kind": "line",
      "limit": 9,
      "source": "イジメ。",
      "target": "欺负人。"
    },
    {
      "offset": 8475,
      "kind": "line",
      "limit": 10,
      "source": "イジメ、かっこ悪い！",
      "target": "欺负人，真难看！"
    },
    {
      "offset": 8503,
      "kind": "line",
      "limit": 2,
      "source": "…？",
      "target": "…？"
    },
    {
      "offset": 8522,
      "kind": "line",
      "limit": 10,
      "source": "今日も相変わらず、",
      "target": "今天她也一如往常，"
    },
    {
      "offset": 8546,
      "kind": "line",
      "limit": 10,
      "source": "マイペースでケロリと",
      "target": "我行我素，"
    },
    {
      "offset": 8572,
      "kind": "line",
      "limit": 10,
      "source": "している。",
      "target": "一脸若无其事。"
    },
    {
      "offset": 8639,
      "kind": "line",
      "limit": 11,
      "source": "この子、見覚えないけど",
      "target": "我没见过这孩子，"
    },
    {
      "offset": 8667,
      "kind": "line",
      "limit": 11,
      "source": "誰なんだろう…？",
      "target": "他是谁呢…？"
    },
    {
      "offset": 8692,
      "kind": "line",
      "limit": 10,
      "source": "ああ、おじさんとか",
      "target": "唉，已经会被人"
    },
    {
      "offset": 8716,
      "kind": "line",
      "limit": 10,
      "source": "言われるんだなあ…。",
      "target": "叫大叔了啊…"
    },
    {
      "offset": 8742,
      "kind": "line",
      "limit": 9,
      "source": "悪気がないぶん、",
      "target": "正因为他没有恶意，"
    },
    {
      "offset": 8764,
      "kind": "line",
      "limit": 9,
      "source": "思ったよりも心に",
      "target": "这句话才比想象中"
    },
    {
      "offset": 8786,
      "kind": "line",
      "limit": 9,
      "source": "突き刺さるものだ。",
      "target": "更扎心。"
    },
    {
      "offset": 8813,
      "kind": "line",
      "limit": 11,
      "source": "伊綱君こそ、突然現れる",
      "target": "伊纲也越来越像"
    },
    {
      "offset": 8841,
      "kind": "line",
      "limit": 11,
      "source": "ところとかが癸生川に",
      "target": "癸生川了，尤其是"
    },
    {
      "offset": 8889,
      "kind": "line",
      "limit": 11,
      "source": "似てきてるような…。",
      "target": "突然冒出来这点…"
    },
    {
      "offset": 8918,
      "kind": "line",
      "limit": 11,
      "source": "うう…どうやら、変な",
      "target": "唔…看来我的"
    },
    {
      "offset": 8944,
      "kind": "line",
      "limit": 11,
      "source": "おじさんフラグが立って",
      "target": "怪大叔的标签"
    },
    {
      "offset": 8972,
      "kind": "line",
      "limit": 11,
      "source": "しまったみたいだ…。",
      "target": "已经贴上了…"
    },
    {
      "offset": 9009,
      "kind": "line",
      "limit": 11,
      "source": "無邪気な子供と違って",
      "target": "她可不像天真的孩子"
    },
    {
      "offset": 9041,
      "kind": "line",
      "limit": 11,
      "source": "伊綱君の場合、明らかに",
      "target": "伊纲这么说，"
    },
    {
      "offset": 9069,
      "kind": "line",
      "limit": 11,
      "source": "悪意があるからなあ…。",
      "target": "显然满怀恶意…"
    },
    {
      "offset": 9130,
      "kind": "choice",
      "limit": 0,
      "source": "名前",
      "target": "姓名"
    },
    {
      "offset": 9138,
      "kind": "choice",
      "limit": 0,
      "source": "本人の事",
      "target": "问他自己"
    },
    {
      "offset": 9150,
      "kind": "choice",
      "limit": 0,
      "source": "親の事",
      "target": "询问父母"
    },
    {
      "offset": 9171,
      "kind": "line",
      "limit": 11,
      "source": "…ひとまず坊やの名前、",
      "target": "…总之先告诉我"
    },
    {
      "offset": 9199,
      "kind": "line",
      "limit": 11,
      "source": "教えてくれないかな。",
      "target": "你的名字好吗？"
    },
    {
      "offset": 9227,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 9241,
      "kind": "line",
      "limit": 9,
      "source": "ほら、名前がわから",
      "target": "你看，不知道名字"
    },
    {
      "offset": 9265,
      "kind": "line",
      "limit": 9,
      "source": "ないと、呼ぶことも",
      "target": "我连叫你都"
    },
    {
      "offset": 9289,
      "kind": "line",
      "limit": 9,
      "source": "できないし。",
      "target": "没办法。"
    },
    {
      "offset": 9309,
      "kind": "line",
      "limit": 7,
      "source": "…やだ。",
      "target": "…不要。"
    },
    {
      "offset": 9323,
      "kind": "line",
      "limit": 7,
      "source": "言いたくない。",
      "target": "我不想说。"
    },
    {
      "offset": 9345,
      "kind": "line",
      "limit": 4,
      "source": "ゲフー。",
      "target": "噗哇。"
    },
    {
      "offset": 9359,
      "kind": "line",
      "limit": 10,
      "source": "いやいや…それはまた",
      "target": "不是…这是"
    },
    {
      "offset": 9385,
      "kind": "line",
      "limit": 10,
      "source": "どうしてだい？",
      "target": "为什么？"
    },
    {
      "offset": 9407,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 9423,
      "kind": "line",
      "limit": 11,
      "source": "さっきから聞いても",
      "target": "我从刚才问到现在，"
    },
    {
      "offset": 9447,
      "kind": "line",
      "limit": 11,
      "source": "教えてくれないんです。",
      "target": "他就是不肯说。"
    },
    {
      "offset": 9477,
      "kind": "line",
      "limit": 6,
      "source": "やれやれ…。",
      "target": "真没办法…"
    },
    {
      "offset": 9506,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 9520,
      "kind": "line",
      "limit": 8,
      "source": "うーん…。",
      "target": "唔…"
    },
    {
      "offset": 9536,
      "kind": "line",
      "limit": 8,
      "source": "ただ聞くだけじゃ",
