{
  "script": "c2_00",
  "units": [
    {"offset": 6118, "target": "他能建立一个普通而"},
    {"offset": 6146, "target": "幸福的家庭。"},
    {"offset": 6176, "target": "可没想到……"},
    {"offset": 6194, "target": "如今事情似乎已经"},
    {"offset": 6222, "target": "朝着波折不断的方向"},
    {"offset": 6250, "target": "发展了……"},
    {"offset": 6276, "target": "您是说……"},
    {"offset": 6301, "target": "慧美小姐家里的"},
    {"offset": 6329, "target": "债务吧。"},
    {"offset": 6355, "target": "是的，正是。"},
    {"offset": 6377, "target": "您已经知道了。"},
    {"offset": 6412, "target": "晓跟我提过"},
    {"offset": 6440, "target": "这件事。"},
    {"offset": 6469, "target": "可是……我从很早"},
    {"offset": 6497, "target": "以前就一直这样"},
    {"offset": 6521, "target": "教导他。"},
    {"offset": 6545, "target": "……怎么说？"},
    {"offset": 6580, "target": "正因为我们一直过着"},
    {"offset": 6608, "target": "缺钱的艰苦生活……"},
    {"offset": 6636, "target": "才更不能过上"},
    {"offset": 6690, "target": "执着于金钱的人生。"},
    {"offset": 6726, "target": "……"},
    {"offset": 6740, "target": "钱应该由人创造，"},
    {"offset": 6766, "target": "也必须由人来"},
    {"offset": 6790, "target": "支配。"},
    {"offset": 6812, "target": "要是反被金钱支配，"},
    {"offset": 6838, "target": "过着任它摆布的人生……"},
    {"offset": 6866, "target": "那绝不会带来"},
    {"offset": 6894, "target": "任何好事。"},
    {"offset": 6922, "target": "我是这样说的。"},
    {"offset": 6942, "target": "原来如此……"},
    {"offset": 6960, "target": "真是一番有分量的话。"},
    {"offset": 6990, "target": "……"},
    {"offset": 7004, "target": "也许正因为他对"},
    {"offset": 7056, "target": "金钱并不执着……"},
    {"offset": 7080, "target": "所以才能够"},
    {"offset": 7106, "target": "存下那么多"},
    {"offset": 7130, "target": "钱吧。"},
    {"offset": 7154, "target": "……是啊。"},
    {"offset": 7174, "target": "而且……"},
    {"offset": 7188, "target": "他不执着于那笔存款，"},
    {"offset": 7234, "target": "甚至愿意为了对方"},
    {"offset": 7262, "target": "将钱全部拿出来……"},
    {"offset": 7284, "target": "其实，这让我"},
    {"offset": 7304, "target": "有些高兴。"},
    {"offset": 7328, "target": "况且，他要和一个"},
    {"offset": 7356, "target": "能让自己下定如此"},
    {"offset": 7380, "target": "决心的人结婚。"},
    {"offset": 7406, "target": "无需我从旁说三"},
    {"offset": 7430, "target": "道四……"},
    {"offset": 7454, "target": "我相信他能为自己"},
    {"offset": 7480, "target": "负责，过好今后的"},
    {"offset": 7506, "target": "生活，所以静静守望。"},
    {"offset": 7545, "target": "因为那是他认定的人"},
    {"offset": 7577, "target": "……对吧。"},
    {"offset": 7601, "target": "正是。"},
    {"offset": 7619, "target": "我能理解。"},
    {"offset": 7637, "target": "……正因如此，我也"},
    {"offset": 7661, "target": "决定像这样无偿"},
    {"offset": 7711, "target": "帮忙。"},
    {"offset": 7741, "target": "咦，无偿……？"},
    {"offset": 7787, "target": "是啊。我也不执着"},
    {"offset": 7832, "target": "于金钱。"},
    {"offset": 7856, "target": "呵呵呵，真是一位"},
    {"offset": 7876, "target": "有趣的侦探。"},
    {"offset": 7900, "target": "谢谢夸奖。"},
    {"offset": 7949, "target": "那么……关于晓先生"},
    {"offset": 7995, "target": "交往的对象慧美"},
    {"offset": 8039, "target": "小姐……"},
    {"offset": 8063, "target": "您有没有什么地方"},
    {"offset": 8091, "target": "觉得不对劲？"},
    {"offset": 8113, "target": "……"},
    {"offset": 8127, "target": "……侦探先生"},
    {"offset": 8145, "target": "您突然问起这个，"},
    {"offset": 8176, "target": "是不是说明……"},
    {"offset": 8208, "target": "您已经想到"},
    {"offset": 8234, "target": "什么了"},
    {"offset": 8260, "target": "呢？"},
    {"offset": 8278, "target": "……您真敏锐。"},
    {"offset": 8300, "target": "其实，的确如此。"},
    {"offset": 8333, "target": "我实在没法对晓先生"},
    {"offset": 8381, "target": "本人说出口……"},
    {"offset": 8409, "target": "但有件事一直令我"},
    {"offset": 8437, "target": "在意。"},
    {"offset": 8457, "target": "是什么……"},
    {"offset": 8492, "target": "首先，"},
    {"offset": 8504, "target": "两人相识至今"},
    {"offset": 8528, "target": "才三个月，时间很短", "runs": ["才三个月，", "时间很短"]},
    {"offset": 8559, "target": "这一点。"},
    {"offset": 8587, "target": "其次，对方打着结婚"},
    {"offset": 8613, "target": "的旗号，以家庭状况"},
    {"offset": 8643, "target": "为由索要巨款。"},
    {"offset": 8677, "target": "而且，她拒绝拜见"},
    {"offset": 8705, "target": "晓先生的母亲，也"},
    {"offset": 8733, "target": "不让他见自己父母。"},
    {"offset": 8759, "target": "这会不会是……"},
    {"offset": 8789, "target": "……啊，难道……"},
    {"offset": 8813, "target": "是婚姻诈骗……！？"},
    {"offset": 8880, "target": "……没错。"},
    {"offset": 8898, "target": "您一下就明白了。"},
    {"offset": 8936, "target": "听您这么一说，"},
    {"offset": 8960, "target": "确实是典型手法……"},
    {"offset": 8994, "target": "……所以我也请求"},
    {"offset": 9042, "target": "慧美小姐，让我和她"},
    {"offset": 9070, "target": "谈一谈。"},
    {"offset": 9094, "target": "如果她确实急需钱，"},
    {"offset": 9120, "target": "真心希望我们找回"},
    {"offset": 9146, "target": "那笔存款……"},
    {"offset": 9170, "target": "这种程度的配合，"},
    {"offset": 9196, "target": "她应该会答应"},
    {"offset": 9220, "target": "才对。"},
    {"offset": 9232, "target": "可是……"},
    {"offset": 9258, "target": "如果那真是诈骗……"},
    {"offset": 9302, "target": "……她绝不会愿意"},
    {"offset": 9330, "target": "见侦探吧。"},
    {"offset": 9360, "target": "……正是如此。"},
    {"offset": 9386, "target": "我不仅在意晓先生"},
    {"offset": 9441, "target": "存款的下落，"},
    {"offset": 9469, "target": "也很在意这件事。"},
    {"offset": 9499, "target": "他平时优柔寡断，"},
    {"offset": 9557, "target": "可一旦认定一件事，"},
    {"offset": 9583, "target": "便会一往无前……"},
    {"offset": 9603, "target": "确实令人担心……"},
    {"offset": 9629, "target": "现在，他应该正和"},
    {"offset": 9673, "target": "慧美小姐见面。"},
    {"offset": 9701, "target": "真让人在意"},
    {"offset": 9723, "target": "那边的情况……"},
    {"offset": 9771, "target": "关于那本被偷的"},
    {"offset": 9797, "target": "存折和印章……"},
    {"offset": 9826, "target": "被拿走的只有"},
    {"offset": 9865, "target": "晓先生自己的"},
    {"offset": 9893, "target": "存折吗？"},
    {"offset": 9921, "target": "不是……"},
    {"offset": 9935, "target": "我和丈夫的存折"},
    {"offset": 9959, "target": "也放在同一个"},
    {"offset": 9981, "target": "地方……"},
    {"offset": 10003, "target": "那些也全都不见"},
    {"offset": 10029, "target": "了吗？"},
    {"offset": 10051, "target": "是的。"},
    {"offset": 10069, "target": "唔……"},
    {"offset": 10083, "target": "这么说或许有点怪，"},
    {"offset": 10111, "target": "但有没有可能是普通"},
    {"offset": 10154, "target": "窃贼所为？"},
    {"offset": 10180, "target": "这个可能……当然"},
    {"offset": 10204, "target": "也是有的。"},
    {"offset": 10226, "target": "毕竟只是放在"},
    {"offset": 10252, "target": "衣柜里。"},
    {"offset": 10274, "target": "最后一次确认"},
    {"offset": 10298, "target": "是什么时候？"},
    {"offset": 10330, "target": "因为一直在用银行卡，"},
    {"offset": 10358, "target": "我已经好几个月"},
    {"offset": 10382, "target": "没检查存折了。"},
    {"offset": 10410, "target": "究竟是什么时候"},
    {"offset": 10434, "target": "不见的……我也不清楚。"},
    {"offset": 10464, "target": "这样啊……"},
    {"offset": 10484, "target": "那个，我还想确认"},
    {"offset": 10512, "target": "一件事……"},
    {"offset": 10536, "target": "……您每天会在"},
    {"offset": 10560, "target": "固定时间出门"},
    {"offset": 10586, "target": "吗？"},
    {"offset": 10620, "target": "咦……？"},
    {"offset": 10634, "target": "我的确每天都在"},
    {"offset": 10660, "target": "差不多的时间"},
    {"offset": 10682, "target": "出去买东西……"},
    {"offset": 10702, "target": "……这么说，"},
    {"offset": 10720, "target": "这里又在二楼……", "runs": ["这里又在", "二楼……"]},
    {"offset": 10761, "target": "只要知道您的习惯，"},
    {"offset": 10791, "target": "要闯进来并不难……"},
    {"offset": 10825, "target": "原、原来如此……"},
    {"offset": 10849, "target": "不过，若要不被察觉"},
    {"offset": 10873, "target": "把存折和印章单独偷走", "runs": ["把存折和印章", "单独偷走"]},
    {"offset": 10930, "target": "然后离开……"},
    {"offset": 10956, "target": "果然还是熟悉内情的"},
    {"offset": 10984, "target": "人作案的可能更大。"},
    {"offset": 11012, "target": "犯人早就知道"},
    {"offset": 11038, "target": "存折放在那个衣柜"},
    {"offset": 11066, "target": "里……"},
    {"offset": 11094, "target": "……正因如此，晓先生"},
    {"offset": 11142, "target": "才会怀疑自己的"},
    {"offset": 11170, "target": "父亲吧……"},
    {"offset": 11206, "target": "……"},
    {"offset": 11220, "target": "……还有别人知道"},
    {"offset": 11248, "target": "这件事吗？"},
    {"offset": 11270, "target": "比如，您曾请进家里", "runs": ["比如，您曾", "请进家里"]},
    {"offset": 11303, "target": "的人当中……"},
    {"offset": 11335, "target": "有没有知情者……"},
    {"offset": 11359, "target": "……没有，我想不到"},
    {"offset": 11387, "target": "这样的人。"},
    {"offset": 11417, "target": "这、这样啊……"},
    {"offset": 11441, "target": "总觉得有些在意……"},
    {"offset": 11469, "target": "仔细观察一下吧。", "runs": ["仔细", "观察一下吧。"]},
    {"offset": 11548, "target": "我再问一次，"},
    {"offset": 11574, "target": "您真想不到了解"},
    {"offset": 11598, "target": "家里情况的人吗……？"},
    {"offset": 11626, "target": "……想不到。"},
    {"offset": 11663, "target": "……果然还是在意。"},
    {"offset": 11689, "target": "仔细观察一下。", "runs": ["仔细", "观察一下。"]},
    {"offset": 11740, "target": "……您是不是"},
    {"offset": 11762, "target": "隐瞒了什么？"},
    {"offset": 11788, "target": "…！"},
    {"offset": 11800, "target": "其实，您心里"},
    {"offset": 11824, "target": "有人选，对"},
    {"offset": 11846, "target": "不对？"},
    {"offset": 11862, "target": "我看见您动摇了……"},
    {"offset": 11900, "target": "……"},
    {"offset": 11921, "target": "不知为什么……面对"},
    {"offset": 11949, "target": "侦探先生，我总觉得"},
    {"offset": 11975, "target": "自己没法说谎。"},
    {"offset": 11999, "target": "对不起，其实有一个人"},
    {"offset": 12027, "target": "……我想到了。"},
    {"offset": 12057, "target": "可以告诉我吗？"},
    {"offset": 12085, "target": "是我……父亲。", "runs": ["是我……", "父亲。"]},
    {"offset": 12120, "target": "哦。"},
    {"offset": 12132, "target": "您父亲会来"},
    {"offset": 12156, "target": "这里啊。"},
    {"offset": 12194, "target": "是的。"},
    {"offset": 12206, "target": "……此前他也"},
    {"offset": 12226, "target": "来过这里几次……"},
    {"offset": 12254, "target": "我曾向他请教"},
    {"offset": 12278, "target": "儿子的教育问题，"}
  ]
}
