{
  "script": "c3_01",
  "units": [
    {"offset":9611,"target":"因为一次偶然，"},
    {"offset":9633,"target":"我和她在电影院相识…"},
    {"offset":9659,"target":"后来我鼓起勇气"},
    {"offset":9685,"target":"问到她的电话号码…"},
    {"offset":9713,"target":"约她吃饭，听到她"},
    {"offset":9741,"target":"答应时，我简直"},
    {"offset":9769,"target":"欣喜若狂。"},
    {"offset":9795,"target":"我们聊天时，兴趣和"},
    {"offset":9823,"target":"喜好也完全一致…"},
    {"offset":9851,"target":"能为相同的事一起"},
    {"offset":9877,"target":"欢笑、感到快乐，"},
    {"offset":9901,"target":"她是难得的存在。"},
    {"offset":9927,"target":"我希望能一直和她"},
    {"offset":9951,"target":"在一起。"},
    {"offset":9979,"target":"…所以她向我"},
    {"offset":10003,"target":"商量钱的事"},
    {"offset":10027,"target":"时…"},
    {"offset":10039,"target":"我觉得能帮上她，"},
    {"offset":10067,"target":"便高兴地答应了。"},
    {"offset":10093,"target":"…所以为了她，"},
    {"offset":10121,"target":"我必须尽快把存款"},
    {"offset":10147,"target":"找回来。"},
    {"offset":10174,"target":"她现在在做什么"},
    {"offset":10202,"target":"呢…"},
    {"offset":10220,"target":"或许正在鼓励"},
    {"offset":10262,"target":"家人吧。"},
    {"offset":10286,"target":"…她今后的命运"},
    {"offset":10314,"target":"都系在这件事上。"},
    {"offset":10336,"target":"我一定要努力…"},
    {"offset":10379,"target":"…想来，我对父亲"},
    {"offset":10407,"target":"一无所知，就这样"},
    {"offset":10435,"target":"长大了。"},
    {"offset":10453,"target":"…不如说，我从没"},
    {"offset":10481,"target":"想过要了解他。"},
    {"offset":10509,"target":"他喜欢什么、讨厌"},
    {"offset":10535,"target":"什么，又过着怎样"},
    {"offset":10561,"target":"的人生…"},
    {"offset":10583,"target":"明明应该是亲近的人"},
    {"offset":10611,"target":"我却什么都不知道。"},
    {"offset":10637,"target":"…这果然是一种"},
    {"offset":10661,"target":"异常吧。"},
    {"offset":10685,"target":"可是…父亲过去"},
    {"offset":10711,"target":"所做的一切，我果然"},
    {"offset":10739,"target":"无法原谅。"},
    {"offset":10755,"target":"我也觉得应该和他"},
    {"offset":10783,"target":"彻底谈一次…"},
    {"offset":10809,"target":"真是的，他究竟"},
    {"offset":10831,"target":"在哪里…"},
    {"offset":10860,"target":"…假如。"},
    {"offset":10874,"target":"假如父亲并不是"},
    {"offset":10900,"target":"犯人，会怎样？"},
    {"offset":10928,"target":"…不，如果是这样"},
    {"offset":10952,"target":"犯人还能是谁"},
    {"offset":10974,"target":"呢。"},
    {"offset":10990,"target":"难道是母亲…？"},
    {"offset":11012,"target":"…不，家里所有存折"},
    {"offset":11036,"target":"都被偷走了。"},
    {"offset":11064,"target":"母亲没有理由做"},
    {"offset":11090,"target":"这种事。"},
    {"offset":11108,"target":"果然只能是父亲。"},
    {"offset":11145,"target":"必须尽快找到他…"},
    {"offset":11189,"target":"如果今天之内找不回"},
    {"offset":11213,"target":"那些钱…"},
    {"offset":11239,"target":"没办法，我就去借债","runs":["没办法，我就","去借债"]},
    {"offset":11280,"target":"也要凑出来…"},
    {"offset":11308,"target":"可 ５００ 万这种巨款"},
    {"offset":11336,"target":"不会有地方轻易借给"},
    {"offset":11362,"target":"我…"},
    {"offset":11386,"target":"只能找好几家金融"},
    {"offset":11414,"target":"机构，能借多少"},
    {"offset":11440,"target":"就借多少了…"},
    {"offset":11468,"target":"可是听说可疑的放贷"},
    {"offset":11496,"target":"机构会索要天价"},
    {"offset":11524,"target":"利息…"},
    {"offset":11542,"target":"还有近似黑社会的人"},
    {"offset":11568,"target":"严酷催债"},
    {"offset":11590,"target":"什么的…"},
    {"offset":11616,"target":"…………"},
    {"offset":11632,"target":"…不，只要找回存款"},
    {"offset":11660,"target":"就能马上还清"},
    {"offset":11686,"target":"债务。"},
    {"offset":11704,"target":"应该没事。"},
    {"offset":11733,"target":"不过存款和借款"},
    {"offset":11761,"target":"金额恰好相同，"},
    {"offset":11789,"target":"也算帮了大忙…"},
    {"offset":11813,"target":"若是钱不够，"},
    {"offset":11835,"target":"就危险了…"},
    {"offset":11886,"target":"果然，当侦探的人"},
    {"offset":11910,"target":"大多都很古怪"},
    {"offset":11938,"target":"吗…"},
    {"offset":11962,"target":"那两人虽然各自在"},
    {"offset":11986,"target":"不同意义上都很"},
    {"offset":12008,"target":"不可思议…"},
    {"offset":12034,"target":"但总觉得似乎可以"},
    {"offset":12060,"target":"相信他们。"},
    {"offset":12095,"target":"说起来，刚才"},
    {"offset":12119,"target":"在侦探事务所见到的"},
    {"offset":12143,"target":"女孩…"},
    {"offset":12157,"target":"她也是个让人感觉"},
    {"offset":12185,"target":"很不可思议的人…"},
    {"offset":12211,"target":"而且总觉得好像"},
    {"offset":12237,"target":"在什么地方见过她"},
    {"offset":12259,"target":"似的。"},
    {"offset":12287,"target":"…不过这应该"},
    {"offset":12307,"target":"是错觉吧。"},
    {"offset":12338,"target":"可是…侦探的"},
    {"offset":12362,"target":"报告该去哪里"},
    {"offset":12386,"target":"听呢？"},
    {"offset":12406,"target":"我果然应该老实"},
    {"offset":12432,"target":"待在事务所等着"},
    {"offset":12458,"target":"吗…？"},
    {"offset":12543,"target":"…就在这时。"},
    {"offset":12565,"target":"店门突然“砰”地"},
    {"offset":12587,"target":"发出一声巨响，"},
    {"offset":12609,"target":"被推开了。"},
    {"offset":12633,"target":"…紧接着。"},
    {"offset":12653,"target":"一个洪亮的大嗓门"},
    {"offset":12679,"target":"同时响彻店内。"},
    {"offset":12722,"target":"蝼川内君在吗！"},
    {"offset":12754,"target":"咦…！？"},
    {"offset":12796,"target":"我吃惊地望向门口，"},
    {"offset":12822,"target":"刚才那个叫癸生川的"},
    {"offset":12870,"target":"侦探正站在那里。"},
    {"offset":12894,"target":"全店的视线都被他"},
    {"offset":12920,"target":"独占了…"},
    {"offset":12948,"target":"哦，在那里！"},
    {"offset":12968,"target":"原来你在这儿！"},
    {"offset":13000,"target":"接着，这位侦探对着"},
    {"offset":13024,"target":"目瞪口呆的服务生"},
    {"offset":13052,"target":"说道…"},
    {"offset":13070,"target":"可以点单吗！"},
    {"offset":13088,"target":"我要红茶！"},
    {"offset":13106,"target":"用英语说就是，"},
    {"offset":13128,"target":"Ｉ　ＡＭ　ＴＥＡ！！"},
    {"offset":13156,"target":"…他说着不知所云的"},
    {"offset":13184,"target":"话，大步走到"},
    {"offset":13208,"target":"我的座位旁，"},
    {"offset":13232,"target":"在对面的椅子上"},
    {"offset":13258,"target":"坐了下来。"},
    {"offset":13284,"target":"…周围目光好刺人。"},
    {"offset":13325,"target":"好了，穷鬼君！"},
    {"offset":13347,"target":"我、我叫蝼川内。"},
    {"offset":13393,"target":"您刚才不是这么叫"},
    {"offset":13421,"target":"我的吗？"},
    {"offset":13451,"target":"那不重要！"},
    {"offset":13471,"target":"………"},
    {"offset":13490,"target":"交谈"},
    {"offset":13498,"target":"中断"},
    {"offset":13522,"target":"钱的去向"},
    {"offset":13545,"target":"关于尼子"},
    {"offset":13557,"target":"关于这里"},
    {"offset":13580,"target":"说起来…您怎么"},
    {"offset":13606,"target":"知道我在这里"},
    {"offset":13632,"target":"的？"},
    {"offset":13658,"target":"这种事稍微打听一下"},
    {"offset":13686,"target":"就知道了。"},
    {"offset":13708,"target":"只、只靠这个…！？"},
    {"offset":13734,"target":"好了，这不重要。"},
    {"offset":13758,"target":"现在可不是聊这种"},
    {"offset":13780,"target":"事的时候吧？"},
    {"offset":13808,"target":"啊，是、是啊。"},
    {"offset":13854,"target":"那个，所以…"},
    {"offset":13874,"target":"关于钱的去向"},
    {"offset":13900,"target":"查得怎么样了…？"},
    {"offset":13926,"target":"我先说结论！"},
    {"offset":13946,"target":"５００ 万已经"},
    {"offset":13968,"target":"可能回不来"},
    {"offset":13990,"target":"了！"},
    {"offset":14008,"target":"咦、咦…！？"},
    {"offset":14028,"target":"我再说一次！"},
    {"offset":14048,"target":"５００ 万已经"},
    {"offset":14070,"target":"可能回不来"},
    {"offset":14092,"target":"了！"},
    {"offset":14108,"target":"…很遗憾，你最好先"},
    {"offset":14136,"target":"做好心理准备。"},
    {"offset":14160,"target":"怎、怎么会…"},
    {"offset":14180,"target":"为什么…！？"},
    {"offset":14210,"target":"已经花掉的钱"},
    {"offset":14236,"target":"不会再回来。"},
    {"offset":14264,"target":"泼出去的水若不回"},
    {"offset":14288,"target":"就得不到虎子。"}
  ]
}
