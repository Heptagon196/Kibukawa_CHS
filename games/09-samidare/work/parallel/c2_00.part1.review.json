    },
    {
      "offset": 5873,
      "kind": "line",
      "limit": 10,
      "source": "あ、そうなんですか。",
      "target": "哦，是这样啊。"
    },
    {
      "offset": 5901,
      "kind": "line",
      "limit": 11,
      "source": "その気持ちもわかるので",
      "target": "我也理解她的心情，"
    },
    {
      "offset": 5929,
      "kind": "line",
      "limit": 11,
      "source": "別にせかしたりもせず、",
      "target": "所以没有催促，"
    },
    {
      "offset": 5957,
      "kind": "line",
      "limit": 11,
      "source": "黙って見守っています。",
      "target": "只是默默看着。"
    },
    {
      "offset": 5998,
      "kind": "line",
