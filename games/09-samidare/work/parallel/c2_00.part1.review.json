    },
    {
      "offset": 5067,
      "kind": "line",
      "limit": 11,
      "source": "今まで信じてきたものが",
      "target": "过去一直相信的东西"
    },
    {
      "offset": 5095,
      "kind": "line",
      "limit": 11,
      "source": "すべて台無しになって",
      "target": "就会全部化为"
    },
    {
      "offset": 5121,
      "kind": "line",
      "limit": 11,
      "source": "しまいます。",
      "target": "乌有。"
    },
    {
      "offset": 5141,
      "kind": "line",
      "limit": 10,
      "source": "偶然、今すぐお金が",
      "target": "偏偏他现在急需"
    },
    {
      "offset": 5165,
      "kind": "line",
      "limit": 10,
      "source": "必要な状況だったのが",
      "target": "用钱，或许才会"
    },
    {
      "offset": 5191,
      "kind": "line",
      "limit": 10,
      "source": "いけないのでしょう。",
      "target": "变成这样。"
    },
    {
      "offset": 5217,
      "kind": "line",
      "limit": 10,
      "source": "そうでなければ…彼も",
      "target": "否则……他应该"
    },
    {
      "offset": 5243,
      "kind": "line",
      "limit": 10,
      "source": "もう少し落ち着いて",
      "target": "可以更冷静地"
    },
    {
      "offset": 5267,
      "kind": "line",
      "limit": 10,
      "source": "見れると思います。",
      "target": "看待这件事。"
    },
    {
      "offset": 5303,
      "kind": "line",
      "limit": 7,
      "source": "そう…ですね。",
      "target": "说得……也是。"
    },
    {
      "offset": 5341,
      "kind": "line",
      "limit": 11,
      "source": "そんな簡単に自分を",
      "target": "我相信他不是那种"
    },
    {
      "offset": 5365,
      "kind": "line",
      "limit": 11,
      "source": "見失うような子では",
      "target": "会轻易失去自我的"
    },
    {
      "offset": 5389,
      "kind": "line",
      "limit": 11,
      "source": "ないと…信じています。",
      "target": "孩子……"
    },
    {
      "offset": 5465,
      "kind": "line",
      "limit": 9,
      "source": "ああ、そういえば。",
      "target": "啊，对了。"
    },
    {
      "offset": 5491,
      "kind": "line",
      "limit": 4,
      "source": "…はい？",
      "target": "……嗯？"
    },
    {
      "offset": 5507,
      "kind": "line",
      "limit": 11,
      "source": "あの…暁さんと交際して",
      "target": "那个……和晓先生交往",
      "runs": [
        "那个……和晓先生",
        "交往"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "あの…暁さんと"
        },
        {
          "colour": 2,
          "text": "交際して"
        }
      ]
    },
    {
      "offset": 5562,
      "kind": "line",
      "limit": 11,
      "source": "いる女性のことは、",
      "target": "的那位女性，您知道"
    },
    {
      "offset": 5592,
