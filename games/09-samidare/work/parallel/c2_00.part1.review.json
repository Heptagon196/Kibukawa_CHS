      "target": "说的是她吧。"
    },
    {
      "offset": 5681,
      "kind": "line",
      "limit": 11,
      "source": "話だけは聞いています。",
      "target": "我只听说过她。"
    },
    {
      "offset": 5719,
      "kind": "line",
