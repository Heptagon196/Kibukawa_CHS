    },
    {
      "offset": 5743,
      "kind": "line",
      "limit": 9,
      "source": "ないんですか？",
      "target": "本人吗？"
    },
    {
      "offset": 5765,
      "kind": "line",
      "limit": 11,
      "source": "あの子は紹介したがって",
      "target": "那孩子似乎很想"
    },
    {
      "offset": 5793,
      "kind": "line",
      "limit": 11,
      "source": "いるようですけど…",
      "target": "介绍她给我……"
    },
    {
      "offset": 5817,
      "kind": "line",
      "limit": 11,
      "source": "本人があまり乗り気じゃ",
