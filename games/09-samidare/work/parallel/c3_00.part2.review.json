{
  "script": "c3_00",
  "batch": "c3_00.part2.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 5544,
      "kind": "line",
      "limit": 11,
      "source": "くれた、あの人を…",
      "target": "那个人…"
    },
    {
      "offset": 5568,
      "kind": "line",
      "limit": 10,
      "source": "私は生涯かけて、信じ",
      "target": "我决心用这一生"
    },
    {
      "offset": 5594,
      "kind": "line",
      "limit": 10,
      "source": "尽くしていこうと",
      "target": "始终相信他，"
    },
    {
      "offset": 5616,
      "kind": "line",
      "limit": 10,
      "source": "心に決めたんです。",
      "target": "绝不动摇。"
    },
    {
      "offset": 5642,
      "kind": "line",
      "limit": 8,
      "source": "なるほど…。",
      "target": "原来如此…"
    },
    {
      "offset": 5660,
      "kind": "line",
      "limit": 8,
      "source": "そういう事情が",
      "target": "原来还有"
    },
    {
      "offset": 5680,
      "kind": "line",
      "limit": 8,
      "source": "あったんですか。",
      "target": "这段往事。"
    },
    {
      "offset": 5702,
      "kind": "line",
      "limit": 8,
      "source": "それなら確かに、",
      "target": "这样一来，"
    },
    {
      "offset": 5724,
      "kind": "line",
      "limit": 8,
      "source": "２５年という長い",
      "target": "即使过了漫长的"
    },
    {
      "offset": 5746,
      "kind": "line",
      "limit": 8,
      "source": "期間であっても…",
      "target": "25 年…"
    },
    {
      "offset": 5768,
      "kind": "line",
      "limit": 9,
      "source": "黙って信じていける",
      "target": "您也就能默默地"
    },
    {
      "offset": 5792,
      "kind": "line",
      "limit": 9,
      "source": "わけですね。",
      "target": "一直信任他了。"
    },
    {
      "offset": 5812,
      "kind": "line",
      "limit": 10,
      "source": "いえ。",
      "target": "哪里。"
    },
    {
      "offset": 5824,
      "kind": "line",
      "limit": 10,
      "source": "…お恥ずかしいです。",
      "target": "…让您见笑了。"
    },
    {
      "offset": 5878,
      "kind": "choice",
      "limit": 0,
      "source": "暁の事",
      "target": "关于晓"
    },
    {
      "offset": 5888,
      "kind": "choice",
      "limit": 0,
      "source": "忠雄の事",
      "target": "关于忠雄"
    },
    {
      "offset": 5920,
      "kind": "line",
      "limit": 9,
      "source": "暁は、そんなふうに",
      "target": "晓是经历那些事"
    },
    {
      "offset": 5950,
      "kind": "line",
      "limit": 9,
      "source": "生まれてきた子です",
      "target": "才出生的孩子…"
    },
    {
      "offset": 5974,
      "kind": "line",
      "limit": 9,
      "source": "から…",
      "target": "所以…"
    },
    {
      "offset": 5986,
      "kind": "line",
      "limit": 10,
      "source": "やはり、思い入れは",
      "target": "我对他的感情"
    },
    {
      "offset": 6010,
      "kind": "line",
      "limit": 10,
      "source": "強かったと思います。",
      "target": "一定很深。"
    },
    {
      "offset": 6036,
      "kind": "line",
      "limit": 9,
      "source": "自分で幸せへの道を",
      "target": "为了让他靠自己"
    },
    {
      "offset": 6060,
      "kind": "line",
      "limit": 9,
      "source": "歩んでいけるよう…",
      "target": "走上幸福之路…"
    },
    {
      "offset": 6084,
      "kind": "line",
      "limit": 10,
      "source": "厳しく…そして多くの",
      "target": "我严格管教，也教了"
    },
    {
      "offset": 6110,
      "kind": "line",
      "limit": 10,
      "source": "ことを教えて、育てて",
      "target": "他许多事情，"
    },
    {
      "offset": 6136,
      "kind": "line",
      "limit": 10,
      "source": "きました。",
      "target": "将他养大。"
    },
    {
      "offset": 6162,
      "kind": "line",
      "limit": 4,
      "source": "なので…",
      "target": "所以…"
    },
    {
      "offset": 6183,
      "kind": "line",
      "limit": 11,
      "source": "詐欺なんかに、簡単に",
      "target": "我想相信，他不会"
    },
    {
      "offset": 6215,
      "kind": "line",
      "limit": 11,
      "source": "引っかかるような子じゃ",
      "target": "轻易上诈骗的当…"
    },
    {
      "offset": 6243,
      "kind": "line",
      "limit": 11,
      "source": "ないと思いたいですが…",
      "target": "可是…"
    },
    {
      "offset": 6271,
      "kind": "line",
      "limit": 11,
      "source": "それもあの子の決めた",
      "target": "如果那也是他自己"
    },
    {
      "offset": 6297,
      "kind": "line",
      "limit": 11,
      "source": "道なら…口出しはすべき",
      "target": "选择的路…我是否"
    },
    {
      "offset": 6325,
      "kind": "line",
      "limit": 11,
      "source": "ではないのでしょうか。",
      "target": "不该插嘴呢。"
    },
    {
      "offset": 6370,
      "kind": "line",
      "limit": 10,
      "source": "…やっぱり、私も",
      "target": "…看来我也是个"
    },
    {
      "offset": 6392,
      "kind": "line",
      "limit": 10,
      "source": "親バカみたいですね。",
      "target": "溺爱孩子的母亲。"
    },
    {
      "offset": 6420,
      "kind": "line",
      "limit": 9,
      "source": "…いえ、素敵なこと",
      "target": "…不会，我觉得"
    },
    {
      "offset": 6444,
      "kind": "line",
      "limit": 9,
      "source": "だと思います。",
      "target": "这很好。"
    },
    {
      "offset": 6464,
      "kind": "line",
      "limit": 11,
      "source": "これは、僕の身の上話に",
      "target": "接下来成了我的"
    },
    {
      "offset": 6492,
      "kind": "line",
      "limit": 11,
      "source": "なってしまいますが…",
      "target": "身世故事，不过…"
    },
    {
      "offset": 6529,
      "kind": "line",
      "limit": 10,
      "source": "僕の母は、子供を",
      "target": "我母亲的身体"
    },
    {
      "offset": 6551,
      "kind": "line",
      "limit": 10,
      "source": "産んではいけないと",
      "target": "不适合生孩子，"
    },
    {
      "offset": 6575,
      "kind": "line",
      "limit": 10,
      "source": "言われる身体でした。",
      "target": "医生是这么说的。"
    },
    {
      "offset": 6601,
      "kind": "line",
      "limit": 10,
      "source": "無理に出産すれば、",
      "target": "如果勉强生产，"
    },
    {
      "offset": 6625,
      "kind": "line",
      "limit": 10,
      "source": "自分も子供も、命の",
      "target": "母子两人的性命"
    },
    {
      "offset": 6649,
      "kind": "line",
      "limit": 10,
      "source": "保証はない…という。",
      "target": "都无法保证…"
    },
    {
      "offset": 6677,
      "kind": "line",
      "limit": 4,
      "source": "まあ…。",
      "target": "天哪…"
    },
    {
      "offset": 6691,
      "kind": "line",
      "limit": 7,
      "source": "それは、病気か",
      "target": "是因为疾病"
    },
    {
      "offset": 6711,
      "kind": "line",
      "limit": 7,
      "source": "なにかで？",
      "target": "之类的吗？"
    },
    {
      "offset": 6729,
      "kind": "line",
      "limit": 9,
      "source": "はい。",
      "target": "是的。"
    },
    {
      "offset": 6741,
      "kind": "line",
      "limit": 9,
      "source": "生まれついての病気",
      "target": "听说是先天性"
    },
    {
      "offset": 6765,
      "kind": "line",
      "limit": 9,
      "source": "だったそうです。",
      "target": "疾病。"
    },
    {
      "offset": 6789,
      "kind": "line",
      "limit": 7,
      "source": "あら、まあ…。",
      "target": "哎呀…"
    },
    {
      "offset": 6811,
      "kind": "line",
      "limit": 9,
      "source": "それでも…母は、",
      "target": "即使如此…母亲"
    },
    {
      "offset": 6833,
      "kind": "line",
      "limit": 9,
      "source": "こうして僕を産んで",
      "target": "还是像这样生下"
    },
    {
      "offset": 6857,
      "kind": "line",
      "limit": 9,
      "source": "くれたんです。",
      "target": "了我。"
    },
    {
      "offset": 6877,
      "kind": "line",
      "limit": 10,
      "source": "僕はそんな母を誇りに",
      "target": "我为这样的母亲"
    },
    {
      "offset": 6903,
      "kind": "line",
      "limit": 10,
      "source": "思っていますし…",
      "target": "感到自豪…"
    },
    {
      "offset": 6925,
      "kind": "line",
      "limit": 11,
      "source": "そうして多くの危険を",
      "target": "也会珍惜她冒着"
    },
    {
      "offset": 6951,
      "kind": "line",
      "limit": 11,
      "source": "乗り越えてまでもらった",
      "target": "重重危险赐予我的"
    },
    {
      "offset": 6979,
      "kind": "line",
      "limit": 11,
      "source": "命を大切にし、",
      "target": "生命，"
    },
    {
      "offset": 6999,
      "kind": "line",
      "limit": 10,
      "source": "後悔しない生き方を",
      "target": "时刻提醒自己，"
    },
    {
      "offset": 7023,
      "kind": "line",
      "limit": 10,
      "source": "していこうと、いつも",
      "target": "要活得不留"
    },
    {
      "offset": 7049,
      "kind": "line",
      "limit": 10,
      "source": "心掛けています。",
      "target": "遗憾。"
    },
    {
      "offset": 7078,
      "kind": "line",
      "limit": 11,
      "source": "なので、恐らく暁さんも",
      "target": "所以，晓先生或许"
    },
    {
      "offset": 7126,
      "kind": "line",
      "limit": 11,
      "source": "同じ気持ちを持っている",
      "target": "也怀着同样的"
    },
    {
      "offset": 7154,
      "kind": "line",
      "limit": 11,
      "source": "んじゃないでしょうか。",
      "target": "心情吧。"
    },
    {
      "offset": 7184,
      "kind": "line",
      "limit": 9,
      "source": "そうだと…",
      "target": "但愿…"
    },
    {
      "offset": 7200,
      "kind": "line",
      "limit": 9,
      "source": "いいのですけどね。",
      "target": "如此吧。"
    },
    {
      "offset": 7245,
      "kind": "line",
      "limit": 11,
      "source": "悪い人にダマされないと",
      "target": "希望他不会被坏人"
    },
    {
      "offset": 7273,
      "kind": "line",
      "limit": 11,
      "source": "いいのですが…。",
      "target": "欺骗…"
    },
    {
      "offset": 7309,
      "kind": "line",
      "limit": 11,
      "source": "事故に遭った時は、もう",
      "target": "您遭遇车祸时，"
    },
    {
      "offset": 7353,
      "kind": "line",
      "limit": 11,
      "source": "忠雄さんと結婚はされて",
      "target": "已经和忠雄先生"
    },
    {
      "offset": 7381,
      "kind": "line",
      "limit": 11,
      "source": "たんですか？",
      "target": "结婚了吗？"
    },
    {
      "offset": 7401,
      "kind": "line",
      "limit": 4,
      "source": "それが…",
      "target": "其实…"
    },
    {
      "offset": 7415,
      "kind": "line",
      "limit": 9,
      "source": "実は、結婚したのは",
      "target": "我们是在出院后"
    },
    {
      "offset": 7439,
      "kind": "line",
      "limit": 9,
      "source": "退院後なんです…。",
      "target": "才结婚的…"
    },
    {
      "offset": 7465,
      "kind": "line",
      "limit": 11,
      "source": "ああ、なるほど。",
      "target": "啊，原来如此。"
    },
    {
      "offset": 7487,
      "kind": "line",
      "limit": 11,
      "source": "その一件がきっかけで",
      "target": "是那件事促成了"
    },
    {
      "offset": 7513,
      "kind": "line",
      "limit": 11,
      "source": "結婚されたわけですね。",
      "target": "你们结婚吧。"
    },
    {
      "offset": 7543,
      "kind": "line",
      "limit": 5,
      "source": "そうです。",
      "target": "是的。"
    },
    {
      "offset": 7561,
      "kind": "line",
      "limit": 10,
      "source": "それで、忠雄さんの",
      "target": "那么，忠雄先生"
    },
    {
      "offset": 7585,
      "kind": "line",
      "limit": 10,
      "source": "行動が変わったのは、",
      "target": "行为发生变化，"
    },
    {
      "offset": 7611,
      "kind": "line",
      "limit": 10,
      "source": "どこのタイミング",
      "target": "究竟是在"
    },
    {
      "offset": 7633,
      "kind": "line",
      "limit": 10,
      "source": "だったんでしょうか？",
      "target": "什么时候？"
    },
    {
      "offset": 7677,
      "kind": "line",
      "limit": 7,
      "source": "ああ、思えば…",
      "target": "这么说来…"
    },
    {
      "offset": 7701,
      "kind": "line",
      "limit": 10,
      "source": "退院する頃には、もう",
      "target": "出院时，他就已经"
    },
    {
      "offset": 7733,
      "kind": "line",
      "limit": 10,
      "source": "どこかおかしい感じが",
      "target": "有些不对劲了。"
    },
    {
      "offset": 7759,
      "kind": "line",
      "limit": 10,
      "source": "ありました。",
      "target": "我记得是这样。"
    },
    {
      "offset": 7779,
      "kind": "line",
      "limit": 4,
      "source": "ふむ…。",
      "target": "嗯…"
    },
    {
      "offset": 7817,
      "kind": "line",
      "limit": 11,
      "source": "…あの、ちょっと",
      "target": "…那个，我有件事"
    },
    {
      "offset": 7839,
      "kind": "line",
      "limit": 11,
      "source": "気になったんですが…。",
      "target": "有些在意…"
    },
    {
      "offset": 7869,
      "kind": "line",
      "limit": 3,
      "source": "はい？",
      "target": "什么？"
    },
    {
      "offset": 7883,
      "kind": "line",
      "limit": 11,
      "source": "２５年前の事故での",
      "target": "25 年前那场事故"
    },
    {
      "offset": 7907,
      "kind": "line",
      "limit": 11,
      "source": "入院費は、忠雄さんが",
      "target": "的住院费，都是"
    },
    {
      "offset": 7933,
      "kind": "line",
      "limit": 11,
      "source": "全て支払ったんですか？",
      "target": "忠雄先生付的吗？"
    },
    {
      "offset": 7963,
      "kind": "line",
      "limit": 10,
      "source": "…ええ、おそらく",
      "target": "…嗯，应该"
    },
    {
      "offset": 7985,
      "kind": "line",
      "limit": 10,
      "source": "そうだと思いますが。",
      "target": "是吧。"
    },
    {
      "offset": 8013,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 8029,
      "kind": "line",
      "limit": 8,
      "source": "あの、なにか…？",
      "target": "那个，怎么了…？"
    },
    {
      "offset": 8053,
      "kind": "line",
      "limit": 8,
      "source": "いえ、それだけ",
      "target": "没什么，只是"
    },
    {
      "offset": 8073,
      "kind": "line",
      "limit": 8,
      "source": "大掛かりな入院と",
      "target": "那么大规模的"
    },
    {
      "offset": 8095,
      "kind": "line",
      "limit": 8,
      "source": "なると…",
      "target": "住院治疗…"
    },
    {
      "offset": 8120,
      "kind": "line",
      "limit": 10,
      "source": "莫大な治療費が",
      "target": "治疗费应该相当"
    },
    {
      "offset": 8146,
      "kind": "line",
      "limit": 10,
      "source": "かかったはずですよ。",
      "target": "庞大。"
    },
    {
      "offset": 8174,
      "kind": "line",
      "limit": 8,
      "source": "そうなんですか？",
      "target": "是吗？"
    },
    {
      "offset": 8196,
      "kind": "line",
      "limit": 8,
      "source": "どのくらいの…？",
      "target": "大约有多少…？"
    },
    {
      "offset": 8220,
      "kind": "line",
      "limit": 10,
      "source": "集中治療室にも入った",
      "target": "您还进过重症"
    },
    {
      "offset": 8246,
      "kind": "line",
      "limit": 10,
      "source": "ということですし…",
      "target": "监护室…"
    },
    {
      "offset": 8270,
      "kind": "line",
      "limit": 9,
      "source": "おそらく、何千万円",
      "target": "恐怕要几千万日元",
      "runs": [
        "恐怕要",
        "几千万日元"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "おそらく、"
        },
        {
          "colour": 2,
          "text": "何千万円"
        }
      ]
    },
    {
      "offset": 8302,
      "kind": "line",
      "limit": 9,
      "source": "という金額になると",
      "target": "那么多。"
    },
    {
      "offset": 8326,
      "kind": "line",
      "limit": 9,
      "source": "思うんです。",
      "target": "我是这么想的。"
    },
    {
      "offset": 8346,
      "kind": "line",
      "limit": 6,
      "source": "えええっ!?",
      "target": "什么！？"
    },
    {
      "offset": 8362,
      "kind": "line",
      "limit": 4,
      "source": "そんな…",
      "target": "怎么会…"
    },
    {
      "offset": 8376,
      "kind": "line",
      "limit": 6,
      "source": "そんなはずは",
      "target": "不可能有"
    },
    {
      "offset": 8394,
      "kind": "line",
      "limit": 6,
      "source": "ありません！",
      "target": "这种事！"
    },
    {
      "offset": 8412,
      "kind": "line",
      "limit": 10,
      "source": "そんなお金があるはず",
      "target": "我们不可能有"
    },
    {
      "offset": 8438,
      "kind": "line",
      "limit": 10,
      "source": "なんて、ありません！",
      "target": "那么多钱！"
    },
    {
      "offset": 8466,
      "kind": "line",
      "limit": 9,
      "source": "しかし…実際、その",
      "target": "可是…实际上，"
    },
    {
      "offset": 8490,
      "kind": "line",
      "limit": 9,
      "source": "くらいはかかると",
      "target": "我想确实需要"
    },
    {
      "offset": 8512,
      "kind": "line",
      "limit": 9,
      "source": "思うんですが…。",
      "target": "那么多…"
    },
    {
      "offset": 8536,
      "kind": "line",
      "limit": 11,
      "source": "そんな…何千万円なんて",
      "target": "怎么会…几千万日元"
    },
    {
      "offset": 8564,
      "kind": "line",
