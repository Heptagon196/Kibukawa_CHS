{
  "script": "c2_00",
  "units": [
    {"offset": 12306, "target": "听取他的意见。"},
    {"offset": 12328, "target": "忠雄先生的事"},
    {"offset": 12350, "target": "也和他商量过吗？"},
    {"offset": 12380, "target": "没有。"},
    {"offset": 12392, "target": "关于那个人，"},
    {"offset": 12418, "target": "我几乎什么都没说。"},
    {"offset": 12456, "target": "……我觉得谈起丈夫"},
    {"offset": 12482, "target": "只会让父亲平添"},
    {"offset": 12508, "target": "担心……"},
    {"offset": 12538, "target": "啊，也对。"},
    {"offset": 12564, "target": "毕竟您似乎也并未"},
    {"offset": 12590, "target": "对此心怀不满。"},
    {"offset": 12616, "target": "是吧。"},
    {"offset": 12642, "target": "是的，没错。"},
    {"offset": 12664, "target": "我们的事"},
    {"offset": 12684, "target": "是我们自己的问题……"},
    {"offset": 12710, "target": "我希望别人"},
    {"offset": 12728, "target": "不要干涉。"},
    {"offset": 12754, "target": "那么……您父亲知道"},
    {"offset": 12802, "target": "晓先生在存钱的"},
    {"offset": 12828, "target": "事吗？"},
    {"offset": 12866, "target": "……他知道。"},
    {"offset": 12886, "target": "我和他说过晓正"},
    {"offset": 12910, "target": "努力攒结婚资金，"},
    {"offset": 12936, "target": "而且说过几次。"},
    {"offset": 12964, "target": "存折在哪里……？"},
    {"offset": 12988, "target": "这个……"},
    {"offset": 13002, "target": "您也看见了，"},
    {"offset": 13024, "target": "家里的东西很少……"},
    {"offset": 13052, "target": "……啊，我明白了。"},
    {"offset": 13076, "target": "重要的东西会放"},
    {"offset": 13100, "target": "在哪里……"},
    {"offset": 13118, "target": "只要来过几次，"},
    {"offset": 13140, "target": "大概就能猜到，"},
    {"offset": 13166, "target": "是这个意思吧。"},
    {"offset": 13192, "target": "可是，父亲怎么会……"},
    {"offset": 13255, "target": "如果偷走存折的"},
    {"offset": 13277, "target": "人不是忠雄先生……"},
    {"offset": 13303, "target": "那您父亲恐怕"},
    {"offset": 13325, "target": "就是嫌疑最大"},
    {"offset": 13353, "target": "的人了……"},
    {"offset": 13391, "target": "……"},
    {"offset": 13444, "target": "关于您父亲，"},
    {"offset": 13470, "target": "能再详细告诉我"},
    {"offset": 13490, "target": "一些吗？"},
    {"offset": 13516, "target": "他现在在哪里，"},
    {"offset": 13544, "target": "又在做什么？"},
    {"offset": 13566, "target": "……"},
    {"offset": 13578, "target": "我父亲名叫水岛寅男。", "runs": ["我父亲名叫", "水岛寅男。"]},
    {"offset": 13646, "target": "就是这个名字。"},
    {"offset": 13662, "target": "水岛是我的旧姓。"},
    {"offset": 13700, "target": "他现在在哪里，"},
    {"offset": 13720, "target": "又在做什么……"},
    {"offset": 13742, "target": "说来惭愧，我也"},
    {"offset": 13768, "target": "不太清楚。"},
    {"offset": 13798, "target": "咦……？"},
    {"offset": 13824, "target": "从我年幼时起，父亲"},
    {"offset": 13865, "target": "就一直游戏人间，"},
    {"offset": 13914, "target": "像个四处漂泊的浪子……"},
    {"offset": 13946, "target": "他没有固定工作，"},
    {"offset": 13984, "target": "终年在全国四处旅行，"},
    {"offset": 14012, "target": "是个怪人。"},
    {"offset": 14036, "target": "所以，他几乎从来"},
    {"offset": 14064, "target": "不回家……"},
    {"offset": 14090, "target": "就是了……"},
    {"offset": 14104, "target": "这样啊……"},
    {"offset": 14118, "target": "您父亲还真是位"},
    {"offset": 14138, "target": "不得了的人……"},
    {"offset": 14164, "target": "恕我冒昧，那生活费"},
    {"offset": 14190, "target": "又是怎么解决的？"},
    {"offset": 14220, "target": "每个月都会准时"},
    {"offset": 14244, "target": "寄来生活费。"},
    {"offset": 14268, "target": "至于他到底做"},
    {"offset": 14292, "target": "什么工作，我并不"},
    {"offset": 14318, "target": "清楚……"},
    {"offset": 14336, "target": "原来如此……"},
    {"offset": 14356, "target": "而且，他现在仍旧"},
    {"offset": 14384, "target": "过着那样的生活，"},
    {"offset": 14410, "target": "一点没变。"},
    {"offset": 14428, "target": "明明已经年过"},
    {"offset": 14452, "target": "七十了……"},
    {"offset": 14482, "target": "咦，至今还……？"},
    {"offset": 14504, "target": "……那么，您这边"},
    {"offset": 14530, "target": "能联系到他吗？"},
    {"offset": 14558, "target": "是的，联系不到。", "runs": ["是的，", "联系不到。"]},
    {"offset": 14595, "target": "每次见面，都是"},
    {"offset": 14617, "target": "父亲主动联系我。"},
    {"offset": 14643, "target": "……他偶尔也会"},
    {"offset": 14669, "target": "不打招呼，突然来"},
    {"offset": 14693, "target": "这间公寓。"},
    {"offset": 14719, "target": "唔……"},
    {"offset": 14733, "target": "那么，您最后一次"},
    {"offset": 14761, "target": "见他是什么时候？"},
    {"offset": 14793, "target": "大概是两个月"},
    {"offset": 14819, "target": "以前。"},
    {"offset": 14843, "target": "……那么，当时他"},
    {"offset": 14867, "target": "还在鞠滨。"},
    {"offset": 14897, "target": "是的。"},
    {"offset": 14909, "target": "但他如今究竟在哪，"},
    {"offset": 14937, "target": "我完全不清楚……"},
    {"offset": 14965, "target": "唔……"},
    {"offset": 14979, "target": "这样一来，想见他"},
    {"offset": 15003, "target": "并询问情况似乎很"},
    {"offset": 15029, "target": "困难……"},
    {"offset": 15047, "target": "是啊。"},
    {"offset": 15065, "target": "我早已认为父亲就是"},
    {"offset": 15093, "target": "那样的人，也已经"},
    {"offset": 15121, "target": "习惯了……"},
    {"offset": 15143, "target": "原来如此……"},
    {"offset": 15161, "target": "……当时，寅男先生"},
    {"offset": 15207, "target": "有没有什么反常"},
    {"offset": 15231, "target": "的表现？"},
    {"offset": 15263, "target": "这个嘛，没什么……"},
    {"offset": 15301, "target": "非要说的话，他难得"},
    {"offset": 15327, "target": "问起了我丈夫的"},
    {"offset": 15355, "target": "下落……就这件事吧。"},
    {"offset": 15383, "target": "他问忠雄先生在哪？"},
    {"offset": 15411, "target": "是的。还说事到如今，"},
    {"offset": 15435, "target": "想见他一次……"},
    {"offset": 15463, "target": "他就是这样说的……"},
    {"offset": 15493, "target": "唔……"},
    {"offset": 15507, "target": "只有这些吗……"},
    {"offset": 15535, "target": "是的。"},
    {"offset": 15553, "target": "他本来就不太在意"},
    {"offset": 15590, "target": "世俗琐事，自由奔放，"},
    {"offset": 15652, "target": "是那样的人……"},
    {"offset": 15676, "target": "这样啊……"},
    {"offset": 15696, "target": "……不过，您现在能"},
    {"offset": 15722, "target": "如此宽容地对待"},
    {"offset": 15759, "target": "忠雄先生……"},
    {"offset": 15783, "target": "或许也是因为父亲"},
    {"offset": 15811, "target": "就是那样的人吧。"},
    {"offset": 15841, "target": "啊，是啊。"},
    {"offset": 15865, "target": "或许也有这个原因。"},
    {"offset": 15895, "target": "…嗯？"},
    {"offset": 15933, "target": "晓先生见过自己的"},
    {"offset": 15978, "target": "外祖父水岛寅男"},
    {"offset": 16021, "target": "先生吗？"},
    {"offset": 16051, "target": "……应该没有"},
    {"offset": 16077, "target": "见过吧。"},
    {"offset": 16099, "target": "我跟他提过父亲……"},
    {"offset": 16127, "target": "但他们应该一直没有"},
    {"offset": 16155, "target": "直接见过。"},
    {"offset": 16175, "target": "唔……"},
    {"offset": 16189, "target": "这也是一段"},
    {"offset": 16211, "target": "挺特别的家庭"},
    {"offset": 16233, "target": "关系……"},
    {"offset": 16261, "target": "毕竟我父亲就是"},
    {"offset": 16285, "target": "那样的人……"},
    {"offset": 16307, "target": "唔……"},
    {"offset": 16348, "target": "很遗憾，我不知道"},
    {"offset": 16370, "target": "父亲现在身在"},
    {"offset": 16394, "target": "何处。"},
    {"offset": 16430, "target": "蝼川内绫子"},
    {"offset": 16444, "target": "电视"},
    {"offset": 16454, "target": "衣柜"},
    {"offset": 16473, "target": "年龄大约在五十岁", "runs": ["年龄", "大约在五十岁"]},
    {"offset": 16512, "target": "上下吧……"},
    {"offset": 16536, "target": "她身上仍有一股光彩，"},
    {"offset": 16571, "target": "令人觉得她年轻时"},
    {"offset": 16603, "target": "一定很美。"},
    {"offset": 16645, "target": "此外，她端正的"},
    {"offset": 16667, "target": "五官中……"},
    {"offset": 16687, "target": "透着撑起这个家庭的"},
    {"offset": 16715, "target": "自信，以及坚定而"},
    {"offset": 16761, "target": "强韧的意志。"},
    {"offset": 16791, "target": "……正如听说的一样，"},
    {"offset": 16815, "target": "她给我的感觉就是"},
    {"offset": 16843, "target": "一位出色的母亲。"},
    {"offset": 16874, "target": "一台很普通的十四英寸"},
    {"offset": 16900, "target": "彩色电视。"},
    {"offset": 16922, "target": "好歹比事务所那台"},
    {"offset": 16948, "target": "新一些……"},
    {"offset": 16981, "target": "看似是桐木衣柜，"},
    {"offset": 17005, "target": "仔细一看，用的"},
    {"offset": 17029, "target": "似乎是廉价木材。"},
    {"offset": 17065, "target": "蝼川内绫子"},
    {"offset": 17097, "target": "……感觉不到她心中"},
    {"offset": 17119, "target": "有任何不安或迷茫。"},
    {"offset": 17145, "target": "刚才的谈话内容"},
    {"offset": 17167, "target": "似乎都是真的。"},
    {"offset": 17194, "target": "……尽管很轻微，"},
    {"offset": 17218, "target": "我感觉她在动摇……"},
    {"offset": 17250, "target": "她刚才说的，也可能是谎", "runs": ["她刚才说的，也可能是", "谎"]},
    {"offset": 17291, "target": "话。"},
    {"offset": 17319, "target": "……再问她一次"},
    {"offset": 17341, "target": "吧。"},
    {"offset": 17370, "target": "……隐约透着紧张", "runs": ["……隐约透着", "紧张"]},
    {"offset": 17407, "target": "的气息。"},
    {"offset": 17434, "target": "刚才那些话里，她似乎"},
    {"offset": 17464, "target": "隐瞒了什么……"},
    {"offset": 17496, "target": "我有这种感觉。"},
    {"offset": 17518, "target": "绫子女士是个意志"},
    {"offset": 17544, "target": "十分坚定的人。"},
    {"offset": 17566, "target": "她有意隐瞒的事情，"},
    {"offset": 17594, "target": "恐怕没那么容易"},
    {"offset": 17620, "target": "问出来……"},
    {"offset": 17685, "target": "保存"},
    {"offset": 17699, "target": "返回游戏"},
    {"offset": 17728, "target": "保存成功。"},
    {"offset": 17764, "target": "保存失败。", "runs": ["保存", "失败", "。"]}
  ]
}
