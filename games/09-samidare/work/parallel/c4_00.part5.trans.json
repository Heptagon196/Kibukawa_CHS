{
  "script": "c4_00",
  "units": [
    {"offset": 19955, "target": "想到吧…"},
    {"offset": 19983, "target": "她应该也没有"},
    {"offset": 20009, "target": "自己是个骗子的"},
    {"offset": 20033, "target": "意识吧。"},
    {"offset": 20049, "target": "她对忠雄先生"},
    {"offset": 20071, "target": "的感情…并没有"},
    {"offset": 20093, "target": "掺假。"},
    {"offset": 20115, "target": "这样啊…"},
    {"offset": 20133, "target": "那、那么…"},
    {"offset": 20155, "target": "招来的灾祸", "runs": ["招来的", "灾祸"]},
    {"offset": 20209, "target": "究竟是什么…？"},
    {"offset": 20250, "target": "就是尼子的另一个", "runs": ["就是尼子的", "另一个"]},
    {"offset": 20283, "target": "女儿！"},
    {"offset": 20314, "target": "什么…！？"},
    {"offset": 20332, "target": "另一个女儿…！？"},
    {"offset": 20377, "target": "绫子女士始终"},
    {"offset": 20405, "target": "没能彻底成为"},
    {"offset": 20431, "target": "一个骗子…"},
    {"offset": 20460, "target": "尼子或许早早"},
    {"offset": 20494, "target": "就对她不抱"},
    {"offset": 20516, "target": "希望了。"},
    {"offset": 20532, "target": "…另一个女儿", "runs": ["…", "另一个女儿"]},
    {"offset": 20569, "target": "也开始受到培养。"},
    {"offset": 20595, "target": "说起来，你刚才"},
    {"offset": 20621, "target": "也说过他有两个"},
    {"offset": 20647, "target": "女儿…"},
    {"offset": 20669, "target": "这次从她幼年时"},
    {"offset": 20693, "target": "就开始彻底实行"},
    {"offset": 20726, "target": "精英教育。"},
    {"offset": 20746, "target": "…把他掌握的技术"},
    {"offset": 20772, "target": "与知识，毫无保留地"},
    {"offset": 20800, "target": "据说全灌输给了女儿。"},
    {"offset": 20830, "target": "这…听起来"},
    {"offset": 20852, "target": "实在太可怕了…"},
    {"offset": 20890, "target": "这样养大的女儿，"},
    {"offset": 20916, "target": "成了完美的犯罪机器。"},
    {"offset": 20944, "target": "而且绫子女士的美貌"},
    {"offset": 20992, "target": "据说也完整地继承下来，", "runs": ["据说也完整地", "继承下来，"]},
    {"offset": 21028, "target": "所以更加棘手。"},
    {"offset": 21058, "target": "…什么！？"},
    {"offset": 21076, "target": "……！？"},
    {"offset": 21088, "target": "继承了…？"},
    {"offset": 21114, "target": "那也难怪！"},
    {"offset": 21145, "target": "因为尼子随后培养的，"},
    {"offset": 21181, "target": "正是绫子女士生下后"},
    {"offset": 21225, "target": "遗弃的那个孩子！"},
    {"offset": 21285, "target": "啊、啊…！！"},
    {"offset": 21314, "target": "对了，听说她以前"},
    {"offset": 21338, "target": "曾经遗弃过"},
    {"offset": 21378, "target": "一个孩子…"},
    {"offset": 21396, "target": "…！？"},
    {"offset": 21408, "target": "然后…"},
    {"offset": 21422, "target": "那孩子似乎叫灵崎朱", "runs": ["那孩子似乎叫", "灵崎朱"]},
    {"offset": 21488, "target": "并以这个名字长大。"},
    {"offset": 21518, "target": "塔玛萨奇，绫…"},
    {"offset": 21542, "target": "原来如此，向我打听"},
    {"offset": 21570, "target": "的就是这个人…"},
    {"offset": 21600, "target": "但我的调查，也只查到"},
    {"offset": 21628, "target": "这里为止。"},
    {"offset": 21667, "target": "很难想象，灵崎朱"},
    {"offset": 21714, "target": "如今还会老老实实"},
    {"offset": 21742, "target": "使用本名。"},
    {"offset": 21762, "target": "她现在用了什么名字，"},
    {"offset": 21790, "target": "又在哪里做什么，"},
    {"offset": 21818, "target": "我都没能查明。"},
    {"offset": 21848, "target": "………"},
    {"offset": 21864, "target": "不过，刚才我已经"},
    {"offset": 21892, "target": "向绫子女士确认过…"},
    {"offset": 21916, "target": "如果那个孩子如今"},
    {"offset": 21940, "target": "还活着…"},
    {"offset": 21968, "target": "今年就２７岁了…", "runs": ["今年就", "２７岁了…"]},
    {"offset": 22007, "target": "她是这么说的。"},
    {"offset": 22029, "target": "…也就是说，她是我"},
    {"offset": 22055, "target": "的姐姐啊…"},
    {"offset": 22085, "target": "…得知被遗弃的女儿"},
    {"offset": 22109, "target": "依然活着，且被养大"},
    {"offset": 22135, "target": "这件事…"},
    {"offset": 22151, "target": "她一方面由衷高兴，"},
    {"offset": 22179, "target": "另一方面也因其境遇"},
    {"offset": 22207, "target": "而深受打击。"},
    {"offset": 22231, "target": "女儿竟成了"},
    {"offset": 22255, "target": "犯罪机器。"},
    {"offset": 22277, "target": "…心情一定很复杂。"},
    {"offset": 22305, "target": "如果那孩子真的"},
    {"offset": 22331, "target": "干了坏事…"},
    {"offset": 22349, "target": "请不要顾虑，"},
    {"offset": 22373, "target": "直接抓住她，"},
    {"offset": 22399, "target": "让她接受制裁。"},
    {"offset": 22423, "target": "…………"},
    {"offset": 22451, "target": "不过，年龄这种东西"},
    {"offset": 22477, "target": "想造假很容易。"},
    {"offset": 22505, "target": "…所以算不上什么"},
    {"offset": 22531, "target": "有用的线索。"},
    {"offset": 22551, "target": "话是这么说…"},
    {"offset": 22583, "target": "…但——是！！"},
    {"offset": 22611, "target": "…！？"},
    {"offset": 22623, "target": "听了这次蝼川内"},
    {"offset": 22673, "target": "父子的事情…"},
    {"offset": 22693, "target": "我终于抓住了"},
    {"offset": 22750, "target": "灵崎朱的尾巴！"},
    {"offset": 22792, "target": "虽说还没有证据，"},
    {"offset": 22816, "target": "但我已经有头绪了！"},
    {"offset": 22838, "target": "真的吗！？"},
    {"offset": 22862, "target": "听好！"},
    {"offset": 22876, "target": "按我的推理…"},
    {"offset": 22909, "target": "能把尼子启三"},
    {"offset": 22956, "target": "不留痕迹地抹掉他", "runs": ["不留痕迹地", "抹掉他"]},
    {"offset": 22988, "target": "的那种人…"},
    {"offset": 23008, "target": "我认为，恐怕也就"},
    {"offset": 23071, "target": "只有灵崎朱了。"},
    {"offset": 23093, "target": "…恐怕掌握他的身份"},
    {"offset": 23121, "target": "与藏身之处的，"},
    {"offset": 23147, "target": "也只有她了。"},
    {"offset": 23175, "target": "至于她的理由，"},
    {"offset": 23199, "target": "我也大致猜得到。"},
    {"offset": 23217, "target": "…为了世代交替。", "runs": ["…", "为了世代交替。"]},
    {"offset": 23256, "target": "这在动物界"},
    {"offset": 23282, "target": "是很常见的事。"},
    {"offset": 23320, "target": "原来如此…"},
    {"offset": 23340, "target": "所以，忠雄先生！"},
    {"offset": 23366, "target": "什、什么…！？"},
    {"offset": 23397, "target": "尼子死后，应该有"},
    {"offset": 23429, "target": "一个女人主动"},
    {"offset": 23457, "target": "接近过你！"},
    {"offset": 23487, "target": "她还说过“你需要"},
    {"offset": 23515, "target": "钱吧？”之类的话！"},
    {"offset": 23539, "target": "……！！"},
    {"offset": 23553, "target": "那个人，正是"},
    {"offset": 23584, "target": "灵崎朱…"},
    {"offset": 23632, "target": "也是从尼子手中"},
    {"offset": 23673, "target": "夺走存折、偷走晓"},
    {"offset": 23707, "target": "存款的犯人！"},
    {"offset": 23784, "target": "啊，原来如此…"},
    {"offset": 23808, "target": "……………"},
    {"offset": 23838, "target": "你刚才说自己"},
    {"offset": 23868, "target": "参与了犯罪…"},
    {"offset": 23902, "target": "可是，"},
    {"offset": 23916, "target": "那正是灵崎朱"},
    {"offset": 23977, "target": "作案的手法。"},
    {"offset": 23995, "target": "她会利用人的弱点，"},
    {"offset": 24021, "target": "把对方逼进"},
    {"offset": 24045, "target": "无法拒绝的处境。"},
    {"offset": 24069, "target": "…然后，自己不用"},
    {"offset": 24095, "target": "动手就完成犯罪。"},
    {"offset": 24121, "target": "…这样一来，"},
    {"offset": 24143, "target": "自然不留证据。"},
    {"offset": 24161, "target": "唔…"},
    {"offset": 24171, "target": "…虽然不甘心，"},
    {"offset": 24195, "target": "但正是如此…"},
    {"offset": 24226, "target": "我上个月…被那个", "runs": ["我", "上个月…被那个"]},
    {"offset": 24263, "target": "女人怂恿…"},
    {"offset": 24285, "target": "成了她诈骗的"},
    {"offset": 24309, "target": "帮凶。"},
    {"offset": 24331, "target": "那…用的是什么"},
    {"offset": 24351, "target": "手法？"},
    {"offset": 24381, "target": "只需一通电话…"},
    {"offset": 24407, "target": "手法简单得可怕，"},
    {"offset": 24433, "target": "连我也很吃惊。"},
    {"offset": 24453, "target": "是什么…？"},
    {"offset": 24471, "target": "女人假装成对方的"},
    {"offset": 24499, "target": "女儿，打去电话。"},
    {"offset": 24523, "target": "再说自己出了"},
    {"offset": 24547, "target": "交通事故，急需"},
    {"offset": 24573, "target": "一笔和解金…"},
    {"offset": 24597, "target": "不给对方怀疑的"},
    {"offset": 24625, "target": "空当，一口气说完。"},
    {"offset": 24651, "target": "接着由我假装警察，"},
    {"offset": 24679, "target": "指示对方立刻"},
    {"offset": 24703, "target": "把钱汇过来。"},
    {"offset": 24731, "target": "…就这些。"},
    {"offset": 24753, "target": "咦…？"},
    {"offset": 24767, "target": "这么简单就能…？"},
    {"offset": 24797, "target": "原来如此…"},
    {"offset": 24815, "target": "这是利用人对子女的爱，"},
    {"offset": 24843, "target": "很恶劣的手法。"},
    {"offset": 24867, "target": "人越是走投无路…"},
    {"offset": 24891, "target": "就越容易失去"},
    {"offset": 24915, "target": "判断力。"},
    {"offset": 24939, "target": "…是种新型诈骗啊。"},
    {"offset": 24963, "target": "要是这种手法传开，"},
    {"offset": 24991, "target": "可就麻烦了。"},
    {"offset": 25017, "target": "…会想出这种点子的"}
  ]
}
