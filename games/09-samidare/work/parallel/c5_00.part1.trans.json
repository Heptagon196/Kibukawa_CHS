  "units": [
    {"offset": 20, "target": "（蝼川内）"},
    {"offset": 59, "target": "终节Ａ"},
    {"offset": 71, "target": "　"},
    {"offset": 79, "target": "『代替他』"},
    {"offset": 136, "target": "２００４年６月某日"},
    {"offset": 160, "target": "天气：雨"},
    {"offset": 174, "target": "　"},
    {"offset": 193, "target": "癸生川侦探事务所"},
    {"offset": 265, "target": "…这样啊。"},
    {"offset": 285, "target": "以前还发生过那种事…"},
    {"offset": 315, "target": "是啊，就是这样。"},
    {"offset": 341, "target": "转眼都８年了…。"},
    {"offset": 369, "target": "…事务所也已经"},
    {"offset": 413, "target": "完全变了样呢。"},
    {"offset": 437, "target": "哦…。"},
    {"offset": 451, "target": "…原来以前是"},
    {"offset": 477, "target": "那样啊，伊纲。"},
    {"offset": 525, "target": "…………。"},
    {"offset": 543, "target": "哎呀，您丈夫当年"},
    {"offset": 589, "target": "当年真是帮了我"},
    {"offset": 617, "target": "不少忙。"},
    {"offset": 633, "target": "他是那么可靠、"},
    {"offset": 657, "target": "那么出色的侦探。"},
    {"offset": 687, "target": "…………。"},
    {"offset": 705, "target": "…伊纲？"},
    {"offset": 723, "target": "…咦？"},
    {"offset": 737, "target": "…啊，那、那当然"},
    {"offset": 765, "target": "是理所当然的啦。"},
    {"offset": 791, "target": "呵呵呵。看来你"},
    {"offset": 813, "target": "很信任他啊。"},
    {"offset": 841, "target": "…我不知道他现在"},
    {"offset": 869, "target": "身在何处，还请"},
    {"offset": 897, "target": "替我向他问好。"},
    {"offset": 921, "target": "…好的。"},
    {"offset": 937, "target": "………。"},
    {"offset": 953, "target": "…啊，对了，那个…"},
    {"offset": 981, "target": "您说的约定是…？"},
    {"offset": 1013, "target": "…哦，对了。"},
    {"offset": 1039, "target": "所以，我今天是来"},
    {"offset": 1069, "target": "偿还当时那笔欠款的。"},
    {"offset": 1105, "target": "…这是第一次还款，"},
    {"offset": 1131, "target": "我先带了３００万日元", "runs": ["我先带了", "３００万日元"]},
    {"offset": 1172, "target": "过来。"},
    {"offset": 1196, "target": "３００万…！？"},
    {"offset": 1218, "target": "…和全部欠款相比"},
    {"offset": 1242, "target": "还远远不够，"},
    {"offset": 1264, "target": "请先收下吧。"},
    {"offset": 1286, "target": "…那一次，真的"},
    {"offset": 1310, "target": "非常感谢你们"},
    {"offset": 1334, "target": "帮了我。"},
    {"offset": 1348, "target": "三…３００万日元！！"},
    {"offset": 1378, "target": "…伊纲？"},
    {"offset": 1427, "target": "生王先生！这可是"},
    {"offset": 1457, "target": "３００万日元啊！"},
    {"offset": 1481, "target": "这、这是真钞啊！"},
    {"offset": 1509, "target": "能买了！"},
    {"offset": 1523, "target": "设备，能买了！"},
    {"offset": 1545, "target": "啊哇哇哇！"},
    {"offset": 1570, "target": "伊纲，冷静点！"},
    {"offset": 1602, "target": "这又不是事务所的"},
    {"offset": 1630, "target": "钱！"},
    {"offset": 1654, "target": "…啊，对不起。"},
    {"offset": 1680, "target": "可能是听了以前的"},
    {"offset": 1704, "target": "事情，才变得"},
    {"offset": 1728, "target": "有点不对劲…。"},
    {"offset": 1756, "target": "这、这样…。"},
    {"offset": 1776, "target": "这笔钱由我负责"},
    {"offset": 1804, "target": "交还给老板，"},
    {"offset": 1828, "target": "请放心吧。"},
    {"offset": 1856, "target": "麻烦你了。"},
    {"offset": 1885, "target": "…咦？"},
    {"offset": 1899, "target": "不过…。"},
    {"offset": 1917, "target": "…嗯？"},
    {"offset": 1933, "target": "那次说过，孩子也", "runs": ["那次说过，", "孩子也"]},
    {"offset": 1974, "target": "会一起带来的"},
    {"offset": 2000, "target": "对吧…？"},
    {"offset": 2024, "target": "那个…虽然不好"},
    {"offset": 2048, "target": "开口，难道…。"},
    {"offset": 2083, "target": "哦，不不，"},
    {"offset": 2105, "target": "孩子没事。"},
    {"offset": 2129, "target": "长得很健康。"},
    {"offset": 2157, "target": "啊，这样啊。"},
    {"offset": 2181, "target": "那真是太好了…。"},
    {"offset": 2207, "target": "就是太活泼了，"},
    {"offset": 2233, "target": "反而让我头疼。"},
    {"offset": 2257, "target": "…今天本来也一起"},
    {"offset": 2285, "target": "到了附近，可是…"},
    {"offset": 2307, "target": "他好像从我这儿"},
    {"offset": 2331, "target": "跑掉了…"},
    {"offset": 2349, "target": "跑、跑掉了…？"},
    {"offset": 2371, "target": "说来惭愧，"},
    {"offset": 2399, "target": "他似乎很"},
    {"offset": 2423, "target": "讨厌我…。"},
    {"offset": 2451, "target": "毕竟我总是工作，"},
    {"offset": 2477, "target": "很少待在家里，"},
    {"offset": 2503, "target": "可能是我的错吧…。"},
    {"offset": 2527, "target": "原来如此。"},
    {"offset": 2557, "target": "他似乎更亲近"},
    {"offset": 2587, "target": "总待在家里的"},
    {"offset": 2615, "target": "我父亲。"},
    {"offset": 2643, "target": "真叫人没办法。"},
    {"offset": 2673, "target": "父亲…也就是说，"},
    {"offset": 2697, "target": "是忠雄先生吧。"},
    {"offset": 2721, "target": "是的。"},
    {"offset": 2733, "target": "托你们的福…"},
    {"offset": 2753, "target": "如今，妻子、父母…", "runs": ["如今，", "妻子、父母…"]},
    {"offset": 2792, "target": "一家人团聚，"},
    {"offset": 2816, "target": "过得很幸福。"},
    {"offset": 2840, "target": "…不过，生活"},
    {"offset": 2866, "target": "绝对算不上"},
    {"offset": 2892, "target": "富裕。"},
    {"offset": 2908, "target": "哎呀，这不是"},
    {"offset": 2932, "target": "很美满吗。"},
    {"offset": 2958, "target": "太好了…。"},
    {"offset": 2976, "target": "真的太好了…。"},
    {"offset": 3002, "target": "不，这一切都多亏"},
    {"offset": 3026, "target": "这家侦探事务所的"},
    {"offset": 3050, "target": "各位。"},
    {"offset": 3081, "target": "那、那个…。"},
    {"offset": 3099, "target": "我能…问您"},
    {"offset": 3143, "target": "一个问题吗？"},
    {"offset": 3163, "target": "…什么？"},
    {"offset": 3179, "target": "…？"},
    {"offset": 3191, "target": "故事最后…你忘了"},
    {"offset": 3221, "target": "问凉二先生什么事…"},
    {"offset": 3255, "target": "…到底是什么？"},
    {"offset": 3283, "target": "哦，那个啊。"},
    {"offset": 3307, "target": "…其实也不是什么"},
    {"offset": 3335, "target": "大不了的事情，"},
    {"offset": 3359, "target": "只是…"},
    {"offset": 3375, "target": "其实…"},
    {"offset": 3391, "target": "（晓）"},
    {"offset": 3449, "target": "…咦？"},
    {"offset": 3465, "target": "名字…吗？"},
    {"offset": 3493, "target": "对！就是之前说的"},
    {"offset": 3532, "target": "白鹭洲先生心上人的", "runs": ["白鹭洲先生", "心上人的"]},
    {"offset": 3573, "target": "名字呀！"},
    {"offset": 3597, "target": "我想拿来给孩子"},
    {"offset": 3623, "target": "取名字！"},
    {"offset": 3645, "target": "请告诉我嘛！"},
    {"offset": 3671, "target": "…………。"},
    {"offset": 3687, "target": "…真拿你没办法…。"},
    {"offset": 3713, "target": "拜托啦！"},
    {"offset": 3740, "target": "…伊、兹……哦。"},
    {"offset": 3768, "target": "…啊——对不起！"},
    {"offset": 3796, "target": "雨声太大，没听"},
    {"offset": 3822, "target": "清楚——！"},
    {"offset": 3842, "target": "可以再说一遍吗！"},
    {"offset": 3872, "target": "…我已经说过了！"},
    {"offset": 3898, "target": "那么，再见！"},
    {"offset": 3922, "target": "啊…！"},
    {"offset": 3943, "target": "…他躲进房间"},
    {"offset": 3967, "target": "里了…。"},
    {"offset": 3992, "target": "原来那个人也会"},
    {"offset": 4018, "target": "害羞啊…。"},
    {"offset": 4038, "target": "…不过“伊兹…”", "runs": ["…不过", "“伊兹…”"]},
    {"offset": 4079, "target": "我还是听见了，算了。"},
    {"offset": 4107, "target": "伊、兹…？"},
    {"offset": 4123, "target": "伊兹…什么呢。"},
    {"offset": 4148, "target": "…伊兹米吧？", "runs": ["…", "伊兹米吧？"]},
    {"offset": 4183, "target": "果然。"},
    {"offset": 4211, "target": "…蝼川内泉啊…", "runs": ["…蝼川内", "泉啊…"]},
    {"offset": 4280, "target": "…嗯，挺不错！"},
    {"offset": 4327, "target": "…这便是"},
    {"offset": 4349, "target": "代替他接掌"},
    {"offset": 4373, "target": "侦探事务所的"},
    {"offset": 4399, "target": "她…"},
    {"offset": 4419, "target": "每逢五月雨时节"},
    {"offset": 4445, "target": "总会想起的，"},
    {"offset": 4467, "target": "雨声的旋律…。"},
    {"offset": 4512, "target": "企划"},
    {"offset": 4523, "target": "石山贵也"},
    {"offset": 4553, "target": "剧本"},
    {"offset": 4564, "target": "生王正生"},
    {"offset": 4594, "target": "应用程序"},
    {"offset": 4617, "target": "大森俊广"},
    {"offset": 4647, "target": "服务器程序"},
    {"offset": 4670, "target": "稻垣荣二"},
    {"offset": 4684, "target": "川野贵史"},
    {"offset": 4714, "target": "角色美术"}
  ]
}
