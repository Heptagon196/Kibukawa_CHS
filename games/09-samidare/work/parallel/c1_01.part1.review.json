    },
    {
      "offset": 5069,
      "kind": "line",
      "limit": 11,
      "source": "大丈夫ですよ。",
      "target": "请放心。"
    },
    {
      "offset": 5091,
      "kind": "line",
      "limit": 6,
      "source": "そうですか、",
