    },
    {
      "offset": 5109,
      "kind": "line",
      "limit": 6,
      "source": "よかった…。",
      "target": "太好了…"
    },
    {
      "offset": 5129,
      "kind": "line",
      "limit": 9,
      "source": "では、もう少し",
      "target": "那么，能请您"
    },
    {
      "offset": 5149,
      "kind": "line",
      "limit": 9,
      "source": "詳しい話を聞かせて",
      "target": "再详细说一说"
    },
    {
      "offset": 5173,
      "kind": "line",
      "limit": 9,
      "source": "もらえますか。",
      "target": "吗？"
    },
    {
      "offset": 5195,
      "kind": "line",
      "limit": 7,
      "source": "わかりました。",
      "target": "好的。"
    },
    {
      "offset": 5226,
      "kind": "line",
      "limit": 10,
      "source": "父が私のお金を使う",
      "target": "在父亲把我的钱"
    },
    {
      "offset": 5250,
      "kind": "line",
      "limit": 10,
      "source": "前に、何としても",
      "target": "花掉以前，我无论"
    },
    {
      "offset": 5272,
      "kind": "line",
      "limit": 10,
      "source": "取り戻したいんです。",
      "target": "如何也要拿回来。"
    },
    {
      "offset": 5348,
      "kind": "line",
      "limit": 7,
      "source": "父の名前は、",
      "target": "我父亲叫"
    },
    {
      "offset": 5381,
      "kind": "line",
      "limit": 7,
      "source": "螻川内忠雄と",
      "target": "蝼川内忠雄，"
    },
    {
      "offset": 5421,
      "kind": "line",
      "limit": 7,
      "source": "いうのですが…",
      "target": "但是…"
    },
    {
      "offset": 5448,
      "kind": "line",
      "limit": 11,
      "source": "ハッキリ言って、昔から",
      "target": "说实话，他从以前起"
    },
    {
      "offset": 5476,
      "kind": "line",
      "limit": 11,
      "source": "ひどい父親でした。",
      "target": "就是个糟糕的父亲。"
    },
    {
      "offset": 5502,
      "kind": "line",
      "limit": 11,
      "source": "ひどい…といいますと？",
      "target": "糟糕…是指？"
    },
    {
      "offset": 5543,
      "kind": "line",
      "limit": 10,
      "source": "私が物心つく前から、",
      "target": "从我记事以前起，"
    },
    {
      "offset": 5569,
      "kind": "line",
      "limit": 10,
      "source": "ほとんど家にも帰らず",
      "target": "他就几乎不回家，"
    },
    {
      "offset": 5595,
      "kind": "line",
      "limit": 10,
      "source": "外で遊び歩いていて…",
      "target": "一直在外游荡…"
    },
    {
      "offset": 5621,
      "kind": "line",
      "limit": 9,
      "source": "たまに帰ってきたと",
      "target": "偶尔回来一次，"
    },
    {
      "offset": 5645,
      "kind": "line",
      "limit": 9,
      "source": "思えば、家のお金を",
      "target": "也只会强行从母亲"
    },
    {
      "offset": 5669,
