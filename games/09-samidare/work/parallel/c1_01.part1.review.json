    },
    {
      "offset": 4591,
      "kind": "line",
      "limit": 10,
      "source": "それで、何があったん",
      "target": "那么，究竟发生了"
    },
    {
      "offset": 4617,
      "kind": "line",
      "limit": 10,
      "source": "でしょうか。",
