    },
    {
      "offset": 4637,
      "kind": "line",
      "limit": 11,
      "source": "え、ええと…。",
      "target": "这、这个…"
    },
    {
      "offset": 4680,
      "kind": "line",
      "limit": 11,
      "source": "単刀直入に言いますと…",
      "target": "我就直说了…"
    },
    {
      "offset": 4716,
      "kind": "line",
      "limit": 11,
      "source": "父がうちのお金を盗んで",
      "target": "父亲偷走了家里的钱，"
    },
    {
      "offset": 4753,
      "kind": "line",
      "limit": 11,
      "source": "行方をくらましたんで、",
      "target": "然后失去了踪影，"
    },
    {
      "offset": 4793,
      "kind": "line",
      "limit": 11,
      "source": "困ってるんです。",
