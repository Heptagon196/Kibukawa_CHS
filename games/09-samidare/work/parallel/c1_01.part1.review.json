      "target": "调查"
    },
    {
      "offset": 4176,
      "kind": "choice",
      "limit": 0,
      "source": "中断する",
      "target": "中断"
    },
    {
      "offset": 4197,
      "kind": "line",
      "limit": 10,
      "source": "ここがこの事務所の",
      "target": "这里就是事务所的"
    },
    {
      "offset": 4221,
      "kind": "line",
      "limit": 10,
      "source": "応接…なのだろうか。",
      "target": "会客室…吗？"
    },
    {
      "offset": 4247,
      "kind": "line",
      "limit": 10,
      "source": "思ったことを先に",
      "target": "对方先把我心里"
    },
    {
      "offset": 4269,
      "kind": "line",
      "limit": 10,
      "source": "言われてしまったが…",
      "target": "想的话说了出来…"
    },
    {
      "offset": 4306,
      "kind": "line",
      "limit": 10,
      "source": "謙遜でなくて、本当に",
      "target": "他确实没有谦虚，"
    },
    {
      "offset": 4338,
      "kind": "line",
      "limit": 10,
      "source": "汚い部屋だった。",
      "target": "屋里真的很乱。"
    },
    {
      "offset": 4369,
      "kind": "line",
      "limit": 10,
      "source": "じめじめとした空気が",
      "target": "潮湿的空气似乎"
