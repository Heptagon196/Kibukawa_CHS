        {
          "colour": 2,
          "text": "螻川内です。"
        }
      ]
    },
    {
      "offset": 3962,
      "kind": "line",
      "limit": 10,
      "source": "螻川内暁といいます。",
      "target": "全名蝼川内晓。"
    },
    {
      "offset": 4010,
      "kind": "line",
      "limit": 10,
      "source": "２５歳、会社員です。",
      "target": "２５岁，是公司职员。"
    },
    {
      "offset": 4051,
      "kind": "line",
      "limit": 11,
      "source": "螻川内さんですね。",
      "target": "蝼川内先生，对吧。"
    },
    {
      "offset": 4081,
      "kind": "line",
      "limit": 11,
      "source": "よろしくお願いします。",
      "target": "请多关照。"
    },
    {
      "offset": 4111,
      "kind": "line",
      "limit": 8,
      "source": "こ、こちらこそ。",
      "target": "我、我才是。"
    },
    {
      "offset": 4144,
      "kind": "choice",
      "limit": 0,
      "source": "辺り見回す",
      "target": "环顾四周"
    },
    {
      "offset": 4158,
      "kind": "choice",
      "limit": 0,
      "source": "話す",
      "target": "交谈"
    },
    {
      "offset": 4166,
      "kind": "choice",
