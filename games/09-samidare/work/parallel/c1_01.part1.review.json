    },
    {
      "offset": 4883,
      "kind": "line",
      "limit": 11,
      "source": "出して欲しいんですが、",
      "target": "帮忙找到他，"
    },
    {
      "offset": 4911,
      "kind": "line",
      "limit": 11,
      "source": "大丈夫でしょうか…？",
      "target": "可以吗…？"
    },
    {
      "offset": 4937,
      "kind": "line",
      "limit": 10,
      "source": "なにぶん身内のこと",
      "target": "毕竟是家里的事，"
    },
    {
      "offset": 4961,
      "kind": "line",
      "limit": 10,
      "source": "なので、警察沙汰には",
      "target": "我不想把警察"
    },
    {
      "offset": 4987,
      "kind": "line",
      "limit": 10,
      "source": "したくないもので…。",
      "target": "牵扯进来…"
    },
    {
      "offset": 5015,
      "kind": "line",
      "limit": 11,
      "source": "ええ、人捜しの依頼も",
      "target": "没问题，我们也经常"
    },
    {
      "offset": 5041,
      "kind": "line",
      "limit": 11,
      "source": "よくやっていますから。",
