    {
      "offset": 4395,
      "kind": "line",
      "limit": 10,
      "source": "部屋の鬱陶しさを",
      "target": "让这房间更显得"
    },
    {
      "offset": 4439,
      "kind": "line",
      "limit": 10,
      "source": "高めているようだ。",
      "target": "沉闷。"
    },
