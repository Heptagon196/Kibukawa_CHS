 "units": [
  {
   "offset": 347,
   "target": "回家后，慧美小姐"
  },
  {
   "offset": 393,
   "target": "小姐的留言。"
  },
  {
   "offset": 443,
   "target": "在常去的咖啡馆"
  },
  {
   "offset": 722,
   "target": "慧美小姐…"
  },
  {
   "offset": 2683,
   "target": "慧美小姐…"
  },
  {
   "offset": 7327,
   "target": "仍决心给白鹭洲先生"
  },
  {
   "offset": 7377,
   "target": "商量一下的电话。"
  },
  {
   "offset": 7419,
   "target": "…白鹭洲先生虽然一大早"
  },
  {
   "offset": 7594,
   "target": "…果然，慧美小姐"
  },
  {
   "offset": 9527,
   "target": "…没事吗？"
  },
  {
   "offset": 10026,
   "target": "我什么也做不了"
  },
  {
   "offset": 10049,
   "target": "怎样都要救她"
  },
  {
   "offset": 10423,
   "target": "…也是可行的，但是"
  },
  {
   "offset": 10625,
   "target": "…费用究竟会是多少，"
  },
  {
   "offset": 11166,
   "target": "…之后的事，因为太慌，"
  },
  {
   "offset": 11641,
   "target": "…不过。"
  },
  {
   "offset": 11844,
   "target": "…对。"
  },
  {
   "offset": 11914,
   "target": "不也挺好吗。"
  },
  {
   "offset": 12350,
   "target": "像他一样，竭尽所能。"
  },
  {
   "offset": 12805,
   "target": "绝不是为了让你不幸"
  },
  {
   "offset": 12894,
   "target": "希望有一天你能明白。"
  },
  {
   "offset": 13273,
   "target": "求你一件事。"
  },
  {
   "offset": 13311,
   "target": "…之后过了几个小时。"
  }
 ]
