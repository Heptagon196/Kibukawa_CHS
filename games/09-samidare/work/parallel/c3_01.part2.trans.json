{
  "script": "c3_01",
  "units": [
    {"offset":4927,"target":"有人明明已经结婚"},
    {"offset":4955,"target":"生子，却还和别人"},
    {"offset":5005,"target":"在另一个家同居…"},
    {"offset":5031,"target":"有些人看起来认真"},
    {"offset":5059,"target":"诚实，背地里却会"},
    {"offset":5087,"target":"做这种事。"},
    {"offset":5115,"target":"更过分的，甚至会"},
    {"offset":5152,"target":"使用假名…"},
    {"offset":5179,"target":"彻底冒充另一个人，"},
    {"offset":5207,"target":"就这样生活"},
    {"offset":5235,"target":"好几年。"},
    {"offset":5268,"target":"可是，不会吧…"},
    {"offset":5294,"target":"我想起了他的妻子"},
    {"offset":5320,"target":"绫子女士相信着他，"},
    {"offset":5344,"target":"一直苦等的模样。"},
    {"offset":5358,"target":"…总之先记住"},
    {"offset":5382,"target":"这个地址，"},
    {"offset":5406,"target":"之后去看看吧…"},
    {"offset":5454,"target":"…不，等等。"},
    {"offset":5485,"target":"尼子去找忠雄先生时"},
    {"offset":5526,"target":"造访的是晓先生的"},
    {"offset":5560,"target":"家…"},
    {"offset":5584,"target":"可员工名册上写的是"},
    {"offset":5610,"target":"另一个地址，他怎么"},
    {"offset":5638,"target":"会知道真住址…？"},
    {"offset":5675,"target":"难道尼子详细调查过"},
    {"offset":5709,"target":"他的身份…？"},
    {"offset":5733,"target":"还是他本来就知道"},
    {"offset":5761,"target":"内情…？"},
    {"offset":5785,"target":"这样一来，尼子和"},
    {"offset":5829,"target":"忠雄先生究竟是"},
    {"offset":5851,"target":"什么关系…？"},
    {"offset":5877,"target":"…唔…"},
    {"offset":5910,"target":"除此之外，没有"},
    {"offset":5936,"target":"值得注意的信息。"},
    {"offset":5970,"target":"这是一块约两厘米大"},
    {"offset":5998,"target":"经过特殊加工的金属。"},
    {"offset":6026,"target":"掸去灰尘后，"},
    {"offset":6054,"target":"可以看出形状极其"},
    {"offset":6082,"target":"复杂。"},
    {"offset":6108,"target":"…咦？"},
    {"offset":6122,"target":"这个零件，我好像"},
    {"offset":6148,"target":"在哪里见过…"},
    {"offset":6178,"target":"…心中掠过一丝异样，"},
    {"offset":6206,"target":"我开始翻找"},
    {"offset":6228,"target":"记忆。"},
    {"offset":6250,"target":"………"},
    {"offset":6269,"target":"啊…"},
    {"offset":6285,"target":"…想起来了。"},
    {"offset":6305,"target":"这不是手枪用的","runs":["这不是","手枪用的"]},
    {"offset":6344,"target":"零件吗。"},
    {"offset":6372,"target":"以前有位专家让我看"},
    {"offset":6400,"target":"过拆卸手枪的"},
    {"offset":6428,"target":"过程…"},
    {"offset":6456,"target":"那时就见过和这"},
    {"offset":6480,"target":"一模一样的零件。"},
    {"offset":6504,"target":"…可是，"},
    {"offset":6529,"target":"这是真的吗？"},
    {"offset":6564,"target":"…如果只是玩具，"},
    {"offset":6592,"target":"所用的金属材质似乎"},
    {"offset":6620,"target":"好得过头了。"},
    {"offset":6644,"target":"难道说…！？"},
    {"offset":6669,"target":"像是手枪零件的"},
    {"offset":6693,"target":"金属碎片。"},
    {"offset":6709,"target":"…这东西是这间工厂"},
    {"offset":6735,"target":"制造的吗？"},
    {"offset":6763,"target":"如果是这样…"},
    {"offset":6813,"target":"我躲到暗处，"},
    {"offset":6835,"target":"悄悄观察情况。"},
    {"offset":6861,"target":"…有人走进来，"},
    {"offset":6885,"target":"慢慢向这里靠近。"},
    {"offset":6913,"target":"我从缝隙中看到了"},
    {"offset":6937,"target":"一点身影。"},
    {"offset":6955,"target":"那是…"},
    {"offset":6988,"target":"川濑莉沙…！？"},
    {"offset":7042,"target":"不会错，就是她。"},
    {"offset":7068,"target":"她为什么在这里…？"},
    {"offset":7092,"target":"过了一会儿，"},
    {"offset":7112,"target":"又有一个人走进"},
    {"offset":7136,"target":"工厂。"},
    {"offset":7154,"target":"看来他们约好在这里"},
    {"offset":7182,"target":"碰面。"},
    {"offset":7204,"target":"…能听见说话声。"},
    {"offset":7230,"target":"是男人的声音。"},
    {"offset":7248,"target":"他们说得很小声，"},
    {"offset":7276,"target":"具体内容完全"},
    {"offset":7300,"target":"听不清。"},
    {"offset":7326,"target":"虽然看不清对方"},
    {"offset":7348,"target":"男人的样子…"},
    {"offset":7370,"target":"但他们似乎正在"},
    {"offset":7398,"target":"交接什么东西。"},
    {"offset":7428,"target":"…我可是按约定"},
    {"offset":7454,"target":"全都办妥了哦。"},
    {"offset":7482,"target":"…看，正如您所见。"},
    {"offset":7508,"target":"这里已经"},
    {"offset":7528,"target":"没有人了。"},
    {"offset":7552,"target":"只有她尖亮的声音"},
    {"offset":7580,"target":"勉强能听清一些。"},
    {"offset":7618,"target":"…之后，"},
    {"offset":7636,"target":"两人便离开了。"},
    {"offset":7660,"target":"他们离开时，我稍微"},
    {"offset":7684,"target":"探出头，看清了两人"},
    {"offset":7708,"target":"的背影。"},
    {"offset":7732,"target":"对方似乎是身材中等"},
    {"offset":7758,"target":"的中年男人。"},
    {"offset":7792,"target":"…我没见过他。"},
    {"offset":7824,"target":"确认两人已经彻底"},
    {"offset":7852,"target":"离开后，我从设备"},
    {"offset":7880,"target":"后面走了出来。"},
    {"offset":7913,"target":"…他们知道这里没人，"},
    {"offset":7941,"target":"所以才把此处用来"},
    {"offset":7967,"target":"秘密会面吗？"},
    {"offset":7995,"target":"…不过。"},
    {"offset":8011,"target":"嗯…"},
    {"offset":8027,"target":"…让人在意的事"},
    {"offset":8053,"target":"还真多…"},
    {"offset":8086,"target":"我得联系癸生川，"},
    {"offset":8120,"target":"确认一下情报"},
    {"offset":8144,"target":"才行…"},
    {"offset":8168,"target":"…接下来先去"},
    {"offset":8190,"target":"忠雄先生的住处"},
    {"offset":8212,"target":"看看吧。"},
    {"offset":8261,"target":"１９９６年５月某日"},
    {"offset":8285,"target":"天气：雨"},
    {"offset":8299,"target":"　"},
    {"offset":8307,"target":"某处"},
    {"offset":8337,"target":"…辛苦啦。"},
    {"offset":8361,"target":"干得非常漂亮！"},
    {"offset":8391,"target":"…这样…就行了？"},
    {"offset":8417,"target":"这么轻易就能拿到"},
    {"offset":8441,"target":"钱吗…？"},
    {"offset":8465,"target":"呵呵。"},
    {"offset":8479,"target":"可不能告诉"},
    {"offset":8501,"target":"别人哦。"},
    {"offset":8519,"target":"他们会照着做的。"},
    {"offset":8547,"target":"……………"},
    {"offset":8590,"target":"１９９６年６月某日"},
    {"offset":8614,"target":"天气：雨"},
    {"offset":8628,"target":"　"},
    {"offset":8647,"target":"鞠滨市鞠滨台"},
    {"offset":8692,"target":"某咖啡店"},
    {"offset":8753,"target":"呼…"},
    {"offset":8772,"target":"…那以后已经过去"},
    {"offset":8796,"target":"好几个小时。"},
    {"offset":8817,"target":"外面天色也"},
    {"offset":8837,"target":"已经暗了。"},
    {"offset":8859,"target":"…后来我又把所有"},
    {"offset":8885,"target":"想得到的地方"},
    {"offset":8907,"target":"都找了一遍…"},
    {"offset":8931,"target":"可依然毫无"},
    {"offset":8951,"target":"进展。"},
    {"offset":8980,"target":"我来到咖啡店，想再"},
    {"offset":9006,"target":"好好梳理一下"},
    {"offset":9034,"target":"思绪。"},
    {"offset":9060,"target":"那么…稍微"},
    {"offset":9076,"target":"整理一下吧…"},
    {"offset":9123,"target":"环视四周"},
    {"offset":9137,"target":"思考"},
    {"offset":9147,"target":"中断"},
    {"offset":9159,"target":"和往常一样，"},
    {"offset":9183,"target":"这间咖啡店没什么"},
    {"offset":9205,"target":"客人。"},
    {"offset":9221,"target":"耳边传来安静的音乐"},
    {"offset":9247,"target":"和雨声。"},
    {"offset":9273,"target":"关于慧美"},
    {"offset":9285,"target":"关于父亲"},
    {"offset":9297,"target":"关于钱"},
    {"offset":9309,"target":"关于侦探"},
    {"offset":9339,"target":"慧美…"},
    {"offset":9363,"target":"…每当回过神来，我"},
    {"offset":9389,"target":"总是在想她"},
    {"offset":9413,"target":"的事。"},
    {"offset":9425,"target":"…可是，她那么漂亮"},
    {"offset":9453,"target":"又迷人…"},
    {"offset":9471,"target":"为什么愿意和我"},
    {"offset":9495,"target":"这种人交往"},
    {"offset":9521,"target":"呢…"},
    {"offset":9541,"target":"一想到这件事，"},
    {"offset":9563,"target":"我总会感到不安。"},
    {"offset":9587,"target":"大约三个月前，"}
  ]
}
