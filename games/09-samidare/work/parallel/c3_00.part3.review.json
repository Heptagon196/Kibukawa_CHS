    },
    {
      "offset": 10771,
      "kind": "line",
      "limit": 8,
      "source": "ええと、たしか…",
      "target": "呃，好像是…"
    },
    {
      "offset": 10802,
      "kind": "line",
      "limit": 8,
      "source": "…そうそう。",
      "target": "…对了。"
    },
    {
      "offset": 10822,
      "kind": "line",
      "limit": 8,
      "source": "クレフ製作所だ。",
      "target": "是克雷夫制作所。"
    },
    {
      "offset": 10857,
      "kind": "line",
      "limit": 8,
      "source": "ひとまず事務所に",
      "target": "先回事务所，"
    },
    {
      "offset": 10879,
      "kind": "line",
      "limit": 8,
      "source": "戻って、電話帳で",
      "target": "从电话簿上"
    },
    {
      "offset": 10901,
      "kind": "line",
      "limit": 8,
      "source": "探してみるか…。",
      "target": "找找吧…"
    },
    {
      "offset": 10956,
      "kind": "line",
      "limit": 9,
      "source": "１９９６年５月某日",
      "target": "１９９６年５月某日"
    },
    {
      "offset": 10980,
      "kind": "line",
      "limit": 9,
      "source": "天気、曇｜晴",
      "target": "天气：阴｜晴"
    },
    {
      "offset": 10998,
      "kind": "line",
      "limit": 9,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 11006,
      "kind": "line",
      "limit": 9,
      "source": "森家での会話",
      "target": "森家中的对话"
    },
    {
      "offset": 11051,
      "kind": "line",
      "limit": 11,
      "source": "…あなた、どうでした？",
      "target": "…亲爱的，怎么样了？"
    },
    {
      "offset": 11081,
      "kind": "line",
      "limit": 11,
      "source": "ああ、どうにか５００万",
      "target": "嗯，总算凑了５００万",
      "runs": [
        "嗯，总算凑了",
        "５００万"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "ああ、どうにか"
        },
        {
          "colour": 2,
          "text": "５００万"
        }
      ]
    },
    {
      "offset": 11117,
      "kind": "line",
      "limit": 11,
      "source": "都合ついたよ。",
      "target": "日元。"
    },
    {
      "offset": 11139,
      "kind": "line",
      "limit": 8,
      "source": "ホントですか!!",
      "target": "真的吗！！"
    },
    {
      "offset": 11159,
      "kind": "line",
      "limit": 9,
      "source": "ああ、よかった…。",
      "target": "太好了…"
    },
    {
      "offset": 11185,
      "kind": "line",
      "limit": 10,
      "source": "これで来月の返済期限",
      "target": "这样就能熬过"
    },
    {
      "offset": 11211,
      "kind": "line",
      "limit": 10,
      "source": "さえしのげれば…",
      "target": "下个月的还款期限…"
    },
    {
      "offset": 11233,
      "kind": "line",
      "limit": 11,
      "source": "一家揃って、首を",
      "target": "全家也不用一起"
    },
    {
      "offset": 11255,
      "kind": "line",
      "limit": 11,
      "source": "くくらなくても済むよ。",
      "target": "上吊了。"
    },
    {
      "offset": 11285,
      "kind": "line",
      "limit": 11,
      "source": "あなた、そんな縁起でも",
      "target": "亲爱的，别说这么"
    },
    {
      "offset": 11313,
      "kind": "line",
      "limit": 11,
      "source": "ないことを…。",
      "target": "不吉利的话…"
    },
    {
      "offset": 11335,
      "kind": "line",
      "limit": 10,
      "source": "いや、しかし慧美にも",
      "target": "不过，也让慧美"
    },
    {
      "offset": 11381,
      "kind": "line",
      "limit": 10,
      "source": "心配をかけたな…。",
      "target": "担心了…"
    },
    {
      "offset": 11407,
      "kind": "line",
      "limit": 7,
      "source": "そうですね…。",
      "target": "是啊…"
    },
    {
      "offset": 11427,
      "kind": "line",
      "limit": 11,
      "source": "あの子も、ずいぶんと",
      "target": "那孩子也一直"
    },
    {
      "offset": 11453,
      "kind": "line",
      "limit": 11,
      "source": "気に病んでいましたし。",
      "target": "为此烦恼。"
    },
    {
      "offset": 11481,
      "kind": "line",
      "limit": 11,
      "source": "思い詰めて、悪いことに",
      "target": "我还担心她钻牛角尖，"
    },
    {
      "offset": 11509,
      "kind": "line",
      "limit": 11,
      "source": "手を出したりしないか",
      "target": "做出什么坏事"
    },
    {
      "offset": 11535,
      "kind": "line",
      "limit": 11,
      "source": "心配でしたから…。",
      "target": "来…"
    },
    {
      "offset": 11561,
      "kind": "line",
      "limit": 10,
      "source": "いや、まさかあの子に",
      "target": "不，唯独那孩子"
    },
    {
      "offset": 11587,
      "kind": "line",
      "limit": 10,
      "source": "限ってそんな真似は…",
      "target": "不可能那么做…"
    },
    {
      "offset": 11653,
      "kind": "line",
      "limit": 9,
      "source": "１９９６年６月某日",
      "target": "１９９６年６月某日"
    },
    {
      "offset": 11677,
      "kind": "line",
      "limit": 9,
      "source": "天気、雨",
      "target": "天气：雨"
    },
    {
      "offset": 11691,
      "kind": "line",
      "limit": 9,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 11710,
      "kind": "line",
      "limit": 9,
      "source": "癸生川探偵事務所前",
      "target": "癸生川侦探事务所前"
    },
    {
      "offset": 11790,
      "kind": "line",
      "limit": 4,
      "source": "ふう…。",
      "target": "呼…"
    },
    {
      "offset": 11806,
      "kind": "line",
      "limit": 11,
      "source": "…依頼をキャンセルする",
      "target": "…为了取消委托，"
    },
    {
      "offset": 11834,
      "kind": "line",
      "limit": 11,
      "source": "ために、とりあえず",
      "target": "我姑且又回来"
    },
    {
      "offset": 11858,
      "kind": "line",
      "limit": 11,
      "source": "戻って来てみたけど…",
      "target": "了一趟…"
    },
    {
      "offset": 11884,
      "kind": "line",
      "limit": 11,
      "source": "一度頼んでおいて断ると",
      "target": "可委托过后再来拒绝，"
    },
    {
      "offset": 11912,
      "kind": "line",
      "limit": 11,
      "source": "いうのは、どうも気が",
      "target": "总觉得有些"
    },
    {
      "offset": 11938,
      "kind": "line",
      "limit": 11,
      "source": "引けるものだ…。",
      "target": "过意不去…"
    },
    {
      "offset": 11960,
      "kind": "line",
      "limit": 11,
      "source": "それにもし本当に調査を",
      "target": "况且，如果他们真的"
    },
    {
      "offset": 11988,
      "kind": "line",
      "limit": 11,
      "source": "してくれているなら…",
      "target": "已经展开调查…"
    },
    {
      "offset": 12014,
      "kind": "line",
      "limit": 10,
      "source": "それはそれで、任せて",
      "target": "那就继续交给他们"
    },
    {
      "offset": 12040,
      "kind": "line",
      "limit": 10,
      "source": "おいた方がいいし…。",
      "target": "也好…"
    },
    {
      "offset": 12066,
      "kind": "line",
      "limit": 3,
      "source": "…と。",
      "target": "…唉。"
    },
    {
      "offset": 12078,
      "kind": "line",
      "limit": 11,
      "source": "私はふたたび、この",
      "target": "我就这样再次"
    },
    {
      "offset": 12102,
      "kind": "line",
      "limit": 11,
      "source": "事務所の前でウロウロと",
      "target": "在事务所门前徘徊"
    },
    {
      "offset": 12130,
      "kind": "line",
      "limit": 11,
      "source": "することになっていた。",
      "target": "起来。"
    },
    {
      "offset": 12161,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 12173,
      "kind": "line",
      "limit": 7,
      "source": "…いや、でも。",
      "target": "…不，可是。"
    },
    {
      "offset": 12193,
      "kind": "line",
      "limit": 10,
      "source": "今頃、探偵の白鷺洲",
      "target": "现在，那位侦探"
    },
    {
      "offset": 12234,
      "kind": "line",
      "limit": 10,
      "source": "さんは、きっと調査に",
      "target": "白鹭洲先生一定"
    },
    {
      "offset": 12260,
      "kind": "line",
      "limit": 10,
      "source": "出ているに違いない。",
      "target": "出门调查了。"
    },
    {
      "offset": 12288,
      "kind": "line",
      "limit": 10,
      "source": "…そうだ。",
      "target": "…对。"
    },
    {
      "offset": 12304,
      "kind": "line",
      "limit": 10,
      "source": "いないなら、断れなく",
      "target": "既然不在，没法取消"
    },
    {
      "offset": 12330,
      "kind": "line",
      "limit": 10,
      "source": "ても仕方がないな。",
      "target": "也是没办法的事。"
    },
    {
      "offset": 12356,
      "kind": "line",
      "limit": 8,
      "source": "…よし、これだ。",
      "target": "…好，就这样。"
    },
    {
      "offset": 12397,
      "kind": "line",
      "limit": 8,
      "source": "私は変な理屈で",
      "target": "我用这种怪道理"
    },
    {
      "offset": 12417,
      "kind": "line",
      "limit": 8,
      "source": "自分を納得させ…",
      "target": "说服自己…"
    },
    {
      "offset": 12439,
      "kind": "line",
      "limit": 10,
      "source": "誰も出るなと心で思い",
      "target": "心里想着千万别有人"
    },
    {
      "offset": 12465,
      "kind": "line",
      "limit": 10,
      "source": "ながら、事務所のイン",
      "target": "回应，同时按下了"
    },
    {
      "offset": 12491,
      "kind": "line",
      "limit": 10,
      "source": "ターホンを押した。",
      "target": "事务所门铃。"
    },
    {
      "offset": 12531,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 12559,
      "kind": "line",
      "limit": 8,
      "source": "…………………。",
      "target": "…………………"
    },
    {
      "offset": 12595,
      "kind": "line",
      "limit": 10,
      "source": "…よし、いないか…。",
      "target": "…好，没人…"
    },
    {
      "offset": 12623,
      "kind": "line",
      "limit": 9,
      "source": "…と、思った瞬間。",
      "target": "…就在我这么想时。"
    },
    {
      "offset": 12656,
      "kind": "line",
      "limit": 8,
      "source": "…あい、どーぞ。",
      "target": "…哎，请进。"
    },
    {
      "offset": 12680,
      "kind": "line",
      "limit": 10,
      "source": "中から、やる気のない",
      "target": "里面传来一句"
    },
    {
      "offset": 12706,
      "kind": "line",
      "limit": 10,
      "source": "返事が聞こえてきた。",
      "target": "有气无力的回应。"
    },
    {
      "offset": 12732,
      "kind": "line",
      "limit": 8,
      "source": "ああ、しまった、",
      "target": "糟了，"
    },
    {
      "offset": 12754,
      "kind": "line",
      "limit": 8,
      "source": "誰かいたのか…。",
      "target": "原来有人…"
    },
    {
      "offset": 12776,
      "kind": "line",
      "limit": 11,
      "source": "…さっきの白鷺洲さんの",
      "target": "…刚才白鹭洲先生的"
    },
    {
      "offset": 12826,
      "kind": "line",
      "limit": 11,
      "source": "声ではないようだけど…",
      "target": "声音好像不太一样…"
    },
    {
      "offset": 12854,
      "kind": "line",
      "limit": 10,
      "source": "でも返事があったの",
      "target": "可既然有人回应，"
    },
    {
      "offset": 12878,
      "kind": "line",
      "limit": 10,
      "source": "だから、仕方がない。",
      "target": "那就没办法了。"
    },
    {
      "offset": 12904,
      "kind": "line",
      "limit": 9,
      "source": "私はドアを開けて、",
      "target": "我打开门，"
    },
    {
      "offset": 12928,
      "kind": "line",
      "limit": 9,
      "source": "部屋に入った。",
      "target": "走进房间。"
    },
    {
      "offset": 12965,
      "kind": "line",
      "limit": 8,
      "source": "…失礼します…。",
      "target": "…打扰了…"
    },
    {
      "offset": 12989,
      "kind": "line",
      "limit": 10,
      "source": "さっきと変わらぬ",
      "target": "我环顾着与刚才"
    },
    {
      "offset": 13011,
      "kind": "line",
      "limit": 10,
      "source": "汚い部屋を見回すと…",
      "target": "一样脏乱的房间…"
    },
    {
      "offset": 13037,
      "kind": "line",
      "limit": 11,
      "source": "奥から、この部屋と",
      "target": "一个仿佛与这房间"
    },
    {
      "offset": 13061,
      "kind": "line",
      "limit": 11,
      "source": "うまく馴染ませたような",
      "target": "融为一体，"
    },
    {
      "offset": 13089,
      "kind": "line",
      "limit": 11,
      "source": "小汚い風体の…",
      "target": "邋里邋遢的…"
    },
    {
      "offset": 13131,
      "kind": "line",
      "limit": 8,
      "source": "やけに長身の男が",
      "target": "高得出奇的男人"
    },
    {
      "offset": 13153,
      "kind": "line",
      "limit": 8,
      "source": "のそっと現れた。",
      "target": "从里面缓缓现身。"
    },
    {
      "offset": 13192,
      "kind": "line",
      "limit": 11,
      "source": "…誰だ君は。",
      "target": "…你是谁。"
    },
    {
      "offset": 13210,
      "kind": "line",
      "limit": 11,
      "source": "もしかして依頼人か!?",
      "target": "难道是委托人！？"
    },
    {
      "offset": 13238,
      "kind": "line",
      "limit": 5,
      "source": "えっ…!?",
      "target": "咦…！？"
    },
    {
      "offset": 13252,
      "kind": "line",
      "limit": 11,
      "source": "いや、あの…どちらかと",
      "target": "不，那个…硬要说"
    },
    {
      "offset": 13280,
      "kind": "line",
      "limit": 11,
      "source": "言えば、その逆で…。",
      "target": "的话，正相反…",
      "runs": [
        "的话，",
        "正相反…"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "言えば、その"
        },
        {
          "colour": 2,
          "text": "逆で…。"
        }
      ]
    },
    {
      "offset": 13321,
      "kind": "line",
      "limit": 11,
      "source": "…そうか。",
      "target": "…这样啊。"
    },
    {
      "offset": 13337,
      "kind": "line",
      "limit": 11,
      "source": "依頼をしたけど",
      "target": "你委托了调查，"
    },
    {
      "offset": 13357,
      "kind": "line",
      "limit": 11,
      "source": "取り消しに来たんだな。",
      "target": "但来取消了吧。"
    },
    {
      "offset": 13387,
      "kind": "line",
      "limit": 9,
      "source": "あっ…はい、はい。",
      "target": "啊…对，对。"
    },
    {
      "offset": 13411,
      "kind": "line",
      "limit": 9,
      "source": "そ、そうです。",
      "target": "就、就是这样。"
    },
    {
      "offset": 13433,
      "kind": "line",
      "limit": 8,
      "source": "…これは驚いた。",
      "target": "…真让人吃惊。"
    },
    {
      "offset": 13455,
      "kind": "line",
      "limit": 11,
      "source": "自分で言って、これでは",
      "target": "我自己都觉得刚才"
    },
    {
      "offset": 13483,
      "kind": "line",
      "limit": 11,
      "source": "伝わらないと思ったが…",
      "target": "那样说传达不了意思…"
    },
    {
      "offset": 13511,
      "kind": "line",
      "limit": 8,
      "source": "なんて察しのいい",
      "target": "他却领会得"
    },
    {
      "offset": 13533,
      "kind": "line",
      "limit": 8,
      "source": "人なんだろう。",
      "target": "如此之快。"
    },
    {
      "offset": 13555,
      "kind": "line",
      "limit": 5,
      "source": "おおかた…",
      "target": "大概是…"
    },
    {
      "offset": 13571,
      "kind": "line",
      "limit": 10,
      "source": "こんな得体の知れない",
      "target": "这种来历不明的"
    },
    {
      "offset": 13617,
      "kind": "line",
      "limit": 10,
      "source": "探偵事務所に頼んで、",
      "target": "侦探事务所，委托它"
    },
    {
      "offset": 13643,
      "kind": "line",
      "limit": 10,
      "source": "本当に大丈夫なのか…",
      "target": "真的不要紧吗…"
    },
    {
      "offset": 13669,
      "kind": "line",
      "limit": 11,
      "source": "…と、言われて来たな。",
      "target": "…有人这么说吧。"
    },
    {
      "offset": 13748,
      "kind": "line",
      "limit": 4,
      "source": "うっ…。",
      "target": "呃…"
    },
    {
      "offset": 13764,
      "kind": "line",
      "limit": 11,
      "source": "な、なんだ、この男は…",
      "target": "这、这个男人怎么回事…"
    },
    {
      "offset": 13792,
      "kind": "line",
      "limit": 10,
      "source": "まさか人の心が読める",
      "target": "难道他会读心"
    },
    {
      "offset": 13818,
      "kind": "line",
      "limit": 10,
      "source": "んじゃなかろうか…。",
      "target": "不成…"
    },
    {
      "offset": 13844,
      "kind": "line",
      "limit": 11,
      "source": "私はたった２～３の",
      "target": "短短两三句话，"
    },
    {
      "offset": 13868,
      "kind": "line",
      "limit": 11,
      "source": "言葉で、すっかり彼の",
      "target": "我便彻底被带进"
    },
    {
      "offset": 13894,
      "kind": "line",
      "limit": 11,
      "source": "ペースに呑まれていた。",
      "target": "了他的节奏。"
    },
    {
      "offset": 13954,
      "kind": "choice",
      "limit": 0,
      "source": "話す",
      "target": "交谈"
    },
    {
      "offset": 13962,
      "kind": "choice",
      "limit": 0,
      "source": "調べる",
      "target": "调查"
    },
