{
  "script": "c4_00",
  "batch": "c4_00.part2.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 5088,
      "kind": "line",
      "limit": 11,
      "source": "惚れていたんだろう。",
      "target": "着绫子。"
    },
    {
      "offset": 5120,
      "kind": "line",
      "limit": 6,
      "source": "自分だけは…",
      "target": "我始终相信…"
    },
    {
      "offset": 5138,
      "kind": "line",
      "limit": 9,
      "source": "自分に対してだけは",
      "target": "她唯独对我"
    },
    {
      "offset": 5162,
      "kind": "line",
      "limit": 9,
      "source": "違うんだと…信じて",
      "target": "是不一样的…"
    },
    {
      "offset": 5186,
      "kind": "line",
      "limit": 9,
      "source": "疑わなかった。",
      "target": "我对此深信不疑。"
    },
    {
      "offset": 5206,
      "kind": "line",
      "limit": 11,
      "source": "何かやむを得ない事情が",
      "target": "她一定是有着"
    },
    {
      "offset": 5234,
      "kind": "line",
      "limit": 11,
      "source": "あってやっているに",
      "target": "某些不得已的苦衷，"
    },
    {
      "offset": 5258,
      "kind": "line",
      "limit": 11,
      "source": "違いない…と。",
      "target": "才会这么做…"
    },
    {
      "offset": 5278,
      "kind": "line",
      "limit": 9,
      "source": "だから、調査の件は",
      "target": "所以调查一事"
    },
    {
      "offset": 5302,
      "kind": "line",
      "limit": 9,
      "source": "綾子には隠し…",
      "target": "我瞒着绫子…"
    },
    {
      "offset": 5322,
      "kind": "line",
      "limit": 11,
      "source": "自分は、黙って綾子を",
      "target": "决定默默地"
    },
    {
      "offset": 5348,
      "kind": "line",
      "limit": 11,
      "source": "信じようと決めたのだ。",
      "target": "相信她。"
    },
    {
      "offset": 5378,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "…………"
    },
    {
      "offset": 5394,
      "kind": "line",
      "limit": 9,
      "source": "…ちょうど、",
      "target": "…就在"
    },
    {
      "offset": 5412,
      "kind": "line",
      "limit": 9,
      "source": "そんな頃だったよ。",
      "target": "那段时间。"
    },
    {
      "offset": 5436,
      "kind": "line",
      "limit": 11,
      "source": "綾子が突然、泣きながら",
      "target": "绫子突然哭着"
    },
    {
      "offset": 5464,
      "kind": "line",
      "limit": 11,
      "source": "私に言ってきたんだ。",
      "target": "对我说。"
    },
    {
      "offset": 5492,
      "kind": "line",
      "limit": 7,
      "source": "妊娠した…と。",
      "target": "说她怀孕了。"
    },
    {
      "offset": 5520,
      "kind": "line",
      "limit": 3,
      "source": "…!!",
      "target": "…！！"
    },
    {
      "offset": 5553,
      "kind": "line",
      "limit": 5,
      "source": "…そして。",
      "target": "…然后。"
    },
    {
      "offset": 5569,
      "kind": "line",
      "limit": 8,
      "source": "それからの話は、",
      "target": "之后的事情，"
    },
    {
      "offset": 5591,
      "kind": "line",
      "limit": 8,
      "source": "次の通りだった。",
      "target": "经过是这样的。"
    },
    {
      "offset": 5616,
      "kind": "line",
      "limit": 11,
      "source": "忠雄は、その妊娠を期に",
      "target": "忠雄便以怀孕为契机"
    },
    {
      "offset": 5644,
      "kind": "line",
      "limit": 11,
      "source": "結婚しようと、綾子に",
      "target": "向绫子提出"
    },
    {
      "offset": 5670,
      "kind": "line",
      "limit": 11,
      "source": "持ち掛けた。",
      "target": "结婚。"
    },
    {
      "offset": 5688,
      "kind": "line",
      "limit": 11,
      "source": "…しかし綾子は、お金が",
      "target": "…可是绫子说，"
    },
    {
      "offset": 5716,
      "kind": "line",
      "limit": 11,
      "source": "ないから、結婚しても",
      "target": "两人没有钱，"
    },
    {
      "offset": 5742,
      "kind": "line",
      "limit": 11,
      "source": "養っていけないと言って",
      "target": "就算结婚也养不起"
    },
    {
      "offset": 5770,
      "kind": "line",
      "limit": 11,
      "source": "断った。",
      "target": "孩子，拒绝了。"
    },
    {
      "offset": 5784,
      "kind": "line",
      "limit": 11,
      "source": "しかも、忠雄に多額の",
      "target": "而且忠雄背负着"
    },
    {
      "offset": 5810,
      "kind": "line",
      "limit": 11,
      "source": "借金がある身だという",
      "target": "巨额债务，"
    },
    {
      "offset": 5836,
      "kind": "line",
      "limit": 11,
      "source": "理由から、なかなか言い",
      "target": "她因此迟迟无法"
    },
    {
      "offset": 5864,
      "kind": "line",
      "limit": 11,
      "source": "出せず…もう妊娠５ヶ月",
      "target": "开口…那时已经"
    },
    {
      "offset": 5898,
      "kind": "line",
      "limit": 11,
      "source": "になっていたらしい。",
      "target": "怀孕五个月了。"
    },
    {
      "offset": 5924,
      "kind": "line",
      "limit": 10,
      "source": "…そう簡単に堕ろせる",
      "target": "…已经不是能轻易"
    },
    {
      "offset": 5966,
      "kind": "line",
      "limit": 10,
      "source": "状態でもない。",
      "target": "堕胎的阶段了。"
    },
    {
      "offset": 5986,
      "kind": "line",
      "limit": 10,
      "source": "しかし…",
      "target": "可是…"
    },
    {
      "offset": 6000,
      "kind": "line",
      "limit": 11,
      "source": "「気持ちだけでは、",
      "target": "“世上有很多事，"
    },
    {
      "offset": 6024,
      "kind": "line",
      "limit": 11,
      "source": "どうにもならないことが",
      "target": "只凭感情"
    },
    {
      "offset": 6052,
      "kind": "line",
      "limit": 11,
      "source": "たくさんあるから…」",
      "target": "是解决不了的…”"
    },
    {
      "offset": 6078,
      "kind": "line",
      "limit": 11,
      "source": "…それが、綾子の言い分",
      "target": "…这就是绫子的"
    },
    {
      "offset": 6106,
      "kind": "line",
      "limit": 11,
      "source": "だった。",
      "target": "说法。"
    },
    {
      "offset": 6123,
      "kind": "line",
      "limit": 11,
      "source": "今、思い切って堕ろして",
      "target": "她说，现在狠下心"
    },
    {
      "offset": 6167,
      "kind": "line",
      "limit": 11,
      "source": "しまった方が、結果的に",
      "target": "把孩子打掉，反而"
    },
    {
      "offset": 6195,
      "kind": "line",
      "limit": 11,
      "source": "お金はかからなくて",
      "target": "不用花太多钱，"
    },
    {
      "offset": 6219,
      "kind": "line",
      "limit": 11,
      "source": "済むから、中絶手術の",
      "target": "所以希望忠雄只出"
    },
    {
      "offset": 6251,
      "kind": "line",
      "limit": 11,
      "source": "の費用だけ出して欲しい",
      "target": "堕胎手术的费用"
    },
    {
      "offset": 6279,
      "kind": "line",
      "limit": 11,
      "source": "…と、頼んできた。",
      "target": "…她如此请求。"
    },
    {
      "offset": 6306,
      "kind": "line",
      "limit": 11,
      "source": "…ひとまずその話は",
      "target": "…忠雄暂时没有"
    },
    {
      "offset": 6330,
      "kind": "line",
      "limit": 11,
      "source": "持ち帰り、忠雄は親戚に",
      "target": "答复，回去向亲戚"
    },
    {
      "offset": 6358,
      "kind": "line",
      "limit": 11,
      "source": "相談した。",
      "target": "商量。"
    },
    {
      "offset": 6374,
      "kind": "line",
      "limit": 11,
      "source": "すると、詐欺師だと",
      "target": "亲戚们早已认定"
    },
    {
      "offset": 6398,
      "kind": "line",
      "limit": 11,
      "source": "思っている親戚は、口を",
      "target": "她是骗子，异口同声"
    },
    {
      "offset": 6426,
      "kind": "line",
      "limit": 11,
      "source": "揃えて「妊娠なんて絶対",
      "target": "地说“怀孕绝对是"
    },
    {
      "offset": 6454,
      "kind": "line",
      "limit": 11,
      "source": "ウソだ」と言い…金は",
      "target": "谎话”…并让他"
    },
    {
      "offset": 6486,
      "kind": "line",
      "limit": 11,
      "source": "渡すなと言う。",
      "target": "一分钱也别给。"
    },
    {
      "offset": 6509,
      "kind": "line",
      "limit": 11,
      "source": "…そうして、迷って",
      "target": "…就在他犹豫"
    },
    {
      "offset": 6533,
      "kind": "line",
      "limit": 11,
      "source": "いる時だった。",
      "target": "不决时。"
    },
    {
      "offset": 6560,
      "kind": "line",
      "limit": 11,
      "source": "綾子が交通事故に遭い、",
      "target": "绫子遭遇车祸，",
      "runs": [
        "绫子",
        "遭遇车祸，"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "綾子が"
        },
        {
          "colour": 2,
          "text": "交通事故に遭い、"
        }
      ]
    },
    {
      "offset": 6601,
      "kind": "line",
      "limit": 11,
      "source": "意識不明の重体となって",
      "target": "重伤昏迷，"
    },
    {
      "offset": 6629,
      "kind": "line",
      "limit": 11,
      "source": "緊急入院した、という",
      "target": "被紧急送进医院——"
    },
    {
      "offset": 6655,
      "kind": "line",
      "limit": 11,
      "source": "連絡が入ったのだ。",
      "target": "他收到了消息。"
    },
    {
      "offset": 6708,
      "kind": "line",
      "limit": 11,
      "source": "全身に渡る打撲、骨折、",
      "target": "她全身挫伤、骨折，"
    },
    {
      "offset": 6736,
      "kind": "line",
      "limit": 11,
      "source": "裂傷で…辛うじて命を",
      "target": "还有多处撕裂伤…"
    },
    {
      "offset": 6762,
      "kind": "line",
      "limit": 11,
      "source": "繋ぎ止めている状態",
      "target": "勉强维持着"
    },
    {
      "offset": 6786,
      "kind": "line",
      "limit": 11,
      "source": "だった。",
      "target": "生命。"
    },
    {
      "offset": 6800,
      "kind": "line",
      "limit": 10,
      "source": "このままでは、お腹の",
      "target": "这样下去，腹中的"
    },
    {
      "offset": 6826,
      "kind": "line",
      "limit": 10,
      "source": "子供も危ういという",
      "target": "孩子恐怕也很危险，"
    },
    {
      "offset": 6850,
      "kind": "line",
      "limit": 10,
      "source": "報告もされた。",
      "target": "他也收到了报告。"
    },
    {
      "offset": 6870,
      "kind": "line",
      "limit": 11,
      "source": "…つまり、少なくとも",
      "target": "…也就是说，至少"
    },
    {
      "offset": 6896,
      "kind": "line",
      "limit": 11,
      "source": "妊娠をしたということは",
      "target": "她怀孕这件事"
    },
    {
      "offset": 6924,
      "kind": "line",
      "limit": 11,
      "source": "真実だったのだ。",
      "target": "是真的。"
    },
    {
      "offset": 6946,
      "kind": "line",
      "limit": 11,
      "source": "しかし探偵からの報告に",
      "target": "但侦探的报告称，"
    },
    {
      "offset": 6974,
      "kind": "line",
      "limit": 11,
      "source": "よれば、その子が本当に",
      "target": "那孩子到底是不是"
    },
    {
      "offset": 7008,
      "kind": "line",
      "limit": 11,
      "source": "忠雄の子なのかどうかは",
      "target": "忠雄亲生的，"
    },
    {
      "offset": 7036,
      "kind": "line",
      "limit": 11,
      "source": "怪しいらしい。",
      "target": "恐怕很可疑。"
    },
    {
      "offset": 7059,
      "kind": "line",
      "limit": 11,
      "source": "時は一刻を争っている。",
      "target": "此事刻不容缓。"
    },
    {
      "offset": 7087,
      "kind": "line",
      "limit": 11,
      "source": "…このまま、他人として",
      "target": "…即使把她当作外人"
    },
    {
      "offset": 7115,
      "kind": "line",
      "limit": 11,
      "source": "放っておいたとしても、",
      "target": "就这样放着不管，"
    },
    {
      "offset": 7143,
      "kind": "line",
      "limit": 11,
      "source": "医師は最低限の治療は",
      "target": "医生也会进行"
    },
    {
      "offset": 7169,
      "kind": "line",
      "limit": 11,
      "source": "行うだろう。",
      "target": "最低限度的治疗。"
    },
    {
      "offset": 7187,
      "kind": "line",
      "limit": 11,
      "source": "しかしそれでは、綾子が",
      "target": "可那样一来，绫子"
    },
    {
      "offset": 7215,
      "kind": "line",
      "limit": 11,
      "source": "本当に助かるかどうかは",
      "target": "究竟能不能活下来"
    },
    {
      "offset": 7243,
      "kind": "line",
      "limit": 11,
      "source": "わからないし…まず、",
      "target": "还是未知数…而且"
    },
    {
      "offset": 7275,
      "kind": "line",
      "limit": 11,
      "source": "間違いなくお腹の子供は",
      "target": "腹中的孩子必定"
    },
    {
      "offset": 7303,
      "kind": "line",
      "limit": 11,
      "source": "見殺しにされる。",
      "target": "会被见死不救。"
    },
    {
      "offset": 7325,
      "kind": "line",
      "limit": 11,
      "source": "胎内に子供がいるだけで",
      "target": "仅仅怀着孩子，"
    },
    {
      "offset": 7353,
      "kind": "line",
      "limit": 11,
      "source": "母体への負担は相当な",
      "target": "就会给母体带来"
    },
    {
      "offset": 7379,
      "kind": "line",
      "limit": 11,
      "source": "ものになる。",
      "target": "很大的负担。"
    },
    {
      "offset": 7397,
      "kind": "line",
      "limit": 11,
      "source": "綾子を助ける可能性を",
      "target": "为了提高绫子"
    },
    {
      "offset": 7423,
      "kind": "line",
      "limit": 11,
      "source": "上げるためにも、子供は",
      "target": "获救的可能，孩子"
    },
    {
      "offset": 7460,
      "kind": "line",
      "limit": 11,
      "source": "諦めるよう、医者も",
      "target": "也应放弃——医生这样"
    },
    {
      "offset": 7497,
      "kind": "line",
      "limit": 11,
      "source": "薦めていたからだ。",
      "target": "建议。"
    },
    {
      "offset": 7531,
      "kind": "line",
      "limit": 10,
      "source": "…そして、忠雄は",
      "target": "…最后，忠雄"
    },
    {
      "offset": 7553,
      "kind": "line",
      "limit": 10,
      "source": "決断した。",
      "target": "作出了决定。"
    },
    {
      "offset": 7569,
      "kind": "line",
      "limit": 10,
      "source": "何があっても、母子",
      "target": "无论如何，要让母子",
      "runs": [
        "无论如何，要让",
        "母子"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "何があっても、"
        },
        {
          "colour": 2,
          "text": "母子"
        }
      ]
    },
    {
      "offset": 7600,
      "kind": "line",
      "limit": 10,
      "source": "ともに助けよう…と。",
      "target": "都活下来…"
    },
    {
      "offset": 7650,
      "kind": "line",
      "limit": 9,
      "source": "それから、忠雄は…",
      "target": "此后，忠雄…"
    },
    {
      "offset": 7674,
      "kind": "line",
      "limit": 11,
      "source": "腕のいい医師を探し、",
      "target": "找来医术高明的医生，"
    },
    {
      "offset": 7700,
      "kind": "line",
      "limit": 11,
      "source": "転院させ、集中治療室へ",
      "target": "让她转院，送进"
    },
    {
      "offset": 7728,
      "kind": "line",
      "limit": 11,
      "source": "入れ…あらゆる手を",
      "target": "重症监护室…又动用"
    },
    {
      "offset": 7758,
      "kind": "line",
      "limit": 11,
      "source": "使い、少しでも助かる",
      "target": "各种手段，寻找哪怕"
    },
    {
      "offset": 7784,
      "kind": "line",
      "limit": 11,
      "source": "道を選んだ。",
      "target": "一线生机。"
    },
    {
      "offset": 7802,
      "kind": "line",
      "limit": 11,
      "source": "綾子の家族は、まったく",
      "target": "绫子的家人完全"
    },
    {
      "offset": 7830,
      "kind": "line",
      "limit": 11,
      "source": "アテにできなかった。",
      "target": "指望不上。"
    },
    {
      "offset": 7856,
      "kind": "line",
      "limit": 11,
      "source": "どこで何をしているの",
      "target": "他们在哪里、"
    },
    {
      "offset": 7882,
      "kind": "line",
      "limit": 11,
      "source": "かも、わからない。",
      "target": "做什么都不知道。"
    },
    {
      "offset": 7906,
      "kind": "line",
      "limit": 11,
      "source": "忠雄は、自身でも必死に",
      "target": "忠雄自己也拼命"
    },
    {
      "offset": 7934,
      "kind": "line",
      "limit": 11,
      "source": "看病し、身の回りの世話",
      "target": "照顾她，继续帮她"
    },
    {
      "offset": 7962,
      "kind": "line",
      "limit": 11,
      "source": "も続けた。",
      "target": "料理生活。"
    },
    {
      "offset": 7981,
      "kind": "line",
      "limit": 11,
      "source": "…そして、帝王切開に",
      "target": "…随后，通过剖宫产"
    },
    {
      "offset": 8007,
      "kind": "line",
      "limit": 11,
      "source": "よって、暁が誕生。",
      "target": "晓出生了。"
    },
    {
      "offset": 8031,
      "kind": "line",
      "limit": 11,
      "source": "母胎と別々に治療する",
      "target": "让母子分开接受治疗，"
    },
    {
      "offset": 8057,
      "kind": "line",
      "limit": 11,
      "source": "ことで、どうにか２人の",
      "target": "设法挽救"
    },
    {
      "offset": 8085,
      "kind": "line",
      "limit": 11,
      "source": "命を救おうという、",
      "target": "两人的生命——"
    },
    {
      "offset": 8109,
      "kind": "line",
      "limit": 11,
      "source": "一か八かの賭けである。",
      "target": "这是一场豪赌。"
    },
    {
      "offset": 8144,
      "kind": "line",
      "limit": 11,
      "source": "…これが大成功だった。",
      "target": "…结果大获成功。"
    },
    {
      "offset": 8175,
      "kind": "line",
      "limit": 10,
      "source": "綾子も順調に回復して",
      "target": "绫子也顺利地"
    },
    {
      "offset": 8201,
      "kind": "line",
      "limit": 10,
      "source": "いき、リハビリの末、",
      "target": "逐渐康复，经复健后，"
    },
    {
      "offset": 8227,
      "kind": "line",
      "limit": 10,
      "source": "大きな後遺症もなく",
      "target": "没留下严重后遗症，"
    },
    {
      "offset": 8251,
      "kind": "line",
      "limit": 10,
      "source": "母子ともに退院した。",
      "target": "母子双双出院。"
    },
    {
      "offset": 8281,
      "kind": "line",
      "limit": 10,
      "source": "…そして綾子は、",
      "target": "…后来，绫子"
    },
    {
      "offset": 8303,
      "kind": "line",
      "limit": 10,
      "source": "自分のしてきた行いを",
      "target": "后悔自己过去的"
    },
    {
      "offset": 8329,
      "kind": "line",
      "limit": 10,
      "source": "悔やみ、忠雄に正直に",
      "target": "所作所为，便向忠雄"
    },
    {
      "offset": 8355,
      "kind": "line",
      "limit": 10,
      "source": "打ち明け、謝罪し…",
      "target": "坦白并道歉…"
    },
    {
      "offset": 8390,
      "kind": "line",
      "limit": 10,
      "source": "…その後、自首をする",
      "target": "…之后，她本打算"
    },
    {
      "offset": 8416,
      "kind": "line",
      "limit": 10,
      "source": "つもりだった。",
      "target": "去自首。"
    },
    {
      "offset": 8436,
      "kind": "line",
      "limit": 10,
      "source": "しかし忠雄は、母親が",
      "target": "可是忠雄说，母亲"
    },
    {
      "offset": 8462,
      "kind": "line",
      "limit": 10,
      "source": "犯罪者では、せっかく",
      "target": "若成了罪犯，这个"
    },
    {
      "offset": 8488,
      "kind": "line",
      "limit": 10,
      "source": "生まれてきたこの子が",
      "target": "好不容易出生的孩子"
    },
    {
      "offset": 8514,
      "kind": "line",
      "limit": 10,
      "source": "可哀相だ、と言い…",
      "target": "未免太可怜了…"
    },
    {
      "offset": 8538,
      "kind": "line",
      "limit": 11,
      "source": "これまで綾子がダマし",
      "target": "于是他将绫子此前"
    },
    {
      "offset": 8564,
      "kind": "line",
      "limit": 11,
      "source": "取った金を全額返金し、",
      "target": "骗走的钱全部退还，"
    },
    {
      "offset": 8592,
      "kind": "line",
      "limit": 11,
      "source": "更に示談金も払うことで",
      "target": "还另外支付和解金，"
    },
    {
      "offset": 8644,
      "kind": "line",
      "limit": 11,
      "source": "どうにか全ての起訴を",
      "target": "设法让所有控告"
    },
    {
      "offset": 8670,
      "kind": "line",
      "limit": 11,
      "source": "取り消させたのだった。",
      "target": "都被撤回了。"
    },
    {
      "offset": 8698,
      "kind": "line",
      "limit": 11,
      "source": "…口で言うのは簡単だが",
      "target": "…说起来容易，"
    },
    {
      "offset": 8726,
      "kind": "line",
      "limit": 11,
      "source": "実際、その交渉はかなり",
      "target": "实际上，那场交涉"
    },
    {
      "offset": 8754,
      "kind": "line",
      "limit": 11,
      "source": "苦労したらしい。",
      "target": "似乎相当艰难。"
    },
    {
      "offset": 8779,
      "kind": "line",
      "limit": 11,
      "source": "…こうして、綾子は",
      "target": "…就这样，绫子"
    },
    {
      "offset": 8803,
      "kind": "line",
      "limit": 11,
      "source": "残りの人生を、恩義ある",
      "target": "决心用余生报答"
    },
    {
      "offset": 8831,
      "kind": "line",
      "limit": 11,
      "source": "忠雄と、息子の暁のため",
      "target": "恩人忠雄，并为了"
    },
    {
      "offset": 8879,
      "kind": "line",
      "limit": 11,
      "source": "に尽くすと心に決め、",
      "target": "儿子晓奉献一切。"
    },
    {
      "offset": 8905,
      "kind": "line",
      "limit": 11,
      "source": "２人は結婚した。",
      "target": "两人结婚了。"
    },
    {
      "offset": 8937,
      "kind": "line",
      "limit": 5,
      "source": "…しかし。",
      "target": "…可是。"
    },
    {
      "offset": 8953,
      "kind": "line",
      "limit": 11,
      "source": "綾子の治療にかかった、",
      "target": "绫子的治疗"
    },
    {
      "offset": 8981,
      "kind": "line",
      "limit": 11,
      "source": "その膨大な治療費、",
      "target": "花费了巨额费用，"
    },
    {
      "offset": 9005,
      "kind": "line",
      "limit": 11,
      "source": "そして示談金の全てを、",
      "target": "连同全部和解金，"
    },
    {
      "offset": 9033,
      "kind": "line",
      "limit": 11,
      "source": "忠雄は負担していた。",
      "target": "都由忠雄负担。"
    },
    {
      "offset": 9059,
      "kind": "line",
      "limit": 11,
      "source": "数々の手を尽くし、",
      "target": "他想尽各种办法，"
    },
    {
      "offset": 9083,
      "kind": "line",
      "limit": 11,
      "source": "闇金融にも手を出して",
      "target": "甚至向高利贷借钱"
    },
    {
      "offset": 9109,
      "kind": "line",
      "limit": 11,
      "source": "工面したその借金は、",
      "target": "凑出的债务，"
    },
    {
      "offset": 9135,
      "kind": "line",
      "limit": 11,
      "source": "法外な利息によって更に",
      "target": "又因高得离谱的利息"
    },
    {
      "offset": 9163,
      "kind": "line",
      "limit": 11,
      "source": "増え続けており…",
      "target": "越滚越多…"
    },
    {
      "offset": 9185,
      "kind": "line",
      "limit": 11,
      "source": "到底、普通に働いて",
      "target": "数额早已不可能"
    },
    {
      "offset": 9209,
      "kind": "line",
      "limit": 11,
      "source": "返済できるような額では",
      "target": "靠普通工作"
    },
    {
      "offset": 9237,
      "kind": "line",
      "limit": 11,
      "source": "なかった。",
      "target": "偿还。"
    },
    {
      "offset": 9262,
      "kind": "line",
      "limit": 11,
      "source": "そして忠雄は、借金",
      "target": "于是忠雄过起了"
    },
    {
      "offset": 9286,
      "kind": "line",
      "limit": 11,
      "source": "返済のためだけの日々を",
      "target": "只为偿还债务而"
    },
    {
      "offset": 9314,
      "kind": "line",
      "limit": 11,
      "source": "過ごすことになった。",
      "target": "奔波的日子。"
    },
    {
      "offset": 9340,
      "kind": "line",
      "limit": 11,
      "source": "更に、そこから母子の",
      "target": "此外，还得设法拿出"
    },
    {
      "offset": 9366,
      "kind": "line",
      "limit": 11,
      "source": "生活費も捻出しなければ",
      "target": "母子二人的生活费。"
    },
    {
      "offset": 9394,
      "kind": "line",
      "limit": 11,
      "source": "ならない。",
      "target": "才行。"
    },
    {
      "offset": 9410,
      "kind": "line",
      "limit": 11,
      "source": "毎日肉体を酷使し続け、",
      "target": "他每天都在透支身体，"
    },
    {
      "offset": 9438,
      "kind": "line",
      "limit": 11,
      "source": "家に帰る間もないくらい",
      "target": "忙得连家都无暇回，"
    },
    {
      "offset": 9466,
      "kind": "line",
      "limit": 11,
      "source": "働き続けた。",
      "target": "一直工作。"
    },
    {
      "offset": 9487,
      "kind": "line",
      "limit": 11,
      "source": "暴力団紛いの人物からも",
      "target": "还被形同黑帮的人"
    },
    {
      "offset": 9515,
      "kind": "line",
      "limit": 11,
      "source": "催促に追われるので…",
      "target": "不断催债…"
    },
    {
      "offset": 9541,
      "kind": "line",
      "limit": 11,
      "source": "綾子と暁に迷惑が及ば",
      "target": "为避免绫子和晓"
    },
    {
      "offset": 9567,
      "kind": "line",
      "limit": 11,
      "source": "ないよう、住所を変えて",
      "target": "受牵连，他还更换"
    },
    {
      "offset": 9595,
      "kind": "line",
      "limit": 11,
      "source": "守ったりもした。",
      "target": "住址来保护他们。"
    },
    {
      "offset": 9620,
      "kind": "line",
      "limit": 10,
      "source": "そんなふうに数年間は",
      "target": "他就这样坚持了"
    },
    {
      "offset": 9646,
      "kind": "line",
      "limit": 10,
      "source": "頑張ったが…それでも",
      "target": "好几年…可身体"
    },
    {
      "offset": 9678,
      "kind": "line",
      "limit": 10,
      "source": "やはり肉体の限界は",
      "target": "终究还是"
    },
    {
      "offset": 9702,
      "kind": "line",
      "limit": 10,
      "source": "やってきた。",
      "target": "到了极限。"
    },
    {
      "offset": 9727,
      "kind": "line",
      "limit": 11,
      "source": "身体を壊し、暴力団から",
      "target": "他累垮了身体，又被"
    },
    {
      "offset": 9755,
      "kind": "line",
      "limit": 11,
      "source": "追われ…もうどうにも",
      "target": "黑帮追债…最终"
    },
    {
      "offset": 9787,
      "kind": "line",
      "limit": 11,
      "source": "ならず、一家心中しか",
      "target": "走投无路，只能全家"
    },
    {
      "offset": 9813,
      "kind": "line",
      "limit": 11,
      "source": "ないという時に、手を",
      "target": "寻死之际，有一个人"
    },
    {
      "offset": 9845,
      "kind": "line",
      "limit": 11,
      "source": "差し延べてくれた人が",
      "target": "向他伸出了"
    },
    {
      "offset": 9871,
      "kind": "line",
      "limit": 11,
      "source": "いたのである。",
      "target": "援手。"
    },
    {
      "offset": 9894,
      "kind": "line",
      "limit": 11,
      "source": "…その人物とは、綾子の",
      "target": "…那个人，是"
    }
  ]
}
