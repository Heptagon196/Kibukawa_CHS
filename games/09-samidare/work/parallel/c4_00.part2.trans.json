{
  "script": "c4_00",
  "units": [
    {"offset": 5088, "target": "着绫子。"},
    {"offset": 5120, "target": "我始终相信…"},
    {"offset": 5138, "target": "她唯独对我"},
    {"offset": 5162, "target": "是不一样的…"},
    {"offset": 5186, "target": "我对此深信不疑。"},
    {"offset": 5206, "target": "她一定是有着"},
    {"offset": 5234, "target": "某些不得已的苦衷，"},
    {"offset": 5258, "target": "才会这么做…"},
    {"offset": 5278, "target": "所以调查一事"},
    {"offset": 5302, "target": "我瞒着绫子…"},
    {"offset": 5322, "target": "决定默默地"},
    {"offset": 5348, "target": "相信她。"},
    {"offset": 5378, "target": "…………"},
    {"offset": 5394, "target": "…就在"},
    {"offset": 5412, "target": "那段时间。"},
    {"offset": 5436, "target": "绫子突然哭着"},
    {"offset": 5464, "target": "对我说。"},
    {"offset": 5492, "target": "说她怀孕了。"},
    {"offset": 5520, "target": "…！！"},
    {"offset": 5553, "target": "…然后。"},
    {"offset": 5569, "target": "之后的事情，"},
    {"offset": 5591, "target": "经过是这样的。"},
    {"offset": 5616, "target": "忠雄便以怀孕为契机"},
    {"offset": 5644, "target": "向绫子提出"},
    {"offset": 5670, "target": "结婚。"},
    {"offset": 5688, "target": "…可是绫子说，"},
    {"offset": 5716, "target": "两人没有钱，"},
    {"offset": 5742, "target": "就算结婚也养不起"},
    {"offset": 5770, "target": "孩子，拒绝了。"},
    {"offset": 5784, "target": "而且忠雄背负着"},
    {"offset": 5810, "target": "巨额债务，"},
    {"offset": 5836, "target": "她因此迟迟无法"},
    {"offset": 5864, "target": "开口…那时已经"},
    {"offset": 5898, "target": "怀孕五个月了。"},
    {"offset": 5924, "target": "…已经不是能轻易"},
    {"offset": 5966, "target": "堕胎的阶段了。"},
    {"offset": 5986, "target": "可是…"},
    {"offset": 6000, "target": "“世上有很多事，"},
    {"offset": 6024, "target": "只凭感情"},
    {"offset": 6052, "target": "是解决不了的…”"},
    {"offset": 6078, "target": "…这就是绫子的"},
    {"offset": 6106, "target": "说法。"},
    {"offset": 6123, "target": "她说，现在狠下心"},
    {"offset": 6167, "target": "把孩子打掉，反而"},
    {"offset": 6195, "target": "不用花太多钱，"},
    {"offset": 6219, "target": "所以希望忠雄只出"},
    {"offset": 6251, "target": "堕胎手术的费用"},
    {"offset": 6279, "target": "…她如此请求。"},
    {"offset": 6306, "target": "…忠雄暂时没有"},
    {"offset": 6330, "target": "答复，回去向亲戚"},
    {"offset": 6358, "target": "商量。"},
    {"offset": 6374, "target": "亲戚们早已认定"},
    {"offset": 6398, "target": "她是骗子，异口同声"},
    {"offset": 6426, "target": "地说“怀孕绝对是"},
    {"offset": 6454, "target": "谎话”…并让他"},
    {"offset": 6486, "target": "一分钱也别给。"},
    {"offset": 6509, "target": "…就在他犹豫"},
    {"offset": 6533, "target": "不决时。"},
    {"offset": 6560, "target": "绫子遭遇车祸，", "runs": ["绫子", "遭遇车祸，"]},
    {"offset": 6601, "target": "重伤昏迷，"},
    {"offset": 6629, "target": "被紧急送进医院——"},
    {"offset": 6655, "target": "他收到了消息。"},
    {"offset": 6708, "target": "她全身挫伤、骨折，"},
    {"offset": 6736, "target": "还有多处撕裂伤…"},
    {"offset": 6762, "target": "勉强维持着"},
    {"offset": 6786, "target": "生命。"},
    {"offset": 6800, "target": "这样下去，腹中的"},
    {"offset": 6826, "target": "孩子恐怕也很危险，"},
    {"offset": 6850, "target": "他也收到了报告。"},
    {"offset": 6870, "target": "…也就是说，至少"},
    {"offset": 6896, "target": "她怀孕这件事"},
    {"offset": 6924, "target": "是真的。"},
    {"offset": 6946, "target": "但侦探的报告称，"},
    {"offset": 6974, "target": "那孩子到底是不是"},
    {"offset": 7008, "target": "忠雄亲生的，"},
    {"offset": 7036, "target": "恐怕很可疑。"},
    {"offset": 7059, "target": "此事刻不容缓。"},
    {"offset": 7087, "target": "…即使把她当作外人"},
    {"offset": 7115, "target": "就这样放着不管，"},
    {"offset": 7143, "target": "医生也会进行"},
    {"offset": 7169, "target": "最低限度的治疗。"},
    {"offset": 7187, "target": "可那样一来，绫子"},
    {"offset": 7215, "target": "究竟能不能活下来"},
    {"offset": 7243, "target": "还是未知数…而且"},
    {"offset": 7275, "target": "腹中的孩子必定"},
    {"offset": 7303, "target": "会被见死不救。"},
    {"offset": 7325, "target": "仅仅怀着孩子，"},
    {"offset": 7353, "target": "就会给母体带来"},
    {"offset": 7379, "target": "很大的负担。"},
    {"offset": 7397, "target": "为了提高绫子"},
    {"offset": 7423, "target": "获救的可能，孩子"},
    {"offset": 7460, "target": "也应放弃——医生这样"},
    {"offset": 7497, "target": "建议。"},
    {"offset": 7531, "target": "…最后，忠雄"},
    {"offset": 7553, "target": "作出了决定。"},
    {"offset": 7569, "target": "无论如何，要让母子", "runs": ["无论如何，要让", "母子"]},
    {"offset": 7600, "target": "都活下来…"},
    {"offset": 7650, "target": "此后，忠雄…"},
    {"offset": 7674, "target": "找来医术高明的医生，"},
    {"offset": 7700, "target": "让她转院，送进"},
    {"offset": 7728, "target": "重症监护室…又动用"},
    {"offset": 7758, "target": "各种手段，寻找哪怕"},
    {"offset": 7784, "target": "一线生机。"},
    {"offset": 7802, "target": "绫子的家人完全"},
    {"offset": 7830, "target": "指望不上。"},
    {"offset": 7856, "target": "他们在哪里、"},
    {"offset": 7882, "target": "做什么都不知道。"},
    {"offset": 7906, "target": "忠雄自己也拼命"},
    {"offset": 7934, "target": "照顾她，继续帮她"},
    {"offset": 7962, "target": "料理生活。"},
    {"offset": 7981, "target": "…随后，通过剖宫产"},
    {"offset": 8007, "target": "晓出生了。"},
    {"offset": 8031, "target": "让母子分开接受治疗，"},
    {"offset": 8057, "target": "设法挽救"},
    {"offset": 8085, "target": "两人的生命——"},
    {"offset": 8109, "target": "这是一场豪赌。"},
    {"offset": 8144, "target": "…结果大获成功。"},
    {"offset": 8175, "target": "绫子也顺利地"},
    {"offset": 8201, "target": "逐渐康复，经复健后，"},
    {"offset": 8227, "target": "没留下严重后遗症，"},
    {"offset": 8251, "target": "母子双双出院。"},
    {"offset": 8281, "target": "…后来，绫子"},
    {"offset": 8303, "target": "后悔自己过去的"},
    {"offset": 8329, "target": "所作所为，便向忠雄"},
    {"offset": 8355, "target": "坦白并道歉…"},
    {"offset": 8390, "target": "…之后，她本打算"},
    {"offset": 8416, "target": "去自首。"},
    {"offset": 8436, "target": "可是忠雄说，母亲"},
    {"offset": 8462, "target": "若成了罪犯，这个"},
    {"offset": 8488, "target": "好不容易出生的孩子"},
    {"offset": 8514, "target": "未免太可怜了…"},
    {"offset": 8538, "target": "于是他将绫子此前"},
    {"offset": 8564, "target": "骗走的钱全部退还，"},
    {"offset": 8592, "target": "还另外支付和解金，"},
    {"offset": 8644, "target": "设法让所有控告"},
    {"offset": 8670, "target": "都被撤回了。"},
    {"offset": 8698, "target": "…说起来容易，"},
    {"offset": 8726, "target": "实际上，那场交涉"},
    {"offset": 8754, "target": "似乎相当艰难。"},
    {"offset": 8779, "target": "…就这样，绫子"},
    {"offset": 8803, "target": "决心用余生报答"},
    {"offset": 8831, "target": "恩人忠雄，并为了"},
    {"offset": 8879, "target": "儿子晓奉献一切。"},
    {"offset": 8905, "target": "两人结婚了。"},
    {"offset": 8937, "target": "…可是。"},
    {"offset": 8953, "target": "绫子的治疗"},
    {"offset": 8981, "target": "花费了巨额费用，"},
    {"offset": 9005, "target": "连同全部和解金，"},
    {"offset": 9033, "target": "都由忠雄负担。"},
    {"offset": 9059, "target": "他想尽各种办法，"},
    {"offset": 9083, "target": "甚至向高利贷借钱"},
    {"offset": 9109, "target": "凑出的债务，"},
    {"offset": 9135, "target": "又因高得离谱的利息"},
    {"offset": 9163, "target": "越滚越多…"},
    {"offset": 9185, "target": "数额早已不可能"},
    {"offset": 9209, "target": "靠普通工作"},
    {"offset": 9237, "target": "偿还。"},
    {"offset": 9262, "target": "于是忠雄过起了"},
    {"offset": 9286, "target": "只为偿还债务而"},
    {"offset": 9314, "target": "奔波的日子。"},
    {"offset": 9340, "target": "此外，还得设法拿出"},
    {"offset": 9366, "target": "母子二人的生活费。"},
    {"offset": 9394, "target": "才行。"},
    {"offset": 9410, "target": "他每天都在透支身体，"},
    {"offset": 9438, "target": "忙得连家都无暇回，"},
    {"offset": 9466, "target": "一直工作。"},
    {"offset": 9487, "target": "还被形同黑帮的人"},
    {"offset": 9515, "target": "不断催债…"},
    {"offset": 9541, "target": "为避免绫子和晓"},
    {"offset": 9567, "target": "受牵连，他还更换"},
    {"offset": 9595, "target": "住址来保护他们。"},
    {"offset": 9620, "target": "他就这样坚持了"},
    {"offset": 9646, "target": "好几年…可身体"},
    {"offset": 9678, "target": "终究还是"},
    {"offset": 9702, "target": "到了极限。"},
    {"offset": 9727, "target": "他累垮了身体，又被"},
    {"offset": 9755, "target": "黑帮追债…最终"},
    {"offset": 9787, "target": "走投无路，只能全家"},
    {"offset": 9813, "target": "寻死之际，有一个人"},
    {"offset": 9845, "target": "向他伸出了"},
    {"offset": 9871, "target": "援手。"},
    {"offset": 9894, "target": "…那个人，是"}
  ]
}
