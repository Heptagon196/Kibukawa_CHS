      "target": ""
    },
    {
      "offset": 134,
      "kind": "line",
      "source": "２００４年６月某日",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 158,
      "kind": "line",
      "source": "天気、雨",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 172,
      "kind": "line",
      "source": "　",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 191,
      "kind": "line",
      "source": "癸生川探偵事務所",
      "limit": 9,
      "fragments": 2,
      "target": ""
    },
    {
      "offset": 263,
      "kind": "line",
      "source": "…そうですか。",
      "limit": 7,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 283,
      "kind": "line",
      "source": "過去に、そんなことが",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 309,
      "kind": "line",
      "source": "あったんですね…。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 333,
      "kind": "line",
      "source": "それは、何と言うか…",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 359,
      "kind": "line",
      "source": "好きな人を亡くすと",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 383,
      "kind": "line",
      "source": "いうのは、ほんとうに",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 409,
      "kind": "line",
      "source": "辛いものですから…。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 437,
      "kind": "line",
      "source": "…いえいえ。もう、",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 461,
      "kind": "line",
      "source": "８年も前の話です。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 485,
      "kind": "line",
      "source": "まあ、ただ…。",
      "limit": 7,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 505,
      "kind": "line",
      "source": "…それ以降、どうしても",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 533,
      "kind": "line",
      "source": "私は恋愛に臆病になって",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 561,
      "kind": "line",
      "source": "しまいましたが…。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 587,
      "kind": "line",
      "source": "ええ、わかります。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 611,
      "kind": "line",
      "source": "よくわかりますとも…。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 641,
      "kind": "line",
      "source": "結局、あれから今まで",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 667,
      "kind": "line",
      "source": "独身のままですから…。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 695,
      "kind": "line",
      "source": "さっき、この建物の",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 719,
      "kind": "line",
      "source": "下で、野球帽をかぶった",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 747,
      "kind": "line",
      "source": "男の子を見ましたけど…",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 775,
      "kind": "line",
      "source": "ああいう元気な男の子が",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 803,
      "kind": "line",
      "source": "欲しいなあ、なんて",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 827,
      "kind": "line",
      "source": "思ったりしますよ。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 853,
      "kind": "line",
      "source": "ああ、その子…",
      "limit": 7,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 873,
      "kind": "line",
      "source": "たぶんさっき、迷子で",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 899,
      "kind": "line",
      "source": "うちに転がり込んでた",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 925,
      "kind": "line",
      "source": "子だと思いますよ。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 949,
      "kind": "line",
      "source": "…お祖父さんと一緒じゃ",
      "limit": 11,
      "fragments": 3,
      "target": ""
    },
    {
      "offset": 995,
      "kind": "line",
      "source": "ありませんでしたか？",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1023,
      "kind": "line",
      "source": "そうですそうです。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1047,
      "kind": "line",
      "source": "じゃあ、たぶん、",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1069,
      "kind": "line",
      "source": "その人でしょう。",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1091,
      "kind": "line",
      "source": "いやあ、家族って",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1113,
      "kind": "line",
      "source": "いいものですよね…。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1144,
      "kind": "line",
      "source": "………。",
      "limit": 4,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1158,
      "kind": "line",
      "source": "あ、あのぉ…",
      "limit": 6,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1176,
      "kind": "line",
      "source": "お取り込み中、",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1196,
      "kind": "line",
      "source": "すみませんが…。",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1220,
      "kind": "line",
      "source": "…あ、はい。",
      "limit": 6,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1240,
      "kind": "line",
      "source": "…それで、ここに来た",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1268,
      "kind": "line",
      "source": "約束というのは…",
      "limit": 11,
      "fragments": 2,
      "target": ""
    },
    {
      "offset": 1296,
      "kind": "line",
      "source": "何だったんでしょうか？",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1326,
      "kind": "line",
      "source": "ああ、そうそう！",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1348,
      "kind": "line",
      "source": "それなんですが…",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1370,
      "kind": "line",
      "source": "８年前に、ここの",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1392,
      "kind": "line",
      "source": "探偵さんから約束",
      "limit": 8,
      "fragments": 2,
      "emphasis": [
        {
          "colour": null,
          "text": "探偵さんから"
        },
        {
          "colour": 2,
          "text": "約束"
        }
      ],
      "target": ""
    },
    {
      "offset": 1421,
      "kind": "line",
      "source": "されたんですよ。",
      "limit": 8,
      "fragments": 2,
      "target": ""
    },
    {
      "offset": 1456,
      "kind": "line",
      "source": "霊崎朱という女性から、",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1484,
      "kind": "line",
      "source": "私の貯金５００万円を",
      "limit": 11,
      "fragments": 2,
      "emphasis": [
        {
          "colour": null,
          "text": "私の貯金"
        },
        {
          "colour": 2,
          "text": "５００万円を"
        }
      ],
      "target": ""
    },
    {
      "offset": 1517,
      "kind": "line",
      "source": "取り戻す…って。",
      "limit": 11,
      "fragments": 2,
      "target": ""
    },
    {
      "offset": 1547,
      "kind": "line",
      "source": "…えっ？",
      "limit": 4,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1573,
      "kind": "line",
      "source": "それで、まだかな～と",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1599,
      "kind": "line",
      "source": "思って訪ねてみたわけ",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1625,
      "kind": "line",
      "source": "なんですよ。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1643,
      "kind": "line",
      "source": "…もう８年ですから、",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1669,
      "kind": "line",
      "source": "さすがに取り戻して",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1693,
      "kind": "line",
      "source": "いますよね。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1713,
      "kind": "line",
      "source": "………。",
      "limit": 4,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1729,
      "kind": "line",
      "source": "いやあ、危うくすっかり",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1757,
      "kind": "line",
      "source": "忘れるところでした。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1783,
      "kind": "line",
      "source": "この、８年ぶりの大雨で",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1811,
      "kind": "line",
      "source": "思い出したんですよ。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1839,
      "kind": "line",
      "source": "…い、伊綱君。",
      "limit": 10,
      "fragments": 3,
      "target": ""
    },
    {
      "offset": 1879,
      "kind": "line",
      "source": "その話は…聞いてる？",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1907,
      "kind": "line",
      "source": "…いえ、初耳です。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 1933,
      "kind": "line",
      "source": "…今、癸生川は？",
      "limit": 8,
      "fragments": 3,
      "target": ""
    },
    {
      "offset": 1979,
      "kind": "line",
      "source": "…どこをほっつき歩いて",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2007,
      "kind": "line",
      "source": "いるのやら…。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2029,
      "kind": "line",
      "source": "…ん？",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2041,
      "kind": "line",
      "source": "どうかしました？",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2065,
      "kind": "line",
      "source": "おわわわっ！",
      "limit": 6,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2083,
      "kind": "line",
      "source": "…いえ、あの、なんでも",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2111,
      "kind": "line",
      "source": "ありませんよ！",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2131,
      "kind": "line",
      "source": "え、ええと…",
      "limit": 6,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2149,
      "kind": "line",
      "source": "すみません、なにせ",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2173,
      "kind": "line",
      "source": "担当者が不在なもので…",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2201,
      "kind": "line",
      "source": "申し訳ないですが、また",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2229,
      "kind": "line",
      "source": "改めて、出直してもらえ",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2257,
      "kind": "line",
      "source": "ますか。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2273,
      "kind": "line",
      "source": "ああ、そうなんですか。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2301,
      "kind": "line",
      "source": "…わかりました、じゃ",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2327,
      "kind": "line",
      "source": "また近いうちに出直して",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2355,
      "kind": "line",
      "source": "きますね。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2373,
      "kind": "line",
      "source": "あー、近いうち。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2395,
      "kind": "line",
      "source": "近いうちですか…。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2421,
      "kind": "line",
      "source": "はい。２～３日したら、",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2449,
      "kind": "line",
      "source": "また来ますので。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2471,
      "kind": "line",
      "source": "その頃には担当の方も",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2497,
      "kind": "line",
      "source": "戻ってますよね。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2521,
      "kind": "line",
      "source": "え、ええと…いや、",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2545,
      "kind": "line",
      "source": "た、たぶん…。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2567,
      "kind": "line",
      "source": "それでは、またその時",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2593,
      "kind": "line",
      "source": "でも結構ですので。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2619,
      "kind": "line",
      "source": "ああ…はい、はい。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2645,
      "kind": "line",
      "source": "…では。",
      "limit": 4,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2681,
      "kind": "line",
      "source": "あわわわ…。",
      "limit": 6,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2699,
      "kind": "line",
      "source": "なんて面倒なことを",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2730,
      "kind": "line",
      "source": "遺してくれたのやら…。",
      "limit": 11,
      "fragments": 2,
      "target": ""
    },
    {
      "offset": 2766,
      "kind": "line",
      "source": "あらまあ、大変だねえ。",
      "limit": 11,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2796,
      "kind": "line",
      "source": "いやいや、何をそんな",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2822,
      "kind": "line",
      "source": "他人事みたいに。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2846,
      "kind": "line",
      "source": "…他人事じゃないか。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2872,
      "kind": "line",
      "source": "話を聞く前も、彼の",
      "limit": 10,
      "fragments": 2,
      "emphasis": [
        {
          "colour": null,
          "text": "話を聞く前も、"
        },
        {
          "colour": 2,
          "text": "彼の"
        }
      ],
      "target": ""
    },
    {
      "offset": 2903,
      "kind": "line",
      "source": "代わりになんなりと…",
      "limit": 10,
      "fragments": 2,
      "target": ""
    },
    {
      "offset": 2935,
      "kind": "line",
      "source": "とか言ってたし。",
      "limit": 10,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2959,
      "kind": "line",
      "source": "…ううう。",
      "limit": 5,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2975,
      "kind": "line",
      "source": "そりゃあ…まあ、",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 2997,
      "kind": "line",
      "source": "言いましたよ。",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 3017,
      "kind": "line",
      "source": "言いましたけど…。",
      "limit": 9,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 3041,
      "kind": "line",
      "source": "………。",
      "limit": 4,
      "fragments": 1,
      "target": ""
    },
    {
      "offset": 3066,
      "kind": "line",
      "source": "ちょっと先生ー！",
      "limit": 8,
      "fragments": 1,
      "target": ""
    },
    {
