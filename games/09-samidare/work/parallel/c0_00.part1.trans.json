{
  "script": "c0_00",
  "units": [
    {"offset": 24, "target": "２００４年６月某日"},
    {"offset": 48, "target": "天气：雨"},
    {"offset": 62, "target": "　"},
    {"offset": 81, "target": "鞠滨市鞠滨台"},
    {"offset": 172, "target": "…这雨已经下了"},
    {"offset": 196, "target": "好多天了。"},
    {"offset": 214, "target": "据新闻说，"},
    {"offset": 238, "target": "大约是８年来"},
    {"offset": 269, "target": "最大的一场暴雨。"},
    {"offset": 293, "target": "原本，鞠滨台这里"},
    {"offset": 343, "target": "离海很近，所以"},
    {"offset": 367, "target": "湿度一直偏高…"},
    {"offset": 393, "target": "再加上这场暴雨，"},
    {"offset": 421, "target": "整座城市都淡淡地"},
    {"offset": 481, "target": "笼上了一层雾。"},
    {"offset": 507, "target": "漫天的雨云将那"},
    {"offset": 536, "target": "铅灰色铺展开来，"},
    {"offset": 568, "target": "夺走了城市的色彩。"},
    {"offset": 618, "target": "…人哭过，"},
    {"offset": 634, "target": "心灵便会"},
    {"offset": 660, "target": "得到洗涤。"},
    {"offset": 682, "target": "所以…哭泣之人的"},
    {"offset": 710, "target": "心中没有污秽。"},
    {"offset": 752, "target": "…那么，"},
    {"offset": 768, "target": "那么，这座城…"},
    {"offset": 792, "target": "莫非已污浊到"},
    {"offset": 820, "target": "不得不如此哭泣"},
    {"offset": 846, "target": "的地步了吗？"},
    {"offset": 890, "target": "这片铅灰色天空，"},
    {"offset": 938, "target": "也不诉说自己为何"},
    {"offset": 964, "target": "那般悲伤…"},
    {"offset": 978, "target": "只是不断哭泣。"},
    {"offset": 1006, "target": "黑白色的"},
    {"offset": 1026, "target": "景物默默地…"},
    {"offset": 1048, "target": "聆听着泪水奏出的"},
    {"offset": 1092, "target": "那一曲旋律。"},
    {"offset": 1123, "target": "城里暴雨如注，"},
    {"offset": 1169, "target": "伞几乎毫无用处。"},
    {"offset": 1195, "target": "脚边飞溅的积水"},
    {"offset": 1221, "target": "打湿了我的裤脚，"},
    {"offset": 1281, "target": "令我的脚步更沉重。"},
    {"offset": 1311, "target": "唔，失策了。"},
    {"offset": 1333, "target": "偏偏挑这种日子"},
    {"offset": 1361, "target": "来，真不该…"},
    {"offset": 1391, "target": "我有些后悔，"},
    {"offset": 1419, "target": "却仍沿着熟悉的路…"},
    {"offset": 1474, "target": "来到鞠滨台的"},
    {"offset": 1537, "target": "癸生川侦探事务所。"},
    {"offset": 1575, "target": "我还是来了。"},
    {"offset": 1619, "target": "序　节"},
    {"offset": 1631, "target": "　"},
    {"offset": 1639, "target": "“代替他”"},
    {"offset": 1705, "target": "来啦！"},
    {"offset": 1719, "target": "来了来了！！"},
    {"offset": 1737, "target": "…糟了。"},
    {"offset": 1761, "target": "呃…"},
    {"offset": 1781, "target": "…嗯？"},
    {"offset": 1795, "target": "那个，门没锁，"},
    {"offset": 1823, "target": "请直接进来吧！"},
    {"offset": 1851, "target": "…真是的！"},
    {"offset": 1875, "target": "站住，别跑！"},
    {"offset": 1897, "target": "…怎、怎么回事！？"},
    {"offset": 1950, "target": "嗨，是我，生王。"},
    {"offset": 1998, "target": "打扰了。"},
    {"offset": 2018, "target": "…咦，伊纲？"},
    {"offset": 2064, "target": "跑哪去了？"},
    {"offset": 2099, "target": "……"},
    {"offset": 2113, "target": "咦，这孩子是…？"},
    {"offset": 2142, "target": "环视四周"},
    {"offset": 2156, "target": "交谈"},
    {"offset": 2164, "target": "调查"},
    {"offset": 2183, "target": "呼叫"},
    {"offset": 2191, "target": "思考"},
    {"offset": 2201, "target": "中断"},
    {"offset": 2251, "target": "那个，你是…？"},
    {"offset": 2293, "target": "…大叔，你是谁？", "runs": ["…", "大叔，你是谁？"]},
    {"offset": 2330, "target": "…！！"},
    {"offset": 2340, "target": "…这、这样啊。"},
    {"offset": 2362, "target": "大叔…"},
    {"offset": 2386, "target": "说的是我啊…"},
    {"offset": 2408, "target": "…？"},
    {"offset": 2420, "target": "也是啊…"},
    {"offset": 2446, "target": "我已经到了会被人"},
    {"offset": 2474, "target": "叫大叔的年纪啊…"},
    {"offset": 2502, "target": "唉，心里突然"},
    {"offset": 2522, "target": "有点难受…"},
    {"offset": 2546, "target": "…所以你是谁？"},
    {"offset": 2568, "target": "嗯，嗯…"},
    {"offset": 2590, "target": "……"},
    {"offset": 2613, "target": "少年，你且听我说。"},
    {"offset": 2641, "target": "在你这个年纪，"},
    {"offset": 2665, "target": "或许觉得大人全是"},
    {"offset": 2693, "target": "大叔，可是…"},
    {"offset": 2723, "target": "…大叔？"},
    {"offset": 2741, "target": "你说什么呢？"},
    {"offset": 2765, "target": "可是！"},
    {"offset": 2783, "target": "听好了，小朋友。"},
    {"offset": 2823, "target": "好在我是个"},
    {"offset": 2847, "target": "成熟又温柔的"},
    {"offset": 2871, "target": "大好人…"},
    {"offset": 2893, "target": "换个脾气火爆的人，"},
    {"offset": 2917, "target": "你现在早就"},
    {"offset": 2939, "target": "吃尽苦头了…"},
    {"offset": 3000, "target": "你怎么受了这点"},
    {"offset": 3024, "target": "小打击就蔫了，"},
    {"offset": 3059, "target": "生王大叔。"},
    {"offset": 3087, "target": "哇啊伊纲！", "runs": ["哇啊", "伊纲！"]},
    {"offset": 3130, "target": "你在啊！"},
    {"offset": 3148, "target": "会跟一个孩子"},
    {"offset": 3172, "target": "较真到这种地步…"},
    {"offset": 3200, "target": "实在称不上"},
    {"offset": 3226, "target": "成熟稳重吧。"},
    {"offset": 3248, "target": "我觉得。"},
    {"offset": 3270, "target": "…不是，那个嘛。"},
    {"offset": 3298, "target": "我只是感叹，人终究"},
    {"offset": 3324, "target": "是会变老的生物啊…"},
    {"offset": 3352, "target": "仅此而已。"},
    {"offset": 3376, "target": "所有生物"},
    {"offset": 3396, "target": "都会变老。"},
    {"offset": 3420, "target": "说得好！"},
    {"offset": 3440, "target": "…这算什么。"},
    {"offset": 3464, "target": "模仿老师？"},
    {"offset": 3482, "target": "一点也不像。"},
    {"offset": 3504, "target": "都说别再学了！"},
    {"offset": 3528, "target": "你听见没有！"},
    {"offset": 3554, "target": "我都道歉了嘛！"},
    {"offset": 3582, "target": "………？"},
    {"offset": 3607, "target": "好了，回到正题。"},
    {"offset": 3635, "target": "…所以，这个用"},
    {"offset": 3679, "target": "无语眼神看我的"},
    {"offset": 3705, "target": "孩子是谁？"},
    {"offset": 3725, "target": "在这之前，先好好"},
    {"offset": 3751, "target": "回答他的问题"},
    {"offset": 3777, "target": "吧。"},
    {"offset": 3797, "target": "…啊，问我啊。"},
    {"offset": 3823, "target": "那个…"},
    {"offset": 3844, "target": "大哥哥叫生王正生", "runs": ["大哥哥叫", "生王正生"]},
    {"offset": 3955, "target": "是事务所里这些人的"},
    {"offset": 3999, "target": "这个嘛…"},
    {"offset": 4021, "target": "算是朋友吧？"},
    {"offset": 4047, "target": "朋友…？"},
    {"offset": 4063, "target": "原来是朋友吗！？"},
    {"offset": 4091, "target": "姑且算是。"},
    {"offset": 4131, "target": "不过我的正职是"},
    {"offset": 4155, "target": "做游戏。"},
    {"offset": 4181, "target": "话说小朋友喜欢"},
    {"offset": 4207, "target": "什么游戏？"},
    {"offset": 4248, "target": "《癸生川凌介事件谭》"},
    {"offset": 4319, "target": "这款游戏很有趣，"},
    {"offset": 4345, "target": "你知道吗？"},
    {"offset": 4371, "target": "…不知道。"},
    {"offset": 4391, "target": "啊、啊，这样啊…"},
    {"offset": 4415, "target": "不知道啊…"},
    {"offset": 4435, "target": "真的很好玩，"},
    {"offset": 4457, "target": "有机会一定要试试…"},
    {"offset": 4496, "target": "生王先生，难道你"},
    {"offset": 4528, "target": "每次和小孩说话都"},
    {"offset": 4556, "target": "会问这个吗？"},
    {"offset": 4586, "target": "…哈！"},
    {"offset": 4600, "target": "糟了，不知不觉"},
    {"offset": 4624, "target": "就问出口了…"},
    {"offset": 4648, "target": "…真是个怪大叔"},
    {"offset": 4674, "target": "呢。"},
    {"offset": 4688, "target": "是啊，是个"},
    {"offset": 4710, "target": "怪大叔。"},
    {"offset": 4732, "target": "那就叫你"},
    {"offset": 4756, "target": "怪大叔好了。"},
    {"offset": 4774, "target": "怪大叔，怪大叔！"},
    {"offset": 4804, "target": "怪大叔！"},
    {"offset": 4826, "target": "这是欺负人…"},
    {"offset": 4855, "target": "…所以，这孩子？"},
    {"offset": 4879, "target": "这个嘛。"},
    {"offset": 4910, "target": "好像是迷路了。"},
    {"offset": 4945, "target": "迷路？"},
    {"offset": 4969, "target": "刚才他独自走在"},
    {"offset": 4995, "target": "事务所门口，"},
    {"offset": 5021, "target": "我就叫住了他…"},
    {"offset": 5049, "target": "看来是和父母"},
    {"offset": 5095, "target": "走散了。"},
    {"offset": 5121, "target": "大概是这样。"},
    {"offset": 5141, "target": "原来如此…"},
    {"offset": 5161, "target": "……"},
    {"offset": 5175, "target": "所以你在帮他"},
    {"offset": 5221, "target": "找父母啊。"},
    {"offset": 5259, "target": "就是这样。"},
    {"offset": 5279, "target": "我正想问问情况，"},
    {"offset": 5305, "target": "可是…"},
    {"offset": 5327, "target": "他连姓名什么的"},
    {"offset": 5355, "target": "都不肯说，"},
    {"offset": 5381, "target": "真让我犯愁。"},
    {"offset": 5407, "target": "哎呀呀。"},
    {"offset": 5423, "target": "是这样吗？"},
    {"offset": 5445, "target": "……"},
    {"offset": 5459, "target": "想看看他的随身物品"},
    {"offset": 5487, "target": "他又会闹腾…"},
    {"offset": 5533, "target": "啊，原来如此。"},
    {"offset": 5555, "target": "难怪我刚来的时候"},
    {"offset": 5588, "target": "这里乱成一团，"},
    {"offset": 5620, "target": "原来是为这个。"},
    {"offset": 5642, "target": "就连伊纲遇上孩子"},
    {"offset": 5670, "target": "也毫无办法"},
    {"offset": 5696, "target": "啊。"},
    {"offset": 5714, "target": "哈哈，真是个"},
    {"offset": 5745, "target": "调皮鬼。"},
    {"offset": 5775, "target": "真是的，这可"},
    {"offset": 5799, "target": "不好笑。"},
    {"offset": 5817, "target": "得赶快联系家长，"},
    {"offset": 5850, "target": "他们一定也很担心"},
    {"offset": 5882, "target": "吧…"},
    {"offset": 5902, "target": "…他们不担心。"},
    {"offset": 5924, "target": "咦…？"},
    {"offset": 5947, "target": "…反正他们一点都"},
    {"offset": 5971, "target": "不担心，别管了。"},
    {"offset": 6001, "target": "哎呀。"},
    {"offset": 6017, "target": "…看来其中"},
    {"offset": 6039, "target": "另有隐情。"},
    {"offset": 6061, "target": "再仔细"},
    {"offset": 6097, "target": "问问他吧…"},
    {"offset": 6180, "target": "或许因为连日阴雨，"},
    {"offset": 6208, "target": "事务所里充斥着"},
    {"offset": 6254, "target": "黏稠而沉闷的空气。"}
  ]
}
