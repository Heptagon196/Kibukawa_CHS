    {"offset": 5343, "target": "１９９９年１２月某日"},
    {"offset": 5369, "target": "天气：雨"},
    {"offset": 5383, "target": "　"},
    {"offset": 5402, "target": "癸生川侦探事务所"},
    {"offset": 5451, "target": "（灵崎朱）"},
    {"offset": 5476, "target": "（老人）"},
    {"offset": 5504, "target": "来、来啦！"},
    {"offset": 5535, "target": "…欢、欢迎来到"},
    {"offset": 5566, "target": "癸生川侦探事务所！"},
    {"offset": 5600, "target": "…………。"},
    {"offset": 5618, "target": "那、那个…请、"},
    {"offset": 5638, "target": "请问是有委托吗…？"},
    {"offset": 5666, "target": "………。"},
    {"offset": 5680, "target": "…哦——。"},
    {"offset": 5698, "target": "那、那个…请问"},
    {"offset": 5724, "target": "有什么事吗…？"},
    {"offset": 5750, "target": "虽然我是新人，"},
    {"offset": 5772, "target": "不过我来听您说！"},
    {"offset": 5818, "target": "…这样啊，你就是…。"},
    {"offset": 5848, "target": "…咦！？"},
    {"offset": 5862, "target": "那、那个…请问"},
    {"offset": 5888, "target": "有什么委托？"},
    {"offset": 5914, "target": "…啊，对不起！"},
    {"offset": 5942, "target": "这个嘛，那个…"},
    {"offset": 5968, "target": "请问从这里要怎么"},
    {"offset": 5996, "target": "去鞠滨公会堂，"},
    {"offset": 6022, "target": "你知道吗…？"},
    {"offset": 6046, "target": "咦…？"},
    {"offset": 6060, "target": "啊、啊，鞠滨公会堂"},
    {"offset": 6088, "target": "先从鞠滨台站坐电车"},
    {"offset": 6116, "target": "到第二站…"},
    {"offset": 6132, "target": "…啊，你知道怎么"},
    {"offset": 6158, "target": "去鞠滨台站吗？"},
    {"offset": 6180, "target": "那个，我说…"},
    {"offset": 6247, "target": "…唉。"},
    {"offset": 6263, "target": "凉二先生已经死了"},
    {"offset": 6291, "target": "这件事，看来"},
    {"offset": 6315, "target": "是真的啊——。"},
    {"offset": 6331, "target": "能配得上做我"},
    {"offset": 6353, "target": "一辈子的搭档"},
    {"offset": 6399, "target": "的人…"},
    {"offset": 6411, "target": "果然只有"},
    {"offset": 6435, "target": "凉二先生"},
    {"offset": 6459, "target": "才行呢——。"},
    {"offset": 6471, "target": "为了让他一眼"},
    {"offset": 6493, "target": "就认出我…"},
    {"offset": 6513, "target": "我还特意和３年前", "runs": ["我还特意", "和３年前"]},
    {"offset": 6544, "target": "穿得一模一样"},
    {"offset": 6574, "target": "才过来的呢…。"},
    {"offset": 6594, "target": "唉…。"},
    {"offset": 6630, "target": "…而且啊。"},
    {"offset": 6650, "target": "凉二先生豁出性命"},
    {"offset": 6676, "target": "保护的女人…"},
    {"offset": 6702, "target": "我还以为该是个"},
    {"offset": 6730, "target": "多厉害的女人呢。"},
    {"offset": 6756, "target": "…谁知那个"},
    {"offset": 6778, "target": "土气的小丫头！！"},
    {"offset": 6798, "target": "…要是那个丫头"},
    {"offset": 6824, "target": "当时死掉了"},
    {"offset": 6850, "target": "该多好啊…。"},
    {"offset": 6868, "target": "真是的！"},
    {"offset": 6888, "target": "真是太可惜啦！"},
    {"offset": 6916, "target": "要是和凉二先生"},
    {"offset": 6942, "target": "搭档，连黑道"},
    {"offset": 6968, "target": "都能一手遮天呢。"},
    {"offset": 6990, "target": "啊！越想"},
    {"offset": 7014, "target": "我就越不甘心，"},
    {"offset": 7040, "target": "简直气死我了！"},
    {"offset": 7067, "target": "…那个小丫头"},
    {"offset": 7091, "target": "真让人火大。"},
    {"offset": 7118, "target": "要不要杀了她呢…。"},
    {"offset": 7153, "target": "…那倒很简单，"},
    {"offset": 7179, "target": "可光是那样"},
    {"offset": 7201, "target": "还不够解我的气。"},
    {"offset": 7232, "target": "…好，就这么办！"},
    {"offset": 7254, "target": "代替已经不在的"},
    {"offset": 7274, "target": "他…"},
    {"offset": 7300, "target": "我要彻底地欺负她，"},
    {"offset": 7324, "target": "欺负她，再狠狠"},
    {"offset": 7346, "target": "地欺负她！"},
    {"offset": 7370, "target": "…啊，不过。"},
    {"offset": 7388, "target": "现在的她还太小，"},
    {"offset": 7414, "target": "欺负起来没意思…"},
    {"offset": 7460, "target": "就再等她"},
    {"offset": 7486, "target": "长大一点吧。"},
    {"offset": 7512, "target": "我真温柔啊。"},
    {"offset": 7538, "target": "…呵呵。"},
    {"offset": 7554, "target": "呵呵呵呵。"},
    {"offset": 7572, "target": "啊哈哈哈哈！"},
    {"offset": 7612, "target": "…啊，对不起。"},
    {"offset": 7638, "target": "那边的姑娘，我想"},
    {"offset": 7664, "target": "问个路…。"},
    {"offset": 7697, "target": "…咦？"},
    {"offset": 7711, "target": "在叫我吗？"},
    {"offset": 7731, "target": "…好吧，"},
    {"offset": 7749, "target": "没问题。"},
    {"offset": 7829, "target": "…那么，您想去"},
    {"offset": 7853, "target": "什么地方？"},
    {"offset": 7877, "target": "…老爷爷。"},
    {"offset": 7943, "target": "－　完　－"}
  ]
