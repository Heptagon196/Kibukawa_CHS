{
  "script": "c4_00",
  "units": [
    {"offset": 9922, "target": "替绫子调查的侦探"},
    {"offset": 9948, "target": "介绍他认识的一位"},
    {"offset": 9976, "target": "富豪。"},
    {"offset": 9998, "target": "那人把忠雄欠下的"},
    {"offset": 10026, "target": "债务连同全部利息"},
    {"offset": 10054, "target": "一并无息"},
    {"offset": 10078, "target": "借给了他。"},
    {"offset": 10106, "target": "…虽说是富豪，"},
    {"offset": 10134, "target": "这笔钱对他而言"},
    {"offset": 10158, "target": "也绝非小数目。"},
    {"offset": 10189, "target": "忠雄对他的好意"},
    {"offset": 10215, "target": "感激不已，发誓穷尽"},
    {"offset": 10243, "target": "一生也要把钱"},
    {"offset": 10267, "target": "全部还清。"},
    {"offset": 10298, "target": "…就这样，精神上的"},
    {"offset": 10324, "target": "负担减轻后，忠雄"},
    {"offset": 10352, "target": "仍未有丝毫懈怠，"},
    {"offset": 10378, "target": "继续拼命工作…"},
    {"offset": 10402, "target": "之后的二十多年里，"},
    {"offset": 10430, "target": "他一直瞒着家人"},
    {"offset": 10458, "target": "持续偿还着"},
    {"offset": 10486, "target": "这笔债务。"},
    {"offset": 10545, "target": "…原来如此，"},
    {"offset": 10571, "target": "是这么回事啊。"},
    {"offset": 10597, "target": "也正因如此，绫子女士"},
    {"offset": 10625, "target": "曾是婚姻诈骗犯的事"},
    {"offset": 10653, "target": "才能…"},
    {"offset": 10667, "target": "一直瞒到现在，"},
    {"offset": 10693, "target": "对吧？"},
    {"offset": 10717, "target": "…是啊。"},
    {"offset": 10733, "target": "等债务还清，"},
    {"offset": 10757, "target": "我本想和她一起生活"},
    {"offset": 10785, "target": "的…"},
    {"offset": 10801, "target": "原来如此…"},
    {"offset": 10819, "target": "…还剩下"},
    {"offset": 10845, "target": "多少钱没还？"},
    {"offset": 10877, "target": "五百万日元…"},
    {"offset": 10913, "target": "五百万…！？"},
    {"offset": 10935, "target": "其实上个月，"},
    {"offset": 10959, "target": "我忽然有了必须提前"},
    {"offset": 10987, "target": "还款的理由…"},
    {"offset": 11013, "target": "理由…？"},
    {"offset": 11040, "target": "其实…那位"},
    {"offset": 11064, "target": "替我扛下债务的"},
    {"offset": 11088, "target": "富豪…"},
    {"offset": 11108, "target": "听说他因年老体衰"},
    {"offset": 11152, "target": "已经病危了。"},
    {"offset": 11207, "target": "病危…是吗。"},
    {"offset": 11235, "target": "当然，即便他真的"},
    {"offset": 11263, "target": "去世，我也会继续"},
    {"offset": 11289, "target": "还清债务，可是…"},
    {"offset": 11326, "target": "他对我有大恩，"},
    {"offset": 11356, "target": "所以无论如何也想"},
    {"offset": 11384, "target": "在他生前还清。"},
    {"offset": 11412, "target": "啊，原来如此…"},
    {"offset": 11436, "target": "我能理解。"},
    {"offset": 11456, "target": "其实几年前，"},
    {"offset": 11480, "target": "他已经说不用我"},
    {"offset": 11506, "target": "继续偿还了…"},
    {"offset": 11524, "target": "可我这边，"},
    {"offset": 11546, "target": "无论如何也"},
    {"offset": 11568, "target": "不能接受。"},
    {"offset": 11584, "target": "毕竟我已经花了几十年"},
    {"offset": 11612, "target": "不断偿还。"},
    {"offset": 11634, "target": "无论如何，也得趁他"},
    {"offset": 11660, "target": "还活着…让他收下"},
    {"offset": 11684, "target": "这笔钱才行。"},
    {"offset": 11710, "target": "…否则的话，"},
    {"offset": 11732, "target": "一切就都没有意义了。"},
    {"offset": 11762, "target": "是这样啊。"},
    {"offset": 11782, "target": "原来是这样…"},
    {"offset": 11806, "target": "您才需要"},
    {"offset": 11828, "target": "这笔钱啊。"},
    {"offset": 11848, "target": "毕竟时间"},
    {"offset": 11870, "target": "太紧了…"},
    {"offset": 11892, "target": "我本想借用晓的"},
    {"offset": 11916, "target": "存款，"},
    {"offset": 11938, "target": "来解燃眉之急。"},
    {"offset": 11954, "target": "事到如今也无法说明，"},
    {"offset": 11982, "target": "但我还是打算想办法"},
    {"offset": 12008, "target": "求他答应。"},
    {"offset": 12020, "target": "但…"},
    {"offset": 12034, "target": "岳父寅男先生却先"},
    {"offset": 12062, "target": "偷走了存折…"},
    {"offset": 12092, "target": "…就是这样。"},
    {"offset": 12110, "target": "我急着尽快"},
    {"offset": 12134, "target": "弄到这笔钱，慌乱之下"},
    {"offset": 12162, "target": "我…"},
    {"offset": 12174, "target": "受人引诱，参与犯罪", "runs": ["受人引诱，参与", "犯罪"]},
    {"offset": 12224, "target": "成了帮凶。"},
    {"offset": 12258, "target": "那是…上个月", "runs": ["那是…", "上个月"]},
    {"offset": 12291, "target": "的事。"},
    {"offset": 12311, "target": "什么，犯罪…！？"},
    {"offset": 12331, "target": "那是…怎么"},
    {"offset": 12353, "target": "一回事…？"},
    {"offset": 12382, "target": "好——嘞！"},
    {"offset": 12400, "target": "原来如此，这样"},
    {"offset": 12422, "target": "整件事就串起来了！"},
    {"offset": 12458, "target": "…啊，癸生川。", "runs": ["…啊，", "癸生川。"]},
    {"offset": 12505, "target": "…你终于来了。"},
    {"offset": 12529, "target": "怎、怎么了…？"},
    {"offset": 12566, "target": "也就是说，就是这样！"},
    {"offset": 12599, "target": "这就是一切的"},
    {"offset": 12634, "target": "罪魁祸首！"},
    {"offset": 12654, "target": "…来吧，晓！"},
    {"offset": 12694, "target": "现身吧！"},
    {"offset": 12716, "target": "什么，晓…！？"},
    {"offset": 12789, "target": "(晓)"},
    {"offset": 12810, "target": "(忠雄)"},
    {"offset": 12843, "target": "１９９６年６月某日"},
    {"offset": 12867, "target": "天气：雨"},
    {"offset": 12881, "target": "　"},
    {"offset": 12889, "target": "克雷夫制作所"},
    {"offset": 12950, "target": "…事情就是这样！"},
    {"offset": 12976, "target": "…你父亲刚才的话"},
    {"offset": 12998, "target": "听到了吗？"},
    {"offset": 13018, "target": "啊、啊啊啊…"},
    {"offset": 13040, "target": "…怎、怎么会…"},
    {"offset": 13062, "target": "父亲竟然一直…"},
    {"offset": 13088, "target": "为了偿还债务"},
    {"offset": 13116, "target": "拼命工作…"},
    {"offset": 13142, "target": "而且，母亲原本"},
    {"offset": 13164, "target": "是婚姻诈骗犯…？"},
    {"offset": 13190, "target": "可是…"},
    {"offset": 13204, "target": "啊、啊…啊啊…"},
    {"offset": 13233, "target": "听着父亲的诉说，"},
    {"offset": 13261, "target": "泪水自然涌了出来。"},
    {"offset": 13287, "target": "我终于明白，父母历经"},
    {"offset": 13313, "target": "多少苦难，才换来"},
    {"offset": 13339, "target": "我的生命，而且…"},
    {"offset": 13359, "target": "也明白自己承载了"},
    {"offset": 13385, "target": "多么深厚的爱，"},
    {"offset": 13413, "target": "才得以活到今天…"},
    {"offset": 13441, "target": "想到这里，泪水"},
    {"offset": 13463, "target": "怎么也止不住…"},
    {"offset": 13487, "target": "我曾误解父亲，"},
    {"offset": 13511, "target": "对此羞愧不已。"},
    {"offset": 13533, "target": "…总之，"},
    {"offset": 13553, "target": "就是这么回事。"},
    {"offset": 13575, "target": "倒省了说明的工夫。"},
    {"offset": 13605, "target": "…………"},
    {"offset": 13624, "target": "我被侦探带到的地方，"},
    {"offset": 13652, "target": "正是父亲工作的"},
    {"offset": 13678, "target": "那间工厂。"},
    {"offset": 13706, "target": "在那里，我们恰好碰见"},
    {"offset": 13751, "target": "父亲在和白鹭洲先生"},
    {"offset": 13777, "target": "交谈…"},
    {"offset": 13791, "target": "于是我们藏起来，"},
    {"offset": 13815, "target": "偷听了他们的对话。"},
    {"offset": 13846, "target": "等他们谈完之后，"},
    {"offset": 13870, "target": "侦探突然"},
    {"offset": 13896, "target": "大声喊道。"},
    {"offset": 13922, "target": "好——嘞！"},
    {"offset": 13940, "target": "原来如此，这样"},
    {"offset": 13962, "target": "整件事就串起来了！"},
    {"offset": 14001, "target": "啊，癸生川。"},
    {"offset": 14043, "target": "…你终于来了。"},
    {"offset": 14067, "target": "怎、怎么了…？"},
    {"offset": 14089, "target": "侦探突然冲出来，"},
    {"offset": 14117, "target": "朝两人走去。"},
    {"offset": 14143, "target": "也就是说，就是这样！"},
    {"offset": 14176, "target": "这就是一切的"},
    {"offset": 14211, "target": "罪魁祸首！"},
    {"offset": 14231, "target": "…来吧，晓！"},
    {"offset": 14271, "target": "现身吧！"},
    {"offset": 14293, "target": "什么，晓…！？"},
    {"offset": 14342, "target": "…他在叫我。"},
    {"offset": 14364, "target": "我擦干眼泪，"},
    {"offset": 14392, "target": "走到了三人面前。"},
    {"offset": 14477, "target": "晓，你…"},
    {"offset": 14503, "target": "爸爸，事情"},
    {"offset": 14523, "target": "我都听到了。"},
    {"offset": 14551, "target": "…………"},
    {"offset": 14579, "target": "趁这个机会，还是把"},
    {"offset": 14605, "target": "一切都说清楚吧！"},
    {"offset": 14627, "target": "…综合刚才的事，"},
    {"offset": 14653, "target": "真相已经显而易见了。"},
    {"offset": 14694, "target": "………？"},
    {"offset": 14710, "target": "…癸生川。"},
    {"offset": 14748, "target": "是不是还需要"},
    {"offset": 14772, "target": "再补充说明一下？"},
    {"offset": 14808, "target": "那就逐一确认吧。"}
  ]
}
