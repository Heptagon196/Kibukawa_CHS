{
  "script": "c0_00",
  "units": [
    {"offset": 6294, "target": "通风不好的房间，"},
    {"offset": 6322, "target": "一到这种季节"},
    {"offset": 6350, "target": "真是难熬啊…"},
    {"offset": 6381, "target": "这样沉默下来，"},
    {"offset": 6409, "target": "便能听见雨点"},
    {"offset": 6435, "target": "敲打建筑的声音。"},
    {"offset": 6455, "target": "哗哗作响，"},
    {"offset": 6477, "target": "如同噪声的雨声"},
    {"offset": 6525, "target": "远远回荡在室内。"},
    {"offset": 6556, "target": "房间里尽是"},
    {"offset": 6582, "target": "受潮后沉重"},
    {"offset": 6611, "target": "而难受的空气。"},
    {"offset": 6641, "target": "少年"},
    {"offset": 6658, "target": "伊纲"},
    {"offset": 6666, "target": "窗户"},
    {"offset": 6672, "target": "天花板"},
    {"offset": 6698, "target": "小学低年级…"},
    {"offset": 6724, "target": "大约六七岁"},
    {"offset": 6752, "target": "的小男孩。"},
    {"offset": 6776, "target": "态度虽然有点放肆，"},
    {"offset": 6804, "target": "却似乎也有些"},
    {"offset": 6830, "target": "不知所措。"},
    {"offset": 6863, "target": "仔细一看，他的衣服"},
    {"offset": 6889, "target": "和头发都湿漉漉的。"},
    {"offset": 6931, "target": "…不会着凉吧"},
    {"offset": 6957, "target": "…"},
    {"offset": 6994, "target": "他身上会不会有"},
    {"offset": 7018, "target": "什么线索…"},
    {"offset": 7055, "target": "他头上那顶帽子，"},
    {"offset": 7079, "target": "似乎是本地"},
    {"offset": 7107, "target": "职业棒球队的。"},
    {"offset": 7127, "target": "…也就是说，他很可能"},
    {"offset": 7175, "target": "住在离鞠滨市"},
    {"offset": 7203, "target": "不太远的地方。"},
    {"offset": 7231, "target": "环顾房间，也看不出"},
    {"offset": 7259, "target": "他带了书包之类"},
    {"offset": 7287, "target": "的东西…"},
    {"offset": 7309, "target": "这么说，他是空着手"},
    {"offset": 7337, "target": "一路来到这里"},
    {"offset": 7361, "target": "的吗…？"},
    {"offset": 7381, "target": "鞋子是一双"},
    {"offset": 7405, "target": "穿旧了的运动鞋，"},
    {"offset": 7431, "target": "没什么特别之处。"},
    {"offset": 7459, "target": "唔…好像没有"},
    {"offset": 7487, "target": "别的线索了…"},
    {"offset": 7529, "target": "…咦？"},
    {"offset": 7543, "target": "仔细看，他屁股上的"},
    {"offset": 7569, "target": "口袋好像鼓鼓的。"},
    {"offset": 7598, "target": "起来。"},
    {"offset": 7612, "target": "…里面装了什么吗？"},
    {"offset": 7640, "target": "可是…直接问他"},
    {"offset": 7668, "target": "恐怕也不会"},
    {"offset": 7692, "target": "告诉我…"},
    {"offset": 7717, "target": "…唔，还得让他"},
    {"offset": 7739, "target": "再靠近些，"},
    {"offset": 7763, "target": "才能看清…"},
    {"offset": 7799, "target": "雨点从外侧"},
    {"offset": 7825, "target": "噼里啪啦地"},
    {"offset": 7854, "target": "砸在玻璃窗上。"},
    {"offset": 7893, "target": "水珠沿着震颤的"},
    {"offset": 7936, "target": "玻璃表面静静滑落。"},
    {"offset": 7997, "target": "仔细一看，天花板上"},
    {"offset": 8021, "target": "大概是受潮，"},
    {"offset": 8054, "target": "留下了几处水渍。"},
    {"offset": 8084, "target": "这里并非顶层，"},
    {"offset": 8108, "target": "应该不用担心"},
    {"offset": 8148, "target": "漏雨吧…"},
    {"offset": 8180, "target": "她就是在这间"},
    {"offset": 8206, "target": "事务所担任助手的"},
    {"offset": 8243, "target": "白鹭洲伊纲。"},
    {"offset": 8285, "target": "她平时总爱装傻，"},
    {"offset": 8313, "target": "可我只要稍微"},
    {"offset": 8339, "target": "示弱…"},
    {"offset": 8363, "target": "她立刻就会兴冲冲地"},
    {"offset": 8391, "target": "吐槽起来，"},
    {"offset": 8415, "target": "让人招架不住。"},
    {"offset": 8437, "target": "也就是欺负人。"},
    {"offset": 8461, "target": "欺负人。"},
    {"offset": 8475, "target": "欺负人，真难看！"},
    {"offset": 8503, "target": "…？"},
    {"offset": 8522, "target": "今天她也一如往常，"},
    {"offset": 8546, "target": "我行我素，"},
    {"offset": 8572, "target": "一脸若无其事。"},
    {"offset": 8639, "target": "我没见过这孩子，"},
    {"offset": 8667, "target": "他是谁呢…？"},
    {"offset": 8692, "target": "唉，已经会被人"},
    {"offset": 8716, "target": "叫大叔了啊…"},
    {"offset": 8742, "target": "正因为他没有恶意，"},
    {"offset": 8764, "target": "这句话才比想象中"},
    {"offset": 8786, "target": "更扎心。"},
    {"offset": 8813, "target": "伊纲也越来越像"},
    {"offset": 8841, "target": "癸生川了，尤其是"},
    {"offset": 8889, "target": "突然冒出来这点…"},
    {"offset": 8918, "target": "唔…看来我的"},
    {"offset": 8944, "target": "怪大叔的标签"},
    {"offset": 8972, "target": "已经贴上了…"},
    {"offset": 9009, "target": "她可不像天真的孩子"},
    {"offset": 9041, "target": "伊纲这么说，"},
    {"offset": 9069, "target": "显然满怀恶意…"},
    {"offset": 9130, "target": "姓名"},
    {"offset": 9138, "target": "问他自己"},
    {"offset": 9150, "target": "询问父母"},
    {"offset": 9171, "target": "…总之先告诉我"},
    {"offset": 9199, "target": "你的名字好吗？"},
    {"offset": 9227, "target": "……"},
    {"offset": 9241, "target": "你看，不知道名字"},
    {"offset": 9265, "target": "我连叫你都"},
    {"offset": 9289, "target": "没办法。"},
    {"offset": 9309, "target": "…不要。"},
    {"offset": 9323, "target": "我不想说。"},
    {"offset": 9345, "target": "噗哇。"},
    {"offset": 9359, "target": "不是…这是"},
    {"offset": 9385, "target": "为什么？"},
    {"offset": 9407, "target": "………"},
    {"offset": 9423, "target": "我从刚才问到现在，"},
    {"offset": 9447, "target": "他就是不肯说。"},
    {"offset": 9477, "target": "真没办法…"},
    {"offset": 9506, "target": "……"},
    {"offset": 9520, "target": "唔…"},
    {"offset": 9536, "target": "只是直接问"},
    {"offset": 9558, "target": "果然不行…"},
    {"offset": 9588, "target": "你住在"},
    {"offset": 9608, "target": "这一带吗？"},
    {"offset": 9628, "target": "…不是。"},
    {"offset": 9646, "target": "那你从哪里来？"},
    {"offset": 9685, "target": "在鞠滨市内吗？"},
    {"offset": 9713, "target": "……"},
    {"offset": 9727, "target": "…唔，还是不肯"},
    {"offset": 9749, "target": "告诉我啊…"},
    {"offset": 9771, "target": "至少看来他"},
    {"offset": 9797, "target": "不是住在这一带"},
    {"offset": 9821, "target": "的孩子…"},
    {"offset": 9863, "target": "你一个人吗？"},
    {"offset": 9881, "target": "爸爸或妈妈"},
    {"offset": 9907, "target": "没和你一起吗？"},
    {"offset": 9935, "target": "……"},
    {"offset": 9949, "target": "你说父母不担心，"},
    {"offset": 9975, "target": "可是…为什么"},
    {"offset": 9997, "target": "这么说？"},
    {"offset": 10019, "target": "……"},
    {"offset": 10031, "target": "…因为他们不可能"},
    {"offset": 10057, "target": "担心我。"},
    {"offset": 10075, "target": "咦，怎么了？"},
    {"offset": 10097, "target": "和父母吵架了？"},
    {"offset": 10125, "target": "……"},
    {"offset": 10139, "target": "唔…"},
    {"offset": 10155, "target": "还是不肯说…"},
    {"offset": 10194, "target": "小朋友，你该不会"},
    {"offset": 10220, "target": "是离家出走吧？"},
    {"offset": 10248, "target": "…！！"},
    {"offset": 10258, "target": "才、才不是！"},
    {"offset": 10278, "target": "…生王先生，你这么"},
    {"offset": 10324, "target": "问，他也回答不了"},
    {"offset": 10352, "target": "吧。"},
    {"offset": 10382, "target": "唔…"},
    {"offset": 10416, "target": "我没离家出走！"},
    {"offset": 10440, "target": "呃，我明明什么"},
    {"offset": 10462, "target": "都没说…"},
    {"offset": 10485, "target": "…要怎么套出"},
    {"offset": 10509, "target": "他口袋里有什么，"},
    {"offset": 10535, "target": "想想看…"},
    {"offset": 10561, "target": "你背后有鬼！"},
    {"offset": 10592, "target": "你裤子脏了"},
    {"offset": 10614, "target": "里面没淋湿吧？"},
    {"offset": 10638, "target": "哇啊啊啊！！"},
    {"offset": 10658, "target": "你、你背后有鬼"},
    {"offset": 10686, "target": "啊啊啊！"},
    {"offset": 10710, "target": "…哈？你说什么？"},
    {"offset": 10738, "target": "果然是个怪大叔"},
    {"offset": 10764, "target": "呢。"},
    {"offset": 10778, "target": "真是的，你到底"},
    {"offset": 10804, "target": "在干什么啊。"},
    {"offset": 10826, "target": "唔…"},
    {"offset": 10840, "target": "完全没上钩…"},
    {"offset": 10866, "target": "…那就换一招！"},
    {"offset": 10901, "target": "…咦，你裤子上"},
    {"offset": 10923, "target": "沾了脏东西。"},
    {"offset": 10949, "target": "咦？"},
    {"offset": 10963, "target": "我帮你拍掉。"},
    {"offset": 10985, "target": "稍微转过身"},
    {"offset": 11005, "target": "来。"},
    {"offset": 11027, "target": "什么！？"},
    {"offset": 11041, "target": "不用了。"},
    {"offset": 11061, "target": "别碰我，怪大叔！"},
    {"offset": 11091, "target": "呜，被他提防了…"},
    {"offset": 11119, "target": "这样的话…"},
    {"offset": 11150, "target": "你口袋里的那个，", "runs": ["你口袋里的", "那个，"]},
    {"offset": 11197, "target": "已经被雨淋湿了，"},
    {"offset": 11225, "target": "不要紧吗？"},
    {"offset": 11245, "target": "…啊！糟了！"},
    {"offset": 11288, "target": "少年慌忙跑到房间"},
    {"offset": 11316, "target": "角落，悄悄把它"},
    {"offset": 11360, "target": "拿出来检查。"},
    {"offset": 11388, "target": "咦，那是…"},
    {"offset": 11408, "target": "…没错，果然是"},
    {"offset": 11434, "target": "手机…"},
    {"offset": 11477, "target": "啊，原来他带着"},
    {"offset": 11505, "target": "手机。"},
    {"offset": 11531, "target": "这么说…"},
    {"offset": 11549, "target": "…只要看看手机，"},
    {"offset": 11571, "target": "就能查到联系方式。"},
    {"offset": 11609, "target": "是啊。"},
    {"offset": 11629, "target": "好嘞。"},
    {"offset": 11645, "target": "既然如此，"},
    {"offset": 11667, "target": "也不用耍花招了。"},
    {"offset": 11695, "target": "拿来吧！！"},
    {"offset": 11726, "target": "喂，你干什么！"},
    {"offset": 11750, "target": "住手，你这个"},
    {"offset": 11770, "target": "怪大叔！"}
  ]
}
