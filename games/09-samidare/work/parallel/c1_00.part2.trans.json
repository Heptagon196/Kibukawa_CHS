{
  "script": "c1_00",
  "units": [
    {"offset": 5326, "target": "别看我这样，打扫"},
    {"offset": 5350, "target": "可是很拿手的！"},
    {"offset": 5374, "target": "不用，没事。"},
    {"offset": 5394, "target": "我自己来就好。"},
    {"offset": 5433, "target": "咦，是吗？"},
    {"offset": 5457, "target": "在我面前，你不用"},
    {"offset": 5477, "target": "这么客气的。"},
    {"offset": 5495, "target": "真的没关系！"},
    {"offset": 5519, "target": "嗯，谢谢你。"},
    {"offset": 5566, "target": "交谈"},
    {"offset": 5574, "target": "调查"},
    {"offset": 5584, "target": "观察"},
    {"offset": 5592, "target": "中断"},
    {"offset": 5624, "target": "凉二先生，前些天"},
    {"offset": 5648, "target": "真的非常感谢"},
    {"offset": 5676, "target": "您。"},
    {"offset": 5690, "target": "那天我明明身体"},
    {"offset": 5716, "target": "不舒服，还硬撑着"},
    {"offset": 5742, "target": "出了门…"},
    {"offset": 5782, "target": "…结果下着大雨，"},
    {"offset": 5808, "target": "我却难受得晕倒"},
    {"offset": 5832, "target": "了。"},
    {"offset": 5858, "target": "要不是凉二先生"},
    {"offset": 5886, "target": "恰好路过照顾我，"},
    {"offset": 5914, "target": "真不知会怎样…"},
    {"offset": 5976, "target": "真的…"},
    {"offset": 5990, "target": "真的非常感谢"},
    {"offset": 6018, "target": "您！"},
    {"offset": 6040, "target": "没什么。当时我也"},
    {"offset": 6062, "target": "担心得不知该"},
    {"offset": 6084, "target": "怎么办…"},
    {"offset": 6102, "target": "幸好最后没有"},
    {"offset": 6124, "target": "酿成大事。"},
    {"offset": 6160, "target": "后来我一直想来"},
    {"offset": 6188, "target": "道谢，好几次到这里"},
    {"offset": 6214, "target": "找您…"},
    {"offset": 6238, "target": "可凉二先生总不在，"},
    {"offset": 6266, "target": "我特别不安。"},
    {"offset": 6292, "target": "原来是这样。"},
    {"offset": 6320, "target": "真是抱歉。"},
    {"offset": 6342, "target": "直到刚才，我都在"},
    {"offset": 6368, "target": "办一件费时的工作。"},
    {"offset": 6406, "target": "没关系。"},
    {"offset": 6432, "target": "现在总算能当面"},
    {"offset": 6456, "target": "向您道谢了。"},
    {"offset": 6505, "target": "看你这样子…"},
    {"offset": 6525, "target": "身体似乎已经"},
    {"offset": 6551, "target": "完全好了。"},
    {"offset": 6591, "target": "是！这一切都是"},
    {"offset": 6617, "target": "凉二先生的功劳！"},
    {"offset": 6645, "target": "所以凉二先生"},
    {"offset": 6669, "target": "就是我的救命"},
    {"offset": 6691, "target": "恩人！"},
    {"offset": 6709, "target": "这未免有点…"},
    {"offset": 6731, "target": "太夸张了吧。"},
    {"offset": 6769, "target": "没有，才不"},
    {"offset": 6793, "target": "夸张呢！"},
    {"offset": 6813, "target": "只要是为了凉二先生"},
    {"offset": 6841, "target": "我什么都愿意做！"},
    {"offset": 6869, "target": "我今天也是想着"},
    {"offset": 6895, "target": "能不能帮上什么忙，"},
    {"offset": 6923, "target": "才来这里的！"},
    {"offset": 6949, "target": "哦，是吗？"},
    {"offset": 6987, "target": "是！"},
    {"offset": 7001, "target": "只要有我能做的事，"},
    {"offset": 7027, "target": "不管什么都请"},
    {"offset": 7049, "target": "尽管吩咐！"},
    {"offset": 7075, "target": "做饭、洗衣服，"},
    {"offset": 7099, "target": "或是帮您工作，"},
    {"offset": 7123, "target": "我什么都能做！"},
    {"offset": 7151, "target": "这个嘛…"},
    {"offset": 7169, "target": "好吗？"},
    {"offset": 7202, "target": "那我们先从"},
    {"offset": 7222, "target": "什么开始呢？"},
    {"offset": 7246, "target": "不过你才刚康复，"},
    {"offset": 7274, "target": "我也不能让你太"},
    {"offset": 7300, "target": "勉强自己。"},
    {"offset": 7320, "target": "…你的心意我已经"},
    {"offset": 7346, "target": "确实收到了。这样"},
    {"offset": 7372, "target": "就足够了。"},
    {"offset": 7394, "target": "你愿意感谢我，"},
    {"offset": 7418, "target": "我也很高兴。"},
    {"offset": 7440, "target": "嗯，谢谢。"},
    {"offset": 7476, "target": "怎么这样…"},
    {"offset": 7490, "target": "真的不行吗…？"},
    {"offset": 7514, "target": "可是…这样一来，"},
    {"offset": 7538, "target": "我的心意根本"},
    {"offset": 7560, "target": "无处安放。"},
    {"offset": 7592, "target": "我还有好多心意"},
    {"offset": 7620, "target": "没能传达给"},
    {"offset": 7644, "target": "您呢…！"},
    {"offset": 7666, "target": "这可难办了…"},
    {"offset": 7694, "target": "你这么说，我也…"},
    {"offset": 7718, "target": "今天就先乖乖"},
    {"offset": 7740, "target": "回去，好好休息，"},
    {"offset": 7764, "target": "可以吗？"},
    {"offset": 7802, "target": "…啊！凉二先生，"},
    {"offset": 7828, "target": "您是在担心"},
    {"offset": 7854, "target": "我吧。"},
    {"offset": 7878, "target": "但我的身体已经"},
    {"offset": 7906, "target": "没事了！"},
    {"offset": 7928, "target": "…算我拜托你。"},
    {"offset": 7952, "target": "你要是也能理解"},
    {"offset": 7978, "target": "我的心情，我会很"},
    {"offset": 8004, "target": "高兴的。"},
    {"offset": 8032, "target": "……"},
    {"offset": 8044, "target": "那个…那我可以"},
    {"offset": 8066, "target": "只提一个请求"},
    {"offset": 8090, "target": "吗？"},
    {"offset": 8116, "target": "什么请求？"},
    {"offset": 8134, "target": "好不容易才见到您。"},
    {"offset": 8162, "target": "请让我再陪您"},
    {"offset": 8188, "target": "待一小会儿。"},
    {"offset": 8212, "target": "这样我就会乖乖"},
    {"offset": 8240, "target": "回去。"},
    {"offset": 8270, "target": "…好吗？"},
    {"offset": 8286, "target": "…真是的。"},
    {"offset": 8310, "target": "川濑莉沙"},
    {"offset": 8331, "target": "第一次见到她时，"},
    {"offset": 8357, "target": "我还以为她是"},
    {"offset": 8379, "target": "高中生…"},
    {"offset": 8397, "target": "后来听说她已经"},
    {"offset": 8445, "target": "超过二十岁，我颇为"},
    {"offset": 8471, "target": "吃惊。"},
    {"offset": 8497, "target": "所以她其实比我"},
    {"offset": 8521, "target": "年长，"},
    {"offset": 8549, "target": "可怎么看都感觉"},
    {"offset": 8577, "target": "不出来，我总会把她"},
    {"offset": 8601, "target": "当成比我年幼的人。"},
    {"offset": 8625, "target": "…而她本人似乎"},
    {"offset": 8653, "target": "也希望我这么"},
    {"offset": 8682, "target": "对待她。"},
    {"offset": 8704, "target": "现在看着她…"},
    {"offset": 8752, "target": "果然怎么也不像"},
    {"offset": 8774, "target": "超过二十岁的样子。"},
    {"offset": 8798, "target": "她究竟多大呢？"},
    {"offset": 8830, "target": "川濑莉沙"},
    {"offset": 8842, "target": "…她似乎很开心。", "runs": ["…她似乎", "很开心。"]},
    {"offset": 8879, "target": "比起高兴，"},
    {"offset": 8905, "target": "感觉她更像是在享受"},
    {"offset": 8933, "target": "现在的处境。"},
    {"offset": 8975, "target": "…不行！"},
    {"offset": 8991, "target": "我可不能答应！"},
    {"offset": 9025, "target": "…咦！？"},
    {"offset": 9091, "target": "白鹭洲，你怎么了？"},
    {"offset": 9125, "target": "这可不像你！"},
    {"offset": 9162, "target": "癸生川…原来你"},
    {"offset": 9188, "target": "在房间里啊。"},
    {"offset": 9212, "target": "这个人是谁！？"},
    {"offset": 9249, "target": "那个，我是…"},
    {"offset": 9273, "target": "不，谁都无所谓！"},
    {"offset": 9299, "target": "总之我先告诉"},
    {"offset": 9323, "target": "你一件事…"},
    {"offset": 9345, "target": "……？"},
    {"offset": 9359, "target": "想骗他也没用！", "runs": ["想骗他", "也没用！"]},
    {"offset": 9402, "target": "咦…？"},
    {"offset": 9416, "target": "这是什么意思？"},
    {"offset": 9454, "target": "就是字面意思！"},
    {"offset": 9474, "target": "我说你对白鹭洲"},
    {"offset": 9496, "target": "撒谎也是白费"},
    {"offset": 9518, "target": "力气！"},
    {"offset": 9550, "target": "那、那个…？"},
    {"offset": 9568, "target": "您到底在说什么？"},
    {"offset": 9596, "target": "我听不明白…"},
    {"offset": 9622, "target": "…凉、凉二先生。"},
    {"offset": 9644, "target": "这个无礼的"},
    {"offset": 9668, "target": "大叔是谁…？"},
    {"offset": 9696, "target": "他是癸生川凌介。", "runs": ["他是", "癸生川凌介。"]},
    {"offset": 9762, "target": "这里的侦探。"},
    {"offset": 9786, "target": "咦！？"},
    {"offset": 9798, "target": "这人就是侦探…？"},
    {"offset": 9824, "target": "你看着像日本人，"},
    {"offset": 9850, "target": "难道其实不是？"},
    {"offset": 9876, "target": "如果是日本人，"},
    {"offset": 9900, "target": "理应听得懂日语，"},
    {"offset": 9924, "target": "可你似乎听不懂！"},
    {"offset": 9962, "target": "唔…"},
    {"offset": 9978, "target": "我说你做的事"},
    {"offset": 10002, "target": "已经全都露馅"},
    {"offset": 10022, "target": "了！"},
    {"offset": 10044, "target": "露馅！"},
    {"offset": 10058, "target": "用英语说就是"},
    {"offset": 10078, "target": "ＰＩＰＥＯＵＴ！"},
    {"offset": 10102, "target": "这、这个英文恐怕"},
    {"offset": 10130, "target": "不太对吧…"},
    {"offset": 10150, "target": "我根本没有"},
    {"offset": 10174, "target": "撒谎！"},
    {"offset": 10194, "target": "为什么要这么不负"},
    {"offset": 10222, "target": "责任地乱说！"},
    {"offset": 10252, "target": "他可是会看穿的！", "runs": ["他可是", "会看穿的！"]}
  ]
}
