{
  "script": "c4_00",
  "batch": "c4_00.part6.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 25045,
      "kind": "line",
      "limit": 11,
      "source": "危険なヤツなのだ。",
      "target": "家伙，很危险。"
    },
    {
      "offset": 25069,
      "kind": "line",
      "limit": 11,
      "source": "…恐らく、犯罪に関する",
      "target": "…恐怕，论犯罪方面"
    },
    {
      "offset": 25097,
      "kind": "line",
      "limit": 11,
      "source": "能力は、師匠を超えて",
      "target": "她的本事已经超过"
    },
    {
      "offset": 25143,
      "kind": "line",
      "limit": 11,
      "source": "いるだろう。",
      "target": "师父了吧。"
    },
    {
      "offset": 25163,
      "kind": "line",
      "limit": 9,
      "source": "金は折半するという",
      "target": "说好钱要对半分"
    },
    {
      "offset": 25187,
      "kind": "line",
      "limit": 9,
      "source": "約束だったが…",
      "target": "的，可后来…"
    },
    {
      "offset": 25207,
      "kind": "line",
      "limit": 9,
      "source": "女はそれ以降、私の",
      "target": "那女人从此便"
    },
    {
      "offset": 25231,
      "kind": "line",
      "limit": 9,
      "source": "前から姿を消した。",
      "target": "消失在我面前。"
    },
    {
      "offset": 25267,
      "kind": "line",
      "limit": 11,
      "source": "それは当然、金を持って",
      "target": "当然是卷钱"
    },
    {
      "offset": 25295,
      "kind": "line",
      "limit": 11,
      "source": "トンズラだろうな。",
      "target": "逃之夭夭了吧。"
    },
    {
      "offset": 25321,
      "kind": "line",
      "limit": 10,
      "source": "私はひどく後悔した。",
      "target": "我悔恨不已。"
    },
    {
      "offset": 25347,
      "kind": "line",
      "limit": 10,
      "source": "…しかし、その相手が",
      "target": "可是…我甚至"
    },
    {
      "offset": 25373,
      "kind": "line",
      "limit": 10,
      "source": "どこの誰だかも",
      "target": "连对方是何方神圣"
    },
    {
      "offset": 25393,
      "kind": "line",
      "limit": 10,
      "source": "わからないので…",
      "target": "都不知道…"
    },
    {
      "offset": 25415,
      "kind": "line",
      "limit": 7,
      "source": "謝罪のしようも",
      "target": "也无从"
    },
    {
      "offset": 25435,
      "kind": "line",
      "limit": 7,
      "source": "なかった。",
      "target": "向其道歉。"
    },
    {
      "offset": 25451,
      "kind": "line",
      "limit": 10,
      "source": "…どうにかして、その",
      "target": "我还想方设法"
    },
    {
      "offset": 25477,
      "kind": "line",
      "limit": 10,
      "source": "金も返したかった。",
      "target": "把钱还给对方。"
    },
    {
      "offset": 25503,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 25521,
      "kind": "line",
      "limit": 10,
      "source": "そこで、申し訳ないが",
      "target": "所以，虽很抱歉"
    },
    {
      "offset": 25547,
      "kind": "line",
      "limit": 10,
      "source": "暁の通帳をアテにし、",
      "target": "只好指望晓的存款，"
    },
    {
      "offset": 25573,
      "kind": "line",
      "limit": 10,
      "source": "再び父を捜していた。",
      "target": "再次寻找父亲。"
    },
    {
      "offset": 25608,
      "kind": "line",
      "limit": 9,
      "source": "…金、金、金か…。",
      "target": "…钱、钱、钱吗…"
    },
    {
      "offset": 25632,
      "kind": "line",
      "limit": 10,
      "source": "母の言っていた通り、",
      "target": "母亲说得对，"
    },
    {
      "offset": 25658,
      "kind": "line",
      "limit": 10,
      "source": "金に固執しても、何も",
      "target": "执着于钱财，"
    },
    {
      "offset": 25684,
      "kind": "line",
      "limit": 10,
      "source": "いいことなんてない。",
      "target": "不会有任何好事。"
    },
    {
      "offset": 25710,
      "kind": "line",
      "limit": 9,
      "source": "トラブルを生むだけ",
      "target": "只会招来"
    },
    {
      "offset": 25734,
      "kind": "line",
      "limit": 9,
      "source": "だったんだ。",
      "target": "麻烦而已。"
    },
    {
      "offset": 25752,
      "kind": "line",
      "limit": 5,
      "source": "…クソッ！",
      "target": "…可恶！"
    },
    {
      "offset": 25770,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 25788,
      "kind": "line",
      "limit": 11,
      "source": "結局、貯金はその霊崎朱",
      "target": "结果，存款还是被那个"
    },
    {
      "offset": 25846,
      "kind": "line",
      "limit": 11,
      "source": "とかいう女が持ち去って",
      "target": "叫灵崎朱的女人"
    },
    {
      "offset": 25874,
      "kind": "line",
      "limit": 11,
      "source": "しまったわけか…。",
      "target": "给卷走了…"
    },
    {
      "offset": 25909,
      "kind": "line",
      "limit": 8,
      "source": "暁…すまない…。",
      "target": "晓…对不起…"
    },
    {
      "offset": 25939,
      "kind": "line",
      "limit": 4,
      "source": "………。",
      "target": "………"
    },
    {
      "offset": 25965,
      "kind": "line",
      "limit": 9,
      "source": "ただ、ひとつだけ、",
      "target": "不过，只有一件事，"
    },
    {
      "offset": 25989,
      "kind": "line",
      "limit": 9,
      "source": "忠雄さんには朗報が",
      "target": "对忠雄先生而言"
    },
    {
      "offset": 26013,
      "kind": "line",
      "limit": 9,
      "source": "あります！",
      "target": "是个好消息！"
    },
    {
      "offset": 26042,
      "kind": "line",
      "limit": 3,
      "source": "…ん？",
      "target": "…嗯？"
    },
    {
      "offset": 26056,
      "kind": "line",
      "limit": 10,
      "source": "忠雄さんに金を貸して",
      "target": "据说借钱给"
    },
    {
      "offset": 26082,
      "kind": "line",
      "limit": 10,
      "source": "くれたという、資産家",
      "target": "忠雄先生的那位富豪"
    },
    {
      "offset": 26108,
      "kind": "line",
      "limit": 10,
      "source": "ですが…",
      "target": "已经…"
    },
    {
      "offset": 26131,
      "kind": "line",
      "limit": 11,
      "source": "危篤状態からは回復し、",
      "target": "脱离病危状态，"
    },
    {
      "offset": 26165,
      "kind": "line",
      "limit": 11,
      "source": "今はピンピンしてます。",
      "target": "如今精神得很。"
    },
    {
      "offset": 26195,
      "kind": "line",
      "limit": 5,
      "source": "えっ…!?",
      "target": "什么…！？"
    },
    {
      "offset": 26221,
      "kind": "line",
      "limit": 10,
      "source": "間違いなく、あと",
      "target": "至少再活个"
    },
    {
      "offset": 26243,
      "kind": "line",
      "limit": 10,
      "source": "数年は健在でしょう。",
      "target": "几年绝无问题。"
    },
    {
      "offset": 26269,
      "kind": "line",
      "limit": 9,
      "source": "借金はゆっくり返済",
      "target": "债慢慢还"
    },
    {
      "offset": 26293,
      "kind": "line",
      "limit": 9,
      "source": "すれば大丈夫です！",
      "target": "就行了！"
    },
    {
      "offset": 26319,
      "kind": "line",
      "limit": 10,
      "source": "な…なぜ…？",
      "target": "为…为什么…？"
    },
    {
      "offset": 26337,
      "kind": "line",
      "limit": 10,
      "source": "どうしてそんなこと",
      "target": "你怎么连这种事"
    },
    {
      "offset": 26361,
      "kind": "line",
      "limit": 10,
      "source": "まで、わかるんだ…？",
      "target": "都会知道…？"
    },
    {
      "offset": 26399,
      "kind": "line",
      "limit": 7,
      "source": "…あっ!!",
      "target": "…啊！！"
    },
    {
      "offset": 26413,
      "kind": "line",
      "limit": 7,
      "source": "もしかして…。",
      "target": "难道说…"
    },
    {
      "offset": 26435,
      "kind": "line",
      "limit": 2,
      "source": "…？",
      "target": "…？"
    },
    {
      "offset": 26457,
      "kind": "line",
      "limit": 11,
      "source": "忠雄さん、その資産家は",
      "target": "忠雄先生，那位富豪"
    },
    {
      "offset": 26485,
      "kind": "line",
      "limit": 11,
      "source": "なんという方ですか？",
      "target": "叫什么名字？"
    },
    {
      "offset": 26513,
      "kind": "line",
      "limit": 5,
      "source": "名前か…？",
      "target": "名字吗…？"
    },
    {
      "offset": 26544,
      "kind": "line",
      "limit": 8,
      "source": "御堂丸将云という",
      "target": "他叫御堂丸将云，"
    },
    {
      "offset": 26592,
      "kind": "line",
      "limit": 8,
      "source": "人物だが…。",
      "target": "是这么个人…"
    },
    {
      "offset": 26622,
      "kind": "line",
      "limit": 9,
      "source": "ああ…なるほどね。",
      "target": "啊…原来如此。"
    },
    {
      "offset": 26648,
      "kind": "line",
      "limit": 2,
      "source": "…？",
      "target": "…？"
    },
    {
      "offset": 26677,
      "kind": "line",
      "limit": 6,
      "source": "…こうして。",
      "target": "…就这样。"
    },
    {
      "offset": 26695,
      "kind": "line",
      "limit": 10,
      "source": "事情を説明し、",
      "target": "他们说明了来龙去脉，"
    },
    {
      "offset": 26715,
      "kind": "line",
      "limit": 10,
      "source": "探偵は去っていった。",
      "target": "两位侦探便离开了。"
    },
    {
      "offset": 26744,
      "kind": "line",
      "limit": 7,
      "source": "…とりあえず。",
      "target": "…总而言之。"
    },
    {
      "offset": 26764,
      "kind": "line",
      "limit": 8,
      "source": "事情はなんとなく",
      "target": "事情大致"
    },
    {
      "offset": 26786,
      "kind": "line",
      "limit": 8,
      "source": "わかった。",
      "target": "弄清楚了。"
    },
    {
      "offset": 26802,
      "kind": "line",
      "limit": 7,
      "source": "父と母にどんな",
      "target": "父母之间有着"
    },
    {
      "offset": 26822,
      "kind": "line",
      "limit": 7,
      "source": "過去があり…",
      "target": "怎样的过去…"
    },
    {
      "offset": 26840,
      "kind": "line",
      "limit": 9,
      "source": "どんな事情で自分が",
      "target": "我又是在怎样的"
    },
    {
      "offset": 26864,
      "kind": "line",
      "limit": 9,
      "source": "育てられたのかも",
      "target": "情况下被抚养"
    },
    {
      "offset": 26886,
      "kind": "line",
      "limit": 9,
      "source": "わかった。",
      "target": "长大的。"
    },
    {
      "offset": 26902,
      "kind": "line",
      "limit": 8,
      "source": "私は、完全に誤解",
      "target": "是我彻底"
    },
    {
      "offset": 26924,
      "kind": "line",
      "limit": 8,
      "source": "していたのだ。",
      "target": "误会了父亲。"
    },
    {
      "offset": 26947,
      "kind": "line",
      "limit": 10,
      "source": "父はむしろ、家族に",
      "target": "父亲反而是为了"
    },
    {
      "offset": 26971,
      "kind": "line",
      "limit": 10,
      "source": "被害が及ばないよう、",
      "target": "不让家人受牵连，"
    },
    {
      "offset": 26997,
      "kind": "line",
      "limit": 10,
      "source": "全力を尽くしていた。",
      "target": "拼尽了一切。"
    },
    {
      "offset": 27023,
      "kind": "line",
      "limit": 11,
      "source": "…全力を尽くしていた",
      "target": "…正因为他"
    },
    {
      "offset": 27049,
      "kind": "line",
      "limit": 11,
      "source": "から、これで済んでいた",
      "target": "已拼尽一切，"
    },
    {
      "offset": 27104,
      "kind": "line",
      "limit": 11,
      "source": "のだ。",
      "target": "事情才只到这一步。"
    },
    {
      "offset": 27116,
      "kind": "line",
      "limit": 11,
      "source": "…私が父を恨む…",
      "target": "…我只是"
    },
    {
      "offset": 27138,
      "kind": "line",
      "limit": 11,
      "source": "というだけで。",
      "target": "怨恨了父亲而已。"
    },
    {
      "offset": 27158,
      "kind": "line",
      "limit": 11,
      "source": "父がこれまで、私たち",
      "target": "一想到父亲至今"
    },
    {
      "offset": 27184,
      "kind": "line",
      "limit": 11,
      "source": "母子のために、どれだけ",
      "target": "为我们母子"
    },
    {
      "offset": 27212,
      "kind": "line",
      "limit": 11,
      "source": "苦労をしてきたのかを",
      "target": "吃过多少苦，"
    },
    {
      "offset": 27238,
      "kind": "line",
      "limit": 11,
      "source": "考えると…",
      "target": "我便…"
    },
    {
      "offset": 27254,
      "kind": "line",
      "limit": 8,
      "source": "涙が出てくるほど",
      "target": "甚至喜极而泣，"
    },
    {
      "offset": 27276,
      "kind": "line",
      "limit": 8,
      "source": "嬉しかったのも",
      "target": "这也是"
    },
    {
      "offset": 27296,
      "kind": "line",
      "limit": 8,
      "source": "事実だし…",
      "target": "事实…"
    },
    {
      "offset": 27312,
      "kind": "line",
      "limit": 11,
      "source": "その借金の返済に、",
      "target": "而且他还打算"
    },
    {
      "offset": 27336,
      "kind": "line",
      "limit": 11,
      "source": "私の貯金を使おうとして",
      "target": "用我的积蓄"
    },
    {
      "offset": 27364,
      "kind": "line",
      "limit": 11,
      "source": "いたことも…",
      "target": "偿还那笔债…"
    },
    {
      "offset": 27382,
      "kind": "line",
      "limit": 11,
      "source": "本来なら喜んで支払いに",
      "target": "我本来也一定会"
    },
    {
      "offset": 27410,
      "kind": "line",
      "limit": 11,
      "source": "応じていただろう。",
      "target": "欣然拿钱出来。"
    },
    {
      "offset": 27437,
      "kind": "line",
      "limit": 11,
      "source": "父が言うには、本当は…",
      "target": "听父亲说，他其实…"
    },
    {
      "offset": 27465,
      "kind": "line",
      "limit": 10,
      "source": "最後まで隠し通し、",
      "target": "原本打算隐瞒到底，"
    },
    {
      "offset": 27489,
      "kind": "line",
      "limit": 10,
      "source": "墓場まで持って行く",
      "target": "把秘密带进"
    },
    {
      "offset": 27513,
      "kind": "line",
      "limit": 10,
      "source": "つもりだったらしい。",
      "target": "坟墓里。"
    },
    {
      "offset": 27539,
      "kind": "line",
      "limit": 10,
      "source": "父と母の間に、強固な",
      "target": "正因为父母之间"
    },
    {
      "offset": 27565,
      "kind": "line",
      "limit": 10,
      "source": "信頼があったからこそ",
      "target": "有无比坚固的信任，"
    },
    {
      "offset": 27591,
      "kind": "line",
      "limit": 10,
      "source": "できた、超荒技だった",
      "target": "才敢使出这招"
    },
    {
      "offset": 27617,
      "kind": "line",
      "limit": 10,
      "source": "のだ。",
      "target": "险棋。"
    },
    {
      "offset": 27632,
      "kind": "line",
      "limit": 9,
      "source": "…だから、父の件は",
      "target": "…所以父亲的事"
    },
    {
      "offset": 27656,
      "kind": "line",
      "limit": 9,
      "source": "もう、いい。",
      "target": "已经算了。"
    },
    {
      "offset": 27677,
      "kind": "line",
      "limit": 5,
      "source": "しかし…。",
      "target": "可是…"
    },
    {
      "offset": 27699,
      "kind": "line",
      "limit": 11,
      "source": "…結局私の貯金は、",
      "target": "…我的积蓄终究"
    },
    {
      "offset": 27734,
      "kind": "line",
      "limit": 11,
      "source": "霊崎朱という女が",
      "target": "还是被那个叫灵崎朱"
    },
    {
      "offset": 27775,
      "kind": "line",
      "limit": 11,
      "source": "持ち去ったままなのだ。",
      "target": "的女人卷走了。"
    },
    {
      "offset": 27806,
      "kind": "line",
      "limit": 11,
      "source": "２人の探偵は、今後も",
      "target": "两位侦探向我保证"
    },
    {
      "offset": 27843,
      "kind": "line",
      "limit": 11,
      "source": "霊崎朱の捜索に全力を",
      "target": "今后也会全力"
    },
    {
      "offset": 27888,
      "kind": "line",
      "limit": 11,
      "source": "尽くすと誓ってくれたの",
      "target": "寻找灵崎朱，"
    },
    {
      "offset": 27916,
      "kind": "line",
      "limit": 11,
      "source": "だが…",
      "target": "可是…"
    },
    {
      "offset": 27933,
      "kind": "line",
      "limit": 11,
      "source": "あの２人が協力しても",
      "target": "连他们两人联手"
    },
    {
      "offset": 27976,
      "kind": "line",
      "limit": 11,
      "source": "証拠を見つけられないと",
      "target": "都找不到证据的"
    },
    {
      "offset": 28004,
      "kind": "line",
      "limit": 11,
      "source": "いうような相手だ。",
      "target": "对手。"
    },
    {
      "offset": 28039,
      "kind": "line",
      "limit": 11,
      "source": "癸生川探偵の言う通り、",
      "target": "正如癸生川侦探所说，"
    },
    {
      "offset": 28073,
      "kind": "line",
      "limit": 11,
      "source": "貯金はもう、諦めた方が",
      "target": "那笔积蓄或许还是"
    },
    {
      "offset": 28121,
      "kind": "line",
      "limit": 11,
      "source": "いいかもしれない。",
      "target": "放弃为好。"
    },
    {
      "offset": 28145,
      "kind": "line",
      "limit": 11,
      "source": "…どのみち、明日という",
      "target": "…不管怎样，明天这个",
      "runs": [
        "…不管怎样，",
        "明天这个"
