{
  "script": "c1_01",
  "units": [
    {"offset": 13, "target": "１９９６年６月某日"},
    {"offset": 37, "target": "天气：雨"},
    {"offset": 51, "target": "　"},
    {"offset": 70, "target": "鞠滨市鞠滨台"},
    {"offset": 172, "target": "癸生川侦探事务所前"},
    {"offset": 218, "target": "(我)"},
    {"offset": 244, "target": "…我正犹豫不决。"},
    {"offset": 268, "target": "可我本来就"},
    {"offset": 290, "target": "遇到了麻烦。"},
    {"offset": 312, "target": "碰上麻烦事后，"},
    {"offset": 338, "target": "我边走边苦恼着"},
    {"offset": 366, "target": "该怎么办…"},
    {"offset": 386, "target": "结果在这栋公寓入口"},
    {"offset": 414, "target": "发现了一块侦探"},
    {"offset": 438, "target": "事务所的招牌。"},
    {"offset": 452, "target": "如今来到门前，"},
    {"offset": 478, "target": "我又犹豫着是否可以"},
    {"offset": 506, "target": "进去找他们商量。"},
    {"offset": 537, "target": "招牌上写着："},
    {"offset": 555, "target": "“癸生川侦探事务所”"},
    {"offset": 582, "target": "…就是这个名字。"},
    {"offset": 608, "target": "“承接各类咨询，"},
    {"offset": 636, "target": "欢迎随时来访。”"},
    {"offset": 668, "target": "上面还这样写着。"},
    {"offset": 688, "target": "可自己眼下的麻烦，"},
    {"offset": 714, "target": "真的适合拿到这里"},
    {"offset": 740, "target": "来咨询吗…"},
    {"offset": 768, "target": "会不会只是咨询一下，"},
    {"offset": 796, "target": "就被索要一笔"},
    {"offset": 822, "target": "高得离谱的费用？"},
    {"offset": 850, "target": "这些不安让我迟迟"},
    {"offset": 878, "target": "下不了决心。"},
    {"offset": 904, "target": "…话说这个姓"},
    {"offset": 930, "target": "到底怎么念？"},
    {"offset": 954, "target": "“克布卡瓦”…吗？"},
    {"offset": 978, "target": "我这人优柔寡断得"},
    {"offset": 1006, "target": "就连自己都感到"},
    {"offset": 1049, "target": "厌烦。"},
    {"offset": 1081, "target": "一旦犹豫起来，"},
    {"offset": 1103, "target": "我就很难再"},
    {"offset": 1125, "target": "摆脱这种状态。"},
    {"offset": 1145, "target": "于是便想些无关紧要的"},
    {"offset": 1171, "target": "事，比如招牌上的姓，"},
    {"offset": 1199, "target": "借此转移思绪。"},
    {"offset": 1235, "target": "也就是稍微"},
    {"offset": 1253, "target": "逃避现实。"},
    {"offset": 1271, "target": "就这样迟迟做不出"},
    {"offset": 1299, "target": "决定，时间只顾着"},
    {"offset": 1323, "target": "一点点流逝。"},
    {"offset": 1351, "target": "…就在这时。"},
    {"offset": 1438, "target": "…咦？"},
    {"offset": 1454, "target": "我和一个刚从公寓"},
    {"offset": 1480, "target": "入口出来的女孩"},
    {"offset": 1502, "target": "对上了视线。"},
    {"offset": 1528, "target": "糟了…"},
    {"offset": 1544, "target": "我在雨里呆站着，"},
    {"offset": 1594, "target": "她或许把我当成了"},
    {"offset": 1622, "target": "可疑人物。"},
    {"offset": 1642, "target": "尴尬之下，我转身"},
    {"offset": 1690, "target": "便想尽快离开"},
    {"offset": 1716, "target": "这里。"},
    {"offset": 1736, "target": "…可这时。"},
    {"offset": 1754, "target": "啊，请等一下。"},
    {"offset": 1780, "target": "您该不会是来找"},
    {"offset": 1804, "target": "这家侦探事务所"},
    {"offset": 1830, "target": "的吧？"},
    {"offset": 1852, "target": "咦…？"},
    {"offset": 1878, "target": "看您盯着事务所招牌，"},
    {"offset": 1902, "target": "好像正在犹豫要不要"},
    {"offset": 1930, "target": "进去呢。"},
    {"offset": 1952, "target": "啊，您是这家事务所"},
    {"offset": 1978, "target": "的人吗？"},
    {"offset": 1998, "target": "其实正是这样…"},
    {"offset": 2020, "target": "说真的，多亏您叫住"},
    {"offset": 2048, "target": "了我。"},
    {"offset": 2070, "target": "哈哈，我明白。"},
    {"offset": 2096, "target": "第一次来，确实很难"},
    {"offset": 2120, "target": "鼓起勇气进去。"},
    {"offset": 2158, "target": "我来给您带路吧。"},
    {"offset": 2186, "target": "请跟我来。"},
    {"offset": 2214, "target": "啊，真不好意思。"},
    {"offset": 2238, "target": "您明明正要出门，"},
    {"offset": 2264, "target": "还麻烦您。"},
    {"offset": 2298, "target": "没事，不用介意。"},
    {"offset": 2326, "target": "这里非常欢迎"},
    {"offset": 2348, "target": "客人。"},
    {"offset": 2366, "target": "哈哈…"},
    {"offset": 2380, "target": "…对了，我能问"},
    {"offset": 2404, "target": "一件事吗？"},
    {"offset": 2440, "target": "好的，什么事？"},
    {"offset": 2466, "target": "这家事务所的名字"},
    {"offset": 2490, "target": "到底应该怎么"},
    {"offset": 2510, "target": "念呢…？"},
    {"offset": 2540, "target": "哈哈，这个字确实"},
    {"offset": 2566, "target": "很难认呢。"},
    {"offset": 2592, "target": "念“基布卡瓦”。"},
    {"offset": 2624, "target": "哦，原来如此…"},
    {"offset": 2648, "target": "这个字原来念"},
    {"offset": 2674, "target": "“基布卡瓦”啊…"},
    {"offset": 2698, "target": "请您一定要"},
    {"offset": 2718, "target": "记住哦。"},
    {"offset": 2746, "target": "…那我们走吧。"},
    {"offset": 2801, "target": "好。"},
    {"offset": 2820, "target": "…咦，莉沙小姐。"},
    {"offset": 2862, "target": "你又来了啊。"},
    {"offset": 2886, "target": "啊，凉二先生！委托人", "runs": ["啊，凉二先生！", "委托人"]},
    {"offset": 2922, "target": "我给您带来了！"},
    {"offset": 2950, "target": "咦，委托人…？"},
    {"offset": 2974, "target": "是！"},
    {"offset": 2988, "target": "…您看，就是这位"},
    {"offset": 3021, "target": "先生。"},
    {"offset": 3045, "target": "…打、打扰了。"},
    {"offset": 3069, "target": "那、那个，我有件事"},
    {"offset": 3097, "target": "想请你们帮忙…"},
    {"offset": 3127, "target": "啊，好好。"},
    {"offset": 3149, "target": "无论什么事，我们都"},
    {"offset": 3175, "target": "可以商量。"},
    {"offset": 3193, "target": "屋里很乱，实在抱歉，"},
    {"offset": 3219, "target": "总之请先进来吧。"},
    {"offset": 3249, "target": "啊…谢谢，那我"},
    {"offset": 3273, "target": "就打扰了。"},
    {"offset": 3301, "target": "那我先走啦。"},
    {"offset": 3327, "target": "大叔，希望你的"},
    {"offset": 3347, "target": "烦恼顺利解决。"},
    {"offset": 3371, "target": "再见！"},
    {"offset": 3389, "target": "嗯，好。"},
    {"offset": 3407, "target": "谢谢你。"},
    {"offset": 3427, "target": "……"},
    {"offset": 3439, "target": "大叔…吗。"},
    {"offset": 3459, "target": "我明明才２５岁"},
    {"offset": 3481, "target": "啊…"},
    {"offset": 3530, "target": "请往这边走。"},
    {"offset": 3563, "target": "屋里确实很乱，"},
    {"offset": 3597, "target": "真是不好意思。"},
    {"offset": 3621, "target": "我马上收拾。"},
    {"offset": 3649, "target": "啊，不用，没关系。"},
    {"offset": 3679, "target": "…对了，我还"},
    {"offset": 3703, "target": "没自我介绍。"},
    {"offset": 3723, "target": "我是这里的侦探助手，"},
    {"offset": 3764, "target": "名叫白鹭洲凉二。"},
    {"offset": 3818, "target": "从咨询到实地调查，"},
    {"offset": 3844, "target": "各类工作都由我负责。"},
    {"offset": 3872, "target": "啊，呃…那个，"},
    {"offset": 3896, "target": "我姓蝼川内。", "runs": ["我姓", "蝼川内。"]},
    {"offset": 3962, "target": "全名蝼川内晓。"},
    {"offset": 4010, "target": "２５岁，是公司职员。"},
    {"offset": 4051, "target": "蝼川内先生，对吧。"},
    {"offset": 4081, "target": "请多关照。"},
    {"offset": 4111, "target": "我、我才是。"},
    {"offset": 4144, "target": "环顾四周"},
    {"offset": 4158, "target": "交谈"},
    {"offset": 4166, "target": "调查"},
    {"offset": 4176, "target": "中断"},
    {"offset": 4197, "target": "这里就是事务所的"},
    {"offset": 4221, "target": "会客室…吗？"},
    {"offset": 4247, "target": "对方先把我心里"},
    {"offset": 4269, "target": "想的话说了出来…"},
    {"offset": 4306, "target": "他确实没有谦虚，"},
    {"offset": 4338, "target": "屋里真的很乱。"},
    {"offset": 4369, "target": "潮湿的空气似乎"},
    {"offset": 4395, "target": "让这房间更显得"},
    {"offset": 4439, "target": "沉闷。"},
    {"offset": 4469, "target": "委托内容"},
    {"offset": 4490, "target": "关于父亲"},
    {"offset": 4502, "target": "关于钱"},
    {"offset": 4523, "target": "关于母亲"},
    {"offset": 4535, "target": "关于工厂"},
    {"offset": 4556, "target": "交往对象"},
    {"offset": 4568, "target": "关于女孩"},
    {"offset": 4591, "target": "那么，究竟发生了"},
    {"offset": 4617, "target": "什么事？"},
    {"offset": 4637, "target": "这、这个…"},
    {"offset": 4680, "target": "我就直说了…"},
    {"offset": 4716, "target": "父亲偷走了家里的钱，"},
    {"offset": 4753, "target": "然后失去了踪影，"},
    {"offset": 4793, "target": "让我很头疼。"},
    {"offset": 4817, "target": "您父亲…？"},
    {"offset": 4839, "target": "对。所以我想请你们"},
    {"offset": 4883, "target": "帮忙找到他，"},
    {"offset": 4911, "target": "可以吗…？"},
    {"offset": 4937, "target": "毕竟是家里的事，"},
    {"offset": 4961, "target": "我不想把警察"},
    {"offset": 4987, "target": "牵扯进来…"},
    {"offset": 5015, "target": "没问题，我们也经常"},
    {"offset": 5041, "target": "接受寻人的委托。"},
    {"offset": 5069, "target": "请放心。"},
    {"offset": 5091, "target": "是吗，"},
    {"offset": 5109, "target": "太好了…"},
    {"offset": 5129, "target": "那么，能请您"},
    {"offset": 5149, "target": "再详细说一说"},
    {"offset": 5173, "target": "吗？"},
    {"offset": 5195, "target": "好的。"},
    {"offset": 5226, "target": "在父亲把我的钱"},
    {"offset": 5250, "target": "花掉以前，我无论"},
    {"offset": 5272, "target": "如何也要拿回来。"},
    {"offset": 5348, "target": "我父亲叫"},
    {"offset": 5381, "target": "蝼川内忠雄，"},
    {"offset": 5421, "target": "但是…"},
    {"offset": 5448, "target": "说实话，他从以前起"},
    {"offset": 5476, "target": "就是个糟糕的父亲。"},
    {"offset": 5502, "target": "糟糕…是指？"},
    {"offset": 5543, "target": "从我记事以前起，"},
    {"offset": 5569, "target": "他就几乎不回家，"},
    {"offset": 5595, "target": "一直在外游荡…"},
    {"offset": 5621, "target": "偶尔回来一次，"},
    {"offset": 5645, "target": "也只会强行从母亲"},
    {"offset": 5669, "target": "手里夺走家用，"}
  ]
}
