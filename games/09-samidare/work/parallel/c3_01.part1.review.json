    {
      "offset": 1896,
      "kind": "line",
      "limit": 11,
      "source": "のがわかる。",
      "target": "了。"
    },
    {
      "offset": 1914,
      "kind": "line",
      "limit": 10,
      "source": "それなりに高価な",
      "target": "把这么昂贵的"
    },
    {
      "offset": 1936,
      "kind": "line",
      "limit": 10,
      "source": "機材を放ったらかして",
      "target": "设备放着不管，"
    },
    {
      "offset": 1962,
      "kind": "line",
      "limit": 10,
      "source": "おくということは、",
      "target": "这种情况，"
    },
    {
      "offset": 1986,
      "kind": "line",
      "limit": 10,
      "source": "経営難で工場が潰れた",
      "target": "与其说是经营困难"
    },
    {
      "offset": 2012,
      "kind": "line",
      "limit": 10,
      "source": "というよりは…",
      "target": "导致工厂倒闭…"
    },
    {
      "offset": 2032,
      "kind": "line",
      "limit": 11,
      "source": "従業員が突然、いなく",
      "target": "倒更像是员工突然"
    },
    {
      "offset": 2058,
      "kind": "line",
      "limit": 11,
      "source": "なっただけという感じが",
      "target": "全都消失"
    },
    {
      "offset": 2086,
      "kind": "line",
      "limit": 11,
      "source": "する。",
      "target": "了。"
    },
    {
      "offset": 2098,
      "kind": "line",
      "limit": 10,
      "source": "ここで、何があったの",
      "target": "这里究竟发生了"
    },
    {
      "offset": 2124,
      "kind": "line",
      "limit": 10,
      "source": "だろうか…。",
