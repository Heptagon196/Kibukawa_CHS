    },
    {
      "offset": 1586,
      "kind": "line",
      "limit": 10,
      "source": "ひとまず、機材の",
      "target": "先躲到设备"
    },
    {
      "offset": 1608,
      "kind": "line",
      "limit": 10,
      "source": "陰にでも隠れてよう。",
      "target": "后面吧。"
    },
    {
      "offset": 1649,
      "kind": "choice",
      "limit": 0,
      "source": "機材",
      "target": "设备"
    },
    {
      "offset": 1657,
      "kind": "choice",
      "limit": 0,
      "source": "床",
      "target": "地板"
    },
    {
      "offset": 1663,
      "kind": "choice",
      "limit": 0,
      "source": "裏口",
      "target": "后门"
    },
    {
      "offset": 1680,
      "kind": "choice",
      "limit": 0,
      "source": "事務机",
      "target": "办公桌"
    },
    {
      "offset": 1699,
      "kind": "choice",
      "limit": 0,
      "source": "社員名簿",
      "target": "员工名册"
    },
    {
      "offset": 1720,
      "kind": "choice",
      "limit": 0,
      "source": "金属片",
      "target": "金属碎片"
    },
    {
      "offset": 1739,
      "kind": "line",
      "limit": 10,
      "source": "金属や樹脂を加工する",
      "target": "这里摆着一排加工"
    },
    {
      "offset": 1796,
      "kind": "line",
      "limit": 10,
      "source": "旋盤という機材が",
      "target": "金属、树脂所用的"
    },
    {
      "offset": 1824,
      "kind": "line",
      "limit": 10,
      "source": "並んでいる。",
      "target": "车床。"
    },
    {
      "offset": 1842,
      "kind": "line",
      "limit": 11,
      "source": "積もったホコリから、",
      "target": "从积灰的程度来看，"
