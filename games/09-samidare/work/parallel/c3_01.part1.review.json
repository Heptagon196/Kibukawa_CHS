      "offset": 267,
      "kind": "line",
      "limit": 10,
      "source": "もらった。",
      "target": "下。"
    },
    {
      "offset": 285,
      "kind": "line",
      "limit": 11,
      "source": "どなたか…いますかー？",
      "target": "请问…有人吗——？"
    },
    {
      "offset": 315,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 327,
      "kind": "line",
      "limit": 7,
      "source": "…返事はない。",
      "target": "…没有回应。"
    },
    {
      "offset": 347,
      "kind": "line",
      "limit": 10,
      "source": "しかし、数ヶ月前から",
      "target": "听说从几个月前"
    },
    {
      "offset": 373,
      "kind": "line",
      "limit": 10,
      "source": "突然人の出入りが",
      "target": "开始，就突然没人"
    },
    {
      "offset": 395,
      "kind": "line",
      "limit": 10,
      "source": "なくなったそうだが…",
      "target": "进出了…"
    },
    {
      "offset": 421,
      "kind": "line",
      "limit": 11,
      "source": "ここの従業員や経営者は",
      "target": "这里的员工和经营者"
    },
    {
      "offset": 449,
      "kind": "line",
      "limit": 11,
      "source": "どこに行ってしまったん",
      "target": "究竟都去了哪里"
    },
    {
      "offset": 477,
      "kind": "line",
      "limit": 11,
      "source": "だろうか…。",
      "target": "呢…"
    },
    {
      "offset": 497,
      "kind": "line",
      "limit": 6,
      "source": "さて、と…。",
      "target": "好了…"
    },
    {
      "offset": 529,
      "kind": "choice",
      "limit": 0,
      "source": "場所移動",
      "target": "移动"
    },
    {
      "offset": 541,
      "kind": "choice",
      "limit": 0,
      "source": "辺り見回す",
      "target": "环视四周"
    },
    {
      "offset": 555,
      "kind": "choice",
      "limit": 0,
      "source": "調べる",
      "target": "调查"
    },
    {
      "offset": 565,
      "kind": "choice",
      "limit": 0,
      "source": "中断する",
      "target": "中断"
    },
    {
      "offset": 580,
      "kind": "choice",
      "limit": 0,
      "source": "隠れる",
      "target": "躲藏"
    },
    {
      "offset": 626,
      "kind": "line",
      "limit": 9,
      "source": "昼間だけど、照明が",
      "target": "虽是白天，但没有"
    },
    {
      "offset": 655,
      "kind": "line",
      "limit": 9,
      "source": "点いていないので",
      "target": "开灯，四周"
    },
    {
      "offset": 683,
      "kind": "line",
      "limit": 9,
      "source": "薄暗い。",
      "target": "昏暗。"
    },
    {
      "offset": 697,
      "kind": "line",
      "limit": 11,
      "source": "窓からの薄明かりで、",
      "target": "借着窗外透进的微光"
    },
    {
      "offset": 723,
      "kind": "line",
      "limit": 11,
      "source": "室内の様子がぼんやりと",
      "target": "只能朦胧看清室内的"
    },
    {
      "offset": 751,
      "kind": "line",
      "limit": 11,
      "source": "浮かんでいる感じだ。",
      "target": "样子。"
    },
    {
      "offset": 777,
      "kind": "line",
      "limit": 11,
      "source": "湿気のためか、湿った",
      "target": "大概是因为湿气，"
    },
    {
      "offset": 803,
      "kind": "line",
      "limit": 11,
      "source": "ホコリの匂いが作業場に",
      "target": "车间里弥漫着一股"
    },
    {
      "offset": 844,
      "kind": "line",
      "limit": 11,
      "source": "充満している。",
      "target": "潮湿的灰尘味。"
    },
    {
      "offset": 881,
      "kind": "line",
      "limit": 10,
      "source": "旋盤などの機材も、",
      "target": "车床等设备也都"
    },
    {
      "offset": 911,
      "kind": "line",
      "limit": 10,
      "source": "ホコリが積もったまま",
      "target": "积满灰尘，就这么"
    },
    {
      "offset": 937,
      "kind": "line",
      "limit": 10,
      "source": "放置されていた。",
      "target": "被丢在原地。"
    },
    {
      "offset": 959,
      "kind": "line",
      "limit": 11,
      "source": "確かにこれは、使われ",
      "target": "看来这里确实已经"
    },
    {
      "offset": 985,
      "kind": "line",
      "limit": 11,
      "source": "なくなってから数ヶ月は",
      "target": "停用好几个月"
    },
    {
      "offset": 1013,
      "kind": "line",
      "limit": 11,
      "source": "経っているだろう…。",
      "target": "了…"
    },
    {
      "offset": 1048,
      "kind": "line",
      "limit": 11,
      "source": "工場の隅を見ると、事務",
      "target": "工厂一角有个"
    },
    {
      "offset": 1076,
      "kind": "line",
      "limit": 11,
      "source": "スペースがあり、机が",
      "target": "办公区，桌子",
      "runs": [
