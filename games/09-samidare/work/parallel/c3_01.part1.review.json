      "emphasis": [
        {
          "colour": null,
          "text": "スペースがあり、"
        },
        {
          "colour": 2,
          "text": "机が"
        }
      ]
    },
    {
      "offset": 1115,
      "kind": "line",
      "limit": 11,
      "source": "いくつか並んでいた。",
      "target": "一张张排在那里。"
    },
    {
      "offset": 1141,
      "kind": "line",
      "limit": 8,
      "source": "…この机も、一応",
      "target": "…这张桌子也要查",
      "runs": [
        "…这张",
        "桌子也要查"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "…この"
        },
        {
          "colour": 2,
          "text": "机も、一応"
        }
      ]
    },
    {
      "offset": 1176,
      "kind": "line",
      "limit": 8,
      "source": "調べてみるか…。",
      "target": "一下…"
    },
    {
      "offset": 1207,
      "kind": "line",
      "limit": 11,
      "source": "かつては活気にあふれて",
      "target": "昔日想必充满活力的"
    },
    {
      "offset": 1235,
      "kind": "line",
      "limit": 11,
      "source": "いただろう作業場も、",
      "target": "车间，如今也已"
    },
    {
      "offset": 1261,
      "kind": "line",
      "limit": 11,
      "source": "すっかり寂れている。",
      "target": "彻底荒废。"
    },
    {
      "offset": 1305,
      "kind": "line",
      "limit": 10,
      "source": "かすかに射し込む光の",
      "target": "细小的尘埃在"
    },
    {
      "offset": 1331,
      "kind": "line",
      "limit": 10,
      "source": "中を、小さなホコリが",
      "target": "微弱的光线中"
    },
    {
      "offset": 1357,
      "kind": "line",
      "limit": 10,
      "source": "ゆらゆら舞っていた。",
      "target": "悠悠飘舞。"
    },
    {
      "offset": 1444,
      "kind": "line",
      "limit": 3,
      "source": "…!?",
      "target": "…！？"
    },
    {
      "offset": 1454,
      "kind": "line",
      "limit": 11,
      "source": "裏口から人の気配が…！",
      "target": "后门那边有人…！",
      "runs": [
        "后门那边",
        "有人…！"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "裏口から"
        },
        {
          "colour": 2,
          "text": "人の気配が…！"
        }
      ]
    },
    {
      "offset": 1495,
      "kind": "line",
      "limit": 11,
      "source": "…誰か来る!!",
      "target": "…有人来了！！"
    },
    {
      "offset": 1513,
      "kind": "line",
      "limit": 9,
      "source": "…まずい、",
      "target": "…糟了，"
    },
    {
      "offset": 1529,
      "kind": "line",
      "limit": 9,
