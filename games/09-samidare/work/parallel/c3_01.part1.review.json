    },
    {
      "offset": 116,
      "kind": "line",
      "limit": 10,
      "source": "…工場内は、もぬけの",
      "target": "…工厂里已经空无"
    },
    {
      "offset": 149,
      "kind": "line",
      "limit": 10,
      "source": "空だった。",
      "target": "一人。"
    },
    {
      "offset": 171,
      "kind": "line",
      "limit": 9,
      "source": "正面入口には鍵が",
      "target": "正门虽然上了"
    },
    {
      "offset": 193,
      "kind": "line",
      "limit": 9,
      "source": "かかっていたけど…",
      "target": "锁…"
    },
    {
      "offset": 217,
      "kind": "line",
      "limit": 10,
      "source": "裏口が開いていたので",
      "target": "但后门开着，我就"
    },
    {
      "offset": 243,
      "kind": "line",
      "limit": 10,
      "source": "少し勝手に入らせて",
      "target": "擅自进来了一"
    },
