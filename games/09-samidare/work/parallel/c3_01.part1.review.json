    },
    {
      "offset": 2151,
      "kind": "line",
      "limit": 11,
      "source": "かつては精一杯働いて",
      "target": "这些设备曾经想必也"
    },
    {
      "offset": 2177,
      "kind": "line",
      "limit": 11,
      "source": "いたであろう機材も、",
      "target": "在全力运转，"
    },
    {
      "offset": 2203,
      "kind": "line",
      "limit": 11,
      "source": "今は生気を失っている。",
      "target": "如今却失去了生气。"
    },
    {
      "offset": 2258,
      "kind": "line",
      "limit": 11,
      "source": "床をよく見ると…",
      "target": "仔细看地板…"
    },
    {
      "offset": 2280,
      "kind": "line",
      "limit": 11,
      "source": "ところどころ、ホコリが",
      "target": "有些地方没有"
    },
    {
      "offset": 2308,
      "kind": "line",
      "limit": 11,
      "source": "ない部分があった。",
      "target": "灰尘。"
    },
    {
      "offset": 2332,
      "kind": "line",
      "limit": 10,
      "source": "それほど積もっている",
      "target": "积灰还没有厚到"
    },
    {
      "offset": 2358,
      "kind": "line",
      "limit": 10,
      "source": "わけじゃないので",
      "target": "能让人看清"
    },
    {
      "offset": 2380,
      "kind": "line",
      "limit": 10,
      "source": "ハッキリとしないが…",
      "target": "痕迹的程度…"
    },
    {
      "offset": 2406,
      "kind": "line",
      "limit": 9,
      "source": "誰かが歩いたような",
      "target": "但看起来像是"
    },
    {
      "offset": 2432,
      "kind": "line",
      "limit": 9,
      "source": "足跡にも見える。",
      "target": "有人走过的脚印。"
    },
    {
      "offset": 2460,
      "kind": "line",
      "limit": 10,
      "source": "…どうやらつい最近、",
      "target": "…看来最近，"
    },
    {
      "offset": 2486,
      "kind": "line",
      "limit": 10,
      "source": "ここに誰かが来た",
      "target": "这里曾有人造访",
      "runs": [
        "这里",
        "曾有人造访"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "ここに"
        },
        {
          "colour": 2,
          "text": "誰かが来た"
        }
      ]
    },
    {
      "offset": 2516,
      "kind": "line",
      "limit": 10,
      "source": "ようだ。",
      "target": "过。"
    },
    {
      "offset": 2541,
      "kind": "line",
      "limit": 4,
      "source": "…おや？",
      "target": "…咦？"
    },
    {
      "offset": 2557,
      "kind": "line",
      "limit": 10,
      "source": "部屋の隅の方に、",
      "target": "房间角落里，"
    },
    {
      "offset": 2581,
      "kind": "line",
      "limit": 10,
      "source": "金属片が落ちている。",
      "target": "掉着一块金属碎片。"
    },
    {
      "offset": 2613,
      "kind": "line",
      "limit": 9,
      "source": "この工場で加工した",
      "target": "是这家工厂加工的"
    },
    {
      "offset": 2637,
      "kind": "line",
      "limit": 9,
      "source": "パーツだろうか…？",
      "target": "零件吗…？"
    },
    {
      "offset": 2661,
      "kind": "line",
      "limit": 10,
      "source": "…なんだか気になる。",
      "target": "…总觉得很在意。"
    },
    {
      "offset": 2687,
      "kind": "line",
      "limit": 10,
      "source": "少し調べてみよう。",
      "target": "稍微查一查吧。"
    },
    {
      "offset": 2720,
      "kind": "line",
      "limit": 11,
      "source": "床には、誰かが通った",
      "target": "地板除了有人走过的"
    },
    {
      "offset": 2746,
      "kind": "line",
      "limit": 11,
      "source": "ような跡があった他には",
      "target": "痕迹外，"
    },
    {
      "offset": 2774,
      "kind": "line",
      "limit": 11,
      "source": "特に何もない。",
      "target": "没有别的东西。"
    },
    {
      "offset": 2812,
      "kind": "line",
      "limit": 11,
      "source": "裏口の鍵は開いていた。",
      "target": "后门没有上锁。"
    },
    {
      "offset": 2840,
      "kind": "line",
      "limit": 11,
      "source": "単に、ここを最後に出た",
      "target": "可能只是最后离开"
    },
    {
      "offset": 2868,
      "kind": "line",
      "limit": 11,
      "source": "人が閉め忘れたのか…",
      "target": "这里的人忘了锁…"
    },
    {
      "offset": 2894,
      "kind": "line",
      "limit": 11,
      "source": "それとも誰かが意図的に",
      "target": "也可能是有人故意"
    },
    {
      "offset": 2922,
      "kind": "line",
      "limit": 11,
      "source": "開けたものなのか。",
      "target": "打开的。"
    },
    {
      "offset": 2946,
      "kind": "line",
      "limit": 11,
      "source": "…ともあれ、今は誰でも",
      "target": "…总之现在，谁都能"
    },
    {
      "offset": 2974,
      "kind": "line",
      "limit": 11,
      "source": "簡単にここに出入り",
      "target": "轻易进出"
    },
    {
      "offset": 2998,
      "kind": "line",
      "limit": 11,
      "source": "できる状態だ。",
      "target": "这里。"
    },
    {
      "offset": 3027,
      "kind": "line",
      "limit": 11,
      "source": "裏口の鍵は開いていた。",
      "target": "后门没有上锁。"
    },
    {
      "offset": 3082,
      "kind": "line",
