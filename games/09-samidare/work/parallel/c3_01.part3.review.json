    {
      "offset": 12754,
      "kind": "line",
      "limit": 5,
      "source": "えっ…!?",
      "target": "咦…！？"
    },
    {
      "offset": 12796,
      "kind": "line",
      "limit": 10,
      "source": "驚いてドアを見ると、",
      "target": "我吃惊地望向门口，"
