      "offset": 12870,
      "kind": "line",
      "limit": 10,
      "source": "探偵が立っていた。",
      "target": "侦探正站在那里。"
    },
    {
      "offset": 12894,
      "kind": "line",
      "limit": 10,
      "source": "店内の視線を、完全に",
