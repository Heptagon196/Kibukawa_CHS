{
  "script": "c3_01",
  "batch": "c3_01.part3.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 9611,
      "kind": "line",
      "limit": 10,
      "source": "ふとしたことから",
      "target": "因为一次偶然，"
    },
    {
      "offset": 9633,
      "kind": "line",
      "limit": 10,
      "source": "映画館で知り合って…",
      "target": "我和她在电影院相识…"
    },
    {
      "offset": 9659,
      "kind": "line",
      "limit": 11,
      "source": "そのあと、思い切って",
      "target": "后来我鼓起勇气"
    },
    {
      "offset": 9685,
      "kind": "line",
      "limit": 11,
      "source": "電話番号を聞き出して…",
      "target": "问到她的电话号码…"
    },
    {
      "offset": 9713,
      "kind": "line",
      "limit": 11,
      "source": "食事に誘って、ＯＫして",
      "target": "约她吃饭，听到她"
    },
    {
      "offset": 9741,
      "kind": "line",
      "limit": 11,
      "source": "もらえた時は、どれほど",
      "target": "答应时，我简直"
    },
    {
      "offset": 9769,
      "kind": "line",
      "limit": 11,
      "source": "舞い上がったことか。",
      "target": "欣喜若狂。"
    },
    {
      "offset": 9795,
      "kind": "line",
      "limit": 11,
      "source": "話をしていても、趣味や",
      "target": "我们聊天时，兴趣和"
    },
    {
      "offset": 9823,
      "kind": "line",
      "limit": 11,
      "source": "好みがバッチリ合って…",
      "target": "喜好也完全一致…"
    },
    {
      "offset": 9851,
      "kind": "line",
      "limit": 10,
      "source": "おなじもので、一緒に",
      "target": "能为相同的事一起"
    },
    {
      "offset": 9877,
      "kind": "line",
      "limit": 10,
      "source": "笑ったり楽しんだり",
      "target": "欢笑、感到快乐，"
    },
    {
      "offset": 9901,
      "kind": "line",
      "limit": 10,
      "source": "できる貴重な存在だ。",
      "target": "她是难得的存在。"
    },
    {
      "offset": 9927,
      "kind": "line",
      "limit": 11,
      "source": "ずっと彼女と一緒に",
      "target": "我希望能一直和她"
    },
    {
      "offset": 9951,
      "kind": "line",
      "limit": 11,
      "source": "過ごしたいと、思った。",
      "target": "在一起。"
    },
    {
      "offset": 9979,
      "kind": "line",
      "limit": 9,
      "source": "…だから、彼女から",
      "target": "…所以她向我"
    },
    {
      "offset": 10003,
      "kind": "line",
      "limit": 9,
      "source": "お金の相談をされた",
      "target": "商量钱的事"
    },
    {
      "offset": 10027,
      "kind": "line",
      "limit": 9,
      "source": "時も…",
      "target": "时…"
    },
    {
      "offset": 10039,
      "kind": "line",
      "limit": 11,
      "source": "自分が力になれるならと",
      "target": "我觉得能帮上她，"
    },
    {
      "offset": 10067,
      "kind": "line",
      "limit": 11,
      "source": "喜んでＯＫしたのだ。",
      "target": "便高兴地答应了。"
    },
    {
      "offset": 10093,
      "kind": "line",
      "limit": 11,
      "source": "…だから、彼女のために",
      "target": "…所以为了她，"
    },
    {
      "offset": 10121,
      "kind": "line",
      "limit": 11,
      "source": "早く貯金を見つけない",
      "target": "我必须尽快把存款"
    },
    {
      "offset": 10147,
      "kind": "line",
      "limit": 11,
      "source": "といけない。",
      "target": "找回来。"
    },
    {
      "offset": 10174,
      "kind": "line",
      "limit": 11,
      "source": "彼女は今頃、どうしてる",
      "target": "她现在在做什么"
    },
    {
      "offset": 10202,
      "kind": "line",
      "limit": 11,
      "source": "だろうか…。",
      "target": "呢…"
    },
    {
      "offset": 10220,
      "kind": "line",
      "limit": 9,
      "source": "家族を励ましている",
      "target": "或许正在鼓励"
    },
    {
      "offset": 10262,
      "kind": "line",
      "limit": 9,
      "source": "のかもしれないな。",
      "target": "家人吧。"
    },
    {
      "offset": 10286,
      "kind": "line",
      "limit": 11,
      "source": "…彼女の、今後の運命が",
      "target": "…她今后的命运"
    },
    {
      "offset": 10314,
      "kind": "line",
      "limit": 11,
      "source": "かかってるんだ。",
      "target": "都系在这件事上。"
    },
    {
      "offset": 10336,
      "kind": "line",
      "limit": 11,
      "source": "頑張らないと…。",
      "target": "我一定要努力…"
    },
    {
      "offset": 10379,
      "kind": "line",
      "limit": 11,
      "source": "…思えば、父親のことは",
      "target": "…想来，我对父亲"
    },
    {
      "offset": 10407,
      "kind": "line",
      "limit": 11,
      "source": "何も知らずに、ここまで",
      "target": "一无所知，就这样"
    },
    {
      "offset": 10435,
      "kind": "line",
      "limit": 11,
      "source": "育ってきた。",
      "target": "长大了。"
    },
    {
      "offset": 10453,
      "kind": "line",
      "limit": 11,
      "source": "…と言うより、知りたい",
      "target": "…不如说，我从没"
    },
    {
      "offset": 10481,
      "kind": "line",
      "limit": 11,
      "source": "とも思っていなかった。",
      "target": "想过要了解他。"
    },
    {
      "offset": 10509,
      "kind": "line",
      "limit": 10,
      "source": "何が好きで、嫌いで…",
      "target": "他喜欢什么、讨厌"
    },
    {
      "offset": 10535,
      "kind": "line",
      "limit": 10,
      "source": "どういう生き方をして",
      "target": "什么，又过着怎样"
    },
    {
      "offset": 10561,
      "kind": "line",
      "limit": 10,
      "source": "きたのか、とか…",
      "target": "的人生…"
    },
    {
      "offset": 10583,
      "kind": "line",
      "limit": 11,
      "source": "身近な存在のはずなのに",
      "target": "明明应该是亲近的人"
    },
    {
      "offset": 10611,
      "kind": "line",
      "limit": 11,
      "source": "何も知らないでいる。",
      "target": "我却什么都不知道。"
    },
    {
      "offset": 10637,
      "kind": "line",
      "limit": 9,
      "source": "…やっぱり、これは",
      "target": "…这果然是一种"
    },
    {
      "offset": 10661,
      "kind": "line",
      "limit": 9,
      "source": "異常なのだろうか。",
      "target": "异常吧。"
    },
    {
      "offset": 10685,
      "kind": "line",
      "limit": 11,
      "source": "しかし…これまで父の",
      "target": "可是…父亲过去"
    },
    {
      "offset": 10711,
      "kind": "line",
      "limit": 11,
      "source": "してきたことは、やはり",
      "target": "所做的一切，我果然"
    },
    {
      "offset": 10739,
      "kind": "line",
      "limit": 11,
      "source": "許せない。",
      "target": "无法原谅。"
    },
    {
      "offset": 10755,
      "kind": "line",
      "limit": 11,
      "source": "一度、徹底的に話し合う",
      "target": "我也觉得应该和他"
    },
    {
      "offset": 10783,
      "kind": "line",
      "limit": 11,
      "source": "べきだとは思うが…。",
      "target": "彻底谈一次…"
    },
    {
      "offset": 10809,
      "kind": "line",
      "limit": 8,
      "source": "まったく、どこに",
      "target": "真是的，他究竟"
    },
    {
      "offset": 10831,
      "kind": "line",
      "limit": 8,
      "source": "いるのやら…。",
      "target": "在哪里…"
    },
    {
      "offset": 10860,
      "kind": "line",
      "limit": 4,
      "source": "…もし。",
      "target": "…假如。"
    },
    {
      "offset": 10874,
      "kind": "line",
      "limit": 11,
      "source": "もしも、父が犯人では",
      "target": "假如父亲并不是"
    },
    {
      "offset": 10900,
      "kind": "line",
      "limit": 11,
      "source": "ないとしたら、どうだ？",
      "target": "犯人，会怎样？"
    },
    {
      "offset": 10928,
      "kind": "line",
      "limit": 9,
      "source": "…いや、だとしたら",
      "target": "…不，如果是这样"
    },
    {
      "offset": 10952,
      "kind": "line",
      "limit": 9,
      "source": "他に誰が犯人だと",
      "target": "犯人还能是谁"
    },
    {
      "offset": 10974,
      "kind": "line",
      "limit": 9,
      "source": "いうんだ。",
      "target": "呢。"
    },
    {
      "offset": 10990,
      "kind": "line",
      "limit": 8,
      "source": "まさか、母が…？",
      "target": "难道是母亲…？"
    },
    {
      "offset": 11012,
      "kind": "line",
      "limit": 11,
      "source": "…いや、家の通帳が",
      "target": "…不，家里所有存折"
    },
    {
      "offset": 11036,
      "kind": "line",
      "limit": 11,
      "source": "全て盗まれているのだ。",
      "target": "都被偷走了。"
    },
    {
      "offset": 11064,
      "kind": "line",
      "limit": 10,
      "source": "母がそんなことをする",
      "target": "母亲没有理由做"
    },
    {
      "offset": 11090,
      "kind": "line",
      "limit": 10,
      "source": "意味がない。",
      "target": "这种事。"
    },
    {
      "offset": 11108,
      "kind": "line",
      "limit": 11,
      "source": "やはり、父しかいない。",
      "target": "果然只能是父亲。"
    },
    {
      "offset": 11145,
      "kind": "line",
      "limit": 10,
      "source": "早く捜さなければ…。",
      "target": "必须尽快找到他…"
    },
    {
      "offset": 11189,
      "kind": "line",
      "limit": 10,
      "source": "もし今日中にお金が",
      "target": "如果今天之内找不回"
    },
    {
      "offset": 11213,
      "kind": "line",
      "limit": 10,
      "source": "見つからなかったら…",
      "target": "那些钱…"
    },
    {
      "offset": 11239,
      "kind": "line",
      "limit": 11,
      "source": "仕方ない、僕が借金して",
      "target": "没办法，我就去借债",
      "runs": [
        "没办法，我就",
        "去借债"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "仕方ない、僕が"
        },
        {
          "colour": 2,
          "text": "借金して"
        }
      ]
    },
    {
      "offset": 11280,
      "kind": "line",
      "limit": 11,
      "source": "でも用意しないとな…。",
      "target": "也要凑出来…"
    },
    {
      "offset": 11308,
      "kind": "line",
      "limit": 11,
      "source": "しかし５００万もの大金",
      "target": "可 ５００ 万这种巨款"
    },
    {
      "offset": 11336,
      "kind": "line",
      "limit": 11,
      "source": "そうそう貸してくれる",
      "target": "不会有地方轻易借给"
    },
    {
      "offset": 11362,
      "kind": "line",
      "limit": 11,
      "source": "ところもないから…",
      "target": "我…"
    },
    {
      "offset": 11386,
      "kind": "line",
      "limit": 11,
      "source": "いくつもの金融機関から",
      "target": "只能找好几家金融"
    },
    {
      "offset": 11414,
      "kind": "line",
      "limit": 11,
      "source": "借りれるだけ借りて、",
      "target": "机构，能借多少"
    },
    {
      "offset": 11440,
      "kind": "line",
      "limit": 11,
      "source": "工面するしかないか…。",
      "target": "就借多少了…"
    },
    {
      "offset": 11468,
      "kind": "line",
      "limit": 11,
      "source": "しかし、そういう怪しい",
      "target": "可是听说可疑的放贷"
    },
    {
      "offset": 11496,
      "kind": "line",
      "limit": 11,
      "source": "所は、法外な利子を請求",
      "target": "机构会索要天价"
    },
    {
      "offset": 11524,
      "kind": "line",
      "limit": 11,
      "source": "してきたり…",
      "target": "利息…"
    },
    {
      "offset": 11542,
      "kind": "line",
      "limit": 10,
      "source": "暴力団紛いの連中から",
      "target": "还有近似黑社会的人"
    },
    {
      "offset": 11568,
      "kind": "line",
      "limit": 10,
      "source": "厳しい取り立てを",
      "target": "严酷催债"
    },
    {
      "offset": 11590,
      "kind": "line",
      "limit": 10,
      "source": "されると聞くけど…。",
      "target": "什么的…"
    },
    {
      "offset": 11616,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 11632,
      "kind": "line",
      "limit": 11,
      "source": "…いや、貯金さえ戻って",
      "target": "…不，只要找回存款"
    },
    {
      "offset": 11660,
      "kind": "line",
      "limit": 11,
      "source": "くれば、すぐに返済は",
      "target": "就能马上还清"
    },
    {
      "offset": 11686,
      "kind": "line",
      "limit": 11,
      "source": "できるんだ。",
      "target": "债务。"
    },
    {
      "offset": 11704,
      "kind": "line",
      "limit": 7,
      "source": "大丈夫だろう。",
      "target": "应该没事。"
    },
    {
      "offset": 11733,
      "kind": "line",
      "limit": 11,
      "source": "しかし、偶然貯金と借金",
      "target": "不过存款和借款"
    },
    {
      "offset": 11761,
      "kind": "line",
      "limit": 11,
      "source": "の金額が同じだったのは",
      "target": "金额恰好相同，"
    },
    {
      "offset": 11789,
      "kind": "line",
      "limit": 11,
      "source": "助かったと言うか…",
      "target": "也算帮了大忙…"
    },
    {
      "offset": 11813,
      "kind": "line",
      "limit": 9,
      "source": "足りなかったら、",
      "target": "若是钱不够，"
    },
    {
      "offset": 11835,
      "kind": "line",
      "limit": 9,
      "source": "あぶなかったな…。",
      "target": "就危险了…"
    },
    {
      "offset": 11886,
      "kind": "line",
      "limit": 11,
      "source": "やっぱ、探偵という",
      "target": "果然，当侦探的人"
    },
    {
      "offset": 11910,
      "kind": "line",
      "limit": 11,
      "source": "職業は、変わった人物が",
      "target": "大多都很古怪"
    },
    {
      "offset": 11938,
      "kind": "line",
      "limit": 11,
      "source": "多いのだろうか…。",
      "target": "吗…"
    },
    {
      "offset": 11962,
      "kind": "line",
      "limit": 10,
      "source": "２人とも、それぞれ",
      "target": "那两人虽然各自在"
    },
    {
      "offset": 11986,
      "kind": "line",
      "limit": 10,
      "source": "違う意味でとても",
      "target": "不同意义上都很"
    },
    {
      "offset": 12008,
      "kind": "line",
      "limit": 10,
      "source": "不思議な人だったが…",
      "target": "不可思议…"
    },
    {
      "offset": 12034,
      "kind": "line",
      "limit": 10,
      "source": "なんだか、信用しても",
      "target": "但总觉得似乎可以"
    },
    {
      "offset": 12060,
      "kind": "line",
      "limit": 10,
      "source": "いいような気はする。",
      "target": "相信他们。"
    },
    {
      "offset": 12095,
      "kind": "line",
      "limit": 9,
      "source": "そういえばさっき、",
      "target": "说起来，刚才"
    },
    {
      "offset": 12119,
      "kind": "line",
      "limit": 9,
      "source": "探偵事務所で会った",
      "target": "在侦探事务所见到的"
    },
    {
      "offset": 12143,
      "kind": "line",
      "limit": 9,
      "source": "女の子…",
      "target": "女孩…"
    },
    {
      "offset": 12157,
      "kind": "line",
      "limit": 11,
      "source": "あの子も不思議な感じの",
      "target": "她也是个让人感觉"
    },
    {
      "offset": 12185,
      "kind": "line",
      "limit": 11,
      "source": "する人だったなあ…。",
      "target": "很不可思议的人…"
    },
    {
      "offset": 12211,
      "kind": "line",
      "limit": 11,
      "source": "なんとなく、どこかで",
      "target": "而且总觉得好像"
    },
    {
      "offset": 12237,
      "kind": "line",
      "limit": 11,
      "source": "会ったことがある",
      "target": "在什么地方见过她"
    },
    {
      "offset": 12259,
      "kind": "line",
      "limit": 11,
      "source": "ような感じもするけど。",
      "target": "似的。"
    },
    {
      "offset": 12287,
      "kind": "line",
      "limit": 8,
      "source": "…まあ、これは",
      "target": "…不过这应该"
    },
    {
      "offset": 12307,
      "kind": "line",
      "limit": 8,
      "source": "気のせいだろう。",
      "target": "是错觉吧。"
    },
    {
      "offset": 12338,
      "kind": "line",
      "limit": 9,
      "source": "しかし…探偵さんの",
      "target": "可是…侦探的"
    },
    {
      "offset": 12362,
      "kind": "line",
      "limit": 9,
      "source": "報告はどこで聞けば",
      "target": "报告该去哪里"
    },
    {
      "offset": 12386,
      "kind": "line",
      "limit": 9,
      "source": "いいのだろう。",
      "target": "听呢？"
    },
    {
      "offset": 12406,
      "kind": "line",
      "limit": 10,
      "source": "やっぱりおとなしく、",
      "target": "我果然应该老实"
    },
    {
      "offset": 12432,
      "kind": "line",
      "limit": 10,
      "source": "事務所で待ってるべき",
      "target": "待在事务所等着"
    },
    {
      "offset": 12458,
      "kind": "line",
      "limit": 10,
      "source": "だったのか…？",
      "target": "吗…？"
    },
    {
      "offset": 12543,
      "kind": "line",
      "limit": 8,
      "source": "…と、その瞬間。",
      "target": "…就在这时。"
    },
    {
      "offset": 12565,
      "kind": "line",
      "limit": 9,
      "source": "突然、店のドアが",
      "target": "店门突然“砰”地"
    },
    {
      "offset": 12587,
      "kind": "line",
      "limit": 9,
      "source": "バタン！と大きな",
      "target": "发出一声巨响，"
    },
    {
      "offset": 12609,
      "kind": "line",
      "limit": 9,
      "source": "音を立てて開いた。",
      "target": "被推开了。"
    },
    {
      "offset": 12633,
      "kind": "line",
      "limit": 11,
      "source": "…かと思うと。",
      "target": "…紧接着。"
    },
    {
      "offset": 12653,
      "kind": "line",
      "limit": 11,
      "source": "それと同時に良く通る",
      "target": "一个洪亮的大嗓门"
    },
    {
      "offset": 12679,
      "kind": "line",
      "limit": 11,
      "source": "大きな声が鳴り響いた。",
