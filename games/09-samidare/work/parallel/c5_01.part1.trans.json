    {"offset": 20, "target": "（蝼川内）"},
    {"offset": 59, "target": "终节Ｂ"},
    {"offset": 71, "target": "　"},
    {"offset": 79, "target": "『尽管吩咐』"},
    {"offset": 134, "target": "２００４年６月某日"},
    {"offset": 158, "target": "天气：雨"},
    {"offset": 172, "target": "　"},
    {"offset": 191, "target": "癸生川侦探事务所"},
    {"offset": 263, "target": "…这样啊。"},
    {"offset": 283, "target": "过去还发生过"},
    {"offset": 309, "target": "那样的事啊…"},
    {"offset": 333, "target": "该怎么说呢…"},
    {"offset": 359, "target": "失去喜欢的人"},
    {"offset": 383, "target": "实在是件"},
    {"offset": 409, "target": "很痛苦的事…"},
    {"offset": 437, "target": "不不，都已经"},
    {"offset": 461, "target": "是８年前的事了。"},
    {"offset": 485, "target": "不过…"},
    {"offset": 505, "target": "从那以后，我实在"},
    {"offset": 533, "target": "对恋爱变得胆怯"},
    {"offset": 561, "target": "了…"},
    {"offset": 587, "target": "嗯，我懂。"},
    {"offset": 611, "target": "我太懂了…"},
    {"offset": 641, "target": "结果从那以后"},
    {"offset": 667, "target": "我一直单身到现在…"},
    {"offset": 695, "target": "刚才我在这栋楼"},
    {"offset": 719, "target": "下面看见个戴棒球帽"},
    {"offset": 747, "target": "的男孩…"},
    {"offset": 775, "target": "我有时也会想，"},
    {"offset": 803, "target": "真想要一个那样"},
    {"offset": 827, "target": "活泼的男孩啊。"},
    {"offset": 853, "target": "哦，那个孩子…"},
    {"offset": 873, "target": "应该是刚才迷路后"},
    {"offset": 899, "target": "跑进我们这儿的"},
    {"offset": 925, "target": "孩子。"},
    {"offset": 949, "target": "…他没和爷爷"},
    {"offset": 995, "target": "在一起吗？"},
    {"offset": 1023, "target": "对对，就是。"},
    {"offset": 1047, "target": "那大概"},
    {"offset": 1069, "target": "就是他了。"},
    {"offset": 1091, "target": "哎呀，有家人"},
    {"offset": 1113, "target": "真好啊…"},
    {"offset": 1144, "target": "………"},
    {"offset": 1158, "target": "那、那个…"},
    {"offset": 1176, "target": "打扰你们说话，"},
    {"offset": 1196, "target": "不好意思…"},
    {"offset": 1220, "target": "…啊，好的。"},
    {"offset": 1240, "target": "…那么，你说来这里"},
    {"offset": 1268, "target": "是为了履行"},
    {"offset": 1296, "target": "什么约定呢？"},
    {"offset": 1326, "target": "啊，对了！"},
    {"offset": 1348, "target": "就是这件事…"},
    {"offset": 1370, "target": "８年前，这里的"},
    {"offset": 1392, "target": "侦探向我许下承诺", "runs": ["侦探向我许下", "承诺"]},
    {"offset": 1421, "target": "说要…"},
    {"offset": 1456, "target": "从名叫灵崎朱的女人"},
    {"offset": 1484, "target": "那里，把我５００万日元", "runs": ["那里，把我", "５００万日元"]},
    {"offset": 1517, "target": "的存款追回来…"},
    {"offset": 1547, "target": "…什么？"},
    {"offset": 1573, "target": "一直没等到消息，"},
    {"offset": 1599, "target": "所以我才特意过来"},
    {"offset": 1625, "target": "问问。"},
    {"offset": 1643, "target": "…毕竟已经８年了，"},
    {"offset": 1669, "target": "总该已经替我"},
    {"offset": 1693, "target": "追回来了吧。"},
    {"offset": 1713, "target": "………"},
    {"offset": 1729, "target": "哎呀，我差点"},
    {"offset": 1757, "target": "忘得一干二净。"},
    {"offset": 1783, "target": "是这场时隔８年的大雨"},
    {"offset": 1811, "target": "让我想起来的。"},
    {"offset": 1839, "target": "…伊、伊纲。"},
    {"offset": 1879, "target": "这事…你听说过吗？"},
    {"offset": 1907, "target": "…不，第一次听说。"},
    {"offset": 1933, "target": "…癸生川人呢？"},
    {"offset": 1979, "target": "…又不知道跑到哪儿"},
    {"offset": 2007, "target": "闲逛去了…"},
    {"offset": 2029, "target": "…嗯？"},
    {"offset": 2041, "target": "怎么了吗？"},
    {"offset": 2065, "target": "哇哇哇！"},
    {"offset": 2083, "target": "…没、没什么，"},
    {"offset": 2111, "target": "什么事也没有！"},
    {"offset": 2131, "target": "那、那个…"},
    {"offset": 2149, "target": "不好意思，负责这事的"},
    {"offset": 2173, "target": "人现在不在…"},
    {"offset": 2201, "target": "很抱歉，能不能请您"},
    {"offset": 2229, "target": "改天再来一趟"},
    {"offset": 2257, "target": "呢？"},
    {"offset": 2273, "target": "哦，是这样啊。"},
    {"offset": 2301, "target": "…明白了，那我"},
    {"offset": 2327, "target": "过几天再来"},
    {"offset": 2355, "target": "拜访吧。"},
    {"offset": 2373, "target": "啊，过几天。"},
    {"offset": 2395, "target": "过几天啊…"},
    {"offset": 2421, "target": "好。过２～３天，"},
    {"offset": 2449, "target": "我会再来的。"},
    {"offset": 2471, "target": "到那时负责人"},
    {"offset": 2497, "target": "应该回来了吧。"},
    {"offset": 2521, "target": "那、那个…不，"},
    {"offset": 2545, "target": "大、大概…"},
    {"offset": 2567, "target": "那就到时候"},
    {"offset": 2593, "target": "再来也行。"},
    {"offset": 2619, "target": "啊…好、好。"},
    {"offset": 2645, "target": "…再见。"},
    {"offset": 2681, "target": "哇哇哇…"},
    {"offset": 2699, "target": "他到底给我留下了"},
    {"offset": 2730, "target": "多大的麻烦啊…"},
    {"offset": 2766, "target": "哎呀，真不容易呢。"},
    {"offset": 2796, "target": "等等，你怎么说得"},
    {"offset": 2822, "target": "跟自己没关系似的。"},
    {"offset": 2846, "target": "…不就是别人的事吗。"},
    {"offset": 2872, "target": "听他说话前，也说替他", "runs": ["听他说话前，也说", "替他"]},
    {"offset": 2903, "target": "什么都肯做…"},
    {"offset": 2935, "target": "之类的话。"},
    {"offset": 2959, "target": "…呜呜。"},
    {"offset": 2975, "target": "那…确实，"},
    {"offset": 2997, "target": "我说过。"},
    {"offset": 3017, "target": "我是说过…"},
    {"offset": 3041, "target": "………"},
    {"offset": 3066, "target": "等等，老师——！"},
    {"offset": 3099, "target": "癸生川老师——！"},
    {"offset": 3129, "target": "…真是的，总在"},
    {"offset": 3157, "target": "关键时刻不见人！"},
    {"offset": 3190, "target": "唉…"},
    {"offset": 3222, "target": "伊纲也背负了不少，"},
    {"offset": 3254, "target": "真不容易啊…"},
    {"offset": 3306, "target": "…话说回来。"},
    {"offset": 3328, "target": "继承了传说技艺的"},
    {"offset": 3367, "target": "灵崎朱…吗。"},
    {"offset": 3404, "target": "如果真有"},
    {"offset": 3428, "target": "这样的人…"},
    {"offset": 3448, "target": "那即使身旁的人"},
    {"offset": 3470, "target": "就是她…"},
    {"offset": 3492, "target": "她也一定乔装得"},
    {"offset": 3520, "target": "让人认不出来"},
    {"offset": 3552, "target": "吧…"},
    {"offset": 3566, "target": "啊，可怕可怕…"},
    {"offset": 3602, "target": "真是的，生王先生，"},
    {"offset": 3650, "target": "你怎么还这么"},
    {"offset": 3676, "target": "悠闲啊！"},
    {"offset": 3709, "target": "快准备一下，"},
    {"offset": 3737, "target": "要去调查了！"},
    {"offset": 3765, "target": "什么——！？"},
    {"offset": 3783, "target": "为、为什么我也要…！？"},
    {"offset": 3811, "target": "好啦好啦。"},
    {"offset": 3835, "target": "走，要出发了！"},
    {"offset": 3863, "target": "太惨了…"},
