{
  "script": "c3_01",
  "batch": "c3_01.part4.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 14308,
      "kind": "line",
      "limit": 9,
      "source": "英語で言うなら、",
      "target": "英语就是ＭＩＬＫ"
    },
    {
      "offset": 14330,
      "kind": "line",
      "limit": 9,
      "source": "ミルク・ダズント・",
      "target": "ＮＥＶＥＲ"
    },
    {
      "offset": 14354,
      "kind": "line",
      "limit": 9,
      "source": "リターンだ！",
      "target": "ＲＥＴＵＲＮＳ！"
    },
    {
      "offset": 14374,
      "kind": "line",
      "limit": 9,
      "source": "そ、そんなことを",
      "target": "就算您这么说，"
    },
    {
      "offset": 14396,
      "kind": "line",
      "limit": 9,
      "source": "言われたって、納得",
      "target": "我也不能接受"
    },
    {
      "offset": 14420,
      "kind": "line",
      "limit": 9,
      "source": "できませんよ！",
      "target": "啊！"
    },
    {
      "offset": 14440,
      "kind": "line",
      "limit": 8,
      "source": "理由を…説明して",
      "target": "请告诉我…其中的"
    },
    {
      "offset": 14462,
      "kind": "line",
      "limit": 8,
      "source": "ください。",
      "target": "理由。"
    },
    {
      "offset": 14478,
      "kind": "line",
      "limit": 7,
      "source": "や、やっぱり…",
      "target": "果、果然…"
    },
    {
      "offset": 14498,
      "kind": "line",
      "limit": 10,
      "source": "父がお金を使い込んで",
      "target": "是父亲把钱挥霍一空"
    },
    {
      "offset": 14524,
      "kind": "line",
      "limit": 10,
      "source": "いたんですか？",
      "target": "了吗？"
    },
    {
      "offset": 14556,
      "kind": "line",
      "limit": 4,
      "source": "惜しい！",
      "target": "差一点！"
    },
    {
      "offset": 14572,
      "kind": "line",
      "limit": 7,
      "source": "お、惜しい…？",
      "target": "很、很接近…？"
    },
    {
      "offset": 14620,
      "kind": "line",
      "limit": 10,
      "source": "ついこのあいだ、僕は",
      "target": "就在前不久，我调查过"
    },
    {
      "offset": 14646,
      "kind": "line",
      "limit": 10,
      "source": "とある伝説の詐欺師の",
      "target": "某个传说级骗子",
      "runs": [
        "某个",
        "传说级骗子"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "とある"
        },
        {
          "colour": 2,
          "text": "伝説の詐欺師の"
        }
      ]
    },
    {
      "offset": 14685,
      "kind": "line",
      "limit": 10,
      "source": "調査をしたのだよ。",
      "target": "的身份。"
    },
    {
      "offset": 14711,
      "kind": "line",
      "limit": 4,
      "source": "えっ…？",
      "target": "咦…？"
    },
    {
      "offset": 14725,
      "kind": "line",
      "limit": 10,
      "source": "な、なんですか突然。",
      "target": "怎、怎么突然说这个。"
    },
    {
      "offset": 14751,
      "kind": "line",
      "limit": 9,
      "source": "あ、あの…それが",
      "target": "那、那个…这和"
    },
    {
      "offset": 14773,
      "kind": "line",
      "limit": 9,
      "source": "今回の件と何か…？",
      "target": "这件事有关吗…？"
    },
    {
      "offset": 14799,
      "kind": "line",
      "limit": 9,
      "source": "まあ、聞きたまえ。",
      "target": "你先听我说。"
    },
    {
      "offset": 14842,
      "kind": "line",
      "limit": 10,
      "source": "その詐欺師というのは",
      "target": "那个骗子早在战后"
    },
    {
      "offset": 14868,
      "kind": "line",
      "limit": 10,
      "source": "戦後の昔から全国的に",
      "target": "便开始在全国"
    },
    {
      "offset": 14894,
      "kind": "line",
      "limit": 10,
      "source": "活動していて…",
      "target": "活动…"
    },
    {
      "offset": 14914,
      "kind": "line",
      "limit": 10,
      "source": "その巧妙な手口と、",
      "target": "他的手法极其巧妙，"
    },
    {
      "offset": 14938,
      "kind": "line",
      "limit": 10,
      "source": "絶対に証拠を残さない",
      "target": "而且从不留下"
    },
    {
      "offset": 14964,
      "kind": "line",
      "limit": 10,
      "source": "徹底したやり方で…",
      "target": "任何证据…"
    },
    {
      "offset": 14988,
      "kind": "line",
      "limit": 10,
      "source": "今の今まで、一度",
      "target": "所以直到今天，"
    },
    {
      "offset": 15010,
      "kind": "line",
      "limit": 10,
      "source": "たりとも捕まることが",
      "target": "他一次也没有被"
    },
    {
      "offset": 15036,
      "kind": "line",
      "limit": 10,
      "source": "なければ…",
      "target": "抓住…"
    },
    {
      "offset": 15052,
      "kind": "line",
      "limit": 10,
      "source": "誰ひとり、その正体を",
      "target": "甚至从来没有人"
    },
    {
      "offset": 15078,
      "kind": "line",
      "limit": 10,
      "source": "知るものがいなかった",
      "target": "知道他的真实身份"
    },
    {
      "offset": 15104,
      "kind": "line",
      "limit": 10,
      "source": "らしい。",
      "target": "。"
    },
    {
      "offset": 15118,
      "kind": "line",
      "limit": 11,
      "source": "特に変装が得意だった",
      "target": "尤其擅长易容",
      "runs": [
        "尤其",
        "擅长易容"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "特に"
        },
        {
          "colour": 2,
          "text": "変装が得意だった"
        }
      ]
    },
    {
      "offset": 15157,
      "kind": "line",
      "limit": 11,
      "source": "ようで、うまくその身を",
      "target": "似乎总能巧妙隐藏"
    },
    {
      "offset": 15185,
      "kind": "line",
      "limit": 11,
      "source": "隠しているのだ。",
      "target": "自己的身份。"
    },
    {
      "offset": 15207,
      "kind": "line",
      "limit": 11,
      "source": "そういったことから",
      "target": "正因如此，他被称为"
    },
    {
      "offset": 15231,
      "kind": "line",
      "limit": 11,
      "source": "伝説の詐欺師…極ギサと",
      "target": "传说中的骗子…极恶骗",
      "runs": [
        "传说中的骗子…",
        "极恶骗"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "伝説の詐欺師…"
        },
        {
          "colour": 2,
          "text": "極ギサと"
        }
      ]
    },
    {
      "offset": 15285,
      "kind": "line",
      "limit": 11,
      "source": "呼ばれていた。",
      "target": "。"
    },
    {
      "offset": 15315,
      "kind": "line",
      "limit": 9,
      "source": "裏の世界では、",
      "target": "他在地下世界里"
    },
    {
      "offset": 15335,
      "kind": "line",
      "limit": 9,
      "source": "ちょっとした有名人",
      "target": "似乎也小有"
    },
    {
      "offset": 15359,
      "kind": "line",
      "limit": 9,
      "source": "だったらしいぞ。",
      "target": "名气。"
    },
    {
      "offset": 15383,
      "kind": "line",
      "limit": 9,
      "source": "はあ…。そんな人が",
      "target": "哦…还有这种人"
    },
    {
      "offset": 15407,
      "kind": "line",
      "limit": 9,
      "source": "いたんですか…。",
      "target": "啊…"
    },
    {
      "offset": 15441,
      "kind": "line",
      "limit": 10,
      "source": "年齢不詳。本名不詳。",
      "target": "年龄不详，真名不详。"
    },
    {
      "offset": 15467,
      "kind": "line",
      "limit": 10,
      "source": "性別不詳。住所不定",
      "target": "性别不详，居无定所"
    },
    {
      "offset": 15491,
      "kind": "line",
      "limit": 10,
      "source": "…ということだが、",
      "target": "…虽说如此，"
    },
    {
      "offset": 15515,
      "kind": "line",
      "limit": 11,
      "source": "これまでの調べでは、",
      "target": "但根据至今的调查，"
    },
    {
      "offset": 15543,
      "kind": "line",
      "limit": 11,
      "source": "７０歳くらいの男性だと",
      "target": "已经知道他是约"
    },
    {
      "offset": 15577,
      "kind": "line",
      "limit": 11,
      "source": "わかっていた。",
      "target": "７０ 岁的男性。"
    },
    {
      "offset": 15599,
      "kind": "line",
      "limit": 11,
      "source": "ずいぶん年なんですね。",
      "target": "年纪已经很大了呢。"
    },
    {
      "offset": 15639,
      "kind": "line",
      "limit": 9,
      "source": "なにせ５０年以上も",
      "target": "毕竟活跃了"
    },
    {
      "offset": 15663,
      "kind": "line",
      "limit": 9,
      "source": "現役だったからね。",
      "target": "５０ 多年。"
    },
    {
      "offset": 15687,
      "kind": "line",
      "limit": 10,
      "source": "ただ、その犯行場所も",
      "target": "不过他的作案地点和"
    },
    {
      "offset": 15713,
      "kind": "line",
      "limit": 10,
      "source": "犯行手口も決まった",
      "target": "作案手法都没有固定"
    },
    {
      "offset": 15737,
      "kind": "line",
      "limit": 10,
      "source": "ものはなく…",
      "target": "模式…"
    },
    {
      "offset": 15755,
      "kind": "line",
      "limit": 11,
      "source": "毎回毎回、違う方法で",
      "target": "每一次，都换种手法",
      "runs": [
        "每一次，",
        "都换种手法"
      ],
      "emphasis": [
        {
          "colour": null,
          "text": "毎回毎回、"
        },
        {
          "colour": 2,
          "text": "違う方法で"
        }
      ]
    },
    {
      "offset": 15794,
      "kind": "line",
      "limit": 11,
      "source": "見事に金品を巻き上げて",
      "target": "漂亮地卷走财物后"
    },
    {
      "offset": 15822,
      "kind": "line",
      "limit": 11,
      "source": "去っていくわけだ。",
      "target": "离开。"
    },
    {
      "offset": 15846,
      "kind": "line",
      "limit": 11,
      "source": "しかも、証拠を残さず。",
      "target": "而且不留证据。"
    },
    {
      "offset": 15876,
      "kind": "line",
      "limit": 4,
      "source": "はあ…。",
      "target": "哦…"
    },
    {
      "offset": 15902,
      "kind": "line",
      "limit": 9,
      "source": "時には、あまりにも",
      "target": "有时因为一直"
    },
    {
      "offset": 15926,
      "kind": "line",
      "limit": 9,
      "source": "捕まらないので…",
      "target": "抓不到他…"
    },
    {
      "offset": 15948,
      "kind": "line",
      "limit": 11,
      "source": "もしかすると、そんな",
      "target": "甚至有人怀疑"
    },
    {
      "offset": 15974,
      "kind": "line",
      "limit": 11,
      "source": "人物は元々いないんじゃ",
      "target": "这个人物从一开始就"
    },
    {
      "offset": 16040,
      "kind": "line",
      "limit": 11,
      "source": "ないかとも言われた。",
      "target": "不存在。"
    },
    {
      "offset": 16068,
      "kind": "line",
      "limit": 9,
      "source": "ははあ…。都市伝説",
      "target": "原来如此…就像"
    },
    {
      "offset": 16092,
      "kind": "line",
      "limit": 9,
      "source": "みたいなものだと？",
      "target": "都市传说？"
    },
    {
      "offset": 16118,
      "kind": "line",
      "limit": 11,
      "source": "しかし、その極ギサの兄",
      "target": "但极恶骗的哥哥"
    },
    {
      "offset": 16177,
      "kind": "line",
      "limit": 11,
      "source": "という人物は、確かに",
      "target": "这个人物确实"
    },
    {
      "offset": 16203,
      "kind": "line",
      "limit": 11,
      "source": "存在していたのだ。",
      "target": "存在。"
    },
    {
      "offset": 16227,
      "kind": "line",
      "limit": 10,
      "source": "数々の名前や身分を",
      "target": "他交替使用多个姓名"
    },
    {
      "offset": 16251,
      "kind": "line",
      "limit": 10,
      "source": "使い分け、変装もし、",
      "target": "与身份，又会易容，"
    },
    {
      "offset": 16277,
      "kind": "line",
      "limit": 10,
      "source": "巧みに隠れていた。",
      "target": "一直巧妙躲藏。"
    },
    {
      "offset": 16303,
      "kind": "line",
      "limit": 9,
      "source": "そうなんですか…。",
      "target": "这样啊…"
    },
    {
      "offset": 16339,
      "kind": "line",
      "limit": 11,
      "source": "…で、その人物を捜し",
      "target": "…后来有人委托我"
    },
    {
      "offset": 16365,
      "kind": "line",
      "limit": 11,
      "source": "出せという依頼をされて",
      "target": "把这个人找"
    },
    {
      "offset": 16393,
      "kind": "line",
      "limit": 11,
      "source": "しまったのだよ。",
      "target": "出来。"
    },
    {
      "offset": 16417,
      "kind": "line",
      "limit": 10,
      "source": "えっ…!?",
      "target": "咦…！？"
    },
    {
      "offset": 16431,
      "kind": "line",
      "limit": 10,
      "source": "そんな、何十年も",
      "target": "要找出几十年都"
    },
    {
      "offset": 16453,
      "kind": "line",
      "limit": 10,
      "source": "バレずにいた人を…？",
      "target": "没暴露身份的人…？"
    },
    {
      "offset": 16481,
      "kind": "line",
      "limit": 9,
      "source": "さすがに苦労した！",
      "target": "的确费了很大力气！"
    },
    {
      "offset": 16522,
      "kind": "line",
      "limit": 9,
      "source": "しかし突き止めた！",
      "target": "但我找到了！"
    },
    {
      "offset": 16548,
      "kind": "line",
      "limit": 11,
      "source": "突き止めたんですか!?",
      "target": "您找到他了！？"
    },
    {
      "offset": 16576,
      "kind": "line",
      "limit": 8,
      "source": "突き止めたのだ！",
      "target": "当然找到了！"
    },
    {
      "offset": 16600,
      "kind": "line",
      "limit": 9,
      "source": "それは、すごい…。",
      "target": "这可真厉害…"
    },
    {
      "offset": 16626,
      "kind": "line",
      "limit": 7,
      "source": "驚くのは早い！",
      "target": "惊讶还太早！"
    },
    {
      "offset": 16646,
      "kind": "line",
      "limit": 11,
      "source": "その伝説の詐欺師、",
      "target": "那个传说级骗子，"
    },
    {
      "offset": 16677,
      "kind": "line",
      "limit": 11,
      "source": "極ギサの兄が、現在",
      "target": "极恶骗的哥哥如今"
    },
    {
      "offset": 16725,
      "kind": "line",
      "limit": 11,
      "source": "名乗っていた名前こそ…",
      "target": "名字正是…"
    },
    {
      "offset": 16764,
      "kind": "line",
      "limit": 10,
      "source": "尼子啓三だったのだ！",
      "target": "尼子启三！"
    },
    {
      "offset": 16833,
      "kind": "line",
      "limit": 8,
      "source": "ええええっ…!?",
      "target": "什么——…！？"
    },
    {
      "offset": 16866,
      "kind": "line",
      "limit": 10,
      "source": "逆に言うなら、",
      "target": "换句话说，"
    },
    {
      "offset": 16895,
      "kind": "line",
      "limit": 10,
      "source": "尼子啓三という男は…",
      "target": "尼子启三这个男人…"
    },
    {
      "offset": 16944,
      "kind": "line",
      "limit": 11,
      "source": "一般人の仮面をかぶった",
      "target": "是披着普通人面具的"
    },
    {
      "offset": 16972,
      "kind": "line",
      "limit": 11,
      "source": "大詐欺師だったのだよ！",
      "target": "大骗子！"
    },
    {
      "offset": 17002,
      "kind": "line",
      "limit": 11,
      "source": "そうだったんですか…。",
      "target": "原来是这样…"
    },
    {
      "offset": 17030,
      "kind": "line",
      "limit": 11,
      "source": "じゃあ…そんな人物が、",
      "target": "那么…是这种人"
    },
    {
      "offset": 17058,
      "kind": "line",
      "limit": 11,
      "source": "父を訪ねて来たって",
      "target": "来找过我父亲"
    },
    {
      "offset": 17082,
      "kind": "line",
      "limit": 11,
      "source": "ことですか!?",
      "target": "吗！？"
    },
    {
      "offset": 17102,
      "kind": "line",
      "limit": 5,
      "source": "そうなる！",
      "target": "正是如此！"
    },
    {
      "offset": 17120,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 17157,
      "kind": "line",
      "limit": 11,
      "source": "しかし、尼子はもう",
      "target": "可是尼子早在"
    },
    {
      "offset": 17203,
      "kind": "line",
      "limit": 11,
      "source": "２ヶ月前に死んでいた。",
      "target": "两个月前就死了。"
    },
    {
      "offset": 17239,
      "kind": "line",
      "limit": 8,
      "source": "し、死んで…!?",
      "target": "死、死了…！？"
    },
    {
      "offset": 17261,
      "kind": "line",
      "limit": 8,
      "source": "殺されたようだ。",
      "target": "似乎是被杀的。"
    },
    {
      "offset": 17283,
      "kind": "line",
      "limit": 8,
      "source": "何者かによって。",
      "target": "死于某人之手。"
    },
    {
      "offset": 17307,
      "kind": "line",
      "limit": 5,
      "source": "…………。",
      "target": "…………"
    },
    {
      "offset": 17344,
      "kind": "line",
      "limit": 10,
      "source": "尼子の足取りを追って",
      "target": "我追查尼子的行踪"
    },
    {
      "offset": 17376,
      "kind": "line",
      "limit": 10,
      "source": "いたのだが…",
      "target": "时…"
    },
    {
      "offset": 17394,
      "kind": "line",
      "limit": 11,
      "source": "２ヶ月前のある日からの",
      "target": "发现从两个月前的"
    },
    {
      "offset": 17422,
      "kind": "line",
      "limit": 11,
      "source": "痕跡が、完全に途切れて",
      "target": "某一天开始，他的"
    },
    {
      "offset": 17450,
      "kind": "line",
      "limit": 11,
      "source": "いたのだ。",
      "target": "痕迹彻底中断了。"
    },
    {
      "offset": 17466,
      "kind": "line",
      "limit": 10,
