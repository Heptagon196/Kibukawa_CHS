{
  "script": "c4_00",
  "units": [
    {"offset": 15, "target": "１９９６年６月某日"},
    {"offset": 39, "target": "天气：雨"},
    {"offset": 53, "target": "　"},
    {"offset": 61, "target": "克雷夫制作所"},
    {"offset": 137, "target": "…难道。"},
    {"offset": 153, "target": "没想到，父亲"},
    {"offset": 178, "target": "就在这里…"},
    {"offset": 210, "target": "在得知父亲的"},
    {"offset": 234, "target": "消息后，我…"},
    {"offset": 256, "target": "立刻赶往"},
    {"offset": 280, "target": "这间工厂。"},
    {"offset": 300, "target": "可是…"},
    {"offset": 316, "target": "…果然早已"},
    {"offset": 338, "target": "不在这里了吗…"},
    {"offset": 366, "target": "与工厂尚在运转时"},
    {"offset": 394, "target": "相比，眼前的景象"},
    {"offset": 420, "target": "实在惨不忍睹。"},
    {"offset": 444, "target": "没想到父亲竟是这里的…"},
    {"offset": 477, "target": "…蝼川内先生！"},
    {"offset": 523, "target": "…！？"},
    {"offset": 533, "target": "身后传来一个"},
    {"offset": 557, "target": "呼唤我的声音。"},
    {"offset": 577, "target": "我吃惊地回过头，"},
    {"offset": 601, "target": "只见一名青年"},
    {"offset": 623, "target": "站在那里。"},
    {"offset": 664, "target": "…蝼川内先生。"},
    {"offset": 708, "target": "终于见到你了。"},
    {"offset": 736, "target": "…找了你好久。"},
    {"offset": 767, "target": "你、你是…"},
    {"offset": 787, "target": "谁、谁啊…？"},
    {"offset": 851, "target": "第４节"},
    {"offset": 863, "target": "　"},
    {"offset": 871, "target": "“做个了断吧”"},
    {"offset": 959, "target": "交谈"},
    {"offset": 967, "target": "中断"},
    {"offset": 982, "target": "来龙去脉"},
    {"offset": 1015, "target": "初次见面。"},
    {"offset": 1096, "target": "我是侦探白鹭洲"},
    {"offset": 1137, "target": "凉二。"},
    {"offset": 1161, "target": "侦、侦探…？"},
    {"offset": 1187, "target": "你岳父已经"},
    {"offset": 1235, "target": "不在这里了。"},
    {"offset": 1259, "target": "很遗憾…听说他已经"},
    {"offset": 1287, "target": "去世了。"},
    {"offset": 1313, "target": "…蝼川内忠雄先生。", "runs": ["…蝼川内", "忠雄先生。"]},
    {"offset": 1412, "target": "你、你怎么知道…？"},
    {"offset": 1451, "target": "受你儿子…晓先生"},
    {"offset": 1495, "target": "所托，我一直在"},
    {"offset": 1523, "target": "寻找你。"},
    {"offset": 1547, "target": "…………"},
    {"offset": 1563, "target": "…原来是晓…"},
    {"offset": 1618, "target": "晓先生似乎认为…"},
    {"offset": 1652, "target": "偷走存折的人"},
    {"offset": 1680, "target": "是你。"},
    {"offset": 1702, "target": "原来如此…"},
    {"offset": 1722, "target": "他会那么想"},
    {"offset": 1748, "target": "或许也没办法。"},
    {"offset": 1774, "target": "…你不打算"},
    {"offset": 1798, "target": "否认吗？"},
    {"offset": 1814, "target": "…也差不多。"},
    {"offset": 1924, "target": "………"},
    {"offset": 1938, "target": "其实，是你的岳父"},
    {"offset": 1986, "target": "…水岛寅男先生", "runs": ["…", "水岛寅男先生"]},
    {"offset": 2041, "target": "偷的，对吧。"},
    {"offset": 2073, "target": "………"},
    {"offset": 2087, "target": "…应该是吧。", "runs": ["…", "应该是吧。"]},
    {"offset": 2122, "target": "…所以，你一直在"},
    {"offset": 2146, "target": "寻找父亲。"},
    {"offset": 2174, "target": "…我也…"},
    {"offset": 2188, "target": "我也同样"},
    {"offset": 2208, "target": "需要钱。"},
    {"offset": 2233, "target": "要是岳父没偷…"},
    {"offset": 2267, "target": "我也会去偷。"},
    {"offset": 2293, "target": "…原来如此。"},
    {"offset": 2311, "target": "所以你才说"},
    {"offset": 2339, "target": "都差不多。"},
    {"offset": 2359, "target": "就算找到钱…"},
    {"offset": 2381, "target": "你也没打算归还。"},
    {"offset": 2405, "target": "…所以都一样。"},
    {"offset": 2435, "target": "………"},
    {"offset": 2449, "target": "…你甘愿一直被晓先生"},
    {"offset": 2477, "target": "怀疑下去吗？"},
    {"offset": 2507, "target": "…那也没办法。"},
    {"offset": 2533, "target": "我必须当个坏人，", "runs": ["我必须", "当个坏人，"]},
    {"offset": 2572, "target": "非如此不可。"},
    {"offset": 2594, "target": "…是为了绫子女士"},
    {"offset": 2620, "target": "吧。"},
    {"offset": 2640, "target": "………"},
    {"offset": 2654, "target": "…如果我不当坏人"},
    {"offset": 2680, "target": "绫子就会"},
    {"offset": 2708, "target": "遭人怨恨。"},
    {"offset": 2722, "target": "我有自己的使命。", "runs": ["我有", "自己的使命。"]},
    {"offset": 2761, "target": "在完成使命之前…"},
    {"offset": 2798, "target": "那是…"},
    {"offset": 2812, "target": "…就是还清欠债。", "runs": ["…", "就是还清欠债。"]},
    {"offset": 2853, "target": "…！！"},
    {"offset": 2863, "target": "是绫子告诉你的吗！？"},
    {"offset": 2891, "target": "…绫子竟然连这些"},
    {"offset": 2915, "target": "都知道吗！？"},
    {"offset": 2939, "target": "不，是我的推理。"},
    {"offset": 2967, "target": "这样啊…"},
    {"offset": 2983, "target": "太好了…"},
    {"offset": 3003, "target": "那么，绫子女士的"},
    {"offset": 3029, "target": "医疗费…究竟"},
    {"offset": 3061, "target": "有多少？"},
    {"offset": 3085, "target": "………"},
    {"offset": 3101, "target": "…绫子女士的医疗费"},
    {"offset": 3129, "target": "你全用借来的钱"},
    {"offset": 3157, "target": "支付了。"},
    {"offset": 3173, "target": "而且一直"},
    {"offset": 3197, "target": "没有让家人知道，"},
    {"offset": 3225, "target": "隐瞒至今…"},
    {"offset": 3241, "target": "你花了几十年，"},
    {"offset": 3269, "target": "甚至忙到几乎"},
    {"offset": 3295, "target": "回不了家，拼命工作…"},
    {"offset": 3323, "target": "一点点地偿还", "runs": ["一点点地", "偿还"]},
    {"offset": 3356, "target": "这笔债务。"},
    {"offset": 3382, "target": "…只为不给家人"},
    {"offset": 3408, "target": "增添负担和不安。"},
    {"offset": 3430, "target": "…对吧。"},
    {"offset": 3465, "target": "…………"},
    {"offset": 3484, "target": "…医疗费是两千万。", "runs": ["…医疗费是", "两千万。"]},
    {"offset": 3525, "target": "两千万…"},
    {"offset": 3543, "target": "但问题不在"},
    {"offset": 3567, "target": "这里。"},
    {"offset": 3587, "target": "若只有两千万，"},
    {"offset": 3613, "target": "稍微勉强一下…"},
    {"offset": 3637, "target": "尚且能想办法。"},
    {"offset": 3663, "target": "…不至于耗上"},
    {"offset": 3689, "target": "几十年之久。"},
    {"offset": 3715, "target": "什么…？"},
    {"offset": 3729, "target": "也就是说…"},
    {"offset": 3749, "target": "债务不只有医疗费"},
    {"offset": 3777, "target": "吗！？"},
    {"offset": 3818, "target": "是和解金。"},
    {"offset": 3843, "target": "…和解金？"},
    {"offset": 3885, "target": "…这是五千万。"},
    {"offset": 3911, "target": "…！！"},
    {"offset": 3942, "target": "…大约２６年前，"},
    {"offset": 3966, "target": "我遇见了绫子。"},
    {"offset": 3992, "target": "我们彼此"},
    {"offset": 4019, "target": "相互吸引，开始"},
    {"offset": 4047, "target": "交往。"},
    {"offset": 4074, "target": "…那时，绫子总说"},
    {"offset": 4102, "target": "家里情况复杂…"},
    {"offset": 4130, "target": "一会儿说哥哥闯了祸"},
    {"offset": 4158, "target": "一会儿说妹妹要学费"},
    {"offset": 4184, "target": "用各种理由…"},
    {"offset": 4204, "target": "一次次向我"},
    {"offset": 4228, "target": "借钱。"},
    {"offset": 4252, "target": "………"},
    {"offset": 4268, "target": "我对她的话毫不怀疑，"},
    {"offset": 4296, "target": "四处向亲戚低头求助，"},
    {"offset": 4324, "target": "为她筹钱。"},
    {"offset": 4351, "target": "…可是后来，"},
    {"offset": 4375, "target": "有位亲戚起了疑心"},
    {"offset": 4399, "target": "便…"},
    {"offset": 4413, "target": "委托侦探调查"},
    {"offset": 4437, "target": "绫子的底细。"},
    {"offset": 4465, "target": "侦探…？"},
    {"offset": 4483, "target": "…结果很快出来了。"},
    {"offset": 4509, "target": "他们查明绫子"},
    {"offset": 4533, "target": "没有任何兄弟姐妹…"},
    {"offset": 4559, "target": "调查报告还称，"},
    {"offset": 4589, "target": "她是彻头彻尾的"},
    {"offset": 4621, "target": "婚姻诈骗惯犯。"},
    {"offset": 4662, "target": "什么…！？"},
    {"offset": 4680, "target": "听说她过去多次"},
    {"offset": 4704, "target": "用同样的手法"},
    {"offset": 4728, "target": "骗取男人的钱财。"},
    {"offset": 4752, "target": "还曾生下受骗男人的"},
    {"offset": 4778, "target": "孩子，随后将其"},
    {"offset": 4818, "target": "抛弃。"},
    {"offset": 4838, "target": "从我这里骗走的钱"},
    {"offset": 4864, "target": "全被她挥霍一空，"},
    {"offset": 4892, "target": "一分钱都没剩。"},
    {"offset": 4922, "target": "怎、怎么会…！？"},
    {"offset": 4942, "target": "既然如此，为什么…？"},
    {"offset": 4983, "target": "…我很苦恼。"},
    {"offset": 5005, "target": "听到这份报告后，"},
    {"offset": 5029, "target": "我不知该怎么办。"},
    {"offset": 5055, "target": "…即便如此，我仍深爱"}
  ]
}
