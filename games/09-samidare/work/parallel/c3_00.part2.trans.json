{
  "script": "c3_00",
  "units": [
    {"offset": 5544, "target": "那个人…"},
    {"offset": 5568, "target": "我决心用这一生"},
    {"offset": 5594, "target": "始终相信他，"},
    {"offset": 5616, "target": "绝不动摇。"},
    {"offset": 5642, "target": "原来如此…"},
    {"offset": 5660, "target": "原来还有"},
    {"offset": 5680, "target": "这段往事。"},
    {"offset": 5702, "target": "这样一来，"},
    {"offset": 5724, "target": "即使过了漫长的"},
    {"offset": 5746, "target": "25 年…"},
    {"offset": 5768, "target": "您也就能默默地"},
    {"offset": 5792, "target": "一直信任他了。"},
    {"offset": 5812, "target": "哪里。"},
    {"offset": 5824, "target": "…让您见笑了。"},
    {"offset": 5878, "target": "关于晓"},
    {"offset": 5888, "target": "关于忠雄"},
    {"offset": 5920, "target": "晓是经历那些事"},
    {"offset": 5950, "target": "才出生的孩子…"},
    {"offset": 5974, "target": "所以…"},
    {"offset": 5986, "target": "我对他的感情"},
    {"offset": 6010, "target": "一定很深。"},
    {"offset": 6036, "target": "为了让他靠自己"},
    {"offset": 6060, "target": "走上幸福之路…"},
    {"offset": 6084, "target": "我严格管教，也教了"},
    {"offset": 6110, "target": "他许多事情，"},
    {"offset": 6136, "target": "将他养大。"},
    {"offset": 6162, "target": "所以…"},
    {"offset": 6183, "target": "我想相信，他不会"},
    {"offset": 6215, "target": "轻易上诈骗的当…"},
    {"offset": 6243, "target": "可是…"},
    {"offset": 6271, "target": "如果那也是他自己"},
    {"offset": 6297, "target": "选择的路…我是否"},
    {"offset": 6325, "target": "不该插嘴呢。"},
    {"offset": 6370, "target": "…看来我也是个"},
    {"offset": 6392, "target": "溺爱孩子的母亲。"},
    {"offset": 6420, "target": "…不会，我觉得"},
    {"offset": 6444, "target": "这很好。"},
    {"offset": 6464, "target": "接下来成了我的"},
    {"offset": 6492, "target": "身世故事，不过…"},
    {"offset": 6529, "target": "我母亲的身体"},
    {"offset": 6551, "target": "不适合生孩子，"},
    {"offset": 6575, "target": "医生是这么说的。"},
    {"offset": 6601, "target": "如果勉强生产，"},
    {"offset": 6625, "target": "母子两人的性命"},
    {"offset": 6649, "target": "都无法保证…"},
    {"offset": 6677, "target": "天哪…"},
    {"offset": 6691, "target": "是因为疾病"},
    {"offset": 6711, "target": "之类的吗？"},
    {"offset": 6729, "target": "是的。"},
    {"offset": 6741, "target": "听说是先天性"},
    {"offset": 6765, "target": "疾病。"},
    {"offset": 6789, "target": "哎呀…"},
    {"offset": 6811, "target": "即使如此…母亲"},
    {"offset": 6833, "target": "还是像这样生下"},
    {"offset": 6857, "target": "了我。"},
    {"offset": 6877, "target": "我为这样的母亲"},
    {"offset": 6903, "target": "感到自豪…"},
    {"offset": 6925, "target": "也会珍惜她冒着"},
    {"offset": 6951, "target": "重重危险赐予我的"},
    {"offset": 6979, "target": "生命，"},
    {"offset": 6999, "target": "时刻提醒自己，"},
    {"offset": 7023, "target": "要活得不留"},
    {"offset": 7049, "target": "遗憾。"},
    {"offset": 7078, "target": "所以，晓先生或许"},
    {"offset": 7126, "target": "也怀着同样的"},
    {"offset": 7154, "target": "心情吧。"},
    {"offset": 7184, "target": "但愿…"},
    {"offset": 7200, "target": "如此吧。"},
    {"offset": 7245, "target": "希望他不会被坏人"},
    {"offset": 7273, "target": "欺骗…"},
    {"offset": 7309, "target": "您遭遇车祸时，"},
    {"offset": 7353, "target": "已经和忠雄先生"},
    {"offset": 7381, "target": "结婚了吗？"},
    {"offset": 7401, "target": "其实…"},
    {"offset": 7415, "target": "我们是在出院后"},
    {"offset": 7439, "target": "才结婚的…"},
    {"offset": 7465, "target": "啊，原来如此。"},
    {"offset": 7487, "target": "是那件事促成了"},
    {"offset": 7513, "target": "你们结婚吧。"},
    {"offset": 7543, "target": "是的。"},
    {"offset": 7561, "target": "那么，忠雄先生"},
    {"offset": 7585, "target": "行为发生变化，"},
    {"offset": 7611, "target": "究竟是在"},
    {"offset": 7633, "target": "什么时候？"},
    {"offset": 7677, "target": "这么说来…"},
    {"offset": 7701, "target": "出院时，他就已经"},
    {"offset": 7733, "target": "有些不对劲了。"},
    {"offset": 7759, "target": "我记得是这样。"},
    {"offset": 7779, "target": "嗯…"},
    {"offset": 7817, "target": "…那个，我有件事"},
    {"offset": 7839, "target": "有些在意…"},
    {"offset": 7869, "target": "什么？"},
    {"offset": 7883, "target": "25 年前那场事故"},
    {"offset": 7907, "target": "的住院费，都是"},
    {"offset": 7933, "target": "忠雄先生付的吗？"},
    {"offset": 7963, "target": "…嗯，应该"},
    {"offset": 7985, "target": "是吧。"},
    {"offset": 8013, "target": "………"},
    {"offset": 8029, "target": "那个，怎么了…？"},
    {"offset": 8053, "target": "没什么，只是"},
    {"offset": 8073, "target": "那么大规模的"},
    {"offset": 8095, "target": "住院治疗…"},
    {"offset": 8120, "target": "治疗费应该相当"},
    {"offset": 8146, "target": "庞大。"},
    {"offset": 8174, "target": "是吗？"},
    {"offset": 8196, "target": "大约有多少…？"},
    {"offset": 8220, "target": "您还进过重症"},
    {"offset": 8246, "target": "监护室…"},
    {"offset": 8270, "target": "恐怕要几千万日元", "runs": ["恐怕要", "几千万日元"]},
    {"offset": 8302, "target": "那么多。"},
    {"offset": 8326, "target": "我是这么想的。"},
    {"offset": 8346, "target": "什么！？"},
    {"offset": 8362, "target": "怎么会…"},
    {"offset": 8376, "target": "不可能有"},
    {"offset": 8394, "target": "这种事！"},
    {"offset": 8412, "target": "我们不可能有"},
    {"offset": 8438, "target": "那么多钱！"},
    {"offset": 8466, "target": "可是…实际上，"},
    {"offset": 8490, "target": "我想确实需要"},
    {"offset": 8512, "target": "那么多…"},
    {"offset": 8536, "target": "怎么会…几千万日元"},
    {"offset": 8564, "target": "我们怎么可能"},
    {"offset": 8590, "target": "付得起！"},
    {"offset": 8612, "target": "…您否定得相当"},
    {"offset": 8636, "target": "强烈呢…"},
    {"offset": 8658, "target": "因为，这太…"},
    {"offset": 8682, "target": "………"},
    {"offset": 8707, "target": "………"},
    {"offset": 8723, "target": "…不行，她似乎"},
    {"offset": 8747, "target": "什么都不肯说了…"},
    {"offset": 8775, "target": "…没办法。"},
    {"offset": 8793, "target": "能在这里问到的"},
    {"offset": 8815, "target": "大概就这些了。"},
    {"offset": 8911, "target": "…动摇很明显。", "runs": ["…", "动摇很明显。"]},
    {"offset": 8946, "target": "似乎还在害怕什么", "runs": ["似乎还在", "害怕什么"]},
    {"offset": 8985, "target": "的样子。"},
    {"offset": 9013, "target": "…看她的反应，"},
    {"offset": 9041, "target": "当时确实发生过"},
    {"offset": 9069, "target": "什么。"},
    {"offset": 9093, "target": "先随便聊几句，"},
    {"offset": 9121, "target": "就看她的反应来试探", "runs": ["就", "看她的反应来试探"]},
    {"offset": 9178, "target": "一下吧。"},
    {"offset": 9201, "target": "…隐约有股紧张感", "runs": ["…隐约有股", "紧张感"]},
    {"offset": 9236, "target": "似乎加剧了。"},
    {"offset": 9262, "target": "看来不远不近，"},
    {"offset": 9286, "target": "有些关系吧…"},
    {"offset": 9312, "target": "看来，结婚似乎"},
    {"offset": 9334, "target": "不是关键。"},
    {"offset": 9376, "target": "…！"},
    {"offset": 9386, "target": "明显生出强烈紧张感", "runs": ["明显生出强烈", "紧张感"]},
    {"offset": 9423, "target": "来。"},
    {"offset": 9445, "target": "…对了。"},
    {"offset": 9461, "target": "说到 25 年前，"},
    {"offset": 9487, "target": "正是 25 岁的晓"},
    {"offset": 9535, "target": "先生出生那年…"},
    {"offset": 9559, "target": "果然，生产与此大有", "runs": ["果然，", "生产与此大有"]},
    {"offset": 9598, "target": "关系。"},
    {"offset": 9655, "target": "情绪没有明显变化。"},
    {"offset": 9683, "target": "…看来欠债与此"},
    {"offset": 9709, "target": "无关。"},
    {"offset": 9730, "target": "她听到生产二字时"},
    {"offset": 9752, "target": "反应非常强烈。"},
    {"offset": 9780, "target": "…问问看吧。"},
    {"offset": 9809, "target": "…情绪平静"},
    {"offset": 9833, "target": "下来了。"},
    {"offset": 9849, "target": "现在应该愿意说了。"},
    {"offset": 9880, "target": "…？"},
    {"offset": 9892, "target": "她在害怕…吗？"},
    {"offset": 9924, "target": "似乎感受到一种"},
    {"offset": 9948, "target": "看到难以置信之物"},
    {"offset": 9974, "target": "时的恐惧。"},
    {"offset": 9998, "target": "…刚才的话里，"},
    {"offset": 10024, "target": "究竟有什么…"},
    {"offset": 10070, "target": "…那么，我就"},
    {"offset": 10092, "target": "先告辞了。"},
    {"offset": 10118, "target": "谢谢您告诉我"},
    {"offset": 10144, "target": "这么多事情。"},
    {"offset": 10166, "target": "非常感谢。"},
    {"offset": 10188, "target": "啊…哪、哪里。"},
    {"offset": 10212, "target": "如果还有什么"},
    {"offset": 10236, "target": "线索，我会告诉"},
    {"offset": 10258, "target": "您的。"},
    {"offset": 10278, "target": "好…拜托了。"},
    {"offset": 10306, "target": "告辞。"},
    {"offset": 10376, "target": "接下来…"},
    {"offset": 10394, "target": "去找忠雄先生曾经"},
    {"offset": 10422, "target": "工作过的小工厂"},
    {"offset": 10470, "target": "吧…"},
    {"offset": 10492, "target": "名字好像是…"},
    {"offset": 10517, "target": "回想"},
    {"offset": 10529, "target": "中断"},
    {"offset": 10550, "target": "克雷夫制作所"},
    {"offset": 10575, "target": "克罗斯制作所"},
    {"offset": 10600, "target": "克拉姆制作所"},
    {"offset": 10616, "target": "克罗斯制作所…"},
    {"offset": 10636, "target": "…应该不是"},
    {"offset": 10656, "target": "这个。"},
    {"offset": 10674, "target": "呃，好像是…"},
    {"offset": 10705, "target": "克拉姆制作所…"},
    {"offset": 10725, "target": "…应该不叫"}
  ]
}
