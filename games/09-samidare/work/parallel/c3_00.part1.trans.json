{
  "script": "c3_00",
  "units": [
    {"offset": 13, "target": "１９９６年６月某日"},
    {"offset": 37, "target": "天气：雨"},
    {"offset": 51, "target": "　"},
    {"offset": 72, "target": "蝼川内家　客厅"},
    {"offset": 158, "target": "…那个，还能再"},
    {"offset": 182, "target": "问您一个问题"},
    {"offset": 222, "target": "吗？"},
    {"offset": 240, "target": "为了追查忠雄先生"},
    {"offset": 286, "target": "的下落，我想先问清"},
    {"offset": 314, "target": "一件事…"},
    {"offset": 332, "target": "请问吧。"},
    {"offset": 356, "target": "能告诉我 25 年前"},
    {"offset": 388, "target": "发生过什么事"},
    {"offset": 414, "target": "吗？"},
    {"offset": 442, "target": "……！"},
    {"offset": 456, "target": "听您刚才所说…"},
    {"offset": 500, "target": "忠雄先生似乎从"},
    {"offset": 526, "target": "25 年前开始变了"},
    {"offset": 552, "target": "个人…"},
    {"offset": 574, "target": "所以我想知道，那时"},
    {"offset": 602, "target": "究竟发生了什么。"},
    {"offset": 630, "target": "………"},
    {"offset": 646, "target": "这只是我个人的"},
    {"offset": 668, "target": "想法…"},
    {"offset": 686, "target": "您会下定决心"},
    {"offset": 723, "target": "一辈子信任"},
    {"offset": 753, "target": "忠雄先生…"},
    {"offset": 775, "target": "恐怕也和当时"},
    {"offset": 797, "target": "发生的事情"},
    {"offset": 819, "target": "有关吧？"},
    {"offset": 850, "target": "………"},
    {"offset": 880, "target": "第３节"},
    {"offset": 892, "target": "　"},
    {"offset": 900, "target": "“与别人，在别的家”"},
    {"offset": 995, "target": "移动地点"},
    {"offset": 1007, "target": "交谈"},
    {"offset": 1015, "target": "观察"},
    {"offset": 1023, "target": "中断"},
    {"offset": 1082, "target": "………"},
    {"offset": 1110, "target": "25 年前，究竟"},
    {"offset": 1136, "target": "发生了什么…"},
    {"offset": 1160, "target": "难道是…"},
    {"offset": 1186, "target": "与结婚有关吧？"},
    {"offset": 1221, "target": "与生产有关吧？"},
    {"offset": 1256, "target": "与欠债有关吧？"},
    {"offset": 1282, "target": "…不，先"},
    {"offset": 1306, "target": "把反应看仔细吧。", "runs": ["把反应", "看仔细吧。"]},
    {"offset": 1365, "target": "与结婚有关吧？"},
    {"offset": 1401, "target": "………"},
    {"offset": 1440, "target": "与生产有关吧？"},
    {"offset": 1476, "target": "………"},
    {"offset": 1515, "target": "与欠债有关吧？"},
    {"offset": 1551, "target": "………"},
    {"offset": 1595, "target": "果然…晓先生"},
    {"offset": 1637, "target": "出生时发生过"},
    {"offset": 1661, "target": "什么吧。"},
    {"offset": 1685, "target": "………"},
    {"offset": 1709, "target": "…总觉得内心深处"},
    {"offset": 1735, "target": "都被您看透了"},
    {"offset": 1761, "target": "呢。"},
    {"offset": 1775, "target": "真是一位奇妙的"},
    {"offset": 1797, "target": "侦探…"},
    {"offset": 1817, "target": "您愿意说了…对吧。"},
    {"offset": 1857, "target": "………"},
    {"offset": 1882, "target": "那是…让我想想。"},
    {"offset": 1908, "target": "…25 年前，我怀上"},
    {"offset": 1961, "target": "晓大约半年"},
    {"offset": 1996, "target": "的时候吧。"},
    {"offset": 2038, "target": "我开车时"},
    {"offset": 2060, "target": "卷入交通事故，"},
    {"offset": 2086, "target": "受了重伤…"},
    {"offset": 2124, "target": "昏迷不醒，病情危重", "runs": ["昏迷不醒，", "病情危重"]},
    {"offset": 2159, "target": "到了生死关头。"},
    {"offset": 2189, "target": "怀孕时出了车祸…！？"},
    {"offset": 2227, "target": "毕竟从事故发生的"},
    {"offset": 2253, "target": "那一刻起，我就一直"},
    {"offset": 2281, "target": "没有意识…"},
    {"offset": 2307, "target": "所以当时的事，"},
    {"offset": 2329, "target": "我也记得不太"},
    {"offset": 2353, "target": "清楚…"},
    {"offset": 2387, "target": "据说我的伤势很重，"},
    {"offset": 2415, "target": "别说腹中的孩子…"},
    {"offset": 2441, "target": "就连我自己都性命"},
    {"offset": 2469, "target": "垂危。"},
    {"offset": 2495, "target": "听说是这样。"},
    {"offset": 2513, "target": "……"},
    {"offset": 2527, "target": "不过…当我隐约"},
    {"offset": 2555, "target": "恢复意识时…"},
    {"offset": 2581, "target": "我自己不知为何，"},
    {"offset": 2616, "target": "已经看开了。"},
    {"offset": 2652, "target": "…人会这样"},
    {"offset": 2672, "target": "吗？"},
    {"offset": 2692, "target": "会…吧。"},
    {"offset": 2730, "target": "醒来时，我知道"},
    {"offset": 2758, "target": "自己正躺在医院"},
    {"offset": 2784, "target": "的病床上。"},
    {"offset": 2810, "target": "我也隐约想起…"},
    {"offset": 2834, "target": "自己遭遇了"},
    {"offset": 2874, "target": "车祸。"},
    {"offset": 2902, "target": "一看，全身上下"},
    {"offset": 2930, "target": "接满了各种管子"},
    {"offset": 2954, "target": "和电线…"},
    {"offset": 2976, "target": "可是…身体的感觉", "runs": ["可是…", "身体的感觉"]},
    {"offset": 3028, "target": "却完全消失了。"},
    {"offset": 3067, "target": "身体…没有感觉？"},
    {"offset": 3101, "target": "是的…"},
    {"offset": 3115, "target": "不只是手脚，"},
    {"offset": 3141, "target": "连眼睛和嘴"},
    {"offset": 3167, "target": "都动不了…"},
    {"offset": 3193, "target": "我甚至感觉不到"},
    {"offset": 3248, "target": "自己有没有身体。"},
    {"offset": 3276, "target": "仿佛…自己只剩下"},
    {"offset": 3304, "target": "一颗头颅，"},
    {"offset": 3330, "target": "就是那种感觉。"},
    {"offset": 3356, "target": "……"},
    {"offset": 3370, "target": "想到这里…"},
    {"offset": 3390, "target": "我便觉得，啊…"},
    {"offset": 3418, "target": "我要死了。"},
    {"offset": 3438, "target": "奇怪的是，"},
    {"offset": 3460, "target": "我完全没有感到"},
    {"offset": 3484, "target": "害怕。"},
    {"offset": 3504, "target": "该说是自然就明白了"},
    {"offset": 3530, "target": "吧。"},
    {"offset": 3556, "target": "明白死亡…吗？"},
    {"offset": 3584, "target": "…是啊。"},
    {"offset": 3604, "target": "身体会清楚地"},
    {"offset": 3626, "target": "知道死期…"},
    {"offset": 3652, "target": "等那一刻来临，"},
    {"offset": 3680, "target": "人就会自然地"},
    {"offset": 3718, "target": "接受死亡。"},
    {"offset": 3746, "target": "哦，原来如此…"},
    {"offset": 3770, "target": "可是…您最后还是"},
    {"offset": 3796, "target": "像这样活下来了。"},
    {"offset": 3822, "target": "母子都平安。"},
    {"offset": 3840, "target": "问题就在这里…"},
    {"offset": 3862, "target": "此后详细的"},
    {"offset": 3897, "target": "经过，我也"},
    {"offset": 3923, "target": "不太清楚…"},
    {"offset": 3949, "target": "回过神来，我已经"},
    {"offset": 3973, "target": "被转进设备极其先进"},
    {"offset": 4001, "target": "的医院…"},
    {"offset": 4015, "target": "还被送进了"},
    {"offset": 4041, "target": "所谓的重症监护室"},
    {"offset": 4063, "target": "接受治疗。"},
    {"offset": 4117, "target": "那时您仍然"},
    {"offset": 4143, "target": "意识模糊吗？"},
    {"offset": 4173, "target": "意识已经清醒了"},
    {"offset": 4199, "target": "许多，可是…"},
    {"offset": 4223, "target": "似乎还是缺少"},
    {"offset": 4258, "target": "活下去的意志。"},
    {"offset": 4290, "target": "我记得是这样。"},
    {"offset": 4316, "target": "原来如此。"},
    {"offset": 4332, "target": "您只是任由医生"},
    {"offset": 4358, "target": "为您治疗而已"},
    {"offset": 4382, "target": "吧。"},
    {"offset": 4398, "target": "…是的。"},
    {"offset": 4412, "target": "所以当时，我自己"},
    {"offset": 4440, "target": "都成了那副样子…"},
    {"offset": 4464, "target": "便以为腹中的孩子"},
    {"offset": 4488, "target": "早就已经"},
    {"offset": 4514, "target": "死了。"},
    {"offset": 4536, "target": "…或者说，"},
    {"offset": 4556, "target": "就连自己曾经怀孕"},
    {"offset": 4582, "target": "这件事，也从脑海中"},
    {"offset": 4608, "target": "彻底消失了。"},
    {"offset": 4634, "target": "所以…"},
    {"offset": 4650, "target": "…所以？"},
    {"offset": 4686, "target": "其实，我腹中的孩子"},
    {"offset": 4714, "target": "早已通过剖宫产"},
    {"offset": 4742, "target": "被取出…"},
    {"offset": 4754, "target": "在另一个房间"},
    {"offset": 4778, "target": "接受治疗，四肢健全"},
    {"offset": 4804, "target": "地成长着。"},
    {"offset": 4828, "target": "得知此事时…我才"},
    {"offset": 4854, "target": "第一次从心底"},
    {"offset": 4880, "target": "想要活下去。"},
    {"offset": 4902, "target": "啊，所以您才"},
    {"offset": 4920, "target": "活了下来。"},
    {"offset": 4946, "target": "而为了救我"},
    {"offset": 4970, "target": "和孩子…"},
    {"offset": 4988, "target": "一直照顾我、为医院"},
    {"offset": 5016, "target": "的事奔走，竭尽全力"},
    {"offset": 5044, "target": "帮助我们的人…"},
    {"offset": 5100, "target": "正是我现在的"},
    {"offset": 5118, "target": "丈夫忠雄。"},
    {"offset": 5138, "target": "如果没有他，"},
    {"offset": 5166, "target": "我和孩子肯定…"},
    {"offset": 5190, "target": "都无法活下来"},
    {"offset": 5218, "target": "吧。"},
    {"offset": 5238, "target": "原来是这样…"},
    {"offset": 5268, "target": "之后我顺利康复，"},
    {"offset": 5296, "target": "也多亏不断进行"},
    {"offset": 5324, "target": "复健…"},
    {"offset": 5340, "target": "没有留下严重后遗症，"},
    {"offset": 5375, "target": "还能和孩子一起"},
    {"offset": 5407, "target": "出院。"},
    {"offset": 5442, "target": "那真是太好了…"},
    {"offset": 5470, "target": "所以从那以后…"},
    {"offset": 5492, "target": "为了濒死的我们母子"},
    {"offset": 5520, "target": "而竭尽全力的"}
  ]
}
