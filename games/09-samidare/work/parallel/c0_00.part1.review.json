  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 24,
      "kind": "line",
      "limit": 9,
      "source": "２００４年６月某日",
      "target": "２００４年６月某日"
    },
    {
      "offset": 48,
      "kind": "line",
      "limit": 9,
      "source": "天気、雨",
      "target": "天气：雨"
    },
    {
      "offset": 62,
      "kind": "line",
      "limit": 9,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 81,
      "kind": "line",
      "limit": 9,
      "source": "鞠浜市鞠浜台",
      "target": "鞠滨市鞠滨台"
    },
    {
      "offset": 172,
      "kind": "line",
      "limit": 9,
      "source": "…もう、何日も雨が",
      "target": "…这雨已经下了"
    },
    {
      "offset": 196,
      "kind": "line",
      "limit": 9,
      "source": "続いていた。",
      "target": "好多天了。"
    },
    {
      "offset": 214,
      "kind": "line",
      "limit": 9,
      "source": "ニュースによれば、",
      "target": "据新闻说，"
    },
    {
      "offset": 238,
      "kind": "line",
      "limit": 9,
      "source": "およそ８年ぶりの",
      "target": "大约是８年来"
    },
    {
      "offset": 269,
      "kind": "line",
      "limit": 9,
      "source": "豪雨らしい。",
      "target": "最大的一场暴雨。"
    },
    {
      "offset": 293,
      "kind": "line",
      "limit": 10,
      "source": "元々、ここ鞠浜台は",
      "target": "原本，鞠滨台这里"
    },
    {
      "offset": 343,
      "kind": "line",
      "limit": 10,
      "source": "海が近いので、常に",
      "target": "离海很近，所以"
    },
    {
      "offset": 367,
      "kind": "line",
      "limit": 10,
      "source": "湿度は高めなのだが…",
      "target": "湿度一直偏高…"
    },
    {
      "offset": 393,
      "kind": "line",
      "limit": 11,
      "source": "更にこの大雨が加わり、",
      "target": "再加上这场暴雨，"
    },
    {
      "offset": 421,
      "kind": "line",
      "limit": 11,
      "source": "街全体が淡く霞んで",
      "target": "整座城市都淡淡地"
    },
    {
      "offset": 481,
      "kind": "line",
      "limit": 11,
      "source": "しまった感じがする。",
      "target": "笼上了一层雾。"
    },
    {
      "offset": 507,
      "kind": "line",
      "limit": 11,
      "source": "広がる雨空はその",
      "target": "漫天的雨云将那"
    },
    {
      "offset": 536,
      "kind": "line",
      "limit": 11,
      "source": "鈍い色を一面に広げ、",
      "target": "铅灰色铺展开来，"
    },
    {
      "offset": 568,
      "kind": "line",
      "limit": 11,
      "source": "街の色彩を奪っていた。",
      "target": "夺走了城市的色彩。"
    },
    {
      "offset": 618,
      "kind": "line",
      "limit": 5,
      "source": "…泣くと。",
      "target": "…人哭过，"
    },
    {
      "offset": 634,
      "kind": "line",
      "limit": 10,
      "source": "泣くと、その人の心は",
      "target": "心灵便会"
    },
    {
      "offset": 660,
      "kind": "line",
      "limit": 10,
      "source": "洗われるという。",
      "target": "得到洗涤。"
    },
    {
      "offset": 682,
      "kind": "line",
      "limit": 11,
      "source": "だから…泣いている人の",
      "target": "所以…哭泣之人的"
    },
    {
      "offset": 710,
      "kind": "line",
      "limit": 11,
      "source": "心に、穢れはない。",
      "target": "心中没有污秽。"
    },
    {
      "offset": 752,
      "kind": "line",
      "limit": 5,
      "source": "…ならば。",
      "target": "…那么，"
    },
    {
      "offset": 768,
      "kind": "line",
      "limit": 9,
      "source": "ならば、この街は…",
      "target": "那么，这座城…"
    },
    {
      "offset": 792,
      "kind": "line",
      "limit": 11,
      "source": "こんなにも泣かなければ",
      "target": "莫非已污浊到"
    },
    {
      "offset": 820,
      "kind": "line",
      "limit": 11,
      "source": "ならないほど、汚れて",
      "target": "不得不如此哭泣"
    },
    {
      "offset": 846,
      "kind": "line",
      "limit": 11,
      "source": "いるというのか。",
      "target": "的地步了吗？"
    },
    {
      "offset": 890,
      "kind": "line",
      "limit": 10,
      "source": "この鈍色の空は、何が",
      "target": "这片铅灰色天空，"
    },
    {
      "offset": 938,
      "kind": "line",
      "limit": 10,
      "source": "そんなに悲しいのかも",
      "target": "也不诉说自己为何"
    },
    {
      "offset": 964,
      "kind": "line",
      "limit": 10,
      "source": "告げず…",
      "target": "那般悲伤…"
    },
    {
      "offset": 978,
      "kind": "line",
      "limit": 11,
      "source": "ただ、泣き続けている。",
      "target": "只是不断哭泣。"
    },
    {
      "offset": 1006,
      "kind": "line",
      "limit": 8,
      "source": "モノクロームの",
      "target": "黑白色的"
    },
    {
      "offset": 1026,
      "kind": "line",
      "limit": 8,
      "source": "景色は、じっと…",
      "target": "景物默默地…"
    },
    {
      "offset": 1048,
      "kind": "line",
      "limit": 11,
      "source": "その涙の奏でる調べを",
      "target": "聆听着泪水奏出的"
    },
    {
      "offset": 1092,
      "kind": "line",
      "limit": 11,
      "source": "聞いているようだった。",
      "target": "那一曲旋律。"
    },
    {
      "offset": 1123,
      "kind": "line",
      "limit": 11,
      "source": "街は、傘がほとんど役に",
      "target": "城里暴雨如注，"
    },
    {
      "offset": 1169,
      "kind": "line",
      "limit": 11,
      "source": "立たないほどの大雨。",
      "target": "伞几乎毫无用处。"
    },
    {
      "offset": 1195,
      "kind": "line",
      "limit": 11,
      "source": "足元ではね上がる水が",
      "target": "脚边飞溅的积水"
    },
    {
      "offset": 1221,
      "kind": "line",
      "limit": 11,
      "source": "ズボンの裾を濡らし、",
      "target": "打湿了我的裤脚，"
    },
    {
      "offset": 1281,
      "kind": "line",
      "limit": 11,
      "source": "私の足取りを重くする。",
      "target": "令我的脚步更沉重。"
    },
    {
      "offset": 1311,
      "kind": "line",
      "limit": 11,
      "source": "うう、しまった。",
      "target": "唔，失策了。"
    },
    {
      "offset": 1333,
      "kind": "line",
      "limit": 11,
      "source": "よりによってこんな日に",
      "target": "偏偏挑这种日子"
    },
    {
      "offset": 1361,
      "kind": "line",
      "limit": 11,
      "source": "するんじゃなかった…。",
      "target": "来，真不该…"
    },
    {
      "offset": 1391,
      "kind": "line",
      "limit": 11,
      "source": "私は少し後悔しながらも",
      "target": "我有些后悔，"
    },
    {
      "offset": 1419,
      "kind": "line",
      "limit": 11,
      "source": "いつもの道を通って…",
      "target": "却仍沿着熟悉的路…"
    },
    {
      "offset": 1474,
      "kind": "line",
      "limit": 10,
      "source": "ここ、鞠浜台にある",
      "target": "来到鞠滨台的"
    },
    {
      "offset": 1537,
      "kind": "line",
      "limit": 10,
      "source": "癸生川探偵事務所へと",
      "target": "癸生川侦探事务所。"
    },
    {
      "offset": 1575,
      "kind": "line",
      "limit": 10,
      "source": "やって来たのだった。",
      "target": "我还是来了。"
    },
    {
      "offset": 1619,
      "kind": "line",
      "limit": 8,
      "source": "序　節",
      "target": "序　节"
    },
    {
      "offset": 1631,
      "kind": "line",
      "limit": 8,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 1639,
      "kind": "line",
      "limit": 8,
      "source": "『彼の代わりに』",
      "target": "“代替他”"
    },
    {
      "offset": 1705,
      "kind": "line",
      "limit": 7,
      "source": "はーい！",
      "target": "来啦！"
    },
    {
      "offset": 1719,
      "kind": "line",
      "limit": 7,
      "source": "はいはいっ!!",
      "target": "来了来了！！"
    },
    {
      "offset": 1737,
      "kind": "line",
      "limit": 9,
      "source": "…あっ、しまった。",
      "target": "…糟了。"
    },
    {
      "offset": 1761,
      "kind": "line",
      "limit": 9,
      "source": "ええっと…。",
      "target": "呃…"
    },
    {
      "offset": 1781,
      "kind": "line",
      "limit": 3,
      "source": "…ん？",
      "target": "…嗯？"
    },
    {
      "offset": 1795,
      "kind": "line",
      "limit": 11,
      "source": "あの、カギ開いてるんで",
      "target": "那个，门没锁，"
    },
    {
      "offset": 1823,
      "kind": "line",
      "limit": 11,
      "source": "どうぞ入ってください！",
      "target": "请直接进来吧！"
    },
    {
      "offset": 1851,
      "kind": "line",
      "limit": 9,
      "source": "…あああんもうっ！",
      "target": "…真是的！"
    },
    {
      "offset": 1875,
      "kind": "line",
      "limit": 9,
      "source": "待て、こらっ！",
      "target": "站住，别跑！"
    },
    {
      "offset": 1897,
      "kind": "line",
      "limit": 9,
      "source": "…な、何事だ…!?",
      "target": "…怎、怎么回事！？"
    },
    {
      "offset": 1950,
      "kind": "line",
      "limit": 10,
      "source": "はいどうも生王です。",
      "target": "嗨，是我，生王。"
    },
    {
      "offset": 1998,
      "kind": "line",
      "limit": 10,
      "source": "失礼しますよ。",
      "target": "打扰了。"
    },
    {
      "offset": 2018,
      "kind": "line",
      "limit": 10,
      "source": "…ってあれ、伊綱君？",
      "target": "…咦，伊纲？"
    },
    {
      "offset": 2064,
      "kind": "line",
      "limit": 10,
      "source": "どこいった？",
      "target": "跑哪去了？"
    },
    {
      "offset": 2099,
      "kind": "line",
      "limit": 3,
      "source": "……。",
      "target": "……"
    },
    {
      "offset": 2113,
      "kind": "line",
      "limit": 9,
      "source": "おや、この子は…？",
      "target": "咦，这孩子是…？"
    },
    {
      "offset": 2142,
      "kind": "choice",
      "limit": 0,
      "source": "辺り見回す",
      "target": "环视四周"
    },
    {
      "offset": 2156,
      "kind": "choice",
      "limit": 0,
      "source": "話す",
      "target": "交谈"
    },
    {
      "offset": 2164,
      "kind": "choice",
      "limit": 0,
      "source": "調べる",
      "target": "调查"
    },
    {
      "offset": 2183,
      "kind": "choice",
      "limit": 0,
      "source": "呼ぶ",
      "target": "呼叫"
    },
    {
      "offset": 2191,
      "kind": "choice",
      "limit": 0,
      "source": "考える",
      "target": "思考"
    },
    {
      "offset": 2201,
      "kind": "choice",
      "limit": 0,
      "source": "中断する",
      "target": "中断"
    },
    {
      "offset": 2251,
      "kind": "line",
      "limit": 8,
      "source": "ええと、君は…？",
      "target": "那个，你是…？"
    },
    {
      "offset": 2293,
      "kind": "line",
      "limit": 8,
      "source": "…おじさん、誰？",
      "target": "…大叔，你是谁？",
      "runs": [
        "…",
        "大叔，你是谁？"
      ],
      "emphasis": [
        {
          "colour": null,
