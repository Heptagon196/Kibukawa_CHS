{
  "script": "c0_01",
  "units": [
    {"offset": 5688, "target": "听说这里必须"},
    {"offset": 5739, "target": "作为事务所，"},
    {"offset": 5773, "target": "是有什么理由…"},
    {"offset": 5805, "target": "癸生川说的？"},
    {"offset": 5853, "target": "对，老师以前"},
    {"offset": 5881, "target": "说过。"},
    {"offset": 5905, "target": "是什么呢？"},
    {"offset": 5925, "target": "他在这里等待着"},
    {"offset": 5953, "target": "什么吗…？"},
    {"offset": 5979, "target": "真令人在意。"},
    {"offset": 6015, "target": "不过住了四年半，"},
    {"offset": 6043, "target": "我对这里也有"},
    {"offset": 6085, "target": "感情了。"},
    {"offset": 6107, "target": "啊，已经四年半"},
    {"offset": 6131, "target": "了啊。"},
    {"offset": 6164, "target": "遇见生王先生也是"},
    {"offset": 6198, "target": "那时候吧。"},
    {"offset": 6222, "target": "唔…"},
    {"offset": 6238, "target": "那时候，生王先生…"},
    {"offset": 6288, "target": "啊啊啊啊！"},
    {"offset": 6308, "target": "哇啊啊啊！"},
    {"offset": 6328, "target": "不许说！！"},
    {"offset": 6346, "target": "呵呵呵。"},
    {"offset": 6374, "target": "嗯，这封好像来自"},
    {"offset": 6402, "target": "一位高中女生。"},
    {"offset": 6432, "target": "伊纲妹妹好可爱！"},
    {"offset": 6458, "target": "简直最棒☆"},
    {"offset": 6478, "target": "ＬＯＶＥ！！"},
    {"offset": 6497, "target": "吵死了。"},
    {"offset": 6515, "target": "还有一封。"},
    {"offset": 6539, "target": "伊纲妹妹又可爱"},
    {"offset": 6565, "target": "又迷人！我好崇拜！"},
    {"offset": 6593, "target": "我最喜欢你了！"},
    {"offset": 6618, "target": "啊啊啊！！"},
    {"offset": 6636, "target": "吵死了，闭嘴！"},
    {"offset": 6658, "target": "笨蛋！"},
    {"offset": 6674, "target": "这样不行啊，伊纲小姐。"},
    {"offset": 6702, "target": "难得粉丝特地"},
    {"offset": 6728, "target": "寄来这些话…"},
    {"offset": 6752, "target": "你怎么能如此"},
    {"offset": 6776, "target": "冷淡地回应？"},
    {"offset": 6816, "target": "我更希望听到帅气、"},
    {"offset": 6844, "target": "可靠之类的"},
    {"offset": 6872, "target": "评价。"},
    {"offset": 6900, "target": "哎呀，这种评价"},
    {"offset": 6926, "target": "倒是没收到。"},
    {"offset": 6962, "target": "噗哇。"},
    {"offset": 6978, "target": "啊，震撼发言！"},
    {"offset": 7002, "target": "糟了，一不留神…"},
    {"offset": 7026, "target": "真是的，还不都怪"},
    {"offset": 7072, "target": "生王先生总说！！"},
    {"offset": 7096, "target": "呵呵呵。"},
    {"offset": 7148, "target": "好！…总而言之，"},
    {"offset": 7176, "target": "本期嘉宾是"},
    {"offset": 7198, "target": "侦探助手白鹭洲"},
    {"offset": 7237, "target": "伊纲小姐！"},
    {"offset": 7257, "target": "大家好，请多"},
    {"offset": 7283, "target": "关照。"},
    {"offset": 7313, "target": "…这又是哪一出。"},
    {"offset": 7337, "target": "装成电台主持人"},
    {"offset": 7365, "target": "吗？"},
    {"offset": 7387, "target": "别管了，别管了。"},
    {"offset": 7415, "target": "做这种事讲究的"},
    {"offset": 7439, "target": "就是气氛。"},
    {"offset": 7461, "target": "那么第一封"},
    {"offset": 7485, "target": "来信就是这个！！"},
    {"offset": 7518, "target": "好，来看下一封。"},
    {"offset": 7546, "target": "第二封来信"},
    {"offset": 7568, "target": "在这里！"},
    {"offset": 7590, "target": "你很来劲啊…"},
    {"offset": 7625, "target": "接下来是第三封。"},
    {"offset": 7647, "target": "还有这样的邮件"},
    {"offset": 7667, "target": "寄来！"},
    {"offset": 7695, "target": "还有吗？"},
    {"offset": 7728, "target": "遗憾的是，这已经是"},
    {"offset": 7756, "target": "最后一封邮件"},
    {"offset": 7782, "target": "了！"},
    {"offset": 7798, "target": "一点也不遗憾。"},
    {"offset": 7824, "target": "行了，快点"},
    {"offset": 7846, "target": "念吧。"},
    {"offset": 7884, "target": "…好了，本期"},
    {"offset": 7904, "target": "来信到此结束。"},
    {"offset": 7928, "target": "伊纲小姐，非常感谢"},
    {"offset": 7954, "target": "你的回答。"},
    {"offset": 7976, "target": "这下满意了？"},
    {"offset": 8002, "target": "哎呀，录到了"},
    {"offset": 8030, "target": "很不错的回答。"},
    {"offset": 8048, "target": "太有趣了，不放网站，"},
    {"offset": 8074, "target": "干脆收进应用"},
    {"offset": 8100, "target": "里吧…"},
    {"offset": 8128, "target": "…真是的，随你"},
    {"offset": 8152, "target": "高兴吧。"},
    {"offset": 8279, "target": "咦，有客人。"},
    {"offset": 8303, "target": "…来啦！"},
    {"offset": 8331, "target": "哎呀，居然特地"},
    {"offset": 8351, "target": "冒着这么大的雨…？"},
    {"offset": 8394, "target": "遇上麻烦这种事，"},
    {"offset": 8422, "target": "和天晴还是下雨"},
    {"offset": 8448, "target": "无关。"},
    {"offset": 8464, "target": "行了，快去开门！"},
    {"offset": 8504, "target": "来了！"},
    {"offset": 8531, "target": "…请进这边。"},
    {"offset": 8587, "target": "（男性）"},
    {"offset": 8612, "target": "…打扰了…"},
    {"offset": 8640, "target": "这里是癸生川侦探"},
    {"offset": 8686, "target": "事务所吧？"},
    {"offset": 8710, "target": "对，就是这里。"},
    {"offset": 8736, "target": "唉…"},
    {"offset": 8750, "target": "…请问这里是不是有位"},
    {"offset": 8795, "target": "姓白鹭洲的"},
    {"offset": 8823, "target": "侦探助手…"},
    {"offset": 8853, "target": "啊，是的。"},
    {"offset": 8869, "target": "就是我…？"},
    {"offset": 8889, "target": "…什么！？"},
    {"offset": 8903, "target": "…哈哈，不是，"},
    {"offset": 8929, "target": "不是你这样的"},
    {"offset": 8955, "target": "年轻姑娘…"},
    {"offset": 8977, "target": "…？"},
    {"offset": 8989, "target": "他以前在这里吧？"},
    {"offset": 9015, "target": "那个…"},
    {"offset": 9040, "target": "就是一个姓"},
    {"offset": 9068, "target": "戴眼镜的青年…"},
    {"offset": 9107, "target": "…什么！？"},
    {"offset": 9123, "target": "…？"},
    {"offset": 9138, "target": "…从那一刻起，"},
    {"offset": 9179, "target": "沉默持续了片刻。"},
    {"offset": 9205, "target": "方才还刺耳的"},
    {"offset": 9255, "target": "雨声，突然间"},
    {"offset": 9283, "target": "消失了。"},
    {"offset": 9307, "target": "站在我身边的伊纲"},
    {"offset": 9333, "target": "惊讶得屏住呼吸…"},
    {"offset": 9361, "target": "她剧烈的心跳声"},
    {"offset": 9389, "target": "仿佛连我都能"},
    {"offset": 9415, "target": "听见。"},
    {"offset": 9444, "target": "…不过，那也"},
    {"offset": 9466, "target": "只是一瞬。"},
    {"offset": 9492, "target": "她立刻掩饰住动摇，"},
    {"offset": 9520, "target": "若无其事地告诉他，"},
    {"offset": 9548, "target": "那人不在这里。"},
    {"offset": 9608, "target": "…啊，是吗。"},
    {"offset": 9634, "target": "他现在已经"},
    {"offset": 9658, "target": "不在这里了啊…"},
    {"offset": 9687, "target": "来访的男人得知"},
    {"offset": 9709, "target": "那名青年不在，"},
    {"offset": 9737, "target": "遗憾地点了点头…"},
    {"offset": 9781, "target": "这时才终于自称"},
    {"offset": 9824, "target": "姓蝼川内。"},
    {"offset": 9860, "target": "…随后。"},
    {"offset": 9876, "target": "蝼川内先生说，"},
    {"offset": 9926, "target": "他是来兑现"},
    {"offset": 9960, "target": "八年前的约定。"},
    {"offset": 10014, "target": "约定…吗？"},
    {"offset": 10036, "target": "是的。"},
    {"offset": 10061, "target": "据这个男人说…"},
    {"offset": 10089, "target": "当时这间事务所"},
    {"offset": 10119, "target": "据说有两名"},
    {"offset": 10149, "target": "侦探。"},
    {"offset": 10161, "target": "一个是所长"},
    {"offset": 10198, "target": "癸生川凌介。"},
    {"offset": 10241, "target": "…而"},
    {"offset": 10257, "target": "另一位就是"},
    {"offset": 10277, "target": "助手白鹭洲凉二", "runs": ["助手", "白鹭洲凉二"]},
    {"offset": 10338, "target": "这位青年。"},
    {"offset": 10367, "target": "…可是他既然"},
    {"offset": 10391, "target": "不在…"},
    {"offset": 10405, "target": "这就有点"},
    {"offset": 10427, "target": "难办了…"},
    {"offset": 10447, "target": "……"},
    {"offset": 10461, "target": "…那、那个。"},
    {"offset": 10481, "target": "…什么？"},
    {"offset": 10497, "target": "如果可以，能否"},
    {"offset": 10519, "target": "把详细情况"},
    {"offset": 10539, "target": "告诉我？"},
    {"offset": 10561, "target": "…不，那个，"},
    {"offset": 10581, "target": "请务必告诉我。"},
    {"offset": 10607, "target": "说起来…你似乎也"},
    {"offset": 10644, "target": "姓白鹭洲"},
    {"offset": 10678, "target": "…"},
    {"offset": 10694, "target": "莫非你是他的"},
    {"offset": 10716, "target": "亲属？"},
    {"offset": 10745, "target": "我是妻子"},
    {"offset": 10761, "target": "…！"},
    {"offset": 10771, "target": "…啊，原来如此。"},
    {"offset": 10799, "target": "刚才还称您为"},
    {"offset": 10823, "target": "姑娘，真是失礼…"},
    {"offset": 10860, "target": "没事。"},
    {"offset": 10874, "target": "那么，能请你代替他"},
    {"offset": 10900, "target": "接受我的委托…"},
    {"offset": 10924, "target": "吗？"},
    {"offset": 10940, "target": "好的，请尽管说。"},
    {"offset": 10978, "target": "保存"},
    {"offset": 10992, "target": "返回游戏"},
    {"offset": 11021, "target": "已保存。"},
    {"offset": 11057, "target": "保存失败了。", "runs": ["保存", "失败", "了。"]}
  ]
}
