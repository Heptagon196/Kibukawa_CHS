{
  "script": "c0_00",
  "units": [
    {"offset": 11796, "target": "疼疼疼！"},
    {"offset": 11818, "target": "嘿咻。"},
    {"offset": 11830, "target": "…伊纲，号码在这！"},
    {"offset": 11854, "target": "记住这个号码！！"},
    {"offset": 11880, "target": "嗯，记住了。"},
    {"offset": 11906, "target": "已经没问题了。"},
    {"offset": 11932, "target": "好，打电话！"},
    {"offset": 11954, "target": "搞什么，住手！"},
    {"offset": 11992, "target": "…………"},
    {"offset": 12077, "target": "…总之，从刚才开始"},
    {"offset": 12103, "target": "就一直是这样。"},
    {"offset": 12133, "target": "原来如此…"},
    {"offset": 12151, "target": "这孩子不好对付啊。"},
    {"offset": 12195, "target": "…对了，伊纲。"},
    {"offset": 12221, "target": "什么？"},
    {"offset": 12235, "target": "你最初发现他时"},
    {"offset": 12259, "target": "是什么情况？"},
    {"offset": 12283, "target": "情况？"},
    {"offset": 12315, "target": "这个嘛…"},
    {"offset": 12337, "target": "我刚才出去买了点"},
    {"offset": 12365, "target": "东西…"},
    {"offset": 12389, "target": "回来时，他就站在"},
    {"offset": 12415, "target": "这栋公寓楼前。"},
    {"offset": 12437, "target": "门前。"},
    {"offset": 12468, "target": "没打伞，"},
    {"offset": 12494, "target": "全身湿透了…"},
    {"offset": 12538, "target": "咦，这么大的雨，"},
    {"offset": 12569, "target": "他没打伞？"},
    {"offset": 12595, "target": "嗯。"},
    {"offset": 12609, "target": "一个人？"},
    {"offset": 12637, "target": "是一个人。"},
    {"offset": 12657, "target": "起初我以为他在"},
    {"offset": 12685, "target": "等什么人…"},
    {"offset": 12718, "target": "可实在放心不下，"},
    {"offset": 12744, "target": "就上前问了问。"},
    {"offset": 12774, "target": "唔…"},
    {"offset": 12836, "target": "…你好。"},
    {"offset": 12858, "target": "……"},
    {"offset": 12872, "target": "这么大的雨，"},
    {"offset": 12892, "target": "你一个人在做什么？"},
    {"offset": 12918, "target": "在等谁吗？"},
    {"offset": 12942, "target": "…不是。"},
    {"offset": 12960, "target": "啊，不是啊。"},
    {"offset": 12980, "target": "出什么事了吗？"},
    {"offset": 13002, "target": "……"},
    {"offset": 13016, "target": "你爸爸或妈妈呢？"},
    {"offset": 13046, "target": "…不在。"},
    {"offset": 13066, "target": "咦，不在吗？"},
    {"offset": 13088, "target": "和他们走散了？"},
    {"offset": 13114, "target": "……"},
    {"offset": 13128, "target": "唔…"},
    {"offset": 13144, "target": "难办了，这么大的雨"},
    {"offset": 13172, "target": "也不能丢下他不管…"},
    {"offset": 13245, "target": "…所以我先把他带来"},
    {"offset": 13273, "target": "事务所避雨，"},
    {"offset": 13299, "target": "就是这么回事。"},
    {"offset": 13329, "target": "原来如此…"},
    {"offset": 13353, "target": "我想帮他弄干衣服，"},
    {"offset": 13379, "target": "可他怎么也不肯"},
    {"offset": 13399, "target": "让我碰…"},
    {"offset": 13417, "target": "我只好递给他毛巾，"},
    {"offset": 13445, "target": "他似乎想等衣服"},
    {"offset": 13471, "target": "自然晾干。"},
    {"offset": 13501, "target": "还真够"},
    {"offset": 13517, "target": "野性的啊…"},
    {"offset": 13551, "target": "希望他不会"},
    {"offset": 13575, "target": "着凉…"},
    {"offset": 13601, "target": "……"},
    {"offset": 13650, "target": "不过…说不定"},
    {"offset": 13674, "target": "这孩子并没有"},
    {"offset": 13700, "target": "迷路。"},
    {"offset": 13730, "target": "没有迷路…？"},
    {"offset": 13752, "target": "那就是说…？"},
    {"offset": 13784, "target": "这点你也自己"},
    {"offset": 13810, "target": "想想看嘛。"},
    {"offset": 13834, "target": "唔…"},
    {"offset": 13853, "target": "那个，我想到一种"},
    {"offset": 13881, "target": "可能…"},
    {"offset": 13901, "target": "什么？"},
    {"offset": 13942, "target": "其实他只是一个人"},
    {"offset": 13966, "target": "出来玩，"},
    {"offset": 13990, "target": "会不会是这样？"},
    {"offset": 14024, "target": "唔…我最先也"},
    {"offset": 14048, "target": "这么想过，"},
    {"offset": 14070, "target": "可是…"},
    {"offset": 14090, "target": "啊，原来"},
    {"offset": 14108, "target": "你想过啊…"},
    {"offset": 14130, "target": "他说自己并不住在"},
    {"offset": 14152, "target": "这一带…"},
    {"offset": 14178, "target": "而且…"},
    {"offset": 14204, "target": "他会在雨中漫无目的"},
    {"offset": 14228, "target": "独自跑到这么远的"},
    {"offset": 14250, "target": "地方吗？"},
    {"offset": 14278, "target": "也是…"},
    {"offset": 14299, "target": "这孩子会不会…"},
    {"offset": 14323, "target": "是离家出走来的？"},
    {"offset": 14349, "target": "来的？"},
    {"offset": 14377, "target": "…出走！？"},
    {"offset": 14403, "target": "啊…不过，"},
    {"offset": 14421, "target": "他确实不肯提"},
    {"offset": 14445, "target": "父母，"},
    {"offset": 14471, "target": "也不是没可能…"},
    {"offset": 14509, "target": "而且他似乎也很怕"},
    {"offset": 14537, "target": "我们联系家人，"},
    {"offset": 14559, "target": "很像这么回事。"},
    {"offset": 14579, "target": "…对吧。"},
    {"offset": 14597, "target": "我大概也猜到了"},
    {"offset": 14629, "target": "原因…"},
    {"offset": 14652, "target": "坏事败露"},
    {"offset": 14668, "target": "想让父母担心"},
    {"offset": 14692, "target": "不想学习"},
    {"offset": 14712, "target": "也许是做了坏事，"},
    {"offset": 14738, "target": "趁事情还没败露"},
    {"offset": 14764, "target": "就逃出来了…"},
    {"offset": 14795, "target": "或者是不想学习，"},
    {"offset": 14819, "target": "所以逃出来了…？"},
    {"offset": 14855, "target": "咦，是这样吗…？"},
    {"offset": 14883, "target": "哎呀？不对…？"},
    {"offset": 14909, "target": "我倒觉得…"},
    {"offset": 14927, "target": "只是想让父母担心", "runs": ["只是想让父母", "担心"]},
    {"offset": 14960, "target": "才离家出走，"},
    {"offset": 14988, "target": "对吧？"},
    {"offset": 15006, "target": "想让父母担心？"},
    {"offset": 15028, "target": "你看，他刚才"},
    {"offset": 15046, "target": "不是有点激动地…"},
    {"offset": 15070, "target": "说“反正父母都不担心"},
    {"offset": 15098, "target": "我”之类的话"},
    {"offset": 15122, "target": "吗？"},
    {"offset": 15150, "target": "反过来看，那不正像"},
    {"offset": 15176, "target": "是想让父母"},
    {"offset": 15202, "target": "担心他吗？"},
    {"offset": 15228, "target": "啊，原来如此…"},
    {"offset": 15252, "target": "那就按这个思路"},
    {"offset": 15280, "target": "再问问他吧。"},
    {"offset": 15329, "target": "他一再激动地"},
    {"offset": 15357, "target": "声称父母不担心"},
    {"offset": 15381, "target": "他…"},
    {"offset": 15405, "target": "反而让我觉得，"},
    {"offset": 15431, "target": "他是想让父母担心"},
    {"offset": 15457, "target": "才离家出走的。"},
    {"offset": 15491, "target": "啊，原来如此…"},
    {"offset": 15515, "target": "说得对。"},
    {"offset": 15537, "target": "那就顺着这个思路"},
    {"offset": 15561, "target": "问问看吧。"},
    {"offset": 15613, "target": "这孩子会不会"},
    {"offset": 15635, "target": "其实是被父母"},
    {"offset": 15655, "target": "抛弃了…？"},
    {"offset": 15681, "target": "被抛弃了…！？"},
    {"offset": 15703, "target": "父母突然失踪，"},
    {"offset": 15751, "target": "把他丢下，他才"},
    {"offset": 15779, "target": "四处流浪之类…"},
    {"offset": 15805, "target": "我觉得你的想法"},
    {"offset": 15842, "target": "跳得有点太远了"},
    {"offset": 15874, "target": "吧…"},
    {"offset": 15890, "target": "不是吗…"},
    {"offset": 15910, "target": "他看起来没有"},
    {"offset": 15936, "target": "那么严重。"},
    {"offset": 15960, "target": "这样啊…"},
    {"offset": 15988, "target": "比起这个，"},
    {"offset": 16006, "target": "我倒觉得…"},
    {"offset": 16028, "target": "其实这孩子离家出走", "runs": ["其实这孩子", "离家出走"]},
    {"offset": 16067, "target": "来到这里，"},
    {"offset": 16091, "target": "有没有这种可能？"},
    {"offset": 16115, "target": "…出走！？"},
    {"offset": 16141, "target": "他的态度似乎是"},
    {"offset": 16185, "target": "害怕被人盘问出"},
    {"offset": 16211, "target": "什么。"},
    {"offset": 16241, "target": "啊，因为告诉我们"},
    {"offset": 16267, "target": "我们就会报警。"},
    {"offset": 16297, "target": "对。"},
    {"offset": 16329, "target": "他虽然离家出走，"},
    {"offset": 16357, "target": "却无处可去，"},
    {"offset": 16392, "target": "就先来了事务所…"},
    {"offset": 16428, "target": "啊，原来如此…"},
    {"offset": 16452, "target": "这么说，原因也", "runs": ["这么说，", "原因也"]},
    {"offset": 16493, "target": "能推理出来吗？"}
  ]
}
