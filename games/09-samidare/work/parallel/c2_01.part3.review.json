{
  "script": "c2_01",
  "batch": "c2_01.part3.trans.json",
  "note": "Independent verification: for each entry decide whether ``target`` is the faithful rendering of ``source`` as its own display line. Report shifts, omissions, additions and mistranslations. An entry with ``emphasis`` is drawn in several colours: ``emphasis`` is the source split and ``runs`` the Chinese split, index for index, and it is the run with a non-null colour that the game highlights. See work/parallel/VERIFIER_BRIEF.md.",
  "units": [
    {
      "offset": 8113,
      "kind": "line",
      "limit": 11,
      "source": "しっかりしてるようで",
      "target": "她看起来很可靠，"
    },
    {
      "offset": 8139,
      "kind": "line",
      "limit": 11,
      "source": "たまに妙なポカを見せて",
      "target": "偶尔却也会犯些"
    },
    {
      "offset": 8167,
      "kind": "line",
      "limit": 11,
      "source": "くれるところに…",
      "target": "奇怪的糊涂…"
    },
    {
      "offset": 8189,
      "kind": "line",
      "limit": 10,
      "source": "また一層の愛おしさを",
      "target": "这又让我觉得"
    },
    {
      "offset": 8233,
      "kind": "line",
      "limit": 10,
      "source": "感じたりする。",
      "target": "她更加可爱。"
    },
    {
      "offset": 8253,
      "kind": "line",
      "limit": 10,
      "source": "ただ最近はその事情の",
      "target": "只是最近受家事"
    },
    {
      "offset": 8279,
      "kind": "line",
      "limit": 10,
      "source": "ため、心からの笑顔を",
      "target": "所困，她一直没能"
    },
    {
      "offset": 8305,
      "kind": "line",
      "limit": 10,
      "source": "見せてくれない。",
      "target": "露出真心的笑容。"
    },
    {
      "offset": 8327,
      "kind": "line",
      "limit": 10,
      "source": "私が頑張らないと…。",
      "target": "我必须努力…"
    },
    {
      "offset": 8362,
      "kind": "line",
      "limit": 10,
      "source": "…さっき、気分が悪い",
      "target": "…她刚才说身体"
    },
    {
      "offset": 8388,
      "kind": "line",
      "limit": 10,
      "source": "って言ってたけど…",
      "target": "不舒服…"
    },
    {
      "offset": 8412,
      "kind": "line",
      "limit": 10,
      "source": "よく見ると、確かに",
      "target": "仔细一看，她的"
    },
    {
      "offset": 8436,
      "kind": "line",
      "limit": 10,
      "source": "いつもより顔色が悪い",
      "target": "脸色确实比平时"
    },
    {
      "offset": 8462,
      "kind": "line",
      "limit": 10,
      "source": "気がする。",
      "target": "差一些。"
    },
    {
      "offset": 8478,
      "kind": "line",
      "limit": 11,
      "source": "家が大変な状態で、",
      "target": "家里情况那么糟，"
    },
    {
      "offset": 8502,
      "kind": "line",
      "limit": 11,
      "source": "無理してるんだろうか。",
      "target": "她还在勉强自己吗？"
    },
    {
      "offset": 8530,
      "kind": "line",
      "limit": 11,
      "source": "…痛ましい…。",
      "target": "…太令人心疼了…"
    },
    {
      "offset": 8561,
      "kind": "line",
      "limit": 11,
      "source": "こんな素敵な人とは、",
      "target": "我觉得像她这么好的人"
    },
    {
      "offset": 8587,
      "kind": "line",
      "limit": 11,
      "source": "もう二度と巡り会えない",
      "target": "这辈子恐怕再也"
    },
    {
      "offset": 8615,
      "kind": "line",
      "limit": 11,
      "source": "ような気がする…。",
      "target": "遇不到了…"
    },
    {
      "offset": 8639,
      "kind": "line",
      "limit": 11,
      "source": "だから…何としても",
      "target": "所以…无论如何"
    },
    {
      "offset": 8663,
      "kind": "line",
      "limit": 11,
      "source": "彼女を幸せにしないと！",
      "target": "我都要让她幸福！"
    },
    {
      "offset": 8703,
      "kind": "line",
      "limit": 9,
      "source": "ここは私たちがよく",
      "target": "这家咖啡店是我们"
    },
    {
      "offset": 8727,
      "kind": "line",
      "limit": 9,
      "source": "待ち合わせに使う",
      "target": "经常约见面的"
    },
    {
      "offset": 8749,
      "kind": "line",
      "limit": 9,
      "source": "喫茶店だ。",
      "target": "地方。"
    },
    {
      "offset": 8765,
      "kind": "line",
      "limit": 11,
      "source": "裏通りにあるためか、",
      "target": "也许因为开在小巷里，"
    },
    {
      "offset": 8791,
      "kind": "line",
      "limit": 11,
      "source": "いつ来ても満席だという",
      "target": "这里从来不会"
    },
    {
      "offset": 8819,
      "kind": "line",
      "limit": 11,
      "source": "ことはないし…",
      "target": "座无虚席…"
    },
    {
      "offset": 8839,
      "kind": "line",
      "limit": 11,
      "source": "コーヒー１杯１６０円と",
      "target": "一杯咖啡只要１６０日元"
    },
    {
      "offset": 8867,
      "kind": "line",
      "limit": 11,
      "source": "安価なのが、なによりも",
      "target": "价格便宜，更是"
    },
    {
      "offset": 8895,
      "kind": "line",
      "limit": 11,
      "source": "助かっている。",
      "target": "帮了大忙。"
    },
    {
      "offset": 8924,
      "kind": "line",
      "limit": 11,
      "source": "彼女はここの落ち着いた",
      "target": "她似乎很喜欢这里"
    },
    {
      "offset": 8952,
      "kind": "line",
      "limit": 11,
      "source": "雰囲気が気に入ってる",
      "target": "安静沉稳的"
    },
    {
      "offset": 8978,
      "kind": "line",
      "limit": 11,
      "source": "らしい。",
      "target": "气氛。"
    },
    {
      "offset": 9027,
      "kind": "line",
      "limit": 9,
      "source": "１９９６年５月某日",
      "target": "１９９６年５月某日"
    },
    {
      "offset": 9051,
      "kind": "line",
      "limit": 9,
      "source": "天気、雨",
      "target": "天气：雨"
    },
    {
      "offset": 9065,
      "kind": "line",
      "limit": 9,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 9073,
      "kind": "line",
      "limit": 9,
      "source": "鞠浜市の街はずれ",
      "target": "鞠滨市郊外"
    },
    {
      "offset": 9152,
      "kind": "line",
      "limit": 4,
      "source": "…うふ。",
      "target": "…呵呵。"
    },
    {
      "offset": 9166,
      "kind": "line",
      "limit": 5,
      "source": "うふふふ。",
      "target": "呵呵呵呵。"
    },
    {
      "offset": 9182,
      "kind": "line",
      "limit": 7,
      "source": "あははははっ。",
      "target": "啊哈哈哈哈！"
    },
    {
      "offset": 9205,
      "kind": "line",
      "limit": 8,
      "source": "…よしよし。",
      "target": "…好，很好。"
    },
    {
      "offset": 9223,
      "kind": "line",
      "limit": 8,
      "source": "うまくいったっ♪",
      "target": "顺利上钩了♪"
    },
    {
      "offset": 9245,
      "kind": "line",
      "limit": 11,
      "source": "あれなら、いざとなれば",
      "target": "那种人到迫不得已时，"
    },
    {
      "offset": 9273,
      "kind": "line",
      "limit": 11,
      "source": "借金してでもお金を",
      "target": "就算借钱也会"
    },
    {
      "offset": 9297,
      "kind": "line",
      "limit": 11,
      "source": "用意してくれるだろう。",
      "target": "把钱准备好吧。"
    },
    {
      "offset": 9325,
      "kind": "line",
      "limit": 9,
      "source": "これで５００万円は",
      "target": "这样５００万日元"
    },
    {
      "offset": 9349,
      "kind": "line",
      "limit": 9,
      "source": "あたしのものっ。",
      "target": "就是我的了。"
    },
    {
      "offset": 9371,
      "kind": "line",
      "limit": 9,
      "source": "あの手の人間は、",
      "target": "那种人，"
    },
    {
      "offset": 9393,
      "kind": "line",
      "limit": 9,
      "source": "情に訴えかければ、",
      "target": "只要打感情牌，"
    },
    {
      "offset": 9417,
      "kind": "line",
      "limit": 9,
      "source": "ちょろいもんだね。",
      "target": "就好骗得很。"
    },
    {
      "offset": 9441,
      "kind": "line",
      "limit": 10,
      "source": "あとは、お金を奪って",
      "target": "接下来只要卷走钱"
    },
    {
      "offset": 9467,
      "kind": "line",
      "limit": 10,
      "source": "逃げればいいだけ。",
      "target": "逃跑就行了。"
    },
    {
      "offset": 9491,
      "kind": "line",
      "limit": 7,
      "source": "…あはははっ。",
      "target": "…啊哈哈哈！"
    },
    {
      "offset": 9511,
      "kind": "line",
      "limit": 9,
      "source": "こんな簡単にお金が",
      "target": "这么轻易就能"
    },
    {
      "offset": 9535,
      "kind": "line",
      "limit": 9,
      "source": "手に入るなんて、",
      "target": "拿到钱，"
    },
    {
      "offset": 9557,
      "kind": "line",
      "limit": 9,
      "source": "いい世の中だよ。",
      "target": "真是个好世道。"
    },
    {
      "offset": 9579,
      "kind": "line",
      "limit": 8,
      "source": "あはははははっ…",
      "target": "啊哈哈哈哈哈…"
    },
    {
      "offset": 9647,
      "kind": "line",
      "limit": 9,
      "source": "１９９６年５月某日",
      "target": "１９９６年５月某日"
    },
    {
      "offset": 9671,
      "kind": "line",
      "limit": 9,
      "source": "天気、雨",
      "target": "天气：雨"
    },
    {
      "offset": 9685,
      "kind": "line",
      "limit": 9,
      "source": "　",
      "target": "　"
    },
    {
      "offset": 9704,
      "kind": "line",
      "limit": 9,
      "source": "鞠浜市の街はずれ",
      "target": "鞠滨市郊外"
    },
    {
      "offset": 9787,
      "kind": "line",
      "limit": 8,
      "source": "…ああ、困った。",
      "target": "…啊，伤脑筋。"
    },
    {
      "offset": 9809,
      "kind": "line",
      "limit": 9,
      "source": "早く父を捜さないと",
      "target": "明明得尽快找到"
    },
    {
      "offset": 9833,
      "kind": "line",
      "limit": 9,
      "source": "いけないのに…",
      "target": "父亲…"
    },
    {
      "offset": 9853,
      "kind": "line",
      "limit": 11,
      "source": "いったい、どこを",
      "target": "可我到底该从"
    },
    {
      "offset": 9875,
      "kind": "line",
      "limit": 11,
      "source": "どう捜せばいいのやら。",
      "target": "哪里怎么找呢？"
    },
    {
      "offset": 9903,
      "kind": "line",
      "limit": 11,
      "source": "貯金通帳を盗んだのは、",
      "target": "偷走存折的人，"
    },
    {
      "offset": 9931,
      "kind": "line",
      "limit": 11,
      "source": "間違いなく父の仕業だ。",
      "target": "毫无疑问就是父亲。"
    },
    {
      "offset": 9959,
      "kind": "line",
      "limit": 11,
      "source": "何としても、早いところ",
      "target": "无论如何，都得尽快"
    },
    {
      "offset": 9987,
      "kind": "line",
      "limit": 11,
      "source": "取り戻さないと…。",
      "target": "把它拿回来…"
    },
    {
      "offset": 10014,
      "kind": "line",
      "limit": 10,
      "source": "…しかし、手掛かりは",
      "target": "…可是，我完全"
    },
    {
      "offset": 10040,
      "kind": "line",
      "limit": 10,
      "source": "まったくない。",
      "target": "没有线索。"
    },
    {
      "offset": 10060,
      "kind": "line",
      "limit": 10,
      "source": "普段から、どこにいて",
      "target": "我根本不知道他"
    },
    {
      "offset": 10086,
      "kind": "line",
      "limit": 10,
      "source": "どう暮らしているか、",
      "target": "平时住在哪里，"
    },
    {
      "offset": 10112,
      "kind": "line",
      "limit": 10,
      "source": "全然知らないのだ。",
      "target": "过着怎样的生活。"
    },
    {
      "offset": 10136,
      "kind": "line",
      "limit": 10,
      "source": "…こんなことなら、",
      "target": "…早知如此，"
    },
    {
      "offset": 10160,
      "kind": "line",
      "limit": 10,
      "source": "無理にでも話しておく",
      "target": "当初就算勉强他"
    },
    {
      "offset": 10186,
      "kind": "line",
      "limit": 10,
      "source": "べきだったか…。",
      "target": "也该多聊几句…"
    },
    {
      "offset": 10256,
      "kind": "line",
      "limit": 8,
      "source": "…あっ、やっぱり",
      "target": "…啊，果然是"
    },
    {
      "offset": 10291,
      "kind": "line",
      "limit": 8,
      "source": "螻川内クンだ！",
      "target": "蝼川内小哥！"
    },
    {
      "offset": 10317,
      "kind": "line",
      "limit": 11,
      "source": "こんにちは、莉沙です。",
      "target": "你好，我是莉沙。"
    },
    {
      "offset": 10363,
      "kind": "line",
      "limit": 9,
      "source": "わあ、意外なトコで",
      "target": "哇，居然会在这里"
    },
    {
      "offset": 10387,
      "kind": "line",
      "limit": 9,
      "source": "会いましたねー。",
      "target": "遇到你呢。"
    },
    {
      "offset": 10411,
      "kind": "line",
      "limit": 4,
      "source": "うわっ。",
      "target": "哇！"
    },
    {
      "offset": 10425,
      "kind": "line",
      "limit": 9,
      "source": "…なんだ、君か…。",
      "target": "…原来是你啊…"
    },
    {
      "offset": 10451,
      "kind": "line",
      "limit": 8,
      "source": "あはっ、憶えてて",
      "target": "啊哈，你还记得"
    },
    {
      "offset": 10473,
      "kind": "line",
      "limit": 8,
      "source": "くれたんですね！",
      "target": "我啊！"
    },
    {
      "offset": 10495,
      "kind": "line",
      "limit": 11,
      "source": "ありがとう螻川内クン！",
      "target": "谢谢你，蝼川内小哥！"
    },
    {
      "offset": 10547,
      "kind": "line",
      "limit": 11,
      "source": "嬉しいっ！",
      "target": "好开心！"
    },
    {
      "offset": 10565,
      "kind": "line",
      "limit": 10,
      "source": "…クンはないだろう。",
      "target": "…别叫我小哥吧。"
    },
    {
      "offset": 10603,
      "kind": "line",
      "limit": 9,
      "source": "じゃあ…オジサマ？",
      "target": "那…大叔？"
    },
    {
      "offset": 10629,
      "kind": "line",
      "limit": 9,
      "source": "それもやめてくれ。",
      "target": "这个也别叫。"
    },
    {
      "offset": 10665,
      "kind": "line",
      "limit": 4,
      "source": "ふふっ。",
      "target": "呵呵。"
    },
    {
      "offset": 10694,
      "kind": "choice",
      "limit": 0,
      "source": "話す",
      "target": "交谈"
    },
    {
      "offset": 10702,
      "kind": "choice",
      "limit": 0,
      "source": "中断する",
      "target": "中断"
    },
    {
      "offset": 10739,
      "kind": "line",
      "limit": 10,
      "source": "螻川内さん、お父さん",
      "target": "蝼川内先生，您在找"
    },
    {
      "offset": 10771,
      "kind": "line",
      "limit": 10,
      "source": "捜してるんですよね？",
      "target": "父亲吧？"
    },
    {
      "offset": 10797,
      "kind": "line",
      "limit": 10,
      "source": "見つかりました？",
      "target": "找到了吗？"
    },
    {
      "offset": 10821,
      "kind": "line",
      "limit": 11,
      "source": "そんな簡単に見つかれば",
      "target": "要是那么容易找到，"
    },
    {
      "offset": 10849,
      "kind": "line",
      "limit": 11,
      "source": "苦労しないよ。",
      "target": "我就不用发愁了。"
    },
    {
      "offset": 10881,
      "kind": "line",
      "limit": 8,
      "source": "大変ですよね…。",
      "target": "真辛苦呢…"
    },
    {
      "offset": 10913,
      "kind": "line",
      "limit": 8,
      "source": "…あっ、そうだ！",
      "target": "…啊，对了！"
    },
    {
      "offset": 10937,
      "kind": "line",
      "limit": 3,
      "source": "…ん？",
      "target": "…嗯？"
    },
    {
      "offset": 10964,
      "kind": "line",
      "limit": 9,
      "source": "螻川内さん、お金、",
      "target": "蝼川内先生，您"
    },
    {
      "offset": 10994,
      "kind": "line",
      "limit": 9,
      "source": "必要なんですよね？",
      "target": "钱吧？"
    },
    {
      "offset": 11020,
      "kind": "line",
      "limit": 9,
      "source": "だから父を捜してる",
      "target": "所以我才在找"
    },
    {
      "offset": 11044,
      "kind": "line",
      "limit": 9,
      "source": "わけなんだが。",
      "target": "父亲。"
    },
    {
      "offset": 11076,
      "kind": "line",
      "limit": 11,
      "source": "…実はあたし、簡単に",
      "target": "…其实我知道一个"
    },
    {
      "offset": 11102,
      "kind": "line",
      "limit": 11,
      "source": "大金を手に入れる方法、",
      "target": "能轻松得到一大笔钱"
    },
    {
      "offset": 11130,
      "kind": "line",
      "limit": 11,
      "source": "知ってるんですよ。",
      "target": "的办法。"
    },
    {
      "offset": 11154,
      "kind": "line",
      "limit": 11,
      "source": "お父さんが見つからな",
      "target": "就算找不到父亲，"
    },
    {
      "offset": 11180,
      "kind": "line",
      "limit": 11,
      "source": "くても、お金さえあれば",
      "target": "只要能拿到钱"
    },
    {
      "offset": 11208,
      "kind": "line",
      "limit": 11,
      "source": "いいんですよね？",
      "target": "就行，对吧？"
    },
    {
      "offset": 11232,
      "kind": "line",
      "limit": 8,
      "source": "それはそうだが…",
      "target": "话是这么说…"
    },
    {
      "offset": 11254,
      "kind": "line",
      "limit": 9,
      "source": "…そんなうまい話が",
      "target": "…可哪有这种"
    },
    {
      "offset": 11278,
      "kind": "line",
      "limit": 9,
      "source": "あるものか。",
      "target": "好事。"
    },
    {
      "offset": 11296,
      "kind": "line",
      "limit": 10,
      "source": "もし本当にそんな話が",
      "target": "真有这种好事，"
    },
    {
      "offset": 11322,
      "kind": "line",
      "limit": 10,
      "source": "あるなら、どうして",
      "target": "你为什么不"
    },
    {
      "offset": 11346,
      "kind": "line",
      "limit": 10,
