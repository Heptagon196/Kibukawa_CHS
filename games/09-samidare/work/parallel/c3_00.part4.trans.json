{
  "script": "c3_00",
  "units": [
    {"offset": 16481, "target": "娘家姓水岛。"},
    {"offset": 16528, "target": "尤里卡～～～！！"},
    {"offset": 16552, "target": "…什、什么！？"},
    {"offset": 16568, "target": "怎、怎么了！？"},
    {"offset": 16588, "target": "侦探突然挥舞着"},
    {"offset": 16612, "target": "双臂，在房间里"},
    {"offset": 16640, "target": "飞奔起来。"},
    {"offset": 16666, "target": "那动作敏捷得"},
    {"offset": 16694, "target": "完全无法从他"},
    {"offset": 16720, "target": "笨重的外表想象。"},
    {"offset": 16750, "target": "原来是这样啊啊！"},
    {"offset": 16774, "target": "有点眉目了！"},
    {"offset": 16796, "target": "唔哈！"},
    {"offset": 16825, "target": "…对了，你！"},
    {"offset": 16856, "target": "是叫穷光蛋君吧！？"},
    {"offset": 16892, "target": "我、我姓蝼川内…"},
    {"offset": 16942, "target": "那名字从哪来的？"},
    {"offset": 16972, "target": "算了，那不重要！"},
    {"offset": 16996, "target": "比起那个，"},
    {"offset": 17020, "target": "真的要中止调查"},
    {"offset": 17046, "target": "吗！？"},
    {"offset": 17074, "target": "…不过，就算找到"},
    {"offset": 17100, "target": "你父亲，钱也未必"},
    {"offset": 17124, "target": "能回来。"},
    {"offset": 17154, "target": "咦…？"},
    {"offset": 17180, "target": "来吧，钱和父亲，"},
    {"offset": 17204, "target": "你想找哪一个！"},
    {"offset": 17230, "target": "这个嘛…"},
    {"offset": 17253, "target": "找钱。"},
    {"offset": 17267, "target": "找父亲。"},
    {"offset": 17283, "target": "只要找到父亲，"},
    {"offset": 17307, "target": "钱也会回来…"},
    {"offset": 17337, "target": "这可说不准！"},
    {"offset": 17363, "target": "说到底，只要明天"},
    {"offset": 17389, "target": "之前有钱，父亲完全"},
    {"offset": 17417, "target": "可以不管！"},
    {"offset": 17447, "target": "啊、嗯…"},
    {"offset": 17463, "target": "话是这么说。"},
    {"offset": 17494, "target": "那当然是钱，"},
    {"offset": 17516, "target": "毕竟明天之前"},
    {"offset": 17542, "target": "就需要。"},
    {"offset": 17570, "target": "好！那就如你所愿，"},
    {"offset": 17598, "target": "取消寻找父亲的"},
    {"offset": 17626, "target": "委托！"},
    {"offset": 17640, "target": "然后换个新委托！"},
    {"offset": 17666, "target": "我来找出那笔钱！"},
    {"offset": 17692, "target": "不，就算没人委托"},
    {"offset": 17720, "target": "我也要找！"},
    {"offset": 17738, "target": "咦，不，那个…"},
    {"offset": 17760, "target": "问题不在这里…"},
    {"offset": 17788, "target": "我可不是为了你！"},
    {"offset": 17812, "target": "是为了你母亲！"},
    {"offset": 17838, "target": "咦…！？"},
    {"offset": 17852, "target": "那、那个…请问"},
    {"offset": 17878, "target": "这是什么意思…？"},
    {"offset": 17911, "target": "误会就是用来"},
    {"offset": 17933, "target": "解开的！"},
    {"offset": 17951, "target": "那么，再会！"},
    {"offset": 17977, "target": "回头再见！"},
    {"offset": 18013, "target": "啊、啊，等一下…！"},
    {"offset": 18054, "target": "…侦探发出“啊哟”之类"},
    {"offset": 18082, "target": "的怪叫声，"},
    {"offset": 18108, "target": "飞奔而去。"},
    {"offset": 18134, "target": "……"},
    {"offset": 18146, "target": "结果被独自留在"},
    {"offset": 18170, "target": "事务所里的"},
    {"offset": 18196, "target": "我…"},
    {"offset": 18208, "target": "完全搞不清"},
    {"offset": 18236, "target": "发生了什么，呆呆地"},
    {"offset": 18260, "target": "愣了好一阵。"},
    {"offset": 18285, "target": "…就这样又过了"},
    {"offset": 18309, "target": "一会儿。"},
    {"offset": 18339, "target": "…咦？"},
    {"offset": 18384, "target": "这不是蝼川内"},
    {"offset": 18406, "target": "先生吗？"},
    {"offset": 18428, "target": "您怎么会在"},
    {"offset": 18452, "target": "这里？"},
    {"offset": 18476, "target": "这个嘛…"},
    {"offset": 18508, "target": "…啊哈，原来如此。"},
    {"offset": 18543, "target": "您见到了癸生川，"},
    {"offset": 18569, "target": "正不知所措吧。"},
    {"offset": 18593, "target": "第一次见他的人，"},
    {"offset": 18619, "target": "都会产生这种"},
    {"offset": 18645, "target": "感情。"},
    {"offset": 18667, "target": "啊、是…果然"},
    {"offset": 18693, "target": "什么都瞒不过您。"},
    {"offset": 18732, "target": "那么，怎么回事？"},
    {"offset": 18760, "target": "他说了什么吗？"},
    {"offset": 18790, "target": "这个嘛，"},
    {"offset": 18812, "target": "其实我本来是…"},
    {"offset": 18873, "target": "…总之，事情"},
    {"offset": 18897, "target": "就是这样。"},
    {"offset": 18927, "target": "这样啊。"},
    {"offset": 18954, "target": "慧美小姐让您"},
    {"offset": 18988, "target": "取消委托…"},
    {"offset": 19022, "target": "…您这么一说，"},
    {"offset": 19050, "target": "确实很可疑呢。"},
    {"offset": 19080, "target": "不，那个，请别"},
    {"offset": 19108, "target": "放在心上。"},
    {"offset": 19132, "target": "她也是因为现在的"},
    {"offset": 19158, "target": "处境，变得有些"},
    {"offset": 19204, "target": "神经质了…"},
    {"offset": 19236, "target": "嗯，没关系。"},
    {"offset": 19262, "target": "…那么，您打算"},
    {"offset": 19290, "target": "中止调查吗？"},
    {"offset": 19326, "target": "…不过，癸生川似乎"},
    {"offset": 19374, "target": "已经出门寻找那笔钱"},
    {"offset": 19402, "target": "了…"},
    {"offset": 19432, "target": "不，那个…"},
    {"offset": 19450, "target": "事到如今，能请你们"},
    {"offset": 19478, "target": "查到底吗？"},
    {"offset": 19502, "target": "我也没有其他"},
    {"offset": 19528, "target": "门路了…"},
    {"offset": 19548, "target": "只要还有一丝"},
    {"offset": 19574, "target": "可能，我就想押在"},
    {"offset": 19600, "target": "侦探先生们身上。"},
    {"offset": 19622, "target": "不，应该说…"},
    {"offset": 19642, "target": "如果是你们这些"},
    {"offset": 19668, "target": "侦探，我愿意"},
    {"offset": 19690, "target": "把事情交给你们。"},
    {"offset": 19724, "target": "…我明白了。"},
    {"offset": 19746, "target": "谢谢您。"},
    {"offset": 19774, "target": "请交给我们。"},
    {"offset": 19806, "target": "况且，案件似乎"},
    {"offset": 19834, "target": "也快接近尾声了。"},
    {"offset": 19864, "target": "咦…！？"},
    {"offset": 19899, "target": "癸生川开始行动，"},
    {"offset": 19933, "target": "就代表他发现了"},
    {"offset": 19955, "target": "什么。"},
    {"offset": 19979, "target": "…恐怕他已经"},
    {"offset": 20001, "target": "猜到那笔钱"},
    {"offset": 20027, "target": "在哪里了。"},
    {"offset": 20047, "target": "什么…！？"},
    {"offset": 20065, "target": "真、真的吗！？"},
    {"offset": 20093, "target": "那么，那笔钱就交给"},
    {"offset": 20141, "target": "癸生川…"},
    {"offset": 20165, "target": "我去追查您父亲"},
    {"offset": 20187, "target": "的下落。"},
    {"offset": 20215, "target": "啊、好…"},
    {"offset": 20235, "target": "刚才，我在电话簿里"},
    {"offset": 20257, "target": "找了克雷夫制作所"},
    {"offset": 20283, "target": "的资料…"},
    {"offset": 20303, "target": "但似乎没有"},
    {"offset": 20327, "target": "登记。"},
    {"offset": 20349, "target": "所以我向一个消息"},
    {"offset": 20377, "target": "来源打听了地点。"},
    {"offset": 20405, "target": "这、这样啊。"},
    {"offset": 20456, "target": "听说川北市沿海"},
    {"offset": 20490, "target": "有一家叫这个名字"},
    {"offset": 20512, "target": "的工厂…"},
    {"offset": 20534, "target": "但听说，那里"},
    {"offset": 20556, "target": "几个月前起，工厂运转", "runs": ["几个月前起，", "工厂运转"]},
    {"offset": 20591, "target": "似乎就停止了。"},
    {"offset": 20625, "target": "咦…！？"},
    {"offset": 20639, "target": "工厂已经没有营业"},
    {"offset": 20667, "target": "了吗？"},
    {"offset": 20697, "target": "听说从某天起，"},
    {"offset": 20723, "target": "那里就完全"},
    {"offset": 20745, "target": "没人进出了。"},
    {"offset": 20773, "target": "………"},
    {"offset": 20789, "target": "…就是这样，"},
    {"offset": 20817, "target": "我先去那家工厂"},
    {"offset": 20845, "target": "看看。"},
    {"offset": 20865, "target": "告辞。"},
    {"offset": 20879, "target": "啊…"},
    {"offset": 20912, "target": "…他走了。"},
    {"offset": 20936, "target": "再次被独自留在"},
    {"offset": 20958, "target": "事务所的我…"},
    {"offset": 20978, "target": "觉得自己也得尽量"},
    {"offset": 21006, "target": "寻找一些线索，"},
    {"offset": 21034, "target": "于是…"},
    {"offset": 21048, "target": "决定亲自出门寻找"},
    {"offset": 21074, "target": "父亲。"},
    {"offset": 21139, "target": "…我出门时没有锁门"},
    {"offset": 21163, "target": "这事让我有些在意…"},
    {"offset": 21191, "target": "不过…"},
    {"offset": 21205, "target": "就算小偷看到"},
    {"offset": 21229, "target": "那个房间，大概也会"},
    {"offset": 21257, "target": "打消念头吧…"},
    {"offset": 21330, "target": "眼前的男人"},
    {"offset": 21353, "target": "癸生川凌介"},
    {"offset": 21376, "target": "明明一副邋遢相，"},
    {"offset": 21422, "target": "不知为何，全身却"},
    {"offset": 21448, "target": "透出奇妙的说服力。"},
    {"offset": 21474, "target": "该说他浑身散发着"},
    {"offset": 21502, "target": "吸引旁人的气场"},
    {"offset": 21528, "target": "吗…"},
    {"offset": 21550, "target": "说的话明明有些"},
    {"offset": 21576, "target": "颠三倒四…"},
    {"offset": 21598, "target": "却让人觉得会"},
    {"offset": 21626, "target": "无条件照他说的"},
    {"offset": 21652, "target": "去做。"},
    {"offset": 21676, "target": "…这就是所谓的"},
    {"offset": 21702, "target": "领袖魅力吗…"},
    {"offset": 21735, "target": "他让人感受到的"},
    {"offset": 21785, "target": "信赖，与刚才的"},
    {"offset": 21813, "target": "白鹭洲先生截然不同。"},
    {"offset": 21860, "target": "保存"},
    {"offset": 21874, "target": "返回游戏"},
    {"offset": 21903, "target": "保存成功。"},
    {"offset": 21939, "target": "保存失败。", "runs": ["保存", "失败", "。"]}
  ]
}
