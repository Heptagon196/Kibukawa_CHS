  "findings": [
    {
      "id": "scratch4.dat/s04:6384",
      "source": "<color=0>３分の１の人は、完全な</color><row/><color=0>「信者」となっていて、</color><row/><color=0>恨みどころか感謝して</color><row/><color=0>いる始末だった。</color><ctrl=2E/>",
      "target": "<color=0>其中三分之一的人，</color><row/><color=0>已经彻底成了‘信徒’，</color><row/><color=0>非但不恨他，</color><row/><color=0>反而心存感激。</color><ctrl=2E/>",
      "issue": "旁白中的直接引用未处于外层引号内，应使用双引号，不用内层单引号。",
      "suggested_target": "<color=0>其中三分之一的人，</color><row/><color=0>已经彻底成了“信徒”，</color><row/><color=0>非但不恨他，</color><row/><color=0>反而心存感激。</color><ctrl=2E/>"
    },
    {
      "id": "scratch4.dat/s04:17687",
      "source": "<color=0>だいたい、いつも</color><row/><color=0>補助灯を</color><color=2>点灯させる</color><row/><color=2>時間</color><color=0>だった。</color><ctrl=2E/>",
      "target": "<color=0>大致就在平时</color><row/><color=0>会</color><color=2>打开辅助灯</color><row/><color=2>的时候</color><color=0>。</color><ctrl=2E/>",
      "issue": "着色范围扩展：原文补助灯在普通色段，强调的是点灯させる時間；译文把辅助灯也移入强调。",
      "suggested_target": "<color=0>大致就在平时</color><row/><color=0>会给辅助灯</color><color=2>开灯</color><row/><color=2>的时候</color><color=0>。</color><ctrl=2E/>"
    },
    {
      "id": "scratch4.dat/s04:21122",
      "source": "<color=0>これは天の裁きであると</color><row/><color=0>いった、意味のわから</color><row/><color=0>ない説教ばかりで…</color><ctrl=2E/>",
      "target": "<color=0>还有‘这是上天的裁决’</color><row/><color=0>之类，</color><row/><color=0>莫名其妙的说教……</color><ctrl=2E/>",
      "issue": "旁白直接引用应使用外层双引号。",
      "suggested_target": "<color=0>还有“这是上天的裁决”</color><row/><color=0>之类，</color><row/><color=0>莫名其妙的说教……</color><ctrl=2E/>"
    },
    {
      "id": "scratch4.dat/s04:21728",
      "source": "<color=0>理由を聞いても、</color><row/><color=0>「私がバス事故が起これ</color><row/><color=0>と思った時に、ちょうど</color><row/><color=0>起こったから」とか…</color><ctrl=2E/>",
