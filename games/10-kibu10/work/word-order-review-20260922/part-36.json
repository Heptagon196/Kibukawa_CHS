  "changes": [
    {
      "id": "scratch4.dat/s36:452",
      "source": "<color=0>今回の事件の</color><color=8>犯人当て</color><color=0>を</color><row/><color=0>していただこうと思い</color><row/><color=0>ます。</color><ctrl=2E/>",
      "old_target": "<color=0>这次案件的</color><color=8>猜凶手</color><color=0>环节，</color><row/><color=0>想请各位</color><row/><color=0>参与一下。</color><ctrl=2E/>",
      "target": "<color=0>参与这次案件的</color><color=8>猜凶手</color><color=0>环节，</color><row/><color=0>猜猜谁才是</color><row/><color=0>真凶。</color><ctrl=2E/>",
      "reason": "承接上一条“想请身为玩家的各位”，把参与动作提前，消除宾语前置与重复邀请造成的断句。"
    },
    {
      "id": "scratch4.dat/s36:5993",
      "source": "<color=0>少なくとも暴行未遂の</color><row/><color=0>現行犯で、今すぐでも</color><row/><color=0>しょっ引けるんだぞ！</color><ctrl=2E/>",
      "old_target": "<color=0>至少能当场以</color><row/><color=0>施暴未遂的现行犯</color><row/><color=0>把你抓回去！”</color><ctrl=2E/>",
      "target": "<color=0>至少，你是施暴未遂的</color><row/><color=0>现行犯，现在就能</color><row/><color=0>把你抓回去！”</color><ctrl=2E/>",
      "reason": "“以施暴未遂的现行犯把你抓回去”缺少身份介词搭配；明确被捕者身份与抓捕动作。"
    },
    {
      "id": "scratch4.dat/s36:8628",
      "source": "<color=0>…でも、その一條院って</color><row/><color=0>ヤツの正体は、吐かせ</color><row/><color=0>なくて大丈夫なの？</color><ctrl=2E/>",
      "old_target": "<color=0>……不过，那个叫一条院的</color><row/><color=0>家伙，不用逼他</color><row/><color=0>招出真实身份吗？”</color><ctrl=2E/>",
      "target": "<color=0>……不过，不用逼他招出</color><row/><color=0>那个叫一条院的家伙</color><row/><color=0>究竟是谁吗？”</color><ctrl=2E/>",
      "reason": "原译的“他”紧随一条院，误成逼一条院招出自己的身份；此处是在问是否逼泽津贺供出一条院。"
    },
    {
      "id": "scratch4.dat/s36:18086",
      "source": "<color=0>そこで作ったのが…</color><ctrl=2E/>",
      "old_target": "<color=0>于是，你建立了……</color><ctrl=2E/>",
      "target": "<color=0>于是，你招揽了……</color><ctrl=2E/>",
      "reason": "与后两条联动，按招揽泽津贺、成立组织的先后关系铺陈，避免“建立了……由此建立的组织……就是这样诞生”重复悬空。"
    },
    {
      "id": "scratch4.dat/s36:18136",
      "source": "<color=0>妄想癖のあった</color><row/><color=0>澤津賀氏を抱えて</color><row/><color=0>誕生させた…</color><ctrl=2E/>",
      "old_target": "<color=0>招揽有妄想癖的</color><row/><color=0>泽津贺，</color><row/><color=0>由此建立的组织……</color><ctrl=2E/>",
      "target": "<color=0>有妄想癖的</color><row/><color=0>泽津贺，</color><row/><color=0>就此成立了……</color><ctrl=2E/>",
      "reason": "接前条“招揽了”，让泽津贺充当明确宾语，再引出下一条组织名。"
    },
    {
      "id": "scratch4.dat/s36:18250",
      "source": "<color=2>豫言組織</color><color=0>だったのだ！</color><ctrl=2E/>",
      "old_target": "<color=2>预言组织</color><color=0>，就是这样诞生的！</color><ctrl=2E/>",
      "target": "<color=2>预言组织</color><color=0>！</color><ctrl=2E/>",
      "reason": "直接承接上一条“成立了”，保留组织名高亮并去掉重复倒装。"
    },
    {
      "id": "scratch4.dat/s36:19137",
      "source": "<color=0>永劫会の</color><color=2>入会資格</color><color=0>を</color><row/><color=0>持つ人物を、増やす</color><row/><color=0>ことだったのだ！</color><ctrl=2B/>",
      "old_target": "<color=0>增加具有永劫会</color><color=2>入会资格</color><color=0>的</color><row/><color=0>人，</color><row/><color=0>才是它的目的！</color><ctrl=2B/>",
      "target": "<color=0>让拥有永劫会</color><color=2>入会资格</color><color=0>的</color><row/><color=0>人数</color><row/><color=0>不断增加！</color><ctrl=2B/>",
      "reason": "承接前文“目的是……犯下强奸案”，将“增加人数”作为连续目的表达，去掉重复后置的“才是它的目的”。"
    },
    {
      "id": "scratch4.dat/s36:20235",
      "source": "<color=0>バス事故に見せかけた</color><row/><color=2>暴行犯の殺害</color><color=0>だ。</color><ctrl=2E/>",
      "old_target": "<color=0>把</color><row/><color=2>杀害施暴者</color><color=0>伪装成巴士事故。</color><ctrl=2E/>",
      "target": "<color=0>将巴士事故作为掩饰，</color><row/><color=2>杀害施暴者</color><color=0>。</color><ctrl=2E/>",
      "reason": "把伪装手段放在杀害行为之前，消除独立“把”字和把杀害行为直接当作事故的生硬搭配；保留杀害行为高亮。"
    },
    {
      "id": "scratch4.dat/s36:29424",
      "source": "<color=0>中庭君の証言を</color><color=2>警察に</color><row/><color=2>密告</color><color=0>したのも、君しか</color><row/><color=0>考えられない。</color><ctrl=2E/>",
      "old_target": "<color=0>把中庭的证词</color><color=2>向警方</color><row/><color=2>告密</color><color=0>的，也只能</color><row/><color=0>是你。</color><ctrl=2E/>",
      "target": "<color=0>拿着中庭的证词</color><color=2>向警方</color><row/><color=2>告密</color><color=0>的人，也只能</color><row/><color=0>是你。</color><ctrl=2E/>",
      "reason": "“把证词向警方告密”把字句不成立；改成拿证词告密，保留警方与告密的高亮顺序。"
    },
    {
      "id": "scratch4.dat/s36:31470",
      "source": "<color=0>最悪、僕が一條院だと</color><row/><color=0>バレたとしても…</color><ctrl=2E/>",
      "old_target": "<color=0>我本以为，就算最坏的情况，</color><row/><color=0>被发现我就是一条院……</color><ctrl=2E/>",
      "target": "<color=0>我本以为，就算情况再糟，</color><row/><color=0>让人发现我就是一条院……</color><ctrl=2E/>",
      "reason": "修复“就算最坏的情况，被发现我就是……”的残缺让步句与被动句。"
    },
    {
      "id": "scratch4.dat/s36:34611",
      "source": "<color=0>その</color><color=2>彼氏からの依頼</color><color=0>も</color><row/><color=0>あったからなのだ！</color><ctrl=2E/>",
      "old_target": "<color=0>也是因为，那位</color><color=2>男朋友委托了我</color><color=0>，</color><row/><color=0>我才会怀疑你！”</color><ctrl=2E/>",
      "target": "<color=0>而那位</color><color=2>男朋友委托了我</color><color=0>，</color><row/><color=0>这也是我怀疑你的原因！”</color><ctrl=2E/>",
      "reason": "将原因与判断按顺序表达，保留原有“男朋友委托了我”的完整高亮范围。"
    },
