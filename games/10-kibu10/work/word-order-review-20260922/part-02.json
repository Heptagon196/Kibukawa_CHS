  "changes": [
    {
      "id": "scratch4.dat/s02:598",
      "source": "<color=0>結局、門沢は過去に</color><row/><color=2>暴行事件</color><color=0>を起こしている</color><row/><color=0>ことが発覚し…</color><ctrl=2E/>",
      "old_target": "<color=0>最终，门泽过去犯下的</color><row/><color=2>性侵案</color><color=0>，也被</color><row/><color=0>揭露了出来……</color><ctrl=2E/>",
      "target": "<color=0>最终，门泽过去犯下的</color><row/><color=2>性侵案</color><color=0>也</color><row/><color=0>被揭露了出来……</color><ctrl=2E/>",
      "reason": "去掉把主语与被动谓语拆开的逗号，使性侵案被揭露的句法连续。"
    },
    {
      "id": "scratch4.dat/s02:1760",
      "source": "<color=0>そして肝心の、門沢</color><row/><color=0>殺害の容疑者だが…</color><ctrl=2E/>",
      "old_target": "<color=0>而最关键的，</color><row/><color=0>门泽命案的嫌疑人……</color><ctrl=2E/>",
      "target": "<color=0>至于最关键的</color><row/><color=0>门泽命案嫌疑人……</color><ctrl=2E/>",
      "reason": "改正‘而最关键的，’悬空修饰，使该话题顺接下一句调查方向。"
    },
    {
      "id": "scratch4.dat/s02:4801",
      "source": "<color=0>写真に写っていた４人の</color><row/><color=0>うち、ひとりは最初に</color><row/><color=0>被害届を出した</color><color=2>柚木香波</color><row/><color=0>という女性である。</color><ctrl=2E/>",
      "old_target": "<color=0>照片中的 4 人里，</color><row/><color=0>已经认出了一位，</color><row/><color=0>就是最早报案的</color><color=2>柚木香波</color><row/><color=0>。</color><ctrl=2E/>",
      "target": "<color=0>照片中的 4 人里，</color><row/><color=0>有一位女性，</color><row/><color=0>名叫</color><color=2>柚木香波</color><row/><color=0>，就是最早报案的人。</color><ctrl=2E/>",
      "reason": "整合姓名与报案者身份，避免原译额外插入认出过程、末行只剩句号。"
    },
    {
      "id": "scratch4.dat/s02:6250",
      "source": "<color=0>…こうして、</color><row/><color=0>あれからの１週間。</color><ctrl=2E/>",
      "old_target": "<color=0>……就这样，</color><row/><color=0>从那天起过去的这一周。</color><ctrl=2E/>",
      "target": "<color=0>……就这样，</color><row/><color=0>从那天起的一周里，</color><ctrl=2E/>",
      "reason": "时间状语顺接下一句调查毫无进展，消除‘从那天起过去的这一周’悬空句。"
    },
    {
      "id": "scratch4.dat/s02:12790",
      "source": "<color=0>中でも要注意団体として</color><row/><color=2>豫言組織</color><color=0>ってのを重点的</color><row/><color=0>に調べてるんですわ。</color><ctrl=2B/>",
      "old_target": "<color=0>其中需要格外警惕的</color><row/><color=2>预言组织</color><color=0>，我们正在</color><row/><color=0>重点调查。”</color><ctrl=2B/>",
      "target": "<color=0>其中，我们把需要格外警惕的</color><row/><color=2>预言组织</color><color=0>列为</color><row/><color=0>重点调查对象。”</color><ctrl=2B/>",
      "reason": "把我们正在调查前置为主谓结构，避免为了高亮把调查对象倒装悬置。"
    },
    {
      "id": "scratch4.dat/s02:15984",
      "source": "<color=0>いやですねえ。</color><row/><color=0>世間は、</color><color=2>敵</color><color=0>と</color><color=2>英雄</color><color=0>を</color><row/><color=0>求めてるんですよ。</color><ctrl=2E/>",
      "old_target": "<color=0>“您这话说的。</color><row/><color=0>这世上，</color><color=2>敌人</color><color=0>和</color><color=2>英雄</color><color=0>，</color><row/><color=0>都是大众渴求的。</color><ctrl=2E/>",
      "target": "<color=0>“您这话说的。</color><row/><color=0>大众渴求着</color><color=2>敌人</color><color=0>和</color><color=2>英雄</color><color=0>这样</color><row/><color=0>的存在。</color><ctrl=2E/>",
      "reason": "恢复大众渴求敌人与英雄的主宾关系，避免不必要的话题倒装。"
    },
    {
      "id": "scratch4.dat/s02:38777",
      "source": "<color=0>残った</color><color=2>３人の被害者</color><row/><color=2>女性の誰か</color><color=0>だと思うん</color><row/><color=0>です。</color><ctrl=2E/>",
      "old_target": "<color=0>我认为，剩下的</color><color=2>三名女性受害者</color><row/><color=2>当中的某一个人</color><color=0>，</color><row/><color=0>就是凶手。</color><ctrl=2E/>",
      "target": "<color=0>剩下的</color><color=2>三名女性受害者</color><row/><color=2>当中的某一个人</color><color=0>吧，</color><row/><color=0>我是这样想的。</color><ctrl=2E/>",
      "reason": "顺接上句‘杀害门泽的凶手，果然还是’，避免中途插入我认为再重复就是凶手；保留推测口气。"
    },
    {
      "id": "scratch4.dat/s02:39552",
      "source": "<color=0>やはり、暴行被害者は</color><row/><color=2>相当な恨み</color><color=0>を持って</color><row/><color=0>いそうじゃないですか。</color><ctrl=2E/>",
      "old_target": "<color=0>受过性侵的女性</color><row/><color=2>怀着深深的恨意</color><color=0>，</color><row/><color=0>不是很有可能吗？”</color><ctrl=2E/>",
      "target": "<color=0>受过性侵的女性，恐怕都</color><row/><color=2>怀着深深的恨意</color><color=0>，</color><row/><color=0>您不觉得吗？”</color><ctrl=2E/>",
      "reason": "把可能性移回主谓句中，避免陈述完再倒补‘不是很有可能吗’。"
    },
    {
      "id": "scratch4.dat/s02:41522",
      "source": "<color=0>つまり、こういう内容の</color><row/><color=0>手紙をもらったら…</color><ctrl=2E/>",
      "old_target": "<color=0>“也就是说，</color><row/><color=0>收到内容这样的信……</color><ctrl=2E/>",
      "target": "<color=0>“也就是说，</color><row/><color=0>如果收到这样一封信……</color><ctrl=2E/>",
      "reason": "改正‘内容这样的信’定语错位，并使假设顺接下句心情变化。"
    },
    {
      "id": "scratch4.dat/s02:42864",
      "source": "<color=0>門沢の死を知らずに、</color><row/><color=2>同じ罠</color><color=0>を張ったのかも</color><row/><color=0>しれません。</color><ctrl=2B/>",
      "old_target": "<color=0>她也许不知道门泽已死，设下了</color><row/><color=2>同样的陷阱</color><color=0>，</color><row/><color=0>也说不定。”</color><ctrl=2B/>",
      "target": "<color=0>她不知道门泽已死，也许设下了</color><row/><color=2>同样的陷阱</color><color=0>，</color><row/><color=0>有这种可能。”</color><ctrl=2B/>",
      "reason": "把也许明确作用于设下同样陷阱，消除原译也许与也说不定重复、推测范围不清。"
    },
    {
      "id": "scratch4.dat/s03:2218",
      "source": "<color=0>乗員、乗客</color><color=2>全員が死亡</color><row/><color=0>…という、大事故が</color><row/><color=0>起こったのである。</color><ctrl=2E/>",
      "old_target": "<color=0>司机和乘客</color><color=2>全部死亡</color><row/><color=0>……发生了这样一场</color><row/><color=0>重大事故。</color><ctrl=2E/>",
      "target": "<color=0>司机和乘客</color><color=2>全部死亡</color><row/><color=0>……这场事故</color><row/><color=0>造成了如此惨重的伤亡。</color><ctrl=2E/>",
      "reason": "保留死亡事实及高亮位置，使后半句承接惨重结果，消除日语式倒补‘发生了这样一场重大事故’。"
    },
    {
      "id": "scratch4.dat/s03:4037",
      "source": "<color=0>道路は通行止めにされ、</color><row/><color=0>消火隊、救助隊、調査隊</color><row/><color=0>区画整理など、大勢が</color><row/><color=0>ひしめきあっている。</color><ctrl=2E/>",
      "old_target": "<color=0>道路已被封锁，</color><row/><color=0>消防、救援、调查，</color><row/><color=0>以及划分现场区域的人，</color><row/><color=0>挤满了这里。</color><ctrl=2E/>",
