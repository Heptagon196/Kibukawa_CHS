      "old_target": "<color=0>“你每次都被</color><color=2>蒙上眼睛</color><color=0>，</color><row/><color=0>再坐车带过去，</color><row/><color=0>肯定不知道吧。”</color><ctrl=2E/>",
      "target": "<color=0>“你每次都被</color><color=2>蒙上眼睛</color><color=0>，</color><row/><color=0>再被人用车带过去，</color><row/><color=0>肯定不知道吧。”</color><ctrl=2E/>",
      "reason": "补明第二个被动关系，避免‘你再坐车带过去’错接成澄佳带别人过去。"
    },
    {
      "id": "scratch4.dat/s21:13612",
      "source": "<color=0>何を頼まれたのかは</color><row/><color=0>知らないが、それは</color><row/><color=0>やめとけ！</color><ctrl=2E/>",
      "old_target": "<color=0>我不知道他们拜托你</color><row/><color=0>做了什么，</color><row/><color=0>但千万别去做！</color><ctrl=2E/>",
      "target": "<color=0>我不知道他们拜托你</color><row/><color=0>去做什么，</color><row/><color=0>但千万别去做！</color><ctrl=2E/>",
      "reason": "委托的是尚未实施的行动，原译‘做了什么’与下句禁止实施矛盾。"
    },
    {
      "id": "scratch4.dat/s21:16768",
      "source": "<color=0>うん…来たよ。</color><row/><color=0>昨日。</color><ctrl=2E/>",
      "old_target": "<color=0>嗯……来过了。</color><row/><color=0>昨天。</color><ctrl=2E/>",
      "target": "<color=0>嗯……昨天</color><row/><color=0>来过了。</color><ctrl=2E/>",
      "reason": "将日语后置的时间状语前置，保留停顿与原行数。"
    },
    {
      "id": "scratch4.dat/s22:4453",
      "source": "<color=0>いよいよ、明日。</color><ctrl=2E/>",
      "old_target": "<color=0>终于到明天了。</color><ctrl=2E/>",
      "target": "<color=0>终于，就在明天了。</color><ctrl=2E/>",
      "reason": "表达行动日将至，避免‘到明天了’误作已经到了次日。"
    },
    {
      "id": "scratch4.dat/s23:1051",
      "source": "<color=0>天井は、わたしの背でも</color><row/><color=0>充分に手が届く高さ</color><row/><color=0>だったので…</color><ctrl=2E/>",
      "old_target": "<color=0>车顶的高度，</color><row/><color=0>就连我这样的身高，</color><row/><color=0>也完全够得着……</color><ctrl=2E/>",
      "target": "<color=0>车顶并不高，</color><row/><color=0>以我的身高，</color><row/><color=0>也完全伸手够得着……</color><ctrl=2E/>",
      "reason": "原译让‘身高’成为‘够得着’的主语；改成身高条件与本人伸手动作。"
    },
    {
      "id": "scratch4.dat/s23:3848",
      "source": "<color=0>あのバスに乗っていた</color><row/><color=0>ところを見られた…。</color><ctrl=2E/>",
      "old_target": "<color=0>被看见我</color><row/><color=0>坐过那辆巴士了……</color><ctrl=2E/>",
      "target": "<color=0>我坐那辆巴士的时候，</color><row/><color=0>被她看见了……</color><ctrl=2E/>",
      "reason": "纠正‘被看见我坐过’的被动语序，并由前文明确目击者是友美。"
    },
    {
      "id": "scratch4.dat/s23:9866",
      "source": "<color=0>当局では、</color><color=2>無差別テロ</color><row/><color=0>ではないかとの見方が</color><row/><color=0>強められています。</color><ctrl=2E/>",
      "old_target": "<color=0>有关部门对</color><color=2>无差别恐怖袭击</color><row/><color=0>的怀疑，</color><row/><color=0>正进一步加深。”</color><ctrl=2E/>",
      "target": "<color=0>有关部门怀疑这是</color><color=2>无差别恐怖袭击</color><row/><color=0>，而且这种怀疑</color><row/><color=0>正进一步加深。”</color><ctrl=2E/>",
      "reason": "将怀疑内容补成‘这是无差别恐怖袭击’，避免变成对恐怖袭击本身的泛泛怀疑；保留推测程度和高亮。"
    },
    {
      "id": "scratch4.dat/s23:10598",
      "source": "<color=0>きっと…</color><row/><color=0>なにかの冗談だ。</color><ctrl=2E/>",
      "old_target": "<color=0>一定是……</color><row/><color=0>开什么玩笑。</color><ctrl=2E/>",
      "target": "<color=0>一定是……</color><row/><color=0>有人在开玩笑。</color><ctrl=2E/>",
      "reason": "‘一定是开什么玩笑’拼接不成正常判断句，补明开玩笑的施事，保留自我否认现实的语气。"
    },
    {
      "id": "scratch4.dat/s24:7934",
      "source": "<color=0>謝らなきゃいけない</color><row/><color=0>人が多いから…。</color><ctrl=2E/>",
      "old_target": "<color=0>毕竟需要道歉的人，</color><row/><color=0>实在太多了……</color><ctrl=2E/>",
      "target": "<color=0>毕竟我要向太多人</color><row/><color=0>道歉了……</color><ctrl=2E/>",
      "reason": "明确是叙述者须向别人道歉，避免‘需要道歉的人’误指那些人应当道歉。"
    },
    {
      "id": "scratch4.dat/s25:9055",
      "source": "<color=0>確かに、市民の</color><row/><color=0>義務としては…</color><ctrl=2E/>",
      "old_target": "<color=0>“确实，作为</color><row/><color=0>一个市民的义务……</color><ctrl=2E/>",
      "target": "<color=0>“确实，要尽到</color><row/><color=0>一个市民的义务……</color><ctrl=2E/>",
      "reason": "修正‘作为一个市民的义务’悬空的介词结构，使之自然引出下一句应当送警。"
    },
    {
      "id": "scratch4.dat/s25:16058",
      "source": "<color=0>最初で最後のわがまま</color><row/><color=0>だと言って、大学で</color><row/><color=0>それを専攻したいと</color><row/><color=0>相談したことがあった。</color><ctrl=2E/>",
      "old_target": "<color=0>于是我曾经说，</color><row/><color=0>这是我第一次，也是最后一次任性，</color><row/><color=0>和他们商量，</color><row/><color=0>想去大学专攻双簧管。</color><ctrl=2E/>",
      "target": "<color=0>于是我曾和他们商量，</color><row/><color=0>说这是我第一次，也是最后一次任性，</color><row/><color=0>希望能去大学</color><row/><color=0>专攻双簧管。</color><ctrl=2E/>",
      "reason": "先明确与父母商量，再接所说内容，避免‘说……和他们商量’的谓语错接。"
    },
    {
      "id": "scratch4.dat/s25:16963",
      "source": "<color=0>こんな子供、拾うんじゃ</color><row/><color=0>なかった…って。</color><ctrl=2E/>",
      "old_target": "<color=0>后悔当初</color><row/><color=0>不该收养这样的孩子……</color><ctrl=2E/>",
      "target": "<color=0>觉得当初</color><row/><color=0>不该收养这样的孩子……</color><ctrl=2E/>",
      "reason": "承接前句‘后悔’，后句应是后悔的想法；‘后悔不该收养’容易造成否定层级错误。"
    },
    {
      "id": "scratch4.dat/s25:19808",
      "source": "<color=0>…あ、どうも。</color><row/><color=0>捜査一課、警部補の</color><row/><color=2>工藤</color><color=0>です。</color><ctrl=2E/>",
      "old_target": "<color=0>“……啊，你好。</color><row/><color=0>我是搜查一课的警部补，</color><row/><color=2>工藤</color><color=0>。</color><ctrl=2E/>",
      "target": "<color=0>“……啊，你好。</color><row/><color=0>我是搜查一课的</color><row/><color=2>工藤</color><color=0>，任警部补。</color><ctrl=2E/>",
      "reason": "把身份介绍中的姓名接回‘我是’结构，再说明职级，避免官职与姓名被逗号拆开。"
    },
    {
      "id": "scratch4.dat/s25:28545",
      "source": "<color=0>この風が秋を押しのけて</color><row/><color=0>やがて最後の冬がくる。</color><ctrl=2E/>",
      "old_target": "<color=0>风会把秋天吹走，</color><row/><color=0>迎来最后一个冬季。</color><ctrl=2E/>",
      "target": "<color=0>风会把秋天吹走，</color><row/><color=0>最后一个冬季即将来临。</color><ctrl=2E/>",
      "reason": "原文后半句主语是冬季，改回冬季来临，避免延续‘风’作为迎来冬季的主语。"
    },
    {
      "id": "scratch4.dat/s25:30454",
      "source": "<color=0>それから</color><row/><color=0>約１ヶ月半後の、</color><row/><color=2>９月24日</color><color=0>。</color><ctrl=2E/>",
      "old_target": "<color=0>此后，</color><row/><color=0>大约一个半月后的 </color><row/><color=2>9 月 24 日</color><color=0>。</color><ctrl=2E/>",
      "target": "<color=0>大约又过了</color><row/><color=0>一个半月，到了</color><row/><color=2>9 月 24 日</color><color=0>。</color><ctrl=2E/>",
      "reason": "将‘此后……后的’重复悬空时间短语改成完整时间推进句，保留日期高亮和行数。"
    },
    {
      "id": "scratch4.dat/s25:30548",
      "source": "<color=0>Ｉ県の山中深くから、</color><row/><color=0>妹浦澄佳の</color><color=2>遺体</color><color=0>が</color><row/><color=0>発見されたのだった…。</color><ctrl=2E/>",
      "old_target": "<color=0>在 I 县的深山里，</color><row/><color=0>妹浦澄佳的</color><color=2>遗体</color><color=0>，</color><row/><color=0>最终被发现了……</color><ctrl=2E/>",
      "target": "<color=0>在 I 县的深山里，</color><row/><color=0>妹浦澄佳的</color><color=2>遗体</color><color=0>终于</color><row/><color=0>被发现了……</color><ctrl=2E/>",
      "reason": "去掉主语和被动谓语之间多余的逗号，将副词接到谓语前，保持遗体高亮。"
    }
  ]
