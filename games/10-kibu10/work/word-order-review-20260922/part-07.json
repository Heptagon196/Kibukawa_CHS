  "changes": [
    {
      "id": "scratch4.dat/s07:6326",
      "source": "<color=0>８月に、妹浦澄佳が</color><row/><color=2>自首</color><color=0>しに来てるはず</color><row/><color=0>らしいんだな。</color><ctrl=2E/>",
      "old_target": "<color=0>8 月，妹浦澄佳应该来过</color><row/><color=2>自首</color><color=0>，</color><row/><color=0>他是这么说的。”</color><ctrl=2E/>",
      "target": "<color=0>8 月，妹浦澄佳应该来</color><row/><color=2>自首</color><color=0>过，</color><row/><color=0>他是这么说的。”</color><ctrl=2E/>",
      "reason": "将来过自首调整为来自首过，明确保留此前八月来过的完成义，以及转述中的推测程度。"
    },
    {
      "id": "scratch4.dat/s07:6618",
      "source": "<color=0>だから俺も、自首にゃ</color><row/><color=0>来てないと思って、</color><row/><color=0>そう言ってたわけだ。</color><ctrl=2E/>",
      "old_target": "<color=0>所以我也以为</color><row/><color=0>她没来过自首，</color><row/><color=0>就这么告诉了他。”</color><ctrl=2E/>",
      "target": "<color=0>所以我也以为</color><row/><color=0>她没来自首过，</color><row/><color=0>就这么告诉了他。”</color><ctrl=2E/>",
      "reason": "修正‘没来过自首’的动词组合语序，与前文自首记录相接。"
    },
    {
      "id": "scratch4.dat/s10:1669",
      "source": "<color=0>欧風な赤レンガ造りの</color><row/><color=0>マンションの一室…</color><row/><color=0>ということだ。</color><ctrl=2E/>",
      "old_target": "<color=0>在一栋欧式红砖</color><row/><color=0>公寓楼里，</color><row/><color=0>其中的某个房间……</color><ctrl=2E/>",
      "target": "<color=0>就在一栋欧式红砖</color><row/><color=0>公寓楼的某个房间里……</color><row/><color=0>便条上是这么写的。</color><ctrl=2E/>",
      "reason": "将公寓楼与房间的所属关系接合，消除‘在楼里，其中的某个房间’的悬空结构，并保留传述语气。"
    },
    {
      "id": "scratch4.dat/s11:13764",
      "source": "<color=0>僕とのいち個人としての</color><row/><color=0>調査依頼なら…受ける</color><row/><color=0>こともできるでしょう。</color><ctrl=2E/>",
      "old_target": "<color=0>如果只是我以个人身份</color><row/><color=0>提出的调查委托……</color><row/><color=0>您应该还是可以接受的吧。</color><ctrl=2E/>",
      "target": "<color=0>如果只是我私下</color><row/><color=0>请您帮忙调查……</color><row/><color=0>您应该还是可以接受的吧。</color><ctrl=2E/>",
      "reason": "前句区分工作委托，后句解释为朋友之间的请求；译成私下请求帮忙，保留私人关系的含义，不武断把个人身份归到任何一方。"
    },
    {
      "id": "scratch4.dat/s12:3171",
      "source": "<color=0>実は、石上さんに</color><color=10>紹介</color><row/><color=10>したい人</color><color=0>がいるんです。</color><ctrl=2E/>",
      "old_target": "<color=0>其实，我有个</color><color=10>想介绍</color><row/><color=10>给您认识的人</color><color=0>，石上先生。</color><ctrl=2E/>",
      "target": "<color=0>其实，石上先生，我有个</color><color=10>想介绍</color><row/><color=10>给您认识的人</color><color=0>。</color><ctrl=2E/>",
      "reason": "把称呼放回陈述前，消除为迁就高亮片段而后置称呼的生硬感。"
    },
    {
      "id": "scratch4.dat/s12:8951",
      "source": "<color=0>注意してないと</color><row/><color=0>聞こえないような、</color><row/><color=0>小さな小さな声で…</color><ctrl=2E/>",
      "old_target": "<color=0>用一种不留神</color><row/><color=0>就听不见的，</color><row/><color=0>很轻很轻的声音……</color><ctrl=2E/>",
      "target": "<color=0>用一种不留神</color><row/><color=0>就听不见的、</color><row/><color=0>很轻很轻的声音，说了……</color><ctrl=2E/>",
      "reason": "将谓语‘说了’放在下一条高亮宾语‘一句话’之前，让跨条叙述按汉语语序衔接。"
    },
    {
      "id": "scratch4.dat/s12:9085",
      "source": "<color=2>ひとこと</color><color=0>つぶやいたのを</color><row/><color=0>あたし、聞いたんです。</color><ctrl=2E/>",
      "old_target": "<color=2>一句话</color><color=0>，就这样轻轻说出口，</color><row/><color=0>被我听见了。”</color><ctrl=2E/>",
      "target": "<color=2>一句话</color><color=0>，</color><row/><color=0>我听见了。”</color><ctrl=2E/>",
      "reason": "接前条‘说了……’，消除原译‘一句话就这样轻轻说出口，被我听见’的倒装及被动堆叠。"
    },
    {
      "id": "scratch4.dat/s12:9979",
      "source": "<color=2>「永劫会」</color><color=0>っていう</color><row/><color=0>新興団体があるのを</color><row/><color=0>見つけたんです。</color><ctrl=2E/>",
      "old_target": "<color=2>‘永劫会’</color><color=0>这个名字，</color><row/><color=0>属于一个</color><row/><color=0>新兴团体。</color><ctrl=2E/>",
      "target": "<color=2>‘永劫会’</color><color=0>的</color><row/><color=0>新兴</color><row/><color=0>团体。</color><ctrl=2E/>",
      "reason": "承接9830的只发现一个叫……，完整组成一个叫永劫会的新兴团体；保留高亮及原row数，正文由现有运行时重新排行。"
    },
    {
      "id": "scratch4.dat/s12:20714",
      "source": "<color=0>大学まで一貫の女子校に</color><row/><color=0>通わせて、厳しく育てて</color><row/><color=0>きたんだよ。</color><ctrl=2E/>",
      "old_target": "<color=0>我让她就读一直到</color><row/><color=0>大学的女子学校，</color><row/><color=0>从小对她管教严格。</color><ctrl=2E/>",
      "target": "<color=0>我从小就让她上女校，</color><row/><color=0>一直到大学也是如此，</color><row/><color=0>对她管教得很严格。</color><ctrl=2E/>",
      "reason": "将‘一直到大学’明确修饰就读女校的时间跨度，避免原译‘就读一直到大学的女子学校’的修饰歧义。"
    },
    {
      "id": "scratch4.dat/s12:22004",
      "source": "<color=2>探偵</color><color=0>を雇って、徹底的に</color><row/><color=0>探らせたんだが…</color><ctrl=2E/>",
      "old_target": "<color=2>“侦探</color><color=0>，我雇了一个，让他</color><row/><color=0>彻底调查……</color><ctrl=2E/>",
      "target": "<color=2>“侦探</color><color=0>是雇了，也让他</color><row/><color=0>彻底调查了……</color><ctrl=2E/>",
      "reason": "保留句首高亮侦探，以汉语话题句承接‘找到男人了吗’，去掉‘侦探，我雇了一个’的硬拆。"
    },
    {
      "id": "scratch4.dat/s12:28411",
      "source": "<color=0>10日ほど前に、</color><row/><color=2>キブカワ</color><color=0>という探偵に</color><row/><color=0>お願いしました。</color><ctrl=2E/>",
      "old_target": "<color=0>大约 10 天前，</color><row/><color=2>癸生川</color><color=0>这位侦探，</color><row/><color=0>接受了我的委托。”</color><ctrl=2E/>",
      "target": "<color=0>大约 10 天前，我请</color><row/><color=2>癸生川</color><color=0>这位侦探</color><row/><color=0>帮忙调查了。”</color><ctrl=2E/>",
      "reason": "恢复原文由石上提出委托的主语与动作，去除侦探反客为主的被动转述。"
    },
    {
      "id": "scratch4.dat/s12:32990",
      "source": "<color=0>この事件の、被害者、</color><row/><color=2>門沢文治</color><color=0>という人物</color><row/><color=0>なんだぁな。</color><ctrl=2E/>",
      "old_target": "<color=0>“这起案子的，死者，</color><row/><color=2>门泽文治</color><color=0>，</color><row/><color=0>就是这个人呀。”</color><ctrl=2E/>",
      "target": "<color=0>“这起案子的死者，是个叫</color><row/><color=2>门泽文治</color><color=0>的男人</color><row/><color=0>呀。”</color><ctrl=2E/>",
      "reason": "以死者叫某某正常说明姓名，去掉案子的、死者之间的修饰成分断裂；保留赤洲说话时的停顿。"
    },
    {
      "id": "scratch4.dat/s12:36059",
      "source": "<color=0>門沢と永劫会を結び</color><row/><color=0>つけるような</color><color=2>証拠</color><color=0>は、</color><row/><color=0>無いんだぁな。</color><ctrl=2E/>",
      "old_target": "<color=0>“要把门泽和永劫会</color><row/><color=0>联系起来的</color><color=2>证据</color><color=0>，</color><row/><color=0>目前没有呀。”</color><ctrl=2E/>",
      "target": "<color=0>“能把门泽和永劫会</color><row/><color=0>联系起来的</color><color=2>证据</color><color=0>，</color><row/><color=0>目前没有呀。”</color><ctrl=2E/>",
      "reason": "将“要把……联系起来的证据”修正为“能把……联系起来的证据”，使修饰关系自然准确。"
    },
    {
      "id": "scratch4.dat/s12:48012",
      "source": "<color=0>こんないい加減な探偵に</color><row/><color=0>依頼したことを、少し…</color><ctrl=3B/><row/><color=0>いや、大変後悔しながら</color><row/><color=0>探偵事務所を後にする、</color><row/><color=0>石上雅人であった。</color><ctrl=2E/>",
      "old_target": "<color=0>把委托交给</color><row/><color=0>这么不靠谱的侦探，实在有点……</color><ctrl=3B/><row/><color=0>不，是非常后悔。</color><row/><color=0>石上雅人就这样，</color><row/><color=0>离开了侦探事务所。</color><ctrl=2E/>",
      "target": "<color=0>石上雅人有些后悔，</color><row/><color=0>把委托交给了这么不靠谱的侦探……</color><ctrl=3B/><row/><color=0>不，是非常后悔。</color><row/><color=0>他怀着这样的心情，</color><row/><color=0>离开了侦探事务所。</color><ctrl=2E/>",
      "reason": "将叙述主体提前，并让‘有些后悔……不，是非常后悔’在点击等待两侧完整承接，消除主语和心理谓语悬空。"
    },
    {
      "id": "scratch4.dat/s12:9830",
      "source": "<color=0>新聞とかミニコミ誌とか</color><row/><color=0>片っ端から調べてみたら</color><row/><color=0>いっこだけ…</color><ctrl=2E/>",
      "old_target": "<color=0>“我翻了各种报纸、</color><row/><color=0>地方小报之类的，</color><row/><color=0>只找到一条……</color><ctrl=2E/>",
      "target": "<color=0>“我翻了各种报纸、</color><row/><color=0>地方小报之类的，</color><row/><color=0>只发现一个叫……</color><ctrl=2E/>",
      "reason": "把下一条位于句首的高亮团体名称接入一个叫……的新兴团体结构，避免专名后置补释。"
    }
  ]
