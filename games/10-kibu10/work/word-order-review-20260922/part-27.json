  "changes": [
    {
      "id": "scratch4.dat/s27:2943",
      "source": "<color=0>３ヶ月前に突然辞めて、</color><row/><color=0>今は無職の、沖村勇さん</color><row/><color=0>です。</color><ctrl=2E/>",
      "old_target": "<color=0>可 3 个月前突然辞职，</color><row/><color=0>如今待业的冲村勇</color><row/><color=0>先生。”</color><ctrl=2E/>",
      "target": "<color=0>可 3 个月前突然辞职，</color><row/><color=0>如今还在待业，</color><row/><color=0>没错吧，冲村勇先生？”</color><ctrl=2E/>",
      "reason": "承接前文第二人称介绍，避免句尾突然变成无谓语的身份定语；保留重复点名确认的口吻。"
    },
    {
      "id": "scratch4.dat/s27:6579",
      "source": "<color=0>別れを告げたんだと…</color><row/><color=0>思います。</color><ctrl=2E/>",
      "old_target": "<color=0>我想，才会向你</color><row/><color=0>提出分手。”</color><ctrl=2E/>",
      "target": "<color=0>我想，她才因此向你</color><row/><color=0>提出了分手。”</color><ctrl=2E/>",
      "reason": "补明推测句的主语和因果衔接，避免‘我想，才会’悬空。"
    },
    {
      "id": "scratch4.dat/s27:11763",
      "source": "<color=0>そして、</color><color=2>永劫会</color><color=0>という</color><row/><color=0>組織の一員にされた</color><row/><color=0>ことへと続いた。</color><ctrl=2E/>",
      "old_target": "<color=0>接着，她被迫成为</color><color=2>永劫会</color><color=0>这个</color><row/><color=0>组织的一员，</color><row/><color=0>她将这些娓娓道来。</color><ctrl=2E/>",
      "target": "<color=0>接着又讲到，澄佳被迫加入</color><color=2>永劫会</color><color=0>这个</color><row/><color=0>组织，</color><row/><color=0>成为其中一员的事。</color><ctrl=2E/>",
      "reason": "明确讲述者与遭遇者，消除前后两个‘她’分别指向不同人物造成的主语漂移。"
    },
    {
      "id": "scratch4.dat/s27:27160",
      "source": "<color=0>やっぱり沖村さんに</color><row/><color=0>澄佳さんは、過ぎた人</color><row/><color=0>だったようですね…。</color><ctrl=2E/>",
      "old_target": "<color=0>“看来，澄佳对</color><row/><color=0>冲村先生来说，</color><row/><color=0>实在太好了……</color><ctrl=2E/>",
      "target": "<color=0>“看来，冲村先生</color><row/><color=0>果然还是</color><row/><color=0>配不上澄佳啊……</color><ctrl=2E/>",
      "reason": "将‘过于优秀而不相配’改成中文自然的主谓表达，避免‘澄佳对冲村太好’被理解为待他很好。"
    },
    {
      "id": "scratch4.dat/s31:3062",
      "source": "<color=0>そこでですね。</color><row/><color=0>ここに、今年に入って</color><row/><color=0>から立ち上げられた…</color><ctrl=2E/>",
      "old_target": "<color=0>“说到这里。</color><row/><color=0>今年以来，</color><row/><color=0>新成立的……</color><ctrl=2E/>",
      "target": "<color=0>“说到这里，</color><row/><color=0>我们统计了今年以来</color><row/><color=0>新成立的……</color><ctrl=2E/>",
      "reason": "与下一条连读，先交代统计动作，避免长定语后再插入展板主句。"
    },
    {
      "id": "scratch4.dat/s31:3206",
      "source": "<color=0>新興宗教の数を</color><row/><color=0>まとめたフリップが</color><row/><color=0>あるのですが。</color><ctrl=2E/>",
      "old_target": "<color=0>新兴宗教有多少，</color><row/><color=0>我们准备了一块展板，</color><row/><color=0>把数量统计了出来。</color><ctrl=2E/>",
      "target": "<color=0>新兴宗教的数量，</color><row/><color=0>并整理在了</color><row/><color=0>这块展板上。</color><ctrl=2E/>",
      "reason": "承接上条‘统计了’，按统计数量、展示结果的中文语序表达。"
    },
    {
      "id": "scratch4.dat/s31:8912",
      "source": "<color=0>あっし、ヤマトテレビ</color><row/><color=0>報道局ディレクターの、</color><row/><color=2>矢当</color><color=0>と申します。</color><ctrl=2E/>",
