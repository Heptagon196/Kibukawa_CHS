  "changes": [
    {
      "id": "scratch4.dat/s35:738",
      "source": "<color=0>落ち着け、私。</color><ctrl=2E/>",
      "old_target": "<color=0>冷静点，我。</color><ctrl=2E/>",
      "target": "<color=0>我要冷静点。</color><ctrl=2E/>",
      "reason": "自我鼓励不应直译为句尾呼唤“我”。"
    },
    {
      "id": "scratch4.dat/s35:2391",
      "source": "<color=0>遅いぞ、伊綱君！</color><row/><color=0>何をしていたんだ、</color><row/><color=0>今まで!!</color><ctrl=2E/>",
      "old_target": "<color=0>太慢了，伊纲！</color><row/><color=0>你到现在都</color><row/><color=0>干什么去了！</color><ctrl=2E/>",
      "target": "<color=0>太慢了，伊纲！</color><row/><color=0>你这么久都</color><row/><color=0>干什么去了！</color><ctrl=2E/>",
      "reason": "“到现在都干什么去了”时间状语搭配生硬，改成询问此前耽搁的自然语序。"
    },
    {
      "id": "scratch4.dat/s35:2681",
      "source": "<color=0>予想外にものすごく歓迎</color><row/><color=0>され、私は裏返った変な</color><row/><color=0>声を出してしまった…。</color><ctrl=2E/>",
      "old_target": "<color=0>没想到他竟如此欢迎，</color><row/><color=0>我一激动，</color><row/><color=0>嗓子都喊劈了……</color><ctrl=2E/>",
      "target": "<color=0>没想到他竟如此欢迎我，</color><row/><color=0>我一激动，</color><row/><color=0>嗓子都喊劈了……</color><ctrl=2E/>",
      "reason": "主动转译后补全“欢迎”的宾语，明确受欢迎的是叙述者。"
    },
    {
      "id": "scratch4.dat/s35:5098",
      "source": "<color=0>…先生は調査に</color><row/><color=0>出ていて、いない。</color><ctrl=2E/>",
      "old_target": "<color=0>……老师出去</color><row/><color=0>调查了，不在。</color><ctrl=2E/>",
      "target": "<color=0>……老师不在，</color><row/><color=0>出去调查了。</color><ctrl=2E/>",
      "reason": "将后置的“不在”移至主句，后句交代原因。"
    },
    {
      "id": "scratch4.dat/s35:5972",
      "source": "<color=0>落ち着け、私。</color><ctrl=2E/>",
      "old_target": "<color=0>冷静点，我。</color><ctrl=2E/>",
      "target": "<color=0>我要冷静点。</color><ctrl=2E/>",
      "reason": "自我鼓励不应直译为句尾呼唤“我”。"
    },
    {
      "id": "scratch4.dat/s35:9554",
      "source": "<color=0>…もしかして、バスの</color><row/><color=0>チケットをニセ物と</color><row/><color=2>すり替えた</color><color=0>のは君か!?</color><ctrl=2E/>",
      "old_target": "<color=0>……难不成，把巴士车票</color><row/><color=0>用假票</color><row/><color=2>调包</color><color=0>的人，就是你？！”</color><ctrl=2E/>",
      "target": "<color=0>……难不成，用假票</color><row/><color=0>把巴士车票</color><row/><color=2>调包</color><color=0>的人，就是你？！”</color><ctrl=2E/>",
      "reason": "将工具状语“用假票”移至把字结构之前，保留“调包”的高亮。"
    },
    {
      "id": "scratch4.dat/s35:11967",
      "source": "<color=0>永劫会に</color><color=2>侵入</color><color=0>して、</color><row/><color=0>その内情を探って</color><row/><color=0>きてもらいたい！</color><ctrl=2E/>",
      "old_target": "<color=0>“永劫会这地方，我要你</color><color=2>潜入</color><color=0>进去，</color><row/><color=0>查清</color><row/><color=0>内部的情况！”</color><ctrl=2E/>",
      "target": "<color=0>“我要你</color><color=2>潜入</color><color=0>永劫会，</color><row/><color=0>查清</color><row/><color=0>内部的情况！”</color><ctrl=2E/>",
      "reason": "将地点还原为“潜入”的宾语，避免“永劫会这地方……进去”的重复前置。"
    },
    {
      "id": "scratch4.dat/s35:17767",
      "source": "<color=0>なるほど、それで</color><row/><color=0>女の私じゃないと潜入</color><row/><color=0>できないんですね。</color><ctrl=2E/>",
      "old_target": "<color=0>“原来如此，所以</color><row/><color=0>必须由身为女性的我，</color><row/><color=0>才能潜入进去。</color><ctrl=2E/>",
      "target": "<color=0>“原来如此，所以</color><row/><color=0>只有身为女性的我，</color><row/><color=0>才能潜入进去。</color><ctrl=2E/>",
      "reason": "改正“必须由……才能”的杂糅，保持女性身份是潜入条件。"
    },
    {
      "id": "scratch4.dat/s35:18772",
      "source": "<color=0>永劫会の</color><color=2>趣旨、目的</color><color=0>と、</color><row/><color=2>入会の条件</color><color=0>を探らないと</color><row/><color=0>話になりませんね。</color><ctrl=2E/>",
      "old_target": "<color=0>永劫会的</color><color=2>宗旨、目的</color><color=0>，以及</color><row/><color=2>入会条件</color><color=0>，不先查清楚，</color><row/><color=0>就无从下手了。”</color><ctrl=2E/>",
      "target": "<color=0>不先查清永劫会的</color><color=2>宗旨、目的</color><color=0>，以及</color><row/><color=2>入会条件</color><color=0>，</color><row/><color=0>就无从下手了。”</color><ctrl=2E/>",
      "reason": "将否定条件“不先查清”置于宾语之前，避免列完两项再倒接谓语。"
    },
    {
      "id": "scratch4.dat/s35:22683",
      "source": "<color=0>そもそも、その写真は</color><row/><color=2>何をした人の写真</color><color=0>なの</color><row/><color=0>か？</color><ctrl=2E/>",
      "old_target": "<color=0>说到底，那张照片里的</color><row/><color=2>人究竟做过什么</color><color=0>，</color><row/><color=0>是这个问题吧？</color><ctrl=2E/>",
      "target": "<color=0>说到底，那张照片里的</color><row/><color=2>人究竟做过什么</color><color=0>事</color><row/><color=0>呢？</color><ctrl=2E/>",
      "reason": "将问句直接收束为“做过什么事呢”，去掉原译额外倒接的“是这个问题吧”。"
    },
    {
      "id": "scratch4.dat/s35:33875",
      "source": "<color=0>…ってことは、</color><row/><color=0>これで</color><color=2>養女</color><color=0>のセンは</color><row/><color=0>消えたか…。</color><ctrl=2E/>",
      "old_target": "<color=0>……这么说，</color><row/><color=0>是</color><color=2>养女</color><color=0>这条线索，</color><row/><color=0>也被排除了……</color><ctrl=2E/>",
      "target": "<color=0>……这么说，</color><row/><color=0>她是</color><color=2>养女</color><color=0>的可能性，</color><row/><color=0>也被排除了……</color><ctrl=2E/>",
      "reason": "补足“是养女”的主语，并将被排除的对象明确为可能性。"
    },
    {
      "id": "scratch4.dat/s35:34773",
      "source": "<color=0>はじめまして、</color><row/><color=0>探偵の、白鷺洲伊綱と</color><row/><color=0>いいます。</color><ctrl=2E/>",
      "old_target": "<color=0>初次见面，</color><row/><color=0>我是侦探，</color><row/><color=0>白鹭洲伊纲。”</color><ctrl=2E/>",
      "target": "<color=0>初次见面，</color><row/><color=0>我是侦探</color><row/><color=0>白鹭洲伊纲。”</color><ctrl=2E/>",
      "reason": "去掉身份和姓名之间割裂同位关系的逗号。"
    },
    {
      "id": "scratch4.dat/s35:42200",
      "source": "<color=0>私、探偵の白鷺洲伊綱と</color><row/><color=0>申します。</color><ctrl=2E/>",
      "old_target": "<color=0>我是侦探，</color><row/><color=0>白鹭洲伊纲。”</color><ctrl=2E/>",
      "target": "<color=0>我是侦探</color><row/><color=0>白鹭洲伊纲。”</color><ctrl=2E/>",
      "reason": "去掉身份和姓名之间割裂同位关系的逗号。"
    },
    {
      "id": "scratch4.dat/s35:43729",
      "source": "<color=0>優子さん、</color><row/><color=0>探るような真似して</color><row/><color=0>ごめんなさい。</color><ctrl=2E/>",
      "old_target": "<color=0>“优子，</color><row/><color=0>对不起，</color><row/><color=0>这样打探你的事。</color><ctrl=2E/>",
      "target": "<color=0>“优子，</color><row/><color=0>这样打探你的事，</color><row/><color=0>对不起。</color><ctrl=2E/>",
      "reason": "将道歉缘由置于“对不起”之前，避免道歉后悬接行为片段。"
    },
    {
      "id": "scratch4.dat/s35:44959",
      "source": "<color=0>会員同士は、お互いの</color><row/><color=0>名前も知らされません</color><row/><color=0>から…。</color><ctrl=2E/>",
      "old_target": "<color=0>会员之间，</color><row/><color=0>也不会被告知</color><row/><color=0>彼此的名字……”</color><ctrl=2E/>",
      "target": "<color=0>会里连其他会员的名字</color><row/><color=0>也不会告诉我们</color><row/><color=0>……”</color><ctrl=2E/>",
      "reason": "将日式被动改为自然主动表达，明确告知对象是会员。"
    },
    {
      "id": "scratch4.dat/s35:47476",
      "source": "<color=0>…特に強い</color><color=2>反戦意識</color><color=0>を</color><row/><color=0>持ってるわけでも</color><row/><color=0>なさそうだな…。</color><ctrl=2E/>",
      "old_target": "<color=0>……至于特别强烈的</color><color=2>反战意识</color><color=0>，</color><row/><color=0>她似乎</color><row/><color=0>也没有……</color><ctrl=2E/>",
      "target": "<color=0>……她的</color><color=2>反战意识</color><color=0>，</color><row/><color=0>似乎也不是</color><row/><color=0>特别强烈……</color><ctrl=2E/>",
      "reason": "将主体和程度判断恢复为中文顺序，保留“似乎”和高亮含义。"
    }
  ]
}
