  "changes": [
    {
      "id": "scratch4.dat/s35-1:739",
      "source": "<color=0>和志武の手によって</color><row/><color=2>暴行を受けた人物</color><color=0>の</color><row/><color=0>名前は…</color><ctrl=2E/>",
      "old_target": "<color=0>和志武案中</color><row/><color=2>遭到施暴的人</color><color=0>，其</color><row/><color=0>名字……</color><ctrl=2E/>",
      "target": "<color=0>和志武的</color><row/><color=2>性侵受害者</color><color=0>，</color><row/><color=0>名字是……</color><ctrl=2E/>",
      "reason": "合并受害者身份，去除‘遭到施暴的人，其名字’的生硬拆译，承接下一句姓名。"
    },
    {
      "id": "scratch4.dat/s35-1:7112",
      "source": "<color=0>無理やり</color><color=2>乱暴をされて、</color><row/><color=2>心に傷を負った</color><color=0>人たち</color><row/><color=0>だったんですね…。</color><ctrl=2E/>",
      "old_target": "<color=0>强行</color><color=2>侵犯，</color><row/><color=2>心灵受到了创伤</color><color=0>，是这样</color><row/><color=0>的一群人吧……”</color><ctrl=2E/>",
      "target": "<color=0>遭到强行</color><color=2>侵犯，</color><row/><color=2>心灵受到了创伤</color><color=0>，</color><row/><color=0>是这样吧……”</color><ctrl=2E/>",
      "reason": "前句已给出大家曾被男性强行的受害关系；本句复述时补出遭到，明确被动，去除后置的是这样的一群人造成的句式折返。"
    },
    {
      "id": "scratch4.dat/s35-1:11032",
      "source": "<color=0>…私たちには、屈辱を</color><row/><color=0>上塗りさせる道しか</color><row/><color=0>ないんです。</color><ctrl=2E/>",
      "old_target": "<color=0>“……我们能走的路，</color><row/><color=0>只有让自己</color><row/><color=0>蒙受更多屈辱。</color><ctrl=2E/>",
      "target": "<color=0>“……我们只有</color><row/><color=0>继续蒙受更多屈辱</color><row/><color=0>这一条路可走。</color><ctrl=2E/>",
      "reason": "修正‘能走的路只有让自己……’主谓搭配不全，保持原文无路可走的无奈。"
    },
    {
      "id": "scratch4.dat/s35-1:11556",
      "source": "<color=0>自分が、どこで、</color><row/><color=0>どのようなことを</color><row/><color=0>されたのかを…</color><ctrl=2E/>",
      "old_target": "<color=0>必须把自己在什么地方，</color><row/><color=0>遭到了</color><row/><color=0>什么样的对待……</color><ctrl=2E/>",
      "target": "<color=0>自己在什么地方，</color><row/><color=0>遭到了</color><row/><color=0>什么样的对待……</color><ctrl=2E/>",
      "reason": "与后句‘连具体情况和细节，都必须全部如实说明’衔接，消除‘必须把……连……都必须’的悬空把字句。"
    },
    {
      "id": "scratch4.dat/s35-1:17428",
      "source": "<color=0>そして、実際バスには</color><row/><color=0>乗りませんでしたが、</color><row/><color=0>門沢文治、45歳。</color><ctrl=2E/>",
      "old_target": "<color=0>还有，虽然实际上</color><row/><color=0>没有坐上那辆巴士，</color><row/><color=0>门泽文治，45 岁。</color><ctrl=2E/>",
      "target": "<color=0>还有门泽文治，45 岁，</color><row/><color=0>不过他实际上</color><row/><color=0>并没有坐上那辆巴士。</color><ctrl=2E/>",
      "reason": "先交代人名，再补充未乘车的情况，避免‘虽然没有坐上巴士，门泽文治’主语后置成残句。"
    },
    {
      "id": "scratch4.dat/s35-1:22976",
      "source": "<color=0>名前だけで実在はしない</color><row/><color=2>偶像的存在</color><color=0>なのかも</color><row/><color=0>しれません。</color><ctrl=2E/>",
      "old_target": "<color=0>那只是一个名字，</color><row/><color=2>偶像般的存在</color><color=0>，其实</color><row/><color=0>根本没有这个人。”</color><ctrl=2E/>",
      "target": "<color=0>也许那只是个名字，是个</color><row/><color=2>偶像般的存在</color><color=0>，</color><row/><color=0>现实中并没有这个人。”</color><ctrl=2E/>",
      "reason": "为高亮名词补足判断句，避免一个名字、偶像般的存在孤立堆叠；本句保留也许，明确原文かもしれません的推测程度。"
    },
    {
      "id": "scratch4.dat/s35-1:29176",
      "source": "<color=0>それはまるで、</color><row/><color=0>妹浦澄佳という人物は…</color><ctrl=2E/>",
      "old_target": "<color=0>那简直就像</color><row/><color=0>妹浦澄佳这个人……</color><ctrl=2E/>",
      "target": "<color=0>这样一来，看上去</color><row/><color=0>就像妹浦澄佳这个人……</color><ctrl=2E/>",
      "reason": "与后一条联合理顺假象内容和叙述判断的顺序。"
    },
    {
      "id": "scratch4.dat/s35-1:29273",
      "source": "<color=0>永劫会という団体とは、</color><row/><color=0>初めから</color><color=2>何の関係も</color><row/><color=2>ない</color><color=0>と見せかけている</color><row/><color=0>ようだった。</color><ctrl=2E/>",
      "old_target": "<color=0>和永劫会这个团体，</color><row/><color=0>从一开始就</color><color=2>没有任何</color><row/><color=2>关系</color><color=0>，故意要营造出</color><row/><color=0>这样的假象。</color><ctrl=2E/>",
      "target": "<color=0>从一开始就和永劫会</color><row/><color=0>这个团体</color><color=2>毫无</color><row/><color=2>关系</color><color=0>。这似乎是</color><row/><color=0>有人刻意制造的假象。</color><ctrl=2E/>",
      "reason": "承接前句完整说出无关系的假象，再交代似乎有人刻意伪装，去除后置‘故意要营造出’的语序折返并保留推测。"
    },
    {
      "id": "scratch4.dat/s35-1:35224",
      "source": "<color=0>ファイルを開くと、</color><row/><color=0>中には、</color><color=2>調査報告書</color><color=0>と</color><row/><color=0>書かれた書類が入って</color><row/><color=0>いた。</color><ctrl=2E/>",
