  "changes": [
    {
      "id": "scratch4.dat/s13:3650",
      "source": "<color=0>まあ、良くも悪くも</color><row/><color=0>逃げ出すような人物とは</color><row/><color=0>思えないけど。</color><ctrl=2E/>",
      "old_target": "<color=0>不过，无论从好处</color><row/><color=0>还是坏处想，他都</color><row/><color=0>不像是会逃跑的人。</color><ctrl=2E/>",
      "target": "<color=0>不过，不管怎么说，</color><row/><color=0>他都不像是</color><row/><color=0>会逃跑的人。</color><ctrl=2E/>",
      "reason": "消除“从好处还是坏处想”的日语直译搭配，保留对人物的判断。"
    },
    {
      "id": "scratch4.dat/s13:8197",
      "source": "<color=0>澄佳君をたぶらかして</color><row/><color=0>いる所なのだろう!?</color><row/><color=0>遠慮することあるまい！</color><ctrl=2E/>",
      "old_target": "<color=0>“这里不是在</color><row/><color=0>蛊惑澄佳的地方吗？！</color><row/><color=0>有什么好客气的！”</color><ctrl=2E/>",
      "target": "<color=0>“这里不就是</color><row/><color=0>蛊惑澄佳的地方吗？！</color><row/><color=0>有什么好客气的！”</color><ctrl=2E/>",
      "reason": "去掉“这里不是在……的地方”的句式杂糅。"
    },
    {
      "id": "scratch4.dat/s13:11579",
      "source": "<color=0>彼女と一緒に、こちらの</color><row/><color=0>永劫会に</color><color=2>入会したい</color><color=0>と</color><row/><color=0>言って聞かないのです！</color><ctrl=2E/>",
      "old_target": "<color=0>非说要和女朋友一起，</color><row/><color=0>来到永劫会，</color><color=2>加入贵会</color><color=0>，</color><row/><color=0>怎么劝都不听！”</color><ctrl=2E/>",
      "target": "<color=0>非说要和女朋友一起</color><row/><color=0>来这里</color><color=2>加入贵会</color><color=0>，</color><row/><color=0>怎么劝都不听！”</color><ctrl=2E/>",
      "reason": "将“来到永劫会，加入贵会”整理为连续谓语，保留入会高亮。"
    },
    {
      "id": "scratch4.dat/s13:14980",
      "source": "<color=0>永劫会会員の女性には</color><row/><color=0>必ず</color><color=2>共通点</color><color=0>がある、</color><row/><color=0>ということだ！</color><ctrl=2B/>",
      "old_target": "<color=0>永劫会的女会员</color><row/><color=0>之间，一定存在</color><color=2>共同点</color><color=0>，</color><row/><color=0>就是这么回事！”</color><ctrl=2B/>",
      "target": "<color=0>永劫会的女会员之间</color><row/><color=0>一定存在</color><color=2>共同点</color><color=0>，</color><row/><color=0>就是这么回事！”</color><ctrl=2B/>",
      "reason": "避免把“女会员之间”拆成前后两个分句。"
    },
    {
      "id": "scratch4.dat/s13:17243",
      "source": "<color=0>あの子は、澄佳の友人の</color><row/><color=0>中庭友美…さんです。</color><ctrl=2E/>",
      "old_target": "<color=0>她是澄佳的朋友，</color><row/><color=0>叫中庭友美……小姐。”</color><ctrl=2E/>",
      "target": "<color=0>她是澄佳的朋友，</color><row/><color=0>中庭友美……小姐。”</color><ctrl=2E/>",
      "reason": "原文是同位介绍，去掉“叫”以免把“小姐”并入姓名。"
    },
    {
      "id": "scratch4.dat/s13:19636",
      "source": "<color=0>…ガラスの割れる音が</color><row/><color=0>聞こえ。</color><ctrl=2E/>",
      "old_target": "<color=0>……玻璃碎裂的声音</color><row/><color=0>传来。</color><ctrl=2E/>",
      "target": "<color=0>……传来了</color><row/><color=0>玻璃碎裂的声音。</color><ctrl=2E/>",
      "reason": "调整为中文自然的声音出现句式，避免谓语单独后置。"
    },
    {
      "id": "scratch4.dat/s13:20094",
      "source": "<color=0>突如、天井から</color><row/><color=0>爆発し、炎上した。</color><ctrl=2E/>",
      "old_target": "<color=0>突然从车顶</color><row/><color=0>爆炸起火。</color><ctrl=2E/>",
      "target": "<color=0>车顶突然发生爆炸，</color><row/><color=0>随后燃起大火。</color><ctrl=2E/>",
      "reason": "理清车顶为爆炸起点，消除“从车顶爆炸”的生硬搭配。"
    },
    {
      "id": "scratch4.dat/s14:4656",
      "source": "<color=0>これから行けば</color><row/><color=0>いいだけの話だ！</color><ctrl=2E/>",
      "old_target": "<color=0>那就从现在开始</color><row/><color=0>去一趟好了！”</color><ctrl=2E/>",
      "target": "<color=0>那现在</color><row/><color=0>去一趟就好了！”</color><ctrl=2E/>",
      "reason": "“これから行けば”指现在去即可，消除“从现在开始去”的机械时态表达。"
    },
    {
      "id": "scratch4.dat/s14:16209",
      "source": "<color=0>あ、あたしこそ、</color><row/><color=0>ゴメンなさい…。</color><ctrl=2E/>",
      "old_target": "<color=0>我、我才是，</color><row/><color=0>对不起……”</color><ctrl=2E/>",
      "target": "<color=0>我、我才该道歉，</color><row/><color=0>对不起……”</color><ctrl=2E/>",
      "reason": "补全“我才是”省略的谓语，使道歉对象和语义自然衔接。"
    },
    {
      "id": "scratch4.dat/s14:19805",
      "source": "<color=0>松田氏に部屋を調べて</color><row/><color=0>もらって、僕の知る</color><row/><color=0>澄佳の情報と比べて</color><row/><color=0>みたところ…</color><ctrl=2E/>",
      "old_target": "<color=0>但他替我们</color><row/><color=0>去房间里看了一番，</color><row/><color=0>再与我所知道的</color><row/><color=0>澄佳的情况对照……</color><ctrl=2E/>",
      "target": "<color=0>但松田先生替我们</color><row/><color=0>去房间里查看了一番，</color><row/><color=0>我们把查到的情况</color><row/><color=0>与我所知的澄佳的情况对照……</color><ctrl=2E/>",
      "reason": "明确查看者是松田、对照者是叙述者一行，避免顺接成松田负责对照。"
    },
    {
      "id": "scratch4.dat/s14:22552",
      "source": "<color=0>娘の友達でね、美紀恵の</color><row/><color=0>相手の男を探ってくれて</color><row/><color=0>いた子がいたんだが…</color><ctrl=2E/>",
      "old_target": "<color=0>我女儿有个朋友，</color><row/><color=0>一直在帮忙调查</color><row/><color=0>美纪惠的那个男人……</color><ctrl=2E/>",
      "target": "<color=0>我女儿有个朋友，</color><row/><color=0>一直在帮忙调查</color><row/><color=0>对美纪惠下手的那个男人……</color><ctrl=2E/>",
      "reason": "明确“相手の男”与美纪惠的关系，避免“美纪惠的那个男人”被误读为恋爱关系。"
    },
    {
      "id": "scratch4.dat/s14:30454",
      "source": "<color=0>澄佳が家を出た隙に、</color><row/><color=0>こっそりと部屋を</color><color=2>家探し</color><row/><color=0>させてもらおう、と</color><row/><color=0>提案した。</color><ctrl=2E/>",
      "old_target": "<color=0>趁澄佳出门时，</color><row/><color=0>我提议悄悄</color><color=2>搜查</color><row/><color=0>一下她的</color><row/><color=0>房间。</color><ctrl=2E/>",
      "target": "<color=0>我提议，趁澄佳出门时，</color><row/><color=0>悄悄</color><color=2>搜查</color><row/><color=0>一下她的</color><row/><color=0>房间。</color><ctrl=2E/>",
      "reason": "把“我提议”移到时间状语前，说明是提议趁出门搜查，而非出门时才提出建议。"
    },
    {
      "id": "scratch4.dat/s14:33865",
      "source": "<color=0>その奥に、</color><color=10>ゴミ箱</color><color=0>が</color><row/><color=0>置いてあった。</color><ctrl=2E/>",
      "old_target": "<color=0>那里面还有个</color><color=10>垃圾桶</color><color=0></color><row/><color=0>，放在深处。</color><ctrl=2E/>",
      "target": "<color=0>衣柜深处放着一个</color><color=10>垃圾桶</color><color=0></color><row/><color=0>。</color><ctrl=2E/>",
      "reason": "将位置状语提前，消除“还有个垃圾桶，放在深处”的倒装。"
    },
    {
      "id": "scratch4.dat/s14:39598",
      "source": "<color=0>そんな状況に置かれた</color><row/><color=0>人が、</color><color=2>ごめんなさい</color><color=0>と</color><row/><color=0>書き残すといったら…</color><ctrl=2E/>",
      "old_target": "<color=0>“一个陷入这种处境</color><row/><color=0>的人，写下</color><color=2>对不起</color><color=0>，</color><row/><color=0>留下这样的话……</color><ctrl=2E/>",
      "target": "<color=0>“一个陷入这种处境</color><row/><color=0>的人，要是留下‘</color><color=2>对不起</color><color=0>’</color><row/><color=0>这样的话……</color><ctrl=2E/>",
      "reason": "将写下和留下合成一个谓语，保留原文假设条件和高亮道歉内容。"
    },
    {
      "id": "scratch4.dat/s14:40083",
      "source": "<color=0>これはもう、</color><row/><color=0>十中八九、</color><color=2>自殺</color><color=0>だな。</color><ctrl=2B/>",
      "old_target": "<color=0>“这已经是，</color><row/><color=0>十有八九要</color><color=2>自杀</color><color=0>了。”</color><ctrl=2B/>",
      "target": "<color=0>“这么看来，</color><row/><color=0>十有八九要</color><color=2>自杀</color><color=0>了。”</color><ctrl=2B/>",
      "reason": "将生硬的“这已经是”改为承接推理的状语，保留十有八九的推测。"
    },
    {
      "id": "scratch4.dat/s14:42907",
      "source": "<color=0>澄佳は言えないのでは</color><row/><color=0>なく、自分の意思で</color><row/><color=2>言わない</color><color=0>だけだろう</color><row/><color=0>ということだった。</color><ctrl=2E/>",
      "old_target": "<color=0>澄佳不是不能说，</color><row/><color=0>而是出于自己的意志，</color><row/><color=2>不说</color><color=0>而已，</color><row/><color=0>恐怕就是这么回事。</color><ctrl=2E/>",
      "target": "<color=0>澄佳恐怕不是不能说，</color><row/><color=0>而是自己决定</color><row/><color=2>不说</color><color=0>，</color><row/><color=0>仅此而已。</color><ctrl=2E/>",
      "reason": "将推测置于判断前，并把“不说”与自主决定直接连接，避免后置总结的翻译腔。"
    },
    {
      "id": "scratch4.dat/s15:328",
      "source": "<color=0>バス爆破が澄佳の犯行</color><row/><color=0>だったと知り、自首を</color><row/><color=0>勧めてから、１ヶ月</color><row/><color=0>以上が経った。</color><ctrl=2E/>",
      "old_target": "<color=0>得知巴士爆炸案</color><row/><color=0>是澄佳所为，</color><row/><color=0>劝她自首，</color><row/><color=0>已经过去一个多月了。</color><ctrl=2E/>",
      "target": "<color=0>从得知巴士爆炸案</color><row/><color=0>是澄佳所为，</color><row/><color=0>并劝她自首那天起，</color><row/><color=0>已经过去一个多月了。</color><ctrl=2E/>",
      "reason": "补足“从……起”的时间框架，避免动作串列突然接经过时长。"
    },
    {
      "id": "scratch4.dat/s15:1705",
      "source": "<color=0>彼のパワーを持って</color><row/><color=0>しても、その内情を探る</color><row/><color=0>ことはできなかった。</color><ctrl=2E/>",
      "old_target": "<color=0>但就连他的本事，</color><row/><color=0>也没能</color><row/><color=0>探听到其中的内情。</color><ctrl=2E/>",
      "target": "<color=0>但就连他，</color><row/><color=0>也没能凭自己的本事</color><row/><color=0>探听到其中的内情。</color><ctrl=2E/>",
      "reason": "修正“本事没能探听”的主语错配，以侦探本人作探听者。"
    },
    {
      "id": "scratch4.dat/s15:5685",
      "source": "<color=0>しかも、かなりひどい</color><row/><color=0>目に遭わされている姿で</color><row/><color=0>正直、直視に耐えない。</color><ctrl=2E/>",
      "old_target": "<color=0>而且，她的模样</color><row/><color=0>显然遭受了严重折磨，</color><row/><color=0>实在让人不忍直视。</color><ctrl=2E/>",
      "target": "<color=0>而且，从她的模样来看，</color><row/><color=0>她显然遭受了严重折磨，</color><row/><color=0>实在让人不忍直视。</color><ctrl=2E/>",
      "reason": "将“模样”改为判断依据，避免以模样充当遭受折磨的主语。"
    },
    {
      "id": "scratch4.dat/s15:7296",
      "source": "<color=0>だから、お前さんなら</color><row/><color=0>わかるんじゃないかと</color><row/><color=0>思って聞いてるんだ。</color><ctrl=2E/>",
      "old_target": "<color=0>“所以我们才觉得，</color><row/><color=0>或许你能认出来，</color><row/><color=0>才来问你的。</color><ctrl=2E/>",
      "target": "<color=0>“正因为觉得</color><row/><color=0>或许你能认出来，</color><row/><color=0>我们才来问你的。</color><ctrl=2E/>",
      "reason": "理顺因为觉得能认出而询问的因果，消除重复“才”造成的因果错接。"
    },
    {
