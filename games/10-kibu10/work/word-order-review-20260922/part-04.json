  "changes": [
    {
      "id": "scratch4.dat/s04:1426",
      "source": "<color=0>死因は、首すじを刃物で</color><row/><color=0>切られたことによる、</color><row/><color=0>出血多量。</color><ctrl=2E/>",
      "old_target": "<color=0>死因是颈部被利器</color><row/><color=0>割伤后，</color><row/><color=0>失血过多。</color><ctrl=2E/>",
      "target": "<color=0>死因是颈部被利器</color><row/><color=0>割伤，导致</color><row/><color=0>失血过多。</color><ctrl=2E/>",
      "reason": "将受伤和死亡之间的因果关系连接完整，直接以死因统领句子，不再回补“这就是死因”。"
    },
    {
      "id": "scratch4.dat/s04:3467",
      "source": "<color=0>その相手は、かなり</color><row/><color=0>親しい人物…</color><ctrl=3A/><color=0>恐らく</color><row/><color=2>女性</color><color=0>であると考え</color><row/><color=0>られる。</color><ctrl=2E/>",
      "old_target": "<color=0>对方应该是与他</color><row/><color=0>相当亲近的人……</color><ctrl=3A/><color=0>恐怕是</color><row/><color=2>女性</color><color=0>，</color><row/><color=0>可以这样推测。</color><ctrl=2E/>",
      "target": "<color=0>对方应该是与他</color><row/><color=0>相当亲近的人……</color><ctrl=3A/><color=0>而且是</color><row/><color=2>女性</color><color=0>的可能性</color><row/><color=0>比较大。</color><ctrl=2E/>",
      "reason": "补齐“是女性的可能性比较大”的判断结构，去掉句末重复的推测套语，保留原停顿及不确定程度。"
    },
    {
      "id": "scratch4.dat/s04:4030",
      "source": "<color=0>それは即ち、</color><row/><color=2>殺す理由がない</color><color=0>…</color><row/><color=0>ということになる。</color><ctrl=2E/>",
      "old_target": "<color=0>这就意味着，</color><row/><color=2>没有杀他的理由</color><color=0>……</color><row/><color=0>可以这样理解。</color><ctrl=2E/>",
      "target": "<color=0>这就意味着，她们</color><row/><color=2>没有杀他的理由</color><color=0>…</color><row/><color=0>…</color><ctrl=2E/>",
      "reason": "补明主体并删除句尾重复的“可以这样理解”；普通正文末两段分别承载一个省略号字符，合行后仍为原来的完整省略号，不添加新结论。"
    },
    {
      "id": "scratch4.dat/s04:4229",
      "source": "<color=0>やはり、門沢に</color><color=2>暴行を</color><row/><color=2>受けた女性</color><color=0>が最も怪しい</color><row/><color=0>…という結論に達した</color><row/><color=0>のである。</color><ctrl=2E/>",
      "old_target": "<color=0>最后还是认为，遭门泽</color><color=2>侵犯的</color><row/><color=2>女性</color><color=0>最可疑</color><row/><color=0>……并得出了</color><row/><color=0>这个结论。</color><ctrl=2E/>",
      "target": "<color=0>遭门泽</color><color=2>侵犯的</color><row/><color=2>女性</color><color=0>最可疑</color><row/><color=0>……我最终还是</color><row/><color=0>得出了这个结论。</color><ctrl=2E/>",
      "reason": "原译“最后还是认为……并得出了这个结论”重复组织谓语；只保留一次得出结论的动作。"
    },
    {
      "id": "scratch4.dat/s04:4575",
      "source": "<color=0>門沢は首を切られた時、</color><row/><color=0>反撃せずに逃げた…と</color><row/><color=0>いうことになっている。</color><ctrl=2E/>",
      "old_target": "<color=0>门泽被割伤颈部后，</color><row/><color=0>没有反击，而是逃跑……</color><row/><color=0>我们目前是这样认为的。</color><ctrl=2E/>",
      "target": "<color=0>目前我们认为，门泽</color><row/><color=0>被割伤颈部后没有反击，</color><row/><color=0>而是选择了逃跑……</color><ctrl=2E/>",
      "reason": "将句末补充的判断主体前置，使当前推定统领整个经过，避免先断言再补“我们认为”的日式语序。"
    },
    {
      "id": "scratch4.dat/s04:5269",
      "source": "<color=0>…まあ単に、案外臆病な</color><row/><color=0>性格だっただけかも</color><row/><color=0>しれないが…。</color><ctrl=2E/>",
      "old_target": "<color=0>……当然，也有可能</color><row/><color=0>他其实是个出乎意料</color><row/><color=0>胆小的人……</color><ctrl=2E/>",
      "target": "<color=0>……当然，也可能</color><row/><color=0>他只是比我们想象中</color><row/><color=0>更胆小罢了……</color><ctrl=2E/>",
      "reason": "“是个出乎意料胆小的人”修饰关系不顺，改为清楚的比较结构，保留不确定语气。"
    },
    {
      "id": "scratch4.dat/s04:7879",
      "source": "<color=0>少なくとも</color><color=2>４人の</color><row/><color=2>被害者</color><color=0>がいることが、</color><row/><color=0>彼の部屋から出てきた</color><row/><color=0>写真で、判明した。</color><ctrl=2E/>",
      "old_target": "<color=0>他至少有</color><color=2>四名</color><row/><color=2>受害者</color><color=0>，这一点</color><row/><color=0>从他房间里找出的</color><row/><color=0>照片得到了确认。</color><ctrl=2E/>",
      "target": "<color=0>至少有</color><color=2>四名</color><row/><color=2>受害者</color><color=0>，这一点</color><row/><color=0>已从他房间里找出的</color><row/><color=0>照片中得到确认。</color><ctrl=2E/>",
      "reason": "去掉“他有受害者”的生硬领属表达，并补齐“从照片中得到确认”的介词结构。"
    },
    {
      "id": "scratch4.dat/s04:17687",
      "source": "<color=0>だいたい、いつも</color><row/><color=0>補助灯を</color><color=2>点灯させる</color><row/><color=2>時間</color><color=0>だった。</color><ctrl=2E/>",
      "old_target": "<color=0>大致就在平时</color><row/><color=0>会给辅助灯</color><color=2>开灯</color><row/><color=2>的时候</color><color=0>。</color><ctrl=2E/>",
      "target": "<color=0>大致就是平时</color><row/><color=0>将辅助灯</color><color=2>点亮</color><row/><color=2>的时间</color><color=0>。</color><ctrl=2E/>",
      "reason": "将“给辅助灯开灯”的重复宾语搭配改成“将辅助灯点亮”，保持点灯时间的高亮语义。"
    },
    {
      "id": "scratch4.dat/s04:21939",
      "source": "<color=0>「平和ボケした社会に</color><row/><color=0>鉄槌をくだした」とか…</color><ctrl=2E/>",
      "old_target": "<color=0>还有“我给这个因和平而麻木的</color><row/><color=0>社会，以一记重锤”之类……</color><ctrl=2E/>",
      "target": "<color=0>还有“我用重锤惩戒了这个</color><row/><color=0>因和平而麻木的社会”之类……</color><ctrl=2E/>",
      "reason": "原译“给社会，以一记重锤”混用了给予与施以两种句式；理顺动作及其对象。"
    },
    {
      "id": "scratch4.dat/s04:23009",
      "source": "<color=0>必ず、この９人に共通</color><row/><color=0>して恨みを持つ存在が</color><row/><color=0>いるはずなのだ。</color><ctrl=2E/>",
      "old_target": "<color=0>那么，一定有人</color><row/><color=0>对这九个人</color><row/><color=0>共同怀有怨恨。</color><ctrl=2E/>",
      "target": "<color=0>那么，一定有人</color><row/><color=0>对这九个人</color><row/><color=0>都怀有怨恨。</color><ctrl=2E/>",
      "reason": "“对九个人共同怀有怨恨”容易把共同归给多名怀恨者；原文指同一人对九人均有怨恨。"
    },
    {
      "id": "scratch4.dat/s04:24973",
      "source": "<color=0>試しに、あの事件は</color><row/><color=2>天罰</color><color=0>だという噂も</color><row/><color=0>あるが？…と訊ねて</color><row/><color=0>みた。</color><ctrl=2E/>",
      "old_target": "<color=0>我试探着问他：那起事件是</color><row/><color=2>天谴</color><color=0>，</color><row/><color=0>有这样的传言，</color><row/><color=0>你怎么看……</color><ctrl=2E/>",
      "target": "<color=0>我试探着问他：有人说那起事件是</color><row/><color=2>天谴</color><color=0>，</color><row/><color=0>对于这样的传言，</color><row/><color=0>你怎么看……</color><ctrl=2E/>",
      "reason": "把“有这样的传言”前置为“有人说”，让天谴从一开始就是传言内容，避免先断言后补来源。"
    },
    {
      "id": "scratch4.dat/s04:26438",
      "source": "<color=0>つまり、門沢殺しと</color><row/><color=2>同じ動機</color><color=0>を持っている</color><row/><color=0>人物ということになり…</color><ctrl=2E/>",
      "old_target": "<color=0>也就是说，嫌疑人怀有与杀害门泽者</color><row/><color=2>相同的动机</color><color=0>，</color><row/><color=0>可以这样理解……</color><ctrl=2E/>",
      "target": "<color=0>也就是说，要找的是与杀害门泽者怀有</color><row/><color=2>相同的动机</color><color=0>的</color><row/><color=0>人……</color><ctrl=2E/>",
      "reason": "用“要找的是……的人”完整承载嫌疑人判断，去除句末解释性回补，不另加本句未说出的具体动机。"
    },
    {
      "id": "scratch4.dat/s04:40169",
      "source": "<color=0>門沢の遺体発見現場で</color><row/><color=0>見つけた、あのカードと</color><row/><color=0>同じものだ…。</color><ctrl=2E/>",
      "old_target": "<color=0>和发现门泽尸体时，</color><row/><color=0>在现场找到的那张卡片，</color><row/><color=0>是一模一样的……</color><ctrl=2E/>",
      "target": "<color=0>这和在门泽尸体</color><row/><color=0>发现现场找到的那张卡片</color><row/><color=0>一模一样……</color><ctrl=2E/>",
      "reason": "明确比较主语“这”，将发现现场作为地点修饰语，不再在“和……是一模一样的”中插入时间分句。"
    },
    {
      "id": "scratch4.dat/s04:40685",
      "source": "<color=0>明らかに、見られては</color><row/><color=0>いけないものを見られた</color><row/><color=0>時の反応だ…。</color><ctrl=2E/>",
      "old_target": "<color=0>这反应，显然是</color><row/><color=0>不该被别人看见的东西</color><row/><color=0>被看见了……</color><ctrl=2E/>",
      "target": "<color=0>显然，这是不该让别人</color><row/><color=0>看见的东西被看见时</color><row/><color=0>才会有的反应……</color><ctrl=2E/>",
      "reason": "原译“这反应是……东西被看见了”主宾类型不一致；还原“这是某种情境下的反应”的完整结构。"
    },
    {
      "id": "scratch4.dat/s04:43052",
      "source": "<color=0>頑固なトコだけは、</color><row/><color=0>しっかり俺を受け継ぎ</color><row/><color=0>やがって。</color><ctrl=2E/>",
      "old_target": "<color=0>偏偏是这倔脾气，</color><row/><color=0>把我学了个</color><row/><color=0>十成十。</color><ctrl=2E/>",
      "target": "<color=0>她偏偏把我这倔脾气</color><row/><color=0>学了个</color><row/><color=0>十成十。</color><ctrl=2E/>",
      "reason": "明确学了父亲脾气的主体是女儿，避免“倔脾气把我学了”的错接。"
    },
    {
      "id": "scratch4.dat/s05:2033",
      "source": "<color=0>それよりさ、あれ</color><row/><color=0>どうなったのよ？</color><row/><color=0>妹浦澄佳。</color><ctrl=2E/>",
      "old_target": "<color=0>“先不说这个，那件事</color><row/><color=0>怎么样了？</color><row/><color=0>妹浦澄佳。”</color><ctrl=2E/>",
      "target": "<color=0>“先不说这个，</color><row/><color=0>妹浦澄佳那件事</color><row/><color=0>怎么样了？”</color><ctrl=2E/>",
      "reason": "将句末悬置的人名并入话题，不再照搬日语事后补充对象的语序。"
    },
    {
      "id": "scratch4.dat/s05:8398",
      "source": "<color=0>６日間に渡るＩ県への</color><row/><color=0>出張から帰ってきた。</color><ctrl=2E/>",
