    {"canonical": "砂永光二", "render": "砂永光二", "aliases": ["砂永"], "category": "person_name_or_form", "status": "project_locked", "first_recorded_game": "kibu1", "note": "读音 スナガ（Sunaga）；克罗什公司营业部长。", "source_refs": ["kibu1/characters/5", "kibu2/characters/5", "kibu3/characters/5", "kibu4/characters/5"]},
