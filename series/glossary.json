    {"canonical": "綾城", "render": "绫城", "category": "person_name_or_form", "status": "project_locked", "first_recorded_game": "kibu1", "note": "读音 アヤキ（Ayaki），不是 Ayashiro。程序员、村崎同事；未见名。", "source_refs": ["kibu1/characters/7", "kibu2/characters/7", "kibu3/characters/7", "kibu4/characters/7"]},
    {"canonical": "唐島萌奈", "render": "唐岛萌奈", "aliases": ["萌奈", "唐島", "唐沢萌奈"], "category": "person_name_or_form", "status": "project_locked", "first_recorded_game": "kibu1", "note": "读音 カラシマ モエナ（Karashima Moena）。设计师。scn4 [3378] 单次唐沢萌奈疑似原文笔误，其他处均唐島，应统一唐岛并记待审。", "source_refs": ["kibu1/characters/8", "kibu2/characters/8", "kibu3/characters/8", "kibu4/characters/8"]},
